# Valeurs locales sans secrets. make configure génère les secrets dans .env.local.
APP_ENV=dev
APP_SECRET=configure_with_make_configure
DATABASE_URL=mysql://genesis:configure_with_make_configure@database:3306/genesis_v2?serverVersion=11.8.0-MariaDB&charset=utf8mb4
MESSENGER_TRANSPORT_DSN=amqp://genesis:configure_with_make_configure@rabbitmq:5672/%2f/genesis_v2
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=no-reply@genesis-reborn.local
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=http://genesis-reborn.localhost/.well-known/mercure
MERCURE_JWT_SECRET=configure_with_make_configure
DEFAULT_URI=http://genesis-reborn.localhost
MERCURE_JWT_ISSUER=https://genesis-reborn.localhost
DB_HOST_PORT=3309

# Nom public de l’éditeur et du responsable des données ; renseigner hors du dépôt.
LEGAL_PUBLISHER_NAME=
