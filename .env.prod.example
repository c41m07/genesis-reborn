# Installation neuve : copier ce modèle dans .env.prod sur le VPS (chmod 600).
# Mise à jour : conserver les valeurs du VPS et comparer les clés selon docs/DEPLOIEMENT.md.
# Les domaines, identifiants et secrets d’exemple sont à remplacer sur le serveur.

# Application et déploiement

# Environnement Symfony. Le Compose de production impose prod.
APP_ENV=prod
# Débogage Symfony. Le Compose de production impose 0 (désactivé).
APP_DEBUG=0
# Image du jeu avec son empreinte. Aucun défaut. Le déploiement automatisé fournit cette référence.
APP_IMAGE=ghcr.io/owner/repository@sha256:REPLACE_WITH_CI_DIGEST
# Clé de signature Symfony. Aucun défaut. Générer une clé à l’installation et la conserver ensuite.
APP_SECRET=REPLACE_WITH_RANDOM_HEX
# Fichier chargé dans les conteneurs du jeu. Compose utilise .env.prod par défaut.
# APP_ENV_FILE=.env.prod

# Domaine et HTTPS

# Domaine public routé par Traefik, sans https://. Aucun défaut.
APP_DOMAIN=jeu.example.com
# URL publique HTTPS servant aux liens des courriels et aux métadonnées. Obligatoire en production.
DEFAULT_URI=https://jeu.example.com
# Nom du résolveur de certificats déclaré dans Traefik. Aucun défaut.
TRAEFIK_CERTRESOLVER=letsencrypt
# Sous-réseau dont Symfony accepte les en-têtes de proxy, notamment pour reconnaître HTTPS.
# Par défaut, aucun proxy de confiance. Remplacer l’exemple par le sous-réseau réel de Traefik.
SYMFONY_TRUSTED_PROXIES=172.30.0.0/24

# MariaDB et RabbitMQ

# Mot de passe initial du compte applicatif MariaDB. Aucun défaut. Le reporter dans DATABASE_URL.
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Mot de passe initial du compte administrateur MariaDB. Aucun défaut.
DB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
# Connexion de Symfony à la base du jeu avec le compte applicatif. Aucun défaut.
DATABASE_URL=mysql://genesis:REPLACE_WITH_DB_PASSWORD@database:3306/genesis_v2?serverVersion=11.8.0-MariaDB&charset=utf8mb4
# Mot de passe initial du compte RabbitMQ. Aucun défaut. Le reporter dans MESSENGER_TRANSPORT_DSN.
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_HEX
# Connexion de Symfony Messenger aux files de tâches du jeu sur RabbitMQ. Aucun défaut.
MESSENGER_TRANSPORT_DSN=amqp://genesis:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/%2f/genesis_v2

# Courriels et mentions légales

# Transport d’envoi des courriels du jeu. Obligatoire en production. Renseigner le relais réel.
MAILER_DSN=smtps://USER:PASSWORD@smtp.example.com:465
# Adresse d’expéditeur autorisée par le relais. Obligatoire en production.
# Symfony prévoit no-reply@genesis-reborn.local comme repli local.
MAILER_FROM=no-reply@jeu.example.com
# Nom public de l’éditeur et du responsable des données pour les pages légales. Vide par défaut.
LEGAL_PUBLISHER_NAME=

# Notifications en temps réel

# Adresse interne à laquelle le jeu publie ses événements. Obligatoire en production.
MERCURE_URL=http://mercure/.well-known/mercure
# Adresse HTTPS à laquelle les navigateurs reçoivent les événements. Obligatoire en production.
MERCURE_PUBLIC_URL=https://jeu.example.com/.well-known/mercure
# Clé secrète de signature des jetons partagée par Symfony et Mercure. Aucun défaut.
MERCURE_JWT_SECRET=REPLACE_WITH_RANDOM_HEX
# Identifiant d’émetteur inscrit dans les jetons Mercure. Obligatoire en production.
MERCURE_JWT_ISSUER=https://jeu.example.com

# Inactivité des joueurs

# Active le cycle des empires oubliés (inactivité, vacances, conversion et occupations).
# Par défaut, 0 (désactivé). La conversion des empires éligibles exige son traitement dédié.
FORGOTTEN_EMPIRES_ENABLED=0
# Autorise les courriels d’inactivité aux seuils de 14 et 27 jours. Par défaut, 0.
# À 1, la commande d’avertissement doit aussi être lancée avec --send.
EMPIRE_INACTIVITY_WARNINGS_ENABLED=0

# Hall de guilde

# Ouvre le financement du hall dans les univers où les guildes sont actives.
# Symfony utilise 0 si la variable est absente. Le modèle active le hall avec 1.
GUILD_HALL_ENABLED=1
# Force totale à financer pour un hall. Par défaut, 500000 points.
# Le premier financement enregistre les trois seuils pour ce hall.
GUILD_HALL_REQUIRED_STRENGTH=500000
# Nombre minimal de donateurs ayant atteint le seuil personnel. Par défaut, 3 membres.
GUILD_HALL_REQUIRED_DONORS=3
# Contribution cumulée minimale par membre pour compter comme donateur. Par défaut, 50000 points.
GUILD_HALL_MINIMUM_DONOR_STRENGTH=50000

# Alertes d’exploitation

# Autorise les courriels d’alerte, de rappel et de rétablissement. Par défaut, 0.
# À 1, renseigner le destinataire et lancer le contrôle avec --send.
OPS_ALERT_ENABLED=0
# Adresse qui reçoit les alertes techniques. Vide par défaut.
OPS_ALERT_TO=
# Âge du dernier signe de vie à partir duquel un processus est signalé. Par défaut, 120 s (2 min).
OPS_ALERT_SIGNAL_SECONDS=120
# Retard de publication à partir duquel le contrôle signale une alerte. Par défaut, 300 s (5 min).
OPS_ALERT_RELAY_SECONDS=300
# Délai minimal entre deux notifications pour un incident persistant. Par défaut, 3600 s (1 h).
OPS_ALERT_REMINDER_SECONDS=3600

# Activation administrative et vérification des comptes

# Autorise un administrateur à demander un lien d’activation. Par défaut, 0.
# La configuration livrée utilise un transport administratif indisponible.
ADMIN_ACTIVATION_ENABLED=0
# Active la reprise d’une demande administrative. Par défaut, 0.
# Ce mode exige un fournisseur de reprise. En son absence, l’action devient indisponible.
ADMIN_ACTIVATION_RECOVERY_ENABLED=0
# Accepte les liens historiques et versionnés. Par défaut, 0 (lecture des liens historiques).
EMAIL_VERIFICATION_MIXED_READER_ENABLED=0
# Émet des liens versionnés à l’inscription et au renvoi. Par défaut, 0 (envoi habituel).
# Ce mode exige le lecteur mixte et un fournisseur d’envoi. Le fournisseur est absent
# de la configuration livrée : passer à 1 empêcherait l’envoi des confirmations.
EMAIL_VERIFICATION_VERSIONED_WRITER_ENABLED=0
