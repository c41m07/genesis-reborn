# À copier en .env.prod sur le serveur uniquement (chmod 600).
APP_ENV=prod
APP_DEBUG=0
APP_IMAGE=ghcr.io/owner/repository@sha256:REPLACE_WITH_CI_DIGEST
APP_DOMAIN=jeu.example.com
TRAEFIK_CERTRESOLVER=letsencrypt
APP_SECRET=REPLACE_WITH_RANDOM_HEX
DB_PASSWORD=REPLACE_WITH_RANDOM_HEX
DB_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_HEX
DATABASE_URL=mysql://genesis:REPLACE_WITH_DB_PASSWORD@database:3306/genesis_v2?serverVersion=11.8.0-MariaDB&charset=utf8mb4
MESSENGER_TRANSPORT_DSN=amqp://genesis:REPLACE_WITH_RABBITMQ_PASSWORD@rabbitmq:5672/%2f/genesis_v2
MAILER_DSN=smtps://USER:PASSWORD@smtp.example.com:465
MAILER_FROM=no-reply@example.com
# Conserver désactivé tant que le cycle complet des empires oubliés n’est pas livré.
EMPIRE_INACTIVITY_WARNINGS_ENABLED=0
FORGOTTEN_EMPIRES_ENABLED=0
MERCURE_URL=http://mercure/.well-known/mercure
MERCURE_PUBLIC_URL=https://jeu.example.com/.well-known/mercure
MERCURE_JWT_SECRET=REPLACE_WITH_RANDOM_HEX
MERCURE_JWT_ISSUER=https://jeu.example.com
DEFAULT_URI=https://jeu.example.com
# Remplacer par le sous-réseau exact du réseau Traefik, pas toutes les IP.
SYMFONY_TRUSTED_PROXIES=172.30.0.0/24

# Alertes : renseigner la destination et valider le transport avant activation.
OPS_ALERT_ENABLED=0
OPS_ALERT_TO=
OPS_ALERT_SIGNAL_SECONDS=120
OPS_ALERT_RELAY_SECONDS=300
OPS_ALERT_REMINDER_SECONDS=3600

# Nom public de l’éditeur et du responsable des données ; renseigner hors du dépôt.
LEGAL_PUBLISHER_NAME=
