{% macro field(field, group, slug, label) %}
    {% set fieldId = group ~ '-' ~ slug ~ '-' ~ field.path|replace({'.': '-'}) %}
    <div class="admin-balance-field">
        <label for="{{ fieldId }}">{{ label }}</label>
        <input id="{{ fieldId }}" type="number" name="values[{{ field.path|split('.')|join('][') }}]" value="{{ field.value }}" min="{{ field.min }}" max="{{ field.max }}" step="{{ field.integer ? '1' : '0.01' }}" aria-describedby="{{ fieldId }}-range" required>
        <small>{{ field.overridden ? 'Surcharge de cet univers' : 'Catalogue de référence' }} · Référence : {{ field.reference }}</small>
        <small id="{{ fieldId }}-range">{{ field.min|number_format(field.min < 1 and field.min > 0 ? 2 : 0, ',', ' ') }} à {{ field.max|number_format(0, ',', ' ') }} · {{ field.integer ? 'entier' : 'pas de 0,01' }}</small>
    </div>
{% endmacro %}
{% import _self as editor %}
{% if item.inactive_fields %}<details><summary>Paramètres historiques non modifiables</summary><ul>{% for explanation in item.inactive_fields %}<li>{{ explanation }}</li>{% endfor %}</ul></details>{% endif %}
{% set tierLabels = {'basic': 'Basique', 'intermediate': 'Intermédiaire', 'superior': 'Supérieur'} %}
{% set resourceOrder = constant('App\\Service\\Colony\\ResourceService::DISPLAY_ORDER') %}
{% set resourceLabels = {'metal': 'Métal', 'nano': 'Nano', 'antimatter': 'Antimatière', 'hydrogen': 'Hydrogène', 'electricity': 'Électricité'} %}
<form class="admin-catalogue-editor" method="post" action="{{ path('app_admin_catalogue_save', {id: universe.id, group: group, slug: item.slug}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_catalogue_' ~ universe.id ~ '_' ~ group ~ '_' ~ item.slug) }}">
    <input type="hidden" name="revision" value="{{ item.revision }}">
    {% if item.draft|default(false) %}<p role="status">Votre saisie est conservée. Si le catalogue a changé, <a href="{{ path('app_admin_catalogue_edit', {id: universe.id, group: group, slug: item.slug, reload: 1}) }}">abandonnez cette saisie et rechargez les valeurs actuelles</a>.</p>{% endif %}
    {# Le schéma serveur reste la seule source des champs, y compris les coûts présents par rang. #}
    {% set costFields = item.fields|filter(field => field.path starts with 'cost_profiles.') %}
    {% if costFields %}
        <h3>Coûts par rang</h3>
        {% if group in ['buildings', 'technologies'] %}
            <p>En Intermédiaire et Supérieur, ces quantités fixent la répartition entre matériaux. Le budget de départ dépend du niveau des prérequis. L’aperçu donne le prix du devis.</p>
        {% endif %}
        <div class="admin-catalogue-costs">
            {% for tier, label in tierLabels %}
                {% set tierFields = costFields|filter(field => field.path starts with 'cost_profiles.' ~ tier ~ '.') %}
                {% if tierFields %}
                    <fieldset>
                        <legend>{{ label }}</legend>
                        {% for resource in resourceOrder %}
                            {% set field = tierFields['cost_profiles.' ~ tier ~ '.' ~ resource]|default(null) %}
                            {% if field %}
                                {{ editor.field(field, group, item.slug, resourceLabels[resource]) }}
                            {% endif %}
                        {% endfor %}
                    </fieldset>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
    <h3>Propriétés de la fiche</h3>
    <div class="catalog-balance-grid">
        {% for field in item.fields|filter(field => not (field.path starts with 'cost_profiles.')) %}
            {{ editor.field(field, group, item.slug, field.label) }}
        {% endfor %}
    </div>
    <div class="admin-catalogue-decision-layout">
    <div class="admin-catalogue-publication" id="catalogue-publication" tabindex="-1">
    <h3>Enregistrer dans {{ universe.name }}</h3>
    <label for="catalogue-reason">Motif de la modification</label>
    <textarea id="catalogue-reason" name="reason" minlength="5" maxlength="1000" required>{{ item.reason|default('') }}</textarea>
    <label><input type="checkbox" name="confirmed" value="1" required> Je confirme cette modification pour {{ universe.name }}.</label>
    <button class="primary">Enregistrer cet équilibrage</button>
    </div>
    <fieldset class="admin-catalogue-preview-inputs">
        <legend>Prévisualiser un devis sans enregistrer</legend>
        <p>Aucun bonus de bâtiment ou de recherche. Multiplicateurs actuels de cet univers. Les prérequis, plafonds de niveau, stocks disponibles et effets de production d’une planète ne sont pas vérifiés par ce devis. Il ne garantit pas que la modification soit publiable.</p>
        <label for="preview-tier">Rang du devis</label>
        <select id="preview-tier" name="preview_tier">{% for tier, label in tierLabels %}<option value="{{ tier }}"{% if item.preview.tier|default('basic') == tier %} selected{% endif %}>{{ label }}</option>{% endfor %}</select>
        {% if group in ['buildings', 'technologies'] %}
            <label for="preview-level">Niveau du devis</label>
            <input id="preview-level" name="preview_level" type="number" min="1" max="100" value="{{ item.preview.level|default(1) }}">
        {% else %}
            <label for="preview-quantity">Quantité du devis</label>
            <input id="preview-quantity" name="preview_quantity" type="number" min="1" max="1000" value="{{ item.preview.quantity|default(1) }}">
        {% endif %}
        <button class="secondary" name="preview" value="1" formnovalidate>Comparer le devis</button>
    </fieldset>
    </div>
    {% if item.preview|default(null) %}
        <section aria-labelledby="preview-heading">
            <h3 id="preview-heading">Comparaison calculée, non enregistrée</h3>
            <p>{{ tierLabels[item.preview.tier] }} · niveau {{ item.preview.level }} · quantité {{ item.preview.quantity }}. Le devis est indicatif et sera périmé si le catalogue change.</p>
            <p>Coefficient de durée de l’univers : × {{ item.preview.time_multiplier }}</p>
            <div class="table-scroll" role="region" tabindex="0" aria-labelledby="preview-heading">
                <table class="admin-ops-table admin-design-comparison">
                    <caption>Durée et coûts indicatifs</caption>
                    <thead><tr><th scope="col">Élément</th><th scope="col">Actuel</th><th scope="col">Proposé</th></tr></thead>
                    <tbody>
                        <tr><th scope="row">Durée</th><td>{{ item.preview.before.duration }} s</td><td>{{ item.preview.after.duration }} s</td></tr>
                        {% for resource in resourceOrder %}
                            <tr><th scope="row">{{ resourceLabels[resource] }}</th><td>{{ item.preview.before.costs[resource]|default(0) }}</td><td>{{ item.preview.after.costs[resource]|default(0) }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
    {% endif %}
</form>
<form class="admin-catalogue-reset" method="post" action="{{ path('app_admin_catalogue_save', {id: universe.id, group: group, slug: item.slug}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_catalogue_' ~ universe.id ~ '_' ~ group ~ '_' ~ item.slug) }}">
    <input type="hidden" name="reset" value="1">
    <input type="hidden" name="revision" value="{{ item.revision }}">
    <p>Cette action supprime les surcharges de cette fiche pour cet univers. Elle ne restaure pas une version historique.</p>
    <label for="catalogue-reset-reason">Motif du retour aux références</label>
    <textarea id="catalogue-reset-reason" name="reason" minlength="5" maxlength="1000" required></textarea>
    <label><input type="checkbox" name="confirmed" value="1" required> Je confirme le retour aux références pour cette fiche.</label>
    <button class="secondary">Restaurer les valeurs de référence</button>
</form>
