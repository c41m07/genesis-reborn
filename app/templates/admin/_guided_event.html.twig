{% set effectiveStatus=event.status=='cancelled' ? 'Annulé' : (event.endsAt<=date() ? 'Terminé' : (event.startsAt>date() ? 'Planifié' : 'En cours')) %}
<h3>{{ event.name }}</h3><p>{{ event.type=='production_bonus' ? 'Bonus de production' : 'Annonce' }} · {{ effectiveStatus }} · {{ event.universe ? event.universe.name : 'Tous les univers' }}</p><p class="admin-case-text">{{ event.description }}</p><p>{{ event.startsAt|date('d/m/Y H:i','UTC') }} → {{ event.endsAt|date('d/m/Y H:i','UTC') }} UTC{% if event.type=='production_bonus' %} · Production +{{ event.parameters.percentage }} %{% endif %}</p>
{% if event.parameters.challenge_id|default(null) %}<a class="secondary" href="{{ path('app_admin_challenge',{id:event.parameters.challenge_id}) }}">Gérer le défi collectif et son annonce</a>
{% elseif event.status in ['planned','active'] and event.endsAt>date() %}<p>La définition publiée est figée. Une annulation conserve les effets de production déjà acquis.</p><form method="post" action="{{ path('app_admin_game_event_cancel',{id:event.id}) }}" class="admin-intervention-form"><input type="hidden" name="_token" value="{{ csrf_token('game_event_cancel_'~event.id) }}"><label for="cancel-event-{{ event.id }}">Motif d’annulation</label><textarea id="cancel-event-{{ event.id }}" name="reason" maxlength="1000" required></textarea><label class="admin-intervention-confirm"><input type="checkbox" name="confirmed" value="1" required> Je confirme l’annulation de cet événement.</label><button class="secondary">Annuler cet événement guidé</button></form>{% endif %}
