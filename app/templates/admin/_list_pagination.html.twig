{% if listing.pages > 1 %}<nav class="admin-mission-pages" aria-label="Pagination">{% if listing.page > 1 %}<a class="secondary" href="{{ path(route,filters|default({})|merge({page:listing.page-1})) }}">Page précédente</a>{% endif %}<span>Page {{ listing.page }} / {{ listing.pages }}</span>{% if listing.page < listing.pages %}<a class="secondary" href="{{ path(route,filters|default({})|merge({page:listing.page+1})) }}">Page suivante</a>{% endif %}</nav>{% endif %}
