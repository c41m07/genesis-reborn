{% if departure_trace %}<section class="panel"><h2>Départ conservé</h2><details><summary>Consulter l’instantané du départ</summary>
<p>{{ departure_trace.departedAt|date('d/m/Y H:i:s',preferences.timezone) }} · {{ departure_trace.snapshot.origin }} → {{ departure_trace.snapshot.target }}</p>
<ul class="admin-monitor-report-list">{% for ship in departure_trace.snapshot.ships %}<li>{{ ship.label }} · {{ ship.tier }} · {{ ship.quantity|number_format(0,',',' ') }}</li>{% endfor %}</ul>
<dl class="report-facts">{% for slug,amount in departure_trace.snapshot.freight %}<div><dt>{{ resources[slug]|default(slug) }}</dt><dd>{{ amount|number_format(2,',',' ') }}</dd></div>{% endfor %}<div><dt>Carburant réservé au départ</dt><dd>{{ departure_trace.snapshot.fuel|number_format(2,',',' ') }}</dd></div></dl><p>Cet instantané reste distinct de l’état courant de la flotte.</p></details></section>
{% else %}<p class="muted">Cette mission ne possède pas d’instantané de départ : aucun historique n’a été reconstruit.</p>{% endif %}
