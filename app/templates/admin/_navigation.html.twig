{% import 'ui/macros.html.twig' as ui %}
{# Les liens restent disponibles sans JavaScript, y compris sur mobile. #}
{% set navigationGroups = [
    {label:'Joueurs et modération', icon:'user', items:[
        {route:'app_admin_players', label:'Joueurs', matches:['app_admin_players','app_admin_player']},
        {route:'app_admin_reports', label:'Signalements', matches:['app_admin_reports'], category:'reports'},
        {route:'app_admin_feedbacks', label:'Feedbacks', prefix:'app_admin_feedback', category:'feedbacks'},
        {route:'app_admin_cases', label:'Dossiers', prefix:'app_admin_case'}
    ]},
    {label:'Univers et activité', icon:'universe', items:[
        {route:'app_admin_universes', label:'Univers', matches:['app_admin_universes','app_admin_universe_metrics','app_admin_catalogue','app_admin_resource_boxes']},
        {route:'app_admin_surveillance', label:'Alertes', matches:['app_admin_surveillance']},
        {route:'app_admin_missions', label:'Flottes et transports', prefix:'app_admin_mission'}
    ]},
    {label:'Animation', icon:'notifications', items:[
        {route:'app_admin_game_events', label:'Événements', matches:['app_admin_game_events','app_admin_event_wizard','app_admin_event_preview']},
        {route:'app_admin_challenges', label:'Défis collectifs', prefix:'app_admin_challenge'},
        {route:'app_admin_weekly_rotations', label:'Rotations hebdomadaires', prefix:'app_admin_weekly_rotation'},
        {route:'app_admin_patchnotes', label:'Patchnotes', prefix:'app_admin_patchnote'}
    ]},
    {label:'Exploitation', icon:'clock', items:[
        {route:'app_admin_security', label:'Sécurité', matches:['app_admin_security'], category:'security'},
        {route:'app_admin_operations', label:'État des traitements', matches:['app_admin_operations']},
        {route:'app_admin_audit', label:'Journal des actions', matches:['app_admin_audit']},
        {route:'app_admin_legal_preview', label:'Brouillons juridiques', matches:['app_admin_legal_preview']}
    ]}
] %}
{% set activeGroup = null %}
{% set activeItem = null %}
{% for group in navigationGroups %}
    {% for item in group.items %}
        {% if currentRoute in item.matches|default([]) or (item.prefix is defined and currentRoute starts with item.prefix) %}
            {% set activeGroup = group %}
            {% set activeItem = item %}
        {% endif %}
    {% endfor %}
{% endfor %}
{% if placement == 'sidebar' %}
    <nav aria-label="Console d’administration">
        <a href="{{ path('app_admin_index') }}" {% if currentRoute == 'app_admin_index' %}class="active" aria-current="page"{% endif %}>{{ ui.icon('overview') }} Vue d’ensemble</a>
        {% for group in navigationGroups %}
            <details class="admin-navigation-group" open>
                <summary>{{ ui.icon(group.icon) }} {{ group.label }}</summary>
                <div class="admin-navigation-links">
                    {% for item in group.items %}
                        <a href="{{ path(item.route) }}" {% if activeItem and activeItem.route == item.route %}class="active" aria-current="{{ currentRoute == item.route ? 'page' : 'location' }}"{% endif %}>
                            {{ item.label }}
                            {% if item.category is defined %}{% include 'ui/admin_notification_badge.html.twig' with {category:item.category, count:attribute(adminNotifications,item.category)} only %}{% endif %}
                        </a>
                    {% endfor %}
                </div>
            </details>
        {% endfor %}
    </nav>
{% elseif activeGroup %}
    {% set breadcrumbs = [{label:'Vue d’ensemble', url:path('app_admin_index')}, {label:activeGroup.label, url:null}] %}
    {% set detailLabel = null %}
    {% if currentRoute == 'app_admin_player' %}{% set detailLabel = player.username %}
    {% elseif currentRoute == 'app_admin_feedback' %}{% set detailLabel = feedback.title %}
    {% elseif currentRoute == 'app_admin_case' %}{% set detailLabel = 'Dossier n° '~caseFile.id %}
    {% elseif currentRoute == 'app_admin_case_new' %}{% set detailLabel = 'Nouveau dossier' %}
    {% elseif currentRoute == 'app_admin_challenge' %}{% set detailLabel = challenge.name %}
    {% elseif currentRoute == 'app_admin_mission' %}{% set detailLabel = 'Flotte n° '~fleet.id %}
    {% elseif currentRoute in ['app_admin_mission_combat','app_admin_mission_espionage'] %}
        {% set breadcrumbs = breadcrumbs|merge([{label:activeItem.label, url:path(activeItem.route)}, {label:'Flotte n° '~app.request.attributes.get('id'), url:path('app_admin_mission',{id:app.request.attributes.get('id')})}]) %}
        {% set detailLabel = currentRoute == 'app_admin_mission_combat' ? 'Rapport de combat' : 'Rapport d’espionnage' %}
    {% elseif currentRoute == 'app_admin_event_wizard' %}{% set detailLabel = 'Préparer un événement' %}
    {% elseif currentRoute == 'app_admin_event_preview' %}
        {% set breadcrumbs = breadcrumbs|merge([{label:activeItem.label, url:path(activeItem.route)}, {label:'Préparer un événement', url:path('app_admin_event_wizard')}]) %}
        {% set detailLabel = 'Aperçu avant confirmation' %}
    {% elseif currentRoute in ['app_admin_catalogue','app_admin_resource_boxes','app_admin_universe_metrics'] %}
        {% set breadcrumbs = breadcrumbs|merge([{label:'Univers', url:path('app_admin_universes')}, {label:universe.name, url:path('app_admin_universes', {_fragment:'admin-universe-'~universe.id})}]) %}
        {% set detailLabel = {app_admin_catalogue:'Catalogue', app_admin_resource_boxes:'Boîtes de ressources', app_admin_universe_metrics:'Mesures'}[currentRoute] %}
    {% endif %}
    {% if currentRoute not in ['app_admin_event_preview','app_admin_catalogue','app_admin_resource_boxes','app_admin_universe_metrics','app_admin_mission_combat','app_admin_mission_espionage'] %}
        {% set breadcrumbs = breadcrumbs|merge([{label:activeItem.label, url:detailLabel ? path(activeItem.route) : null}]) %}
    {% endif %}
    {% if detailLabel %}{% set breadcrumbs = breadcrumbs|merge([{label:detailLabel, url:null}]) %}{% endif %}
    <nav class="admin-breadcrumbs" aria-label="Fil d’Ariane">
        <ol>{% for crumb in breadcrumbs %}<li>{% if crumb.url %}<a href="{{ crumb.url }}">{{ crumb.label }}</a>{% else %}<span {% if loop.last %}aria-current="page"{% endif %}>{{ crumb.label }}</span>{% endif %}</li>{% endfor %}</ol>
    </nav>
    <nav class="admin-section-navigation" aria-label="{{ activeGroup.label }}">
        {% for item in activeGroup.items %}<a href="{{ path(item.route) }}" {% if activeItem.route == item.route %}aria-current="{{ currentRoute == item.route ? 'page' : 'location' }}"{% endif %}>{{ item.label }}</a>{% endfor %}
    </nav>
    {% if currentRoute in ['app_admin_catalogue','app_admin_resource_boxes','app_admin_universe_metrics'] %}
        <nav class="admin-universe-navigation" aria-label="Gestion de {{ universe.name }}">
            <span>{{ universe.name }}</span>
            {% for route,label in {app_admin_universe_metrics:'Mesures',app_admin_catalogue:'Catalogue',app_admin_resource_boxes:'Boîtes de ressources'} %}<a href="{{ path(route,{id:universe.id}) }}" {% if currentRoute == route %}aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}
        </nav>
    {% endif %}
{% endif %}
