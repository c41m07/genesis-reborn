<details class="admin-resource-intervention" id="ships-{{ planet.id }}"><summary>Attribuer des vaisseaux à {{ planet.name }}</summary>
<p class="admin-intervention-destination">Destination : {{ planet.name }} · {{ planet.coordinates() }} · {{ row.membership.universe.name }} · {{ player.username }}</p>
<p>Ajout au stock au sol ; aucune flotte en mission n’est modifiée.</p>
<form method="post" action="{{ path('app_admin_player_ships',{id:player.id,planetId:planet.id}) }}" class="admin-intervention-form">
<input type="hidden" name="_token" value="{{ csrf_token('admin_ships_'~planet.id) }}"><input type="hidden" name="request_key" value="{{ stocks[planet.id].ships_request_key }}">
<div class="admin-intervention-field">
    <label for="ship-type-{{ planet.id }}">Type de vaisseau</label>
    <select id="ship-type-{{ planet.id }}" name="slug" required>{% for slug,ship in ship_catalog %}<option value="{{ slug }}">{{ ship.label }}</option>{% endfor %}</select>
</div>
<div class="admin-intervention-field">
    <label for="ship-tier-{{ planet.id }}">Rang</label>
    <select id="ship-tier-{{ planet.id }}" name="tier" required>{% for tier,definition in ship_tiers %}<option value="{{ tier }}">{{ definition.label }}</option>{% endfor %}</select>
</div>
<div class="admin-intervention-field">
    <label for="ship-quantity-{{ planet.id }}">Quantité à attribuer</label>
    <input id="ship-quantity-{{ planet.id }}" name="quantity" type="number" min="1" max="2147483647" step="1" value="1" required aria-describedby="ship-quantity-limit-{{ planet.id }}">
    <small id="ship-quantity-limit-{{ planet.id }}">Entier de 1 à 2 147 483 647</small>
</div>
<div class="admin-intervention-field">
    <label for="ship-reason-{{ planet.id }}">Motif de l’attribution (obligatoire)</label>
    <textarea id="ship-reason-{{ planet.id }}" name="reason" maxlength="1000" required aria-describedby="ship-reason-limit-{{ planet.id }}"></textarea>
    <small id="ship-reason-limit-{{ planet.id }}">1 000 caractères maximum</small>
</div>
<label class="admin-intervention-confirm"><input type="checkbox" name="confirmed" value="1" required> Je confirme le joueur, la colonie, le type, le rang et la quantité indiqués.</label>
<button class="primary" type="submit">Attribuer les vaisseaux</button></form></details>
