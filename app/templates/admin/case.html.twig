{% extends 'admin/layout.html.twig' %}
{% block title %}{{ caseFile.title }} · Dossier{% endblock %}
{% block body %}
<a class="inline-link" href="{{ path('app_admin_cases') }}">← Dossiers de surveillance</a><div class="page-heading"><div><h1>{{ caseFile.title }}</h1><p>Dossier n° {{ caseFile.id }} · {{ statuses[caseFile.status] }} · {{ caseFile.universe ? caseFile.universe.name : 'Plateforme' }}</p></div></div>
<section class="panel"><h2>Observations initiales</h2><p class="admin-case-text">{{ caseFile.description ?: 'Aucune observation initiale.' }}</p><p>Ouvert le {{ caseFile.createdAt|date('d/m/Y H:i',preferences.timezone) }} par {{ caseFile.createdBy ? caseFile.createdBy.username : 'Compte supprimé' }}.</p>
{% if caseFile.membership.player|default(null) %}<a href="{{ path('app_admin_player',{id:caseFile.membership.player.id}) }}">Fiche joueur</a>{% endif %}{% if caseFile.fleet %}<a href="{{ path('app_admin_mission',{id:caseFile.fleet.id}) }}">Inspecter la flotte n° {{ caseFile.fleet.id }}</a>{% endif %}</section>
<section class="panel"><h2>Notes de suivi</h2><ol class="admin-monitor-report-list">{% for note in notes %}<li><strong>{{ note.author ? note.author.username : 'Compte supprimé' }}</strong> · {{ note.createdAt|date('d/m/Y H:i:s',preferences.timezone) }}<p class="admin-case-text">{{ note.body }}</p></li>{% else %}<li>Aucune note de suivi.</li>{% endfor %}</ol></section>
<section class="panel"><h2>Ajouter un suivi</h2><form method="post" action="{{ path('app_admin_case_update',{id:caseFile.id}) }}" class="admin-intervention-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_case_update_'~caseFile.id) }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="expected_status" value="{{ caseFile.status }}">
<label for="case-status">État du dossier</label><select id="case-status" name="status">{% for value,label in statuses %}<option value="{{ value }}" {{ caseFile.status==value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><label for="case-body">Nouvelle note</label><textarea id="case-body" name="body" maxlength="10000"></textarea><p>Les notes ajoutées sont conservées ; une correction s’effectue dans une nouvelle note.</p><button class="secondary">Enregistrer le suivi</button></form></section>
{% endblock %}
