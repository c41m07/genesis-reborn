{% extends 'admin/layout.html.twig' %}
{% block title %}Dossiers de surveillance · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Dossiers de surveillance</h1><p>Notes internes et suivi des éléments à examiner.</p></div><a class="secondary" href="{{ path('app_admin_case_new') }}">Créer un dossier</a></div>
<form method="get" class="feedback-admin-filters"><label>Recherche<input type="search" name="q" value="{{ filters.q }}" maxlength="120"></label><label>Univers<select name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ filters.universe==universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select></label><label>État<select name="status"><option value="active" {{ filters.status=='active' ? 'selected' : '' }}>Dossiers actifs</option><option value="" {{ filters.status=='' ? 'selected' : '' }}>Tous les états</option>{% for value,label in statuses %}<option value="{{ value }}" {{ filters.status==value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
{% if filters.membership %}<input type="hidden" name="membership" value="{{ filters.membership }}">{% endif %}{% if filters.fleet %}<input type="hidden" name="fleet" value="{{ filters.fleet }}">{% endif %}<button class="secondary">Filtrer les dossiers</button></form>
<section class="panel"><h2>{{ total }} dossier(s)</h2><ul class="admin-monitor-report-list">{% for dossier in cases %}<li><a href="{{ path('app_admin_case',{id:dossier.id}) }}">{{ dossier.title }} · n° {{ dossier.id }}</a><small>{{ statuses[dossier.status] }} · {{ dossier.universe ? dossier.universe.name : 'Plateforme' }} · {{ dossier.updatedAt|date('d/m/Y H:i',preferences.timezone) }}</small></li>{% else %}<li>Aucun dossier ne correspond aux filtres.</li>{% endfor %}</ul></section>
{% if pages>1 %}<nav class="admin-mission-pages" aria-label="Pagination des dossiers">{% if page>1 %}<a href="{{ path('app_admin_cases',filters|merge({page:page-1})) }}">Précédent</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page<pages %}<a href="{{ path('app_admin_cases',filters|merge({page:page+1})) }}">Suivant</a>{% endif %}</nav>{% endif %}
{% endblock %}
