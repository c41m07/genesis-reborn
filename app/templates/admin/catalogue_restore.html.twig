{% extends 'admin/layout.html.twig' %}
{% block title %}Préparer une restauration · {{ universe.name }}{% endblock %}
{% block body %}
{% set linear = app.request.query.all()['presentation']|default(null) == 'lineaire' %}
{% set restoreLink = {id: universe.id, group: group, slug: slug, source: source} %}
<div class="page-heading admin-task-heading">
    <div><p class="eyebrow">Catalogue · {{ itemLabel }} · {{ universe.name }}</p>
    <h1>Restaurer les valeurs de la trace #{{ source }}</h1>
    <p>Seuls les champs modifiables seront réappliqués. Règles, prérequis, stocks, files déjà payées et niveaux des joueurs ne sont pas restaurés.</p></div>
</div>
<nav class="admin-design-mode" aria-label="Présentation de la restauration">
    <a class="secondary" href="{{ path('app_admin_catalogue_restore', restoreLink) }}"{% if not linear %} aria-current="true"{% endif %}>Vue côte à côte</a>
    <a class="secondary" href="{{ path('app_admin_catalogue_restore', restoreLink|merge({presentation: 'lineaire'})) }}"{% if linear %} aria-current="true"{% endif %}>Vue linéaire</a>
</nav>
<div class="core-admin-restoration admin-restoration-layout{{ linear ? ' admin-restoration-layout--linear' : '' }}">
<section class="panel admin-design-comparison-panel" aria-labelledby="restore-comparison-title">
<h2 id="restore-comparison-title">Valeurs à réappliquer</h2>
<h2>Devis indicatif</h2>
<p>Rang basique, niveau 1, quantité 1, sans bonus ni vérification des stocks ou prérequis d’une planète. Ce n’est pas une restauration de l’ancien contexte de jeu.</p>
{% set resourceLabels={metal:'Métal',nano:'Nano',hydrogen:'Hydrogène',antimatter:'Antimatière',electricity:'Électricité'} %}
<div class="table-scroll" role="region" tabindex="0" aria-label="Comparaison des valeurs, durées et coûts">
    <table class="admin-ops-table"><caption>Devis indicatif et valeurs historiques proposées</caption><thead><tr><th scope="col">Élément</th><th scope="col">Actuel</th><th scope="col">Proposé</th></tr></thead><tbody>
    <tr><th scope="row">Durée</th><td>{{ preview.quote.before.duration }} s</td><td>{{ preview.quote.after.duration }} s</td></tr>
    {% for resource in preview.quote.before.costs|merge(preview.quote.after.costs)|keys %}<tr><th scope="row">{{ resourceLabels[resource]|default(resource) }}</th><td>{{ preview.quote.before.costs[resource]|default(0) }}</td><td>{{ preview.quote.after.costs[resource]|default(0) }}</td></tr>{% endfor %}
    </tbody>
    <tbody>
        <tr class="admin-design-comparison-divider"><th scope="rowgroup" colspan="3">Champs modifiables</th></tr>
        {% for field in preview.comparison %}
            <tr><th scope="row">{{ field.label }}</th><td>{{ field.before }}</td><td>{{ field.after }}</td></tr>
        {% endfor %}
    </tbody></table>
</div>
</section>
<section class="panel admin-design-restore-decision" aria-labelledby="restore-decision-title">
<p class="eyebrow">Confirmation · {{ universe.name }}</p>
<h2 id="restore-decision-title">Vérifier et publier</h2>
<p class="admin-design-badge admin-design-badge--warning">Aperçu non publié</p>
<p>La production sera matérialisée puis recalculée à la publication. Une évolution du catalogue depuis cet aperçu bloque la confirmation. Les limites sont revérifiées côté serveur.</p>
<form method="post" class="admin-catalogue-restore">
<input type="hidden" name="_token" value="{{ csrf_token(tokenKey) }}">
<input type="hidden" name="revision" value="{{ preview.revision }}">
<label for="restore-reason">Motif de restauration</label><textarea id="restore-reason" name="reason" required minlength="5" maxlength="1000"></textarea>
<label class="admin-design-restore-confirm"><input type="checkbox" name="confirmed" value="1" required><span>Je confirme ces valeurs pour cette fiche et cet univers.</span></label>
<button class="primary">Publier ces valeurs historiques</button>
</form>
<a class="secondary" href="{{ path('app_admin_catalogue_history', {id: universe.id, group: group, slug: slug}) }}">Annuler et revenir à l’historique</a>
</section>
</div>
{% endblock %}
