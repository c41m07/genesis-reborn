{% extends 'admin/layout.html.twig' %}
{% block title %}{{ challenge.name }} · Défi{% endblock %}
{% block body %}
<a class="inline-link" href="{{ path('app_admin_challenges') }}">← Défis et contributions</a><h1>{{ challenge.name }}</h1>
<section class="panel"><h2>Suivi du défi</h2>{% include 'events/_challenge_summary.html.twig' %}{% if not challenge.guided %}<p>Les règles de cette occurrence restent figées. Vous pouvez annuler son exécution ci-dessous ; son historique et les récompenses acquises sont conservés.</p>{% endif %}</section>
<section class="panel"><h2>Contributions individuelles · {{ contributors.total }} participant(s)</h2><div class="table-wrap" role="region" tabindex="0" aria-label="Contributions des participants"><table class="admin-challenge-contributions"><caption>Contributions et récompenses de ce défi</caption><thead><tr><th scope="col">Joueur</th><th scope="col">Contribution</th><th scope="col">Récompense</th></tr></thead><tbody>{% for row in contributors.rows %}<tr><th scope="row">{{ row.player_name }}</th><td>{{ row.contribution|number_format(2,',',' ') }}</td><td>{% if row.reward %}{{ row.reward.kind=='resource_box' ? 'Boîte' : 'Boost' }} · {{ {available:'Disponible',pending:'En attente',used:'Utilisé'}[row.reward.status]|default(row.reward.status) }}{% else %}Non attribuée{% endif %}</td></tr>{% else %}<tr><td colspan="3">Aucune contribution enregistrée.</td></tr>{% endfor %}</tbody></table></div>
{% if contributors.pages>1 %}<nav class="admin-mission-pages" aria-label="Pagination des contributions">{% if contributors.page>1 %}<a href="{{ path('app_admin_challenge',{id:challenge.event.id,page:contributors.page-1}) }}">Précédent</a>{% endif %}<span>Page {{ contributors.page }} / {{ contributors.pages }}</span>{% if contributors.page<contributors.pages %}<a href="{{ path('app_admin_challenge',{id:challenge.event.id,page:contributors.page+1}) }}">Suivant</a>{% endif %}</nav>{% endif %}</section>
{% if challenge.guided and not challenge.event.configuration.archived_at|default(null) and challenge.event.status in ['scheduled','active'] %}<section class="panel"><h2>Annuler le défi</h2><p>L’annonce est également annulée. Les récompenses déjà gagnées ne sont jamais retirées.</p><form method="post" action="{{ path('app_admin_challenge_cancel',{id:challenge.event.id}) }}" class="admin-intervention-form"><input type="hidden" name="_token" value="{{ csrf_token('admin_challenge_cancel_'~challenge.event.id) }}"><label for="challenge-cancel-reason">Motif d’annulation</label><textarea id="challenge-cancel-reason" name="reason" maxlength="1000" required></textarea><label class="admin-intervention-confirm"><input type="checkbox" name="confirmed" value="1" required> Je confirme l’annulation du défi et de son annonce.</label><button class="secondary">Annuler ce défi</button></form></section>{% endif %}
{% if challenge.guided and not challenge.event.configuration.archived_at|default(null) %}<section class="panel"><h2>Suppression du défi</h2>{% include 'admin/_event_removal.html.twig' with {challengeRemoval:true,removalId:challenge.event.id} only %}</section>{% elseif challenge.event.configuration.archived_at|default(null) %}<p>Ce défi est retiré des listes courantes. Son historique est conservé.</p>{% endif %}
{% if challenge.weekly and challenge.event.status in ['scheduled','active'] %}<section class="panel"><h2>Annuler la rotation</h2><p>Cette occurrence ne sera pas recréée cette semaine, même si les modèles actifs changent. Les contributions et les récompenses déjà gagnées sont conservées ; aucune nouvelle récompense ne sera attribuée pour cette occurrence annulée.</p><form method="post" action="{{ path('app_admin_weekly_rotation_cancel',{id:challenge.event.id}) }}" class="admin-intervention-form"><input type="hidden" name="_token" value="{{ csrf_token('weekly_rotation_cancel_'~challenge.event.id) }}"><label for="weekly-cancel-reason">Motif d’annulation de la rotation</label><textarea id="weekly-cancel-reason" name="reason" maxlength="1000" required></textarea><label class="admin-intervention-confirm"><input name="confirmed" value="1" type="checkbox" required> Je confirme l’annulation de cette occurrence hebdomadaire.</label><button class="secondary">Annuler cette rotation</button></form></section>{% endif %}
{% endblock %}
