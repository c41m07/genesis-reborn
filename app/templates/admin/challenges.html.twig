{% extends 'admin/layout.html.twig' %}
{% block title %}Défis et contributions · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Défis et contributions</h1><p>Défis guidés et rotations existantes de chaque univers.</p></div></div>
<nav class="admin-page-navigation admin-challenge-list-navigation" aria-label="Listes des défis"><a href="{{ path('app_admin_challenges') }}"{% if not archived %} aria-current="page"{% endif %}>Défis courants</a><a href="{{ path('app_admin_challenges',{archived:1}) }}"{% if archived %} aria-current="page"{% endif %}>Historique des retraits</a></nav>
<p class="admin-challenge-actions"><a class="secondary" href="{{ path('app_admin_weekly_rotations') }}">Gérer les modèles hebdomadaires</a><a class="primary" href="{{ path('app_admin_event_wizard', {model: 'challenge'}) }}">Créer un défi collectif</a></p>
<form method="get" class="panel admin-challenge-filters">{% if archived %}<input type="hidden" name="archived" value="1">{% endif %}<div class="admin-challenge-field"><label for="challenge-universe">Univers</label><select id="challenge-universe" name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ selected_universe==universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select></div><div class="admin-challenge-field"><label for="challenge-status">État</label><select id="challenge-status" name="status"><option value="">Tous les états</option>{% for value,label in statuses %}<option value="{{ value }}" {{ selected_status==value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div><button class="secondary">Filtrer les défis</button></form>
<section aria-labelledby="challenge-count-title"><h2 id="challenge-count-title">{{ total }} défi(s)</h2>
<ul class="admin-challenges-list">
    {% for challenge in rows %}
        <li><article class="panel">
            <h3><a href="{{ path('app_admin_challenge', {id: challenge.event.id}) }}">{{ challenge.name }}</a></h3>
            <p>{{ challenge.status_label }} · {{ challenge.event.universe.name }} · {{ challenge.event.scheduledAt|date('d/m/Y H:i', 'UTC') }} UTC · {{ challenge.guided ? 'Création guidée' : 'Rotation automatique' }}</p>
        </article></li>
    {% else %}<li class="panel">Aucun défi ne correspond aux filtres.</li>{% endfor %}
</ul></section>
{% if pages>1 %}<nav class="admin-mission-pages" aria-label="Pagination des défis">{% if page>1 %}<a class="secondary" href="{{ path('app_admin_challenges',{archived:archived ? 1 : 0,universe:selected_universe,status:selected_status,page:page-1}) }}">Précédent</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page<pages %}<a class="secondary" href="{{ path('app_admin_challenges',{archived:archived ? 1 : 0,universe:selected_universe,status:selected_status,page:page+1}) }}">Suivant</a>{% endif %}</nav>{% endif %}
{% endblock %}
