{% extends 'admin/layout.html.twig' %}
{% block title %}Défis et contributions · Console{% endblock %}
{% block body %}
<nav aria-label="Listes des défis"><a href="{{ path('app_admin_challenges') }}"{% if not archived %} aria-current="page"{% endif %}>Défis courants</a> · <a href="{{ path('app_admin_challenges',{archived:1}) }}"{% if archived %} aria-current="page"{% endif %}>Historique des retraits</a></nav>
<p><a href="{{ path('app_admin_weekly_rotations') }}">Gérer les modèles hebdomadaires</a></p>
<div class="page-heading"><div><h1>Défis et contributions</h1><p>Défis guidés et rotations existantes de chaque univers.</p></div><a class="secondary" href="{{ path('app_admin_event_wizard',{model:'challenge'}) }}">Créer un défi collectif</a></div>
<form method="get" class="feedback-admin-filters">{% if archived %}<input type="hidden" name="archived" value="1">{% endif %}<label>Univers<select name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ selected_universe==universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select></label><label>État<select name="status"><option value="">Tous les états</option>{% for value,label in statuses %}<option value="{{ value }}" {{ selected_status==value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><button class="secondary">Filtrer les défis</button></form>
<section class="panel"><h2>{{ total }} défi(s)</h2><ul class="admin-monitor-report-list">{% for challenge in rows %}<li><a href="{{ path('app_admin_challenge',{id:challenge.event.id}) }}">{{ challenge.name }}</a><small>{{ challenge.status_label }} · {{ challenge.event.universe.name }} · {{ challenge.event.scheduledAt|date('d/m/Y H:i','UTC') }} UTC · {{ challenge.guided ? 'Création guidée' : 'Rotation automatique' }}</small></li>{% else %}<li>Aucun défi ne correspond aux filtres.</li>{% endfor %}</ul></section>
{% if pages>1 %}<nav class="admin-mission-pages" aria-label="Pagination des défis">{% if page>1 %}<a href="{{ path('app_admin_challenges',{archived:archived ? 1 : 0,universe:selected_universe,status:selected_status,page:page-1}) }}">Précédent</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page<pages %}<a href="{{ path('app_admin_challenges',{archived:archived ? 1 : 0,universe:selected_universe,status:selected_status,page:page+1}) }}">Suivant</a>{% endif %}</nav>{% endif %}
{% endblock %}
