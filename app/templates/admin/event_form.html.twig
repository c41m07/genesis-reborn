{% extends 'admin/layout.html.twig' %}
{% block title %}{{ editing ? 'Modifier '~editing.name : 'Créer un événement avancé' }} · Administration{% endblock %}
{% block body %}<div class="page-heading"><div><h1>{{ editing ? 'Modifier '~editing.name : 'Créer un événement avancé' }}</h1><p>Événement global ou associé à un univers.</p></div><a class="secondary" href="{{ path('app_admin_game_events') }}">Tous les événements</a></div>
<section class="panel"><h2>Paramètres de l’événement</h2><form method="post" action="{{ editing ? path('app_admin_game_event_edit',{id:editing.id}) : path('app_admin_game_event_new') }}" class="form-grid admin-event-form"><input type="hidden" name="_token" value="{{ csrf_token(editing ? 'game_event_edit_'~editing.id : 'game_event_create') }}">
<label>Nom<input name="name" maxlength="120" required value="{{ draft.name }}"></label><label>Type<select name="type">{% for type in types %}<option value="{{ type }}" {{ draft.type==type?'selected':'' }}>{{ type|replace({'_':' '})|capitalize }}</option>{% endfor %}</select></label>
<label>Description<textarea name="description">{{ draft.description }}</textarea></label><label>Statut<select name="status">{% for status in statuses %}<option value="{{ status }}" {{ draft.status==status?'selected':'' }}>{{ status|capitalize }}</option>{% endfor %}</select></label>
<label>Début<input type="datetime-local" name="starts_at" required value="{{ draft.starts_at }}"></label><label>Fin<input type="datetime-local" name="ends_at" required value="{{ draft.ends_at }}"></label>
<label>Univers<select name="universe_id"><option value="0">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}"{% if draft.universe_id==universe.id %} selected{% endif %}>{{ universe.name }}</option>{% endfor %}</select></label><label>Bonus de production (%)<input type="number" name="percentage" min="0.01" max="500" step="0.01" value="{{ draft.percentage }}"></label>
<label class="admin-event-visibility"><input type="checkbox" name="visible" value="1" {{ draft.visible?'checked':'' }}> Visible aux joueurs</label><button class="primary">{{ editing ? 'Enregistrer' : 'Créer' }}</button></form></section>

{% endblock %}
