{% extends 'admin/layout.html.twig' %}
{% block title %}Créer un événement guidé · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">Étape {{ model == '' ? 1 : 2 }} sur 3</p><h1>Créer un événement guidé</h1></div><a class="secondary" href="{{ path('app_admin_game_events') }}">← Événements</a></div>
{% if model == '' %}
    <section class="panel">
        <h2>Choisir un modèle</h2>
        <p>Chaque modèle propose ses réglages, puis un aperçu avant la planification.</p>
        {% set modelHelp = {'bonus': 'Production des ressources augmentée sur une période définie.', 'announcement': 'Un message visible pendant la période choisie, global ou par univers.', 'challenge': 'Un objectif commun, une contribution minimale et une récompense par participant éligible.'} %}
        <div class="admin-event-model-choices">
            {% for value, label in models %}
                <article>
                    <h3>{{ label }}</h3><p>{{ modelHelp[value] }}</p>
                    <a class="secondary" href="{{ path('app_admin_event_wizard', {model: value}) }}" aria-label="Choisir ce modèle : {{ label }}">Choisir ce modèle</a>
                </article>
            {% endfor %}
        </div>
    </section>
{% else %}
    <section class="panel">
        <h2>Régler : {{ models[model] }}</h2>
        <p><a class="secondary" href="{{ path('app_admin_event_wizard') }}">Choisir un autre modèle</a></p>
        <form method="post" class="admin-event-wizard-form">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_event_preview') }}">
            <div class="admin-event-field admin-event-wide">
                <label for="guided-name">Nom de l’événement</label><input id="guided-name" name="name" value="{{ draft.name|default('') }}" maxlength="120" required>
            </div>
            <div class="admin-event-field admin-event-wide">
                <label for="guided-description">Description pour les joueurs</label><textarea id="guided-description" name="description" maxlength="5000">{{ draft.description|default('') }}</textarea>
            </div>
            {% if model == 'bonus' %}
                <div class="admin-event-field admin-event-wide">
                    <label for="guided-percentage">Bonus de production (%)</label><input id="guided-percentage" name="percentage" type="number" min="0.01" max="500" step="0.01" value="{{ draft.percentage|default(10) }}" required>
                </div>
                <p class="admin-event-wide">Augmente temporairement la production des ressources. Les autres règles de l’univers sont conservées.</p>
            {% endif %}
            {% if model == 'challenge' %}
                <div class="admin-event-field admin-event-wide">
                    <label for="guided-objective">Objectif suivi</label><select id="guided-objective" name="objective">{% for value, objective in objectives %}<option value="{{ value }}" {{ draft.objective|default('exploration') == value ? 'selected' : '' }}>{{ objective.label }}</option>{% endfor %}</select>
                </div>
                <div class="admin-event-field">
                    <label for="guided-goal">Objectif collectif à atteindre</label><input id="guided-goal" name="goal" type="number" min="1" max="1000000000000" step="any" value="{{ draft.goal|default(10) }}" required>
                </div>
                <div class="admin-event-field">
                    <label for="guided-minimum">Contribution minimale par joueur</label><input id="guided-minimum" name="minimum_contribution" type="number" min="0" max="1000000000000" step="any" value="{{ draft.minimum_contribution|default(0) }}" required>
                </div>
                <p class="admin-event-wide">Zéro signifie toute contribution positive. Les récompenses sont attribuées à la clôture si l’objectif collectif est atteint.</p>
                <div class="admin-event-field">
                    <label for="guided-reward">Un objet par participant éligible</label><select id="guided-reward" name="reward_kind"><option value="boost" {{ draft.reward_kind|default('boost') == 'boost' ? 'selected' : '' }}>Un boost</option><option value="resource_box" {{ draft.reward_kind|default('boost') == 'resource_box' ? 'selected' : '' }}>Une boîte de ressources</option></select>
                </div>
                <div class="admin-event-field">
                    <label for="guided-box">Format si la récompense est une boîte</label><select id="guided-box" name="box_format">{% for value, label in formats %}<option value="{{ value }}" {{ draft.box_format|default('small') == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>
                </div>
                <p class="admin-event-wide">Durée : une minute à trente jours. Une annonce accompagne la publication. La limite existante de défis simultanés s’applique : le démarrage peut attendre une place, sans décaler la fin annoncée.</p>
            {% endif %}
            <div class="admin-event-field admin-event-wide">
                <label for="guided-universe">Univers concerné</label><select id="guided-universe" name="universe_id" required>{% if model != 'challenge' %}<option value="0">Tous les univers</option>{% endif %}{% for universe in universes %}<option value="{{ universe.id }}" {{ draft.universe_id|default(0) == universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select>
            </div>
            <div class="admin-event-field">
                <label for="guided-start">Début (UTC)</label><input id="guided-start" type="datetime-local" name="starts_at" value="{{ draft.starts_at|default(default_start) }}" required>
            </div>
            <div class="admin-event-field">
                <label for="guided-end">Fin (UTC)</label><input id="guided-end" type="datetime-local" name="ends_at" value="{{ draft.ends_at|default(default_end) }}" required>
            </div>
            <p class="admin-event-wide">Le début doit encore être à venir lors de la confirmation. Les horaires sont en UTC.</p>
            <button class="primary admin-event-wide">Voir l’aperçu</button>
        </form>
    </section>
{% endif %}
{% endblock %}
