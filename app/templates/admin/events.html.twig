{% extends 'admin/layout.html.twig' %}
{% block title %}Événements · Console d’administration{% endblock %}
{% block body %}
<section class="page-heading"><h1>Événements</h1><p>Planifiez des événements globaux ou associés à un univers.</p></section>
<div class="admin-home-actions admin-event-models"><a class="secondary" href="{{ path('app_admin_event_wizard') }}">Créer un événement guidé</a><a class="secondary" href="{{ path('app_admin_challenges') }}">Suivre les défis et contributions</a></div>
<section class="panel"><h2>Créer un événement</h2><form method="post" class="form-grid admin-event-form"><input type="hidden" name="_token" value="{{ csrf_token('game_event_create') }}">
<label>Nom<input name="name" maxlength="120" required value="{{ draft.name }}"></label><label>Type<select name="type">{% for type in types %}<option value="{{ type }}" {{ draft.type==type?'selected':'' }}>{{ type|replace({'_':' '})|capitalize }}</option>{% endfor %}</select></label>
<label>Description<textarea name="description">{{ draft.description }}</textarea></label><label>Statut<select name="status">{% for status in statuses %}<option value="{{ status }}" {{ draft.status==status?'selected':'' }}>{{ status|capitalize }}</option>{% endfor %}</select></label>
<label>Début<input type="datetime-local" name="starts_at" required value="{{ draft.starts_at }}"></label><label>Fin<input type="datetime-local" name="ends_at" required value="{{ draft.ends_at }}"></label>
<label>Univers<select name="universe_id"><option value="0">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}">{{ universe.name }}</option>{% endfor %}</select></label><label>Bonus de production (%)<input type="number" name="percentage" min="0.01" max="500" step="0.01" value="{{ draft.percentage }}"></label>
<label class="admin-event-visibility"><input type="checkbox" name="visible" value="1" {{ draft.visible?'checked':'' }}> Visible aux joueurs</label><button class="primary">Créer</button></form></section>
<nav aria-label="Listes des événements"><a href="{{ path('app_admin_game_events') }}"{% if not archived %} aria-current="page"{% endif %}>Événements courants</a> · <a href="{{ path('app_admin_game_events',{archived:1}) }}"{% if archived %} aria-current="page"{% endif %}>Historique des retraits</a></nav>
<h2>{{ archived ? 'Historique des retraits' : 'Événements enregistrés' }}</h2>
{% for event in events %}<article class="panel">{% if archived %}<h3>{{ event.name }}</h3><p>{{ event.description }}</p><p>Retiré le {{ event.parameters.archived_at|date('d/m/Y H:i','UTC') }} UTC. Historique conservé.</p>{% elseif event.parameters.guided_key|default('') %}{% include 'admin/_guided_event.html.twig' %}{% else %}<form method="post" action="{{ path('app_admin_game_event_edit',{id:event.id}) }}" class="form-grid admin-event-form"><input type="hidden" name="_token" value="{{ csrf_token('game_event_edit_'~event.id) }}"><label>Nom<input name="name" required maxlength="120" value="{{ event.name }}"></label><label>Type<select name="type">{% for type in types %}<option value="{{ type }}" {{ event.type==type?'selected':'' }}>{{ type|replace({'_':' '})|capitalize }}</option>{% endfor %}</select></label><label>Description<textarea name="description">{{ event.description }}</textarea></label><label>Statut<select name="status">{% for status in statuses %}<option value="{{ status }}" {{ event.status==status?'selected':'' }}>{{ status|capitalize }}</option>{% endfor %}</select></label><label>Début<input type="datetime-local" name="starts_at" required value="{{ event.startsAt|date('Y-m-d\\TH:i') }}"></label><label>Fin<input type="datetime-local" name="ends_at" required value="{{ event.endsAt|date('Y-m-d\\TH:i') }}"></label><label>Univers<select name="universe_id"><option value="0">Global</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ event.universe and event.universe.id==universe.id?'selected':'' }}>{{ universe.name }}</option>{% endfor %}</select></label><label>Bonus production (%)<input type="number" name="percentage" min="0.01" max="500" step="0.01" value="{{ event.parameters.percentage|default('') }}"></label><label class="admin-event-visibility"><input type="checkbox" name="visible" value="1" {{ event.visibleToPlayers?'checked':'' }}> Visible aux joueurs</label><button class="primary">Enregistrer</button></form><p>Univers : {{ event.universe ? event.universe.name : 'Global' }} · {{ event.startsAt|date('d/m/Y H:i') }} → {{ event.endsAt|date('d/m/Y H:i') }}</p><form method="post" action="{{ path('app_admin_game_event_cancel',{id:event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('game_event_cancel_'~event.id) }}"><button class="secondary">Annuler l’événement</button></form>{% if event.status=='draft' %}<form method="post" action="{{ path('app_admin_game_event_delete',{id:event.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('game_event_delete_'~event.id) }}"><button class="danger">Supprimer le brouillon</button></form>{% endif %}{% endif %}{% if not archived and not event.parameters.challenge_id|default(null) %}{% include 'admin/_event_removal.html.twig' with {challengeRemoval:false,removalId:event.id} only %}{% endif %}</article>{% else %}<p class="panel">Aucun événement pour le moment.</p>{% endfor %}
{% endblock %}
