{% extends 'admin/layout.html.twig' %}
{% block title %}Feedbacks · Console{% endblock %}
{% block body %}
<header class="feedback-admin-heading"><div><h1>Feedbacks</h1><p>Suivez les signalements et retours des joueurs.</p></div><a class="secondary" href="{{ path('app_admin_index') }}">← Console admin</a></header>
<section class="feedback-admin-metrics" aria-label="Résumé des feedbacks"><article><span>RÉSULTATS FILTRÉS</span><strong>{{ total }}</strong></article><article><span>OUVERTS</span><strong>{{ openCount }}</strong></article></section>
<form method="get" class="feedback-admin-filters"><label>Recherche<input name="q" placeholder="Titre ou pseudo du joueur" value="{{ app.request.query.get('q') }}"></label><label>Type<select name="type"><option value="">Tous</option>{% for v,l in {'bug':'Bug','suggestion':'Suggestion','improvement':'Amélioration','other':'Autre'} %}<option value="{{ v }}" {{ app.request.query.get('type')==v?'selected':'' }}>{{ l }}</option>{% endfor %}</select></label><label>Statut<select name="status"><option value="">Hors archives</option><option value="all" {{ app.request.query.get('status')=='all'?'selected':'' }}>Tous, archives comprises</option>{% for v,l in {'open':'Ouvert','in_progress':'En cours','resolved':'Résolu','rejected':'Rejeté','archived':'Archivé'} %}<option value="{{ v }}" {{ app.request.query.get('status')==v?'selected':'' }}>{{ l }}</option>{% endfor %}</select></label><label>Priorité<select name="priority"><option value="">Toutes</option>{% for v,l in {'low':'Faible','medium':'Moyenne','high':'Élevée'} %}<option value="{{ v }}" {{ app.request.query.get('priority')==v?'selected':'' }}>{{ l }}</option>{% endfor %}</select></label><label>Univers<select name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ app.request.query.get('universe')==universe.id?'selected':'' }}>{{ universe.name }}</option>{% endfor %}</select></label><button class="primary">Appliquer les filtres</button></form>
<section class="feedback-admin-list" aria-label="Liste des feedbacks">{% for f in feedbacks %}<article class="feedback-admin-card"><div class="feedback-admin-card-top"><span class="feedback-status status-{{ f.status }}">{{ {'open':'Ouvert','in_progress':'En cours','resolved':'Résolu','rejected':'Rejeté','archived':'Archivé'}[f.status] }}</span><time datetime="{{ f.createdAt|date('c') }}">{{ f.createdAt|date('d/m/Y · H:i') }}</time></div><h2><a href="{{ path('app_admin_feedback',{id:f.id}) }}">{{ f.title }}</a></h2><p class="feedback-admin-excerpt">{{ f.description|striptags|slice(0,180) ~ '…' }}</p><div class="feedback-admin-meta"><span>{{ {'bug':'Bug','suggestion':'Suggestion','improvement':'Amélioration','other':'Autre'}[f.type] }}</span><span class="priority-{{ f.priority }}">Priorité {{ {'low':'faible','medium':'moyenne','high':'élevée'}[f.priority] }}</span><span>{{ f.player.username }}</span><span>{{ f.universe ? f.universe.name : 'Univers inconnu' }}</span>{% if f.attachmentFilename %}<span>Capture jointe</span>{% endif %}</div><a class="feedback-admin-open" href="{{ path('app_admin_feedback',{id:f.id}) }}">Ouvrir le retour →</a></article>{% else %}<div class="feedback-admin-empty"><h2>Aucun feedback trouvé</h2><p>Modifiez les filtres ou revenez à la liste complète.</p><a href="{{ path('app_admin_feedbacks') }}">Effacer les filtres</a></div>{% endfor %}</section>
{% endblock %}

