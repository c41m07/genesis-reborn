{% extends 'admin/layout.html.twig' %}
{% block title %}Administration · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading" id="admin-heading"><div><h1>Administration</h1><p>Gérez les comptes, la modération, les règles et les catalogues de chaque univers.</p></div></div>
{% for message in app.flashes('error') %}<p class="flash error" role="alert">{{ message }}</p>{% endfor %}
<div data-controller="admin-tabs" data-action="hashchange@window->admin-tabs#sync">
<nav class="admin-tabs ui-tabs" role="tablist" aria-label="Sections d’administration" data-action="keydown->admin-tabs#onKeydown">
  <button id="tab-overview" type="button" role="tab" aria-controls="admin-overview" aria-selected="true" data-admin-tabs-target="tab" data-panel-id="admin-overview" data-action="click->admin-tabs#select">Vue d’ensemble</button>
  <button id="tab-reports" type="button" role="tab" aria-controls="admin-reports" aria-selected="false" data-admin-tabs-target="tab" data-panel-id="admin-reports" data-action="click->admin-tabs#select">Modération</button>
  <button id="tab-players" type="button" role="tab" aria-controls="admin-players" aria-selected="false" data-admin-tabs-target="tab" data-panel-id="admin-players" data-action="click->admin-tabs#select">Joueurs</button>
  <button id="tab-universes" type="button" role="tab" aria-controls="admin-universes" aria-selected="false" data-admin-tabs-target="tab" data-panel-id="admin-universes" data-action="click->admin-tabs#select">Univers</button>
  <button id="tab-security" type="button" role="tab" aria-controls="admin-security" aria-selected="false" data-admin-tabs-target="tab" data-panel-id="admin-security" data-action="click->admin-tabs#select">Sécurité</button>
  <button id="tab-audit" type="button" role="tab" aria-controls="admin-audit" aria-selected="false" data-admin-tabs-target="tab" data-panel-id="admin-audit" data-action="click->admin-tabs#select">Journal</button>
</nav>
<section class="panel admin-tab-panel" id="admin-overview" role="tabpanel" aria-labelledby="tab-overview" data-admin-tabs-target="panel">
<h2>Vue d’ensemble</h2>
<section class="admin-metrics" aria-label="Indicateurs de la plateforme">
  <article class="admin-metric"><span>COMPTES</span><strong>{{ playerCount }}</strong><small>{{ suspendedPlayerCount }} suspendu{{ suspendedPlayerCount == 1 ? '' : 's' }}</small></article>
  <article class="admin-metric"><span>UNIVERS</span><strong>{{ universes|length }}</strong><small>{{ activeUniverseCount }} ouverts · {{ scheduledUniverseCount }} planifiés · {{ closedUniverseCount }} fermés</small></article>
  <article class="admin-metric"><span>À MODÉRER</span><strong>{{ openReportCount }}</strong><small>signalement{{ openReportCount == 1 ? '' : 's' }} ouvert{{ openReportCount == 1 ? '' : 's' }}</small></article>
  <article class="admin-metric"><span>SÉCURITÉ</span><strong>{{ securityIncidentCount }}</strong><small>tentative{{ securityIncidentCount == 1 ? '' : 's' }} d’accès à l’admin</small></article>
</section>
<section class="panel admin-operations">
  <h2>État des opérations</h2><p>État relevé le {{ operations.captured_at|date('d/m/Y H:i:s', 'UTC') }} UTC. Actualisez la page pour relire les signaux.</p>
  <div class="admin-operations-grid">
    <article class="admin-operation-card"><h3>Base de données</h3><span class="admin-operation-status {{ operations.database_healthy ? 'is-healthy' : 'is-missing' }}">{{ operations.database_healthy ? 'Disponible' : 'Indisponible' }}</span></article>
    {% for process in operations.processes %}<article class="admin-operation-card"><h3>{{ process.name }}</h3><span class="admin-operation-status {{ process.status == 'healthy' ? 'is-healthy' : (process.status == 'stale' ? 'is-stale' : 'is-missing') }}">{% if process.status == 'healthy' %}Signal récent{% elseif process.status == 'unknown' %}État inconnu{% elseif process.status == 'stale' %}Signal ancien{% else %}Aucun signal{% endif %}</span><p>{% if process.status == 'unknown' %}Signal illisible ou horodatage incohérent{% elseif process.age_seconds is not null %}Dernier signal il y a {{ process.age_seconds }} s{% else %}Aucun battement de vie reçu{% endif %}</p></article>{% endfor %}
    <article class="admin-operation-card"><h3>Relais en attente</h3>
      {% if operations.outbox_available %}
        <strong>{{ operations.outbox_total }}</strong><p>{{ operations.outbox_overdue }} à échéance atteinte</p>
        <p>Files : {{ operations.outbox.queue }} · Flottes : {{ operations.outbox.fleet }} · Combats : {{ operations.outbox.combat }} · Univers : {{ operations.outbox.universe }} · Notifications : {{ operations.outbox.notification }} · Autres : {{ operations.outbox.other }}</p>
      {% else %}<strong>État inconnu</strong><p>Collecte des relais indisponible. Vérifiez la base et les journaux.</p>{% endif %}
    </article>
  </div>
  {% if operations.outbox_available %}
  <details><summary>Consulter les relais en attente</summary>
    <p>Une ligne attend sa publication vers le transport ou le canal de notification. Elle ne prouve pas un échec du traitement. Les 20 échéances les plus anciennes sont affichées au maximum ; actualisez la page pour un nouveau relevé.</p>
    {% if operations.outbox_pending %}
    <div class="table-wrap" role="region" tabindex="0" aria-label="Relais en attente, tableau défilant">
      <table><caption>Relais classés par échéance, puis identifiant</caption>
        <thead><tr><th scope="col">Identifiant</th><th scope="col">Nature</th><th scope="col">Cible</th><th scope="col">Échéance UTC</th><th scope="col">Attente après échéance</th></tr></thead>
        <tbody>{% for message in operations.outbox_pending %}<tr><td>#{{ message.id }}</td><td>{{ message.kind }}</td><td>#{{ message.target_id }}</td><td><time datetime="{{ message.due_at|date('c', 'UTC') }}">{{ message.due_at|date('d/m/Y H:i:s', 'UTC') }}</time></td><td>{{ message.due ? message.overdue_seconds ~ ' s' : 'Échéance future' }}</td></tr>{% endfor %}</tbody>
      </table>
    </div>
    {% else %}<p>Aucun relais en attente lors du relevé.</p>{% endif %}
    <p>La date de création, les tentatives et la dernière erreur ne sont pas enregistrées dans cette file. Consultez les journaux des relais et la file des échecs du worker pour compléter le diagnostic.</p>
  </details>
  {% endif %}
</section>
<section class="panel admin-recent-events" aria-labelledby="admin-recent-events-title">
  <div class="admin-section-heading"><div><h2 id="admin-recent-events-title">Derniers événements administratifs</h2></div><a href="#admin-audit">Ouvrir le journal</a></div>
  {% for entry in auditLogs|slice(0, 5) %}<article class="admin-event-row"><time datetime="{{ entry.createdAt|date('c') }}">{{ entry.createdAt|date('d/m/Y H:i') }}</time><strong>{{ entry.action }}</strong><span>{{ entry.actor ? entry.actor.username : 'Compte supprimé' }} · {{ entry.targetType }} #{{ entry.targetId }}</span></article>{% else %}<p class="admin-empty-state">Aucun événement administratif enregistré.</p>{% endfor %}
</section>
</section>
<section class="panel admin-tab-panel" id="admin-reports" role="tabpanel" aria-labelledby="tab-reports" data-admin-tabs-target="panel" data-controller="admin-filter">

<h2>Signalements de messages</h2>
<p>Seuls les messages ayant été signalés par un participant apparaissent ici.</p>
<div class="admin-search"><label for="report-search">Rechercher</label><input id="report-search" type="search" placeholder="Joueur, guilde, motif…" data-admin-filter-target="query" data-action="input->admin-filter#filter"><output data-admin-filter-target="count"></output></div>
{% for report in reports %}
<article class="panel" data-admin-filter-target="row">
<p><strong>Signalement #{{ report.id }}</strong> · {{ report.createdAt|date('d/m/Y H:i') }} · {{ report.reporter.displayName }}</p>
<p>{% if report.message.recipient %}Message privé de {{ report.message.sender.displayName }} à {{ report.message.recipient.displayName }}{% else %}Message de la guilde {{ report.message.guild.name }} par {{ report.message.sender.displayName }}{% endif %} · {{ report.message.createdAt|date('d/m/Y H:i') }}</p>
<blockquote>{{ report.message.content }}</blockquote><p>Motif : {{ report.reason }}</p>
<form method="post" action="{{ path('app_admin_report_review',{id:report.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('admin_report_'~report.id) }}">
<button name="decision" value="dismiss">Classer sans suite</button>
<button class="primary" name="decision" value="redact">Masquer le message</button>
</form>
</article>
{% endfor %}
<p hidden data-admin-filter-target="empty" data-default-message="Aucun signalement à traiter." data-no-matches-message="Aucun signalement ne correspond à cette recherche.">Aucun signalement à traiter.</p>
</section>
<section class="panel admin-tab-panel" id="admin-security" role="tabpanel" aria-labelledby="tab-security" data-admin-tabs-target="panel" data-controller="admin-filter">
  <h2>Signalements de sécurité</h2>
  <p>Les tentatives d’accès refusées sont à examiner ; les événements déjà examinés restent au journal.</p>
  <div class="admin-search"><label for="security-search">Rechercher</label><input id="security-search" type="search" placeholder="Compte ou chemin…" data-admin-filter-target="query" data-action="input->admin-filter#filter"><label for="security-auth-filter">Origine</label><select id="security-auth-filter" data-admin-filter-target="filter" data-filter-key="authenticated" data-action="change->admin-filter#filter"><option value="">Toutes</option><option value="yes">Connectée</option><option value="no">Anonyme</option></select><output data-admin-filter-target="count"></output></div>
  <div class="table-wrap" role="region" tabindex="0" aria-label="Tentatives d’accès administrateur refusées">
    <table><caption>Accès à l’administration refusés</caption><thead><tr><th scope="col">Date</th><th scope="col">Compte</th><th scope="col">Méthode</th><th scope="col">Chemin demandé</th><th scope="col">Action</th></tr></thead><tbody>
    {% for incident in securityIncidents|slice(0, 50) %}<tr data-admin-filter-target="row" data-filter-authenticated="{{ incident.details.authenticated|default(false) ? 'yes' : 'no' }}"><td>{{ incident.createdAt|date('d/m/Y H:i:s') }}</td><td>{{ incident.actor ? incident.actor.username : 'Visiteur non connecté' }}</td><td>{{ incident.details.method|default('—') }}</td><td><code>{{ incident.details.path|default('/admin') }}</code></td><td><form method="post" action="{{ path('app_admin_security_review',{id:incident.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_security_review_'~incident.id) }}"><button class="secondary admin-security-review">Marquer examinée</button></form></td></tr>{% endfor %}
    </tbody></table>
  </div>
  <p {% if securityIncidents %}hidden{% endif %} data-admin-filter-target="empty">{{ securityIncidents ? 'Aucun incident ne correspond à cette recherche.' : 'Aucune tentative refusée en attente d’examen.' }}</p>
</section>
<section class="panel admin-tab-panel" id="admin-players" role="tabpanel" aria-labelledby="tab-players" data-admin-tabs-target="panel" data-controller="admin-filter">
<h2>Comptes joueurs</h2><p>Les changements de rôle et les suspensions sont consignés dans le journal. Le compte courant est protégé dans cette liste.</p>
<div class="admin-search"><label for="player-search">Rechercher</label><input id="player-search" type="search" placeholder="Pseudo, courriel…" data-admin-filter-target="query" data-action="input->admin-filter#filter"><label for="player-state-filter">État</label><select id="player-state-filter" data-admin-filter-target="filter" data-filter-key="status" data-action="change->admin-filter#filter"><option value="">Tous</option><option value="active">Actif</option><option value="suspended">Suspendu</option></select><label for="player-role-filter">Rôle</label><select id="player-role-filter" data-admin-filter-target="filter" data-filter-key="role" data-action="change->admin-filter#filter"><option value="">Tous</option><option value="admin">Administrateur</option><option value="player">Joueur</option></select><output data-admin-filter-target="count"></output></div>
<div class="table-wrap" role="region" tabindex="0" aria-label="Tableau défilant horizontalement"><table><caption>Comptes joueurs</caption><thead><tr><th scope="col">Joueur</th><th scope="col">Courriel</th><th scope="col">État</th><th scope="col">Rôle</th><th scope="col">Actions</th></tr></thead><tbody>
{% for player in players %}<tr data-admin-filter-target="row" data-filter-status="{{ player.lockedAt ? 'suspended' : 'active' }}" data-filter-role="{{ 'ROLE_ADMIN' in player.roles ? 'admin' : 'player' }}"><th scope="row" class="admin-player-name">{{ player.username }}</th><td>{{ player.email }}</td><td><span class="badge admin-player-status {{ player.lockedAt ? 'is-suspended' : '' }}">{{ player.lockedAt ? 'Suspendu' : 'Actif' }}</span></td><td>{% if 'ROLE_ADMIN' in player.roles %}<span class="badge">Administrateur</span>{% else %}<span class="badge">Joueur</span>{% endif %}</td><td class="admin-player-actions">
{% if player.id == app.user.id %}<span>Compte courant</span>{% else %}
<form method="post" action="{{ path('app_admin_player_role',{id:player.id}) }}" data-controller="confirmation" data-action="submit->confirmation#confirm" data-confirmation-message-value="{{ ('ROLE_ADMIN' in player.roles ? 'Retirer les droits d’administration à ' : 'Accorder les droits d’administration à ') ~ player.username ~ ' ?' }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_role_'~player.id) }}"><input type="hidden" name="role" value="{{ 'ROLE_ADMIN' in player.roles ? 'demote' : 'promote' }}"><button class="secondary admin-sensitive-action" aria-label="{{ ('ROLE_ADMIN' in player.roles ? 'Retirer les droits d’administration à ' : 'Accorder les droits d’administration à ') ~ player.username }}">{{ 'ROLE_ADMIN' in player.roles ? 'Retirer admin' : 'Promouvoir admin' }}</button></form>
{% if 'ROLE_ADMIN' not in player.roles %}<form method="post" action="{{ path('app_admin_player_suspend',{id:player.id}) }}" {% if not player.lockedAt %}data-controller="confirmation" data-action="submit->confirmation#confirm" data-confirmation-message-value="Suspendre l’accès au compte {{ player.username }} ?"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('admin_suspend_'~player.id) }}"><input type="hidden" name="suspend" value="{{ player.lockedAt ? '0' : '1' }}"><button class="{{ player.lockedAt ? 'secondary' : 'admin-sensitive-action' }}" aria-label="{{ player.lockedAt ? 'Réactiver le compte ' : 'Suspendre le compte ' }}{{ player.username }}">{{ player.lockedAt ? 'Réactiver' : 'Suspendre' }}</button></form>{% endif %}
{% endif %}
</td></tr>{% else %}<tr><td colspan="5">Aucun compte joueur.</td></tr>{% endfor %}
</tbody></table></div>
<p hidden data-admin-filter-target="empty">Aucun compte ne correspond à cette recherche.</p>
</section>
<section class="panel admin-tab-panel" id="admin-universes" role="tabpanel" aria-labelledby="tab-universes" data-admin-tabs-target="panel" data-controller="admin-filter">
<div class="admin-section-heading"><div><h2>Tous les univers</h2><p>Planning, fréquentation et configuration, réunis au même endroit.</p></div><a class="secondary" href="#admin-universe-create">Créer un univers</a></div>
<div class="admin-search"><label for="universe-search">Rechercher</label><input id="universe-search" type="search" placeholder="Nom ou code…" data-admin-filter-target="query" data-action="input->admin-filter#filter"><label for="universe-state-filter">État</label><select id="universe-state-filter" data-admin-filter-target="filter" data-filter-key="status" data-action="change->admin-filter#filter"><option value="">Tous</option><option value="active">Actif</option><option value="scheduled">Planifié</option><option value="closed">Fermé</option></select><output data-admin-filter-target="count"></output></div>
<p>Vous pouvez planifier ou retirer une date de fermeture. Un univers déjà fermé reste fermé.</p>
{% include 'admin/_universe_creation.html.twig' %}
{% for universe in universes %}{% set config = universeConfigs[universe.id] %}{% set selectedSpeedProfile = 'custom' %}{% set selectedSpeedProfileLabel = 'Personnalisé' %}
{% for profile in universeProfiles %}
  {% set profileDuration = (1 / profile.speed)|round(3) %}
  {% if profileDuration == config.multipliers.building_time|round(3) and profileDuration == config.multipliers.research_time|round(3) and profileDuration == config.multipliers.ship_build_time|round(3) and profileDuration == config.multipliers.travel_time|round(3) and profile.speed == config.multipliers.resource_production|round(3) %}
    {% set selectedSpeedProfile = profile.slug %}{% set selectedSpeedProfileLabel = profile.name %}
  {% endif %}
{% endfor %}
{% set isScheduled = universe.status == 'active' and universe.startsAt and universe.startsAt > date() %}{% set isClosingSoon = universe.endsAt and universe.endsAt > date() and universe.endsAt < date('+7 days') %}{% set hasIncompleteConfig = universeConfigs[universe.id].multipliers is empty or universeConfigs[universe.id].limits is empty %}<article class="panel admin-universe-card" id="admin-universe-{{ universe.id }}" tabindex="-1" aria-labelledby="universe-title-{{ universe.id }}" data-admin-filter-target="row" data-filter-status="{{ isScheduled ? 'scheduled' : universe.status }}"><div class="admin-universe-heading"><div><h3 id="universe-title-{{ universe.id }}">{{ universe.name }}</h3><code>{{ universe.slug }}</code></div><span class="admin-status-badge admin-status-badge--{{ isScheduled ? 'scheduled' : universe.status }}">{{ isScheduled ? 'Planifié' : (universe.status == 'active' ? 'Ouvert' : 'Fermé') }}</span></div><div class="admin-universe-facts"><span><small>Joueurs</small><strong>{{ universePlayerCounts[universe.id]|default(0) }}</strong></span><span><small>Ouverture</small><strong>{{ universe.startsAt ? universe.startsAt|date('d/m/Y H:i', 'UTC')~' UTC' : (universe.status == 'active' ? 'Immédiate' : 'Non définie') }}</strong></span><span><small>Fermeture</small><strong>{{ universe.endsAt ? universe.endsAt|date('d/m/Y H:i', 'UTC')~' UTC' : 'Aucune' }}</strong></span><span><small>Profil</small><strong>{{ selectedSpeedProfileLabel }}</strong></span></div>{% if isClosingSoon or universe.status == 'closed' or hasIncompleteConfig %}<div class="admin-universe-alerts">{% if isClosingSoon %}<span class="is-warning">Fermeture dans moins de 7 jours</span>{% endif %}{% if universe.status == 'closed' %}<span>Univers fermé</span>{% endif %}{% if hasIncompleteConfig %}<span class="is-warning">Configuration à vérifier</span>{% endif %}</div>{% endif %}<p><a class="secondary" href="{{ path('app_admin_catalogue',{id:universe.id}) }}">Équilibrer les catalogues de cet univers</a> <a class="secondary" href="{{ path('app_admin_universe_metrics',{id:universe.id}) }}">Observer les mesures de cet univers</a></p><details class="admin-universe-settings" {{ (universeScheduleDraft.universe_id|default(null) == universe.id or universeSettingsDraft.universe_id|default(null) == universe.id) ? 'open' : '' }}><summary>Planning et paramètres</summary>{% include 'admin/_universe_calendar.html.twig' %}
{% include 'admin/_universe_settings.html.twig' %}
</details><details class="admin-danger-zone"><summary>Zone de suppression définitive</summary><p>Cette action supprime l’univers et toutes ses données de jeu. Elle ne peut pas être annulée.</p><form method="post" action="{{ path('app_admin_universe_delete',{id:universe.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_delete_universe_'~universe.id) }}"><label for="confirm-universe-{{ universe.id }}">Saisis <strong>{{ universe.name }}</strong> pour confirmer</label><input id="confirm-universe-{{ universe.id }}" name="confirmation" type="text" autocomplete="off" required><button class="danger">Supprimer définitivement l’univers</button></form></details></article>{% endfor %}
<p hidden data-admin-filter-target="empty">Aucun univers ne correspond à cette recherche.</p>
</section>
<section class="panel admin-tab-panel" id="admin-audit" role="tabpanel" aria-labelledby="tab-audit" data-admin-tabs-target="panel" data-controller="admin-filter">
<h2>Journal d’audit</h2>
<div class="admin-search"><label for="audit-search">Rechercher dans le journal</label><input id="audit-search" type="search" placeholder="Administrateur, cible ou détails…" data-admin-filter-target="query" data-action="input->admin-filter#filter"><label for="audit-action-filter">Action</label><select id="audit-action-filter" data-admin-filter-target="filter" data-filter-key="action" data-action="change->admin-filter#filter"><option value="">Toutes les actions</option>{% for action in auditActions %}<option value="{{ action }}">{{ action }}</option>{% endfor %}</select><output data-admin-filter-target="count"></output></div>
<div class="admin-audit-actions"><button type="button" class="secondary" data-action="click->admin-filter#exportCsv">Exporter les lignes visibles en CSV</button></div>
<div class="table-wrap" role="region" tabindex="0" aria-label="Tableau défilant horizontalement"><table><caption>Journal des actions administratives</caption><thead><tr><th scope="col">Date</th><th scope="col">Administrateur</th><th scope="col">Action</th><th scope="col">Cible</th><th scope="col">Détails</th></tr></thead><tbody>
{% for entry in auditLogs %}<tr data-admin-filter-target="row" data-filter-action="{{ entry.action }}"><td>{{ entry.createdAt|date('d/m/Y H:i:s') }}</td><td>{{ entry.actor ? entry.actor.username : 'Compte supprimé' }}</td><td>{{ entry.action }}</td><td>{{ entry.targetType }} #{{ entry.targetId }}</td><td>{{ entry.details|json_encode }}</td></tr>{% endfor %}
</tbody></table></div>
<p {% if auditLogs %}hidden{% endif %} data-admin-filter-target="empty">{{ auditLogs ? 'Aucune entrée ne correspond à cette recherche.' : 'Aucune action consignée.' }}</p>
</section>
</div>
</div>
{% endblock %}
