{% import 'ui/macros.html.twig' as ui %}
{% set adminUniverses = adminUniverses|default(universes|default([])) %}
{% set currentRoute = app.request.attributes.get('_route') %}
{% set adminNotifications = admin_notifications(app.user) %}
{% set preferences = {timezone:'Europe/Paris'}|merge(app.user.preferences|default({})) %}
{% set missionPage = currentRoute starts with 'app_admin_mission' %}
{% set moderationWorkspace = currentRoute in ['app_admin_reports', 'app_admin_feedbacks', 'app_admin_feedback'] %}
{% set caseWorkspace = currentRoute in ['app_admin_cases', 'app_admin_case_new', 'app_admin_case'] %}
{% set surveillanceWorkspace = currentRoute in ['app_admin_surveillance', 'app_admin_missions', 'app_admin_mission'] %}
{% set universeWorkspace = currentRoute in ['app_admin_universes', 'app_admin_universe_new', 'app_admin_universe_manage'] %}
{% set balanceWorkspace = currentRoute == 'app_admin_universe_metrics' or currentRoute starts with 'app_admin_catalogue' %}
{% set boxesWorkspace = currentRoute == 'app_admin_resource_boxes' %}
{% set eventsWorkspace = currentRoute in ['app_admin_game_events', 'app_admin_game_event_new', 'app_admin_game_event_edit', 'app_admin_event_wizard', 'app_admin_event_preview'] %}
{% set projectsWorkspace = currentRoute in ['app_admin_guild_projects', 'app_admin_guild_project_new', 'app_admin_guild_project_edit'] %}
{% set rotationsWorkspace = currentRoute in ['app_admin_weekly_rotations', 'app_admin_weekly_rotation_new', 'app_admin_weekly_rotation_edit'] %}
{% set challengesWorkspace = currentRoute in ['app_admin_challenges', 'app_admin_challenge'] %}
{% set patchnotesWorkspace = currentRoute starts with 'app_admin_patchnote' %}
{% set opsWorkspace = currentRoute in ['app_admin_security', 'app_admin_permissions', 'app_admin_operations', 'app_admin_audit', 'app_admin_legal_preview'] %}
{% set directWorkspace = opsWorkspace or patchnotesWorkspace or challengesWorkspace or rotationsWorkspace or projectsWorkspace or eventsWorkspace or boxesWorkspace or balanceWorkspace or universeWorkspace or surveillanceWorkspace or caseWorkspace or moderationWorkspace or currentRoute in ['app_admin_index', 'app_admin_group', 'app_admin_players', 'app_admin_player', 'app_admin_guild_directory', 'app_admin_guild_detail'] %}
<!DOCTYPE html><html lang="fr"><head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><meta name="robots" content="noindex">
<title>{% block title %}Console d’administration · Genesis Reborn{% endblock %}</title>
<link rel="icon" href="{{ asset('art/genesis-reborn-emblem.webp') }}" type="image/png">{{ encore_entry_link_tags('app') }}
{% if app.user.preferences.theme|default('dark')=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}
{{ encore_entry_script_tags('app',attributes={defer:true}) }}
</head><body class="admin-console admin-console--organized ui-refined{{ directWorkspace ? ' admin-workspace' : '' }}{{ moderationWorkspace ? ' admin-moderation-workspace' : '' }}{{ caseWorkspace ? ' admin-case-workspace' : '' }}{{ surveillanceWorkspace ? ' admin-surveillance-workspace' : '' }}{{ universeWorkspace ? ' admin-universe-workspace' : '' }}{{ balanceWorkspace ? ' admin-balance-workspace' : '' }}{{ boxesWorkspace ? ' admin-boxes-workspace' : '' }}{{ eventsWorkspace ? ' admin-events-workspace' : '' }}{{ projectsWorkspace ? ' admin-projects-workspace' : '' }}{{ rotationsWorkspace ? ' admin-rotations-workspace' : '' }}{{ challengesWorkspace ? ' admin-challenges-workspace' : '' }}{{ patchnotesWorkspace ? ' admin-patchnotes-workspace' : '' }}{{ opsWorkspace ? ' admin-ops-workspace' : '' }}" data-ui-page="admin-{{ currentRoute }}" data-theme="{{ app.user.preferences.theme|default('dark') }}" data-controller="admin-notifications page-sections" data-admin-notifications-url-value="{{ path('app_admin_notifications') }}" data-admin-notifications-initial-value="{{ adminNotifications|json_encode|e('html_attr') }}">
<a class="skip" href="#admin-main">Aller au contenu</a>
<div class="admin-shell">
<aside class="admin-sidebar" data-controller="admin-navigation" data-action="keydown.esc->admin-navigation#close click->admin-navigation#navigate">
<a class="admin-brand" href="{{ path('app_admin_index') }}" aria-label="Genesis Reborn · Administration"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="Genesis Reborn"><span aria-hidden="true">GENESIS REBORN<br><strong>ADMINISTRATION</strong></span></a>
<button type="button" class="secondary admin-menu-toggle" data-admin-navigation-target="toggle" data-action="admin-navigation#toggle" aria-controls="admin-navigation-panel" aria-expanded="true" hidden>Menu d’administration</button>
<div id="admin-navigation-panel" class="admin-navigation-panel" data-admin-navigation-target="panel">
{% include 'admin/_navigation.html.twig' with {placement:'sidebar'} %}

<div class="admin-sidebar-footer"><a class="secondary" href="{{ path('app_home') }}">← Retour au jeu</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="secondary">Déconnexion</button></form><small>Accès administrateur · actions consignées</small></div>
</div></aside>
<div class="admin-main"><header class="admin-topbar"><span>Console d’administration <i class="connection-dot"></i></span><span>{{ app.user.username }} · ADMIN</span></header>
<main {% if directWorkspace or currentRoute starts with 'app_admin_universe' or currentRoute starts with 'app_admin_catalogue' or currentRoute starts with 'app_admin_game_event' or currentRoute starts with 'app_admin_guild_project' or currentRoute starts with 'app_admin_weekly_rotation' %}data-page-sections="disabled"{% endif %} id="admin-main" class="admin-content" tabindex="-1">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% include 'admin/_navigation.html.twig' with {placement:'content'} %}{% block body %}{% endblock %}</main>
</div></div></body></html>
