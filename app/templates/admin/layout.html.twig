{% import 'ui/macros.html.twig' as ui %}
{% set adminUniverses = adminUniverses|default(universes|default([])) %}
{% set adminNotifications = admin_notifications(app.user) %}
{% set currentRoute = app.request.attributes.get('_route') %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Console d’administration · Genesis Reborn{% endblock %}</title><link rel="icon" href="{{ asset('art/genesis-reborn-emblem.webp') }}" type="image/png">{{ encore_entry_link_tags('app') }}{% if app.user.preferences.theme|default('dark')=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}{{ encore_entry_script_tags('app',attributes={defer:true}) }}</head><body data-controller="admin-notifications" data-admin-notifications-url-value="{{ path('app_admin_notifications') }}" data-admin-notifications-initial-value="{{ adminNotifications|json_encode|e('html_attr') }}" class="admin-console" data-theme="{{ app.user.preferences.theme|default('dark') }}"><a class="skip" href="#admin-main">Aller au contenu</a><div class="admin-shell"><aside class="admin-sidebar" data-controller="admin-navigation" data-action="keydown.esc->admin-navigation#close click->admin-navigation#navigate"><a class="admin-brand" href="{{ path('app_admin_index') }}"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt=""><span>GENESIS<br><strong>OPERATIONS</strong></span></a><button type="button" class="secondary admin-menu-toggle" data-admin-navigation-target="toggle" data-action="admin-navigation#toggle" aria-controls="admin-navigation-panel" aria-expanded="true" hidden>Menu d’administration</button><div id="admin-navigation-panel" class="admin-navigation-panel" data-admin-navigation-target="panel"><nav aria-label="Console d’administration"><a href="{{ path('app_admin_index') }}" class="{{ currentRoute=='app_admin_index'?'active':'' }}" data-admin-panel-link="admin-overview" {% if currentRoute=='app_admin_index' %}aria-current="page"{% endif %}>{{ ui.icon('overview') }} Vue d’ensemble</a><a href="{{ path('app_admin_patchnotes') }}" class="{{ currentRoute starts with 'app_admin_patchnote' ? 'active' : '' }}" {% if currentRoute starts with 'app_admin_patchnote' %}aria-current="page"{% endif %}>{{ ui.icon('notifications') }} Patchnotes</a><a href="{{ path('app_admin_game_events') }}" class="{{ currentRoute starts with 'app_admin_game_event' ? 'active' : '' }}" {% if currentRoute starts with 'app_admin_game_event' %}aria-current="page"{% endif %}>{{ ui.icon('notifications') }} Événements</a><a href="{{ path('app_admin_feedbacks') }}" class="{{ currentRoute starts with 'app_admin_feedback' ? 'active' : '' }}" {% if currentRoute starts with 'app_admin_feedback' %}aria-current="page"{% endif %}>{{ ui.icon('notifications') }} Feedbacks{% include 'ui/admin_notification_badge.html.twig' with {category:'feedbacks', count:adminNotifications.feedbacks} only %}</a><a href="{{ path('app_admin_legal_preview') }}" {% if currentRoute == 'app_admin_legal_preview' %}aria-current="page"{% endif %}>{{ ui.icon('overview') }} Brouillons juridiques</a><a href="{{ path('app_admin_transports') }}" {% if currentRoute == 'app_admin_transports' %}aria-current="page"{% endif %}>{{ ui.icon('storage') }} Transports</a><a href="{{ path('app_admin_missions') }}" {% if currentRoute == 'app_admin_missions' %}aria-current="page"{% endif %}>{{ ui.icon('fleet') }} Missions des flottes</a><a href="{{ path('app_admin_index') }}#admin-reports" data-admin-panel-link="admin-reports">{{ ui.icon('notifications') }} Signalements{% include 'ui/admin_notification_badge.html.twig' with {category:'reports', count:adminNotifications.reports} only %}</a><a href="{{ path('app_admin_index') }}#admin-security" data-admin-panel-link="admin-security">{{ ui.icon('clock') }} Sécurité{% include 'ui/admin_notification_badge.html.twig' with {category:'security', count:adminNotifications.security} only %}</a><a href="{{ path('app_admin_index') }}#admin-players" data-admin-panel-link="admin-players">{{ ui.icon('user') }} Comptes joueurs</a><a href="{{ path('app_admin_index') }}#admin-universes" data-admin-panel-link="admin-universes">{{ ui.icon('universe') }} Tous les univers</a><a href="{{ path('app_admin_index') }}#admin-audit" data-admin-panel-link="admin-audit">{{ ui.icon('clock') }} Journal d’audit</a></nav>{% if adminUniverses is not empty %}<div class="admin-universe-switcher">{% for universe in adminUniverses %}<a href="{{ path('app_admin_catalogue',{id:universe.id}) }}" class="{{ app.request.attributes.get('id')==universe.id?'active':'' }}">{{ universe.name }} <span>Catalogue ↗</span></a>{% endfor %}</div>{% endif %}<div class="admin-sidebar-footer"><a class="secondary" href="{{ path('app_home') }}">← Retour au jeu</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="secondary">Déconnexion</button></form><small>Accès administrateur · actions consignées</small></div></div></aside><div class="admin-main"><header class="admin-topbar"><span>CONSOLE SÉCURISÉE <i class="connection-dot"></i></span><span>{{ app.user.username }} · ADMIN</span></header><main id="admin-main" class="admin-content" tabindex="-1">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main></div></div></body></html>
