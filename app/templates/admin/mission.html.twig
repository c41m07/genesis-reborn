{% extends 'admin/layout.html.twig' %}
{% block title %}Surveillance de la flotte {{ fleet.id }} · Console{% endblock %}
{% block body %}
<a class="inline-link" href="{{ path('app_admin_missions') }}">← Surveillance des missions</a>
<div class="page-heading"><div><h1>Flotte n° {{ fleet.id }}</h1><p>{{ missions[fleet.mission]|default(fleet.mission) }} · {{ fleet.playerUniverse.universe.name }} · {{ fleet.playerUniverse.displayName }}</p></div><a class="secondary" href="{{ path('app_admin_mission', {id:fleet.id}) }}">Actualiser le contrôle</a></div>
<p class="admin-monitor-note">État observé le {{ captured_at|date('d/m/Y H:i:s', preferences.timezone) }}. Les données actuelles ne reconstituent pas la composition ou la cargaison du départ.</p>
<p><a href="{{ path('app_admin_cases',{fleet:fleet.id}) }}">Dossiers de cette mission</a> · <a href="{{ path('app_admin_case_new',{fleet_id:fleet.id}) }}">Ouvrir un dossier</a></p>
{% include 'admin/_mission_departure_trace.html.twig' %}
{% if fleet.status in ['traveling','returning','orbiting','orbit_pending'] %}<section class="panel"><h2>Intervention administrative</h2>
<p>Un motif et une confirmation sont obligatoires. Les missions dont l’échéance est atteinte ou engagées dans un combat ne peuvent pas être modifiées ici. La composition et la cargaison ne sont pas éditables.</p>
<form method="post" action="{{ path('app_admin_mission_intervention',{id:fleet.id}) }}" class="admin-intervention-form">
<input type="hidden" name="_token" value="{{ csrf_token('admin_fleet_'~fleet.id) }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="expected_version" value="{{ fleet_version }}">
<label for="fleet-intervention">Action</label><select id="fleet-intervention" name="operation">{% if fleet.status != 'orbit_pending' %}<option value="reschedule">Changer le délai restant</option>{% endif %}{% if fleet.status != 'returning' %}<option value="recall">Rappeler vers la colonie de départ</option>{% endif %}</select>
<label for="fleet-seconds">Nouveau délai restant en secondes (pour un changement d’échéance)</label><input id="fleet-seconds" name="seconds" type="number" min="1" max="31536000" step="1" value="300"><p>Une seconde à un an. Le rappel conserve la durée de retour de référence et traite le carburant consommé.</p>
<label for="fleet-reason">Motif de l’intervention (obligatoire)</label><textarea id="fleet-reason" name="reason" required maxlength="1000"></textarea>
<label class="admin-intervention-confirm"><input type="checkbox" name="confirmed" value="1" required> Je confirme cette intervention sur la flotte n° {{ fleet.id }}.</label><button class="secondary" type="submit">Appliquer l’intervention</button>
</form></section>{% endif %}
<section class="panel"><h2>Situation de la mission</h2><dl class="report-facts">
<div><dt>État</dt><dd>{{ statuses[fleet.status]|default(fleet.status) }}</dd></div>
<div><dt>Commandant</dt><dd>{{ fleet.playerUniverse.displayName }}</dd></div>
<div><dt>Origine</dt><dd>{{ fleet.homePlanet.name }} · {{ fleet.homePlanet.coordinates() }}</dd></div>
<div><dt>Destination</dt><dd>{% if fleet.destination %}{{ fleet.destination.name }} · {{ fleet.destination.coordinates() }}{% elseif fleet.destinationSystem %}{{ fleet.destinationSystem.name }} · {{ fleet.destinationSystem.galaxy.coordinateCode() }}:{{ fleet.destinationSystem.number() }}{% else %}Non disponible{% endif %}</dd></div>
{% if fleet.destination.owner|default(null) %}<div><dt>Propriétaire actuel de la cible</dt><dd>{{ fleet.destination.owner.displayName }}</dd></div>{% endif %}
<div><dt>Dernier départ enregistré</dt><dd>{{ fleet.departureAt ? fleet.departureAt|date('d/m/Y H:i:s', preferences.timezone) : 'Non enregistré' }}</dd></div>
<div><dt>Échéance actuelle</dt><dd>{{ deadline ? deadline|date('d/m/Y H:i:s', preferences.timezone) : 'Aucune échéance enregistrée' }}</dd></div>
<div><dt>Durée de trajet de référence</dt><dd>{{ duration_label(fleet.travelSeconds) }}</dd></div>
<div><dt>Vitesse choisie</dt><dd>{{ (fleet.speedRatio * 100)|number_format(0) }} %</dd></div>
</dl>{% if deadline and fleet.status != 'completed' and deadline < captured_at %}<p class="admin-monitor-warning" role="status">Échéance dépassée : vérifier les traitements et le journal avant de conclure à un incident. <a href="{{ path('app_admin_operations') }}">Ouvrir l’exploitation</a></p>{% endif %}</section>
<section class="panel"><h2>Vaisseaux actuellement affectés</h2>{% if units %}<div class="table-wrap" tabindex="0" role="region" aria-label="Composition actuelle de la flotte"><table class="data-table"><caption>Effectifs présents au moment du relevé</caption><thead><tr><th scope="col">Vaisseau</th><th scope="col">Rang</th><th scope="col">Quantité</th></tr></thead><tbody>{% for unit in units %}<tr><th scope="row">{{ unit.label }}</th><td>{{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[unit.tier]|default(unit.tier) }}</td><td>{{ unit.quantity|number_format(0, ',', ' ') }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>Aucun vaisseau actuellement affecté. Après un retour, les unités sont réintégrées aux stocks de la colonie ; cela ne signifie pas qu’elles ont été détruites.</p>{% endif %}</section>
<section class="panel"><h2>Cargaison et carburant actuels</h2><dl class="report-facts">{% for slug,label in resources %}<div><dt>{{ label }}</dt><dd>{{ fleet.cargo[slug]|default(0)|number_format(2, ',', ' ') }}</dd></div>{% endfor %}<div><dt>Carburant réservé</dt><dd>{{ fleet.reservedFuel|number_format(2, ',', ' ') }}</dd></div><div><dt>Réserve de stationnement</dt><dd>{{ fleet.orbitFuel|number_format(2, ',', ' ') }}</dd></div></dl><p>Les réserves de carburant sont comprises dans l’hydrogène embarqué. La cargaison peut déjà avoir été livrée ou déposée au retour.</p></section>
{% if transport_report %}<section aria-labelledby="admin-transport-title"><h2 id="admin-transport-title">Rapport du transport</h2>{% include 'transport/_details.html.twig' with {report:transport_report} %}</section>{% elseif fleet.mission == 'transport' %}<section class="panel"><h2>Rapport du transport</h2><p>Aucun rapport économique n’est conservé pour cette mission.</p></section>{% endif %}
{% if combats %}<section class="panel"><h2>Combats associés</h2><p>Jusqu’aux 20 derniers engagements enregistrés pour cette flotte.</p><ul class="admin-monitor-report-list">{% for combat in combats %}<li>{% if combat.report %}<a href="{{ path('app_admin_mission_combat', {id:fleet.id,reportId:combat.report.id}) }}">Rapport de combat n° {{ combat.report.id }}</a> · {{ {attacker_wins:'Victoire des attaquants',defender_wins:'Victoire de la défense',draw:'Égalité'}[combat.report.outcome]|default(combat.report.outcome) }} · {{ combat.report.resolvedAt|date('d/m/Y H:i', preferences.timezone) }}{% else %}Combat n° {{ combat.event.id }} · {{ combat.event.status == 'pending' ? 'En cours' : combat.event.status }} · {{ combat.event.planet.name }}{% endif %}</li>{% endfor %}</ul></section>{% endif %}
{% if fleet.mission == 'spy' %}<section class="panel"><h2>Renseignements du commandant sur cette cible</h2><p>Ces rapports identifient le commandant et la cible, sans identifier la mission d’origine. Les dix derniers sont proposés.</p><ul class="admin-monitor-report-list">{% for report in espionage_reports %}<li><a href="{{ path('app_admin_mission_espionage', {id:fleet.id,reportId:report.id}) }}">Renseignement n° {{ report.id }}</a> · {{ report.createdAt|date('d/m/Y H:i', preferences.timezone) }} · {{ report.result == 'detected' ? 'Détecté' : 'Renseignements obtenus' }}</li>{% else %}<li>Aucun renseignement conservé pour ce commandant et cette cible.</li>{% endfor %}</ul></section>{% endif %}
{% endblock %}
