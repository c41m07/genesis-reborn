{% extends 'admin/layout.html.twig' %}
{% block title %}Surveillance des missions · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Surveillance des missions</h1><p>Suivre les flottes, leurs cargaisons et les rapports disponibles dans les univers.</p></div></div>
<section data-controller="admin-mission-monitor" aria-label="Suivi des missions">
<form method="get" class="feedback-admin-filters">
    <label for="mission-search">Joueur ou cible<input id="mission-search" name="q" type="search" maxlength="120" value="{{ filters.q }}" placeholder="Commandant, colonie, système…"></label>
    <label for="mission-universe">Univers<select id="mission-universe" name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ filters.universe == universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select></label>
    <label for="mission-type">Mission<select id="mission-type" name="mission"><option value="">Toutes les missions</option>{% for value,label in missions %}<option value="{{ value }}" {{ filters.mission == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
    <label for="mission-status">Statut<select id="mission-status" name="status"><option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>Missions en cours</option><option value="" {{ filters.status == '' ? 'selected' : '' }}>Tous, historique compris</option>{% for value,label in statuses %}<option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
    <button class="primary">Filtrer les missions</button><a href="{{ path('app_admin_missions') }}">Effacer les filtres</a>
</form>
<div class="admin-monitor-toolbar"><p>Actualisation toutes les 20 secondes, suspendue pendant la consultation au clavier.</p><button type="button" class="secondary" data-action="admin-mission-monitor#refresh">Actualiser le suivi</button></div><p role="status" data-admin-mission-monitor-target="status"></p>
<div data-admin-mission-monitor-target="results">
<p id="mission-counter-scope" class="admin-counter-scope">Compteurs des missions correspondant aux filtres ci-dessus.</p>
<section class="admin-metrics" aria-labelledby="mission-counter-scope">{% for key,label in {active:'En cours',combat:'Engagées au combat',returning:'En retour',waiting:'Accord attendu'} %}<article class="admin-metric"><span>{{ label }}</span><strong>{{ summary[key] }}</strong></article>{% endfor %}</section>
<p>{{ total }} mission{{ total == 1 ? '' : 's' }} trouvée{{ total == 1 ? '' : 's' }} · Relevé <time datetime="{{ captured_at|date('c') }}">{{ captured_at|date('d/m/Y H:i:s', preferences.timezone) }}</time>.</p>
{% if fleets %}
    {# Les huit colonnes restent dans le HTML, y compris dans les fiches sur écran étroit. #}
    <div class="admin-mission-table" tabindex="0" role="region" aria-label="Historique des missions">
        <table class="data-table admin-missions-table" role="table">
            <caption class="visually-hidden">Historique des missions des flottes</caption>
            <thead role="rowgroup"><tr role="row">
                {% for heading in ['Mission', 'Univers', 'Commandant origine', 'Origine → destination', 'Commandant destination', 'Statut', 'Dernier départ', 'Échéance'] %}
                    <th scope="col" role="columnheader">{{ heading }}</th>
                {% endfor %}
            </tr></thead>
            <tbody role="rowgroup">
                {% for fleet in fleets %}
                    {% set deadline = combat_events[fleet.id].resolveAt|default(fleet.arrivalAt) %}
                    <tr role="row">
                        <th scope="row" role="rowheader"><a href="{{ path('app_admin_mission', {id: fleet.id}) }}">n° {{ fleet.id }} · {{ missions[fleet.mission]|default(fleet.mission) }}</a></th>
                        <td role="cell" data-label="Univers"><span>{{ fleet.playerUniverse.universe.name }}</span></td>
                        <td role="cell" data-label="Commandant origine"><span>{{ fleet.playerUniverse.displayName }}</span></td>
                        <td role="cell" data-label="Origine → destination"><span>
                            {{ fleet.homePlanet.name }} {{ fleet.homePlanet.coordinates() }} →
                            {% if fleet.destination %}
                                {{ fleet.destination.name }} {{ fleet.destination.coordinates() }}
                            {% elseif fleet.destinationSystem %}
                                {{ fleet.destinationSystem.name }} {{ fleet.destinationSystem.galaxy.coordinateCode() }}:{{ fleet.destinationSystem.number() }}
                            {% else %}
                                Destination indisponible
                            {% endif %}
                        </span></td>
                        <td role="cell" data-label="Commandant destination"><span>
                            {% if fleet.destination %}
                                {{ fleet.destination.owner ? fleet.destination.owner.displayName : (fleet.destination.npcPlanet ? 'PNJ' : 'Sans propriétaire') }}
                            {% else %}
                                Sans propriétaire (système)
                            {% endif %}
                        </span></td>
                        <td role="cell" data-label="Statut"><span>{{ statuses[fleet.status]|default(fleet.status) }}</span></td>
                        <td role="cell" data-label="Dernier départ">{% if fleet.departureAt %}<time datetime="{{ fleet.departureAt|date('c') }}">{{ fleet.departureAt|date('d/m/Y H:i:s', preferences.timezone) }}</time>{% else %}—{% endif %}</td>
                        <td role="cell" data-label="Échéance"><span>
                            {% if deadline %}
                                <time datetime="{{ deadline|date('c') }}">{{ deadline|date('d/m/Y H:i:s', preferences.timezone) }}</time>
                                {% if fleet.status != 'completed' and deadline < captured_at %}<strong class="admin-monitor-warning">Échéance dépassée</strong>{% endif %}
                            {% else %}—{% endif %}
                        </span></td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% else %}<p>Aucune mission ne correspond aux filtres.</p>{% endif %}
<nav class="admin-mission-pages" aria-label="Pages des missions">{% if page > 1 %}<a class="secondary" href="{{ path('app_admin_missions', filters|merge({page:page-1})) }}">Page précédente</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page < pages %}<a class="secondary" href="{{ path('app_admin_missions', filters|merge({page:page+1})) }}">Page suivante</a>{% endif %}</nav>
</div></section>
{% endblock %}
