{% extends 'admin/layout.html.twig' %}
{% block title %}Missions des flottes · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Missions des flottes</h1><p>Toutes les missions conservées, en cours et terminées, dans les univers.</p></div></div>
<form method="get" class="feedback-admin-filters">
    <label for="mission-universe">Univers<select id="mission-universe" name="universe"><option value="">Tous les univers</option>{% for universe in universes %}<option value="{{ universe.id }}" {{ filters.universe == universe.id ? 'selected' : '' }}>{{ universe.name }}</option>{% endfor %}</select></label>
    <label for="mission-type">Mission<select id="mission-type" name="mission"><option value="">Toutes les missions</option>{% for value,label in missions %}<option value="{{ value }}" {{ filters.mission == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
    <label for="mission-status">Statut<select id="mission-status" name="status"><option value="">Tous les statuts</option>{% for value,label in statuses %}<option value="{{ value }}" {{ filters.status == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label>
    <button class="primary">Filtrer les missions</button><a href="{{ path('app_admin_missions') }}">Effacer les filtres</a>
</form>
<p role="status">{{ total }} mission{{ total == 1 ? '' : 's' }} trouvée{{ total == 1 ? '' : 's' }}. <a href="{{ path('app_admin_transports') }}">Consulter le détail des ressources transportées</a>.</p>
{% if fleets %}<div class="admin-mission-table" tabindex="0" role="region" aria-label="Historique des missions, tableau défilant"><table class="data-table"><caption class="visually-hidden">Historique des missions des flottes</caption><thead><tr>{% for heading in ['Mission','Univers','Commandant','Origine → destination','Statut','Dernier départ','Échéance'] %}<th scope="col">{{ heading }}</th>{% endfor %}</tr></thead><tbody>
{% for fleet in fleets %}<tr><th scope="row">n° {{ fleet.id }} · {{ missions[fleet.mission]|default(fleet.mission) }}</th><td>{{ fleet.playerUniverse.universe.name }}</td><td>{{ fleet.playerUniverse.displayName }}</td><td>{{ fleet.homePlanet.name }} {{ fleet.homePlanet.coordinates() }} → {% if fleet.destination %}{{ fleet.destination.name }} {{ fleet.destination.coordinates() }}{% elseif fleet.destinationSystem %}{{ fleet.destinationSystem.name }} {{ fleet.destinationSystem.galaxy.coordinateCode() }}:{{ fleet.destinationSystem.number() }}{% else %}Destination indisponible{% endif %}</td><td>{{ statuses[fleet.status]|default(fleet.status) }}</td><td>{{ fleet.departureAt ? fleet.departureAt|date('d/m/Y H:i:s', app.user.preferences.timezone|default('Europe/Paris')) : '—' }}</td><td>{{ fleet.arrivalAt ? fleet.arrivalAt|date('d/m/Y H:i:s', app.user.preferences.timezone|default('Europe/Paris')) : '—' }}</td></tr>{% endfor %}
</tbody></table></div>{% else %}<p>Aucune mission ne correspond aux filtres.</p>{% endif %}
<nav class="admin-mission-pages" aria-label="Pages des missions">{% if page > 1 %}<a class="secondary" href="{{ path('app_admin_missions', filters|merge({page:page-1})) }}">Page précédente</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page < pages %}<a class="secondary" href="{{ path('app_admin_missions', filters|merge({page:page+1})) }}">Page suivante</a>{% endif %}</nav>
{% endblock %}
