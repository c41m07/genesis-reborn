{% extends 'admin/layout.html.twig' %}
{% block title %}{{ editing ? 'Modifier une patchnote' : 'Nouvelle patchnote' }} · Console{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>{{ editing ? 'Modifier une patchnote' : 'Nouvelle patchnote' }}</h1><p>Texte simple, affiché aux joueurs avec ses sauts de ligne.</p></div></div>
<p class="admin-patchnote-actions"><a class="secondary" href="{{ path('app_admin_patchnotes') }}">Toutes les patchnotes</a></p>
{% if error %}<p class="flash error" role="alert">{{ error }}</p>{% endif %}
<form method="post" class="admin-patchnote-form" action="{{ editing ? path('app_admin_patchnote_edit', {id: editing.id}) : path('app_admin_patchnote_new') }}">
    <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'patchnote_edit_' ~ editing.id : 'patchnote_create') }}">
    <section class="panel" aria-labelledby="patchnote-writing-title">
        <h2 id="patchnote-writing-title">Rédaction</h2>
        <div class="admin-patchnote-field">
            <label for="note-title">Titre</label>
            <input id="note-title" required maxlength="160" name="title" value="{{ draft.title }}" aria-describedby="note-title-help">
            <small id="note-title-help">160 caractères maximum</small>
        </div>
        <div class="admin-patchnote-field">
            <label for="note-version">Version / tag</label>
            <input id="note-version" required maxlength="40" name="version" value="{{ draft.version }}" aria-describedby="note-version-help">
            <small id="note-version-help">40 caractères maximum</small>
        </div>
        <div class="admin-patchnote-field">
            <label for="note-summary">Résumé</label>
            <textarea id="note-summary" required maxlength="500" name="summary" rows="5" aria-describedby="note-summary-help">{{ draft.summary }}</textarea>
            <small id="note-summary-help">500 caractères maximum</small>
        </div>
        <div class="admin-patchnote-field">
            <label for="note-content">Contenu détaillé</label>
            <textarea id="note-content" required name="content" rows="12">{{ draft.content }}</textarea>
        </div>
    </section>
    <section class="panel" aria-labelledby="patchnote-publishing-title">
        <h2 id="patchnote-publishing-title">Publication</h2>
        <div class="admin-patchnote-field">
            <label for="note-status">Statut</label>
            <select id="note-status" name="status">
                <option value="draft" {{ draft.status == 'draft' ? 'selected' : '' }}>Brouillon</option>
                <option value="published" {{ draft.status == 'published' ? 'selected' : '' }}>Publié</option>
            </select>
        </div>
        <div class="admin-patchnote-field">
            <label for="note-publication">Date de publication (UTC)</label>
            <input id="note-publication" type="datetime-local" name="publishedAt" value="{{ draft.publishedAt }}" aria-describedby="note-publication-help">
            <small id="note-publication-help">Date vide avec le statut Publié : publication immédiate.</small>
        </div>
        <p>En brouillon, aucune date de publication n’est conservée. Une note publiée avec une date future apparaîtra aux joueurs à partir de cette date.</p>
    </section>
    <div class="admin-patchnote-actions">
        <button class="primary">{{ editing ? 'Enregistrer la patchnote' : 'Créer la patchnote' }}</button>
        <a class="secondary" href="{{ path('app_admin_patchnotes') }}">Annuler et revenir à la liste</a>
    </div>
</form>
{% endblock %}
