{% extends 'admin/layout.html.twig' %}
{% block title %}Patchnotes · Console d’administration{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Patchnotes</h1><p>Rédigez et publiez les nouveautés du jeu.</p></div></div>
<p class="admin-patchnote-actions"><a class="primary" href="{{ path('app_admin_patchnote_new') }}">Nouvelle patchnote</a></p>
<form method="get" class="panel admin-patchnote-filters" aria-labelledby="patchnote-filter-title">
    <h2 id="patchnote-filter-title">Filtrer les patchnotes</h2>
    <div class="admin-patchnote-field">
        <label for="patchnote-status">Statut</label>
        <select id="patchnote-status" name="status">
            <option value="">Tous</option>
            <option value="draft" {{ statusFilter == 'draft' ? 'selected' : '' }}>Brouillons</option>
            <option value="published" {{ statusFilter == 'published' ? 'selected' : '' }}>Publiées</option>
        </select>
    </div>
    <div class="admin-patchnote-field">
        <label for="patchnote-search">Recherche</label>
        <input id="patchnote-search" name="q" value="{{ search }}" placeholder="Titre ou version">
    </div>
    <button class="secondary">Filtrer</button>
</form>
{# La liste publique ouvre une note dès publishedAt <= maintenant, en UTC. #}
{% set publicationNow = date('now', 'UTC') %}
<ul class="admin-patchnote-list">
    {% for note in patchNotes %}
        <li><article class="panel patchnote-editor">
            <h2>{{ note.title }}</h2>
            <p class="badge">{{ note.version }} · {{ note.status != 'published' ? 'Brouillon' : (note.publishedAt and note.publishedAt > publicationNow ? 'Planifié' : 'Publié') }}</p>
            {% if note.publishedAt %}<p>Publication (UTC) : {{ note.publishedAt|date('d/m/Y H:i', 'UTC') }}</p>{% endif %}
            <div class="admin-patchnote-actions">
                <a class="secondary" href="{{ path('app_admin_patchnote_edit', {id: note.id}) }}">Modifier la patchnote<span class="sr-only"> {{ note.title }}</span></a>
                <a class="secondary" href="{{ path('app_admin_patchnote_remove', {id: note.id}) }}">Supprimer la patchnote<span class="sr-only"> {{ note.title }}</span></a>
            </div>
        </article></li>
    {% else %}<li class="panel">Aucune patchnote pour ces filtres.</li>{% endfor %}
</ul>
{% if pages > 1 %}
    <nav class="admin-mission-pages" aria-label="Pagination des patchnotes">
        {% if page > 1 %}<a class="secondary" href="{{ path('app_admin_patchnotes', {status: statusFilter, q: search, page: page - 1}) }}">Page précédente</a>{% endif %}
        <span>Page {{ page }} / {{ pages }}</span>
        {% if page < pages %}<a class="secondary" href="{{ path('app_admin_patchnotes', {status: statusFilter, q: search, page: page + 1}) }}">Page suivante</a>{% endif %}
    </nav>
{% endif %}
{% endblock %}
