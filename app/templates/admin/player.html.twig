{% extends 'admin/layout.html.twig' %}
{% block title %}{{ player.username }} · Fiche joueur{% endblock %}
{% block body %}
<a class="inline-link" href="{{ path('app_admin_players') }}">← Comptes joueurs</a>
<div class="page-heading"><div><h1>{{ player.username }}</h1><p>Fiche joueur · {{ player.lockedAt ? 'Compte suspendu' : 'Compte actif' }}</p></div></div>
<p class="admin-monitor-note">La présence et le temps de jeu sont des estimations de l’activité observée. Le suivi commence à la première visite enregistrée ; aucun historique antérieur n’est reconstitué. Les compteurs sont suspendus après cinq minutes sans activité. Les journées sont comptées en UTC.</p>
{% for row in memberships %}{% set activity = row.activity %}
<section class="panel admin-player-membership" aria-labelledby="membership-{{ row.membership.id }}"><h2 id="membership-{{ row.membership.id }}">{{ row.membership.universe.name }}</h2>
<dl class="report-facts"><div><dt>Présence estimée</dt><dd>{{ activity.online ? 'En ligne' : (activity.last_seen ? 'Hors ligne' : 'Non mesurée') }}</dd></div>
<div><dt>Dernière activité observée</dt><dd>{{ activity.last_seen ? activity.last_seen|date('d/m/Y H:i:s', preferences.timezone) : 'Aucune activité enregistrée' }}</dd></div>
<div><dt>Début du suivi</dt><dd>{{ activity.tracked_since ? activity.tracked_since|date('d/m/Y H:i', preferences.timezone) : 'À la prochaine visite du joueur' }}</dd></div>
<div><dt>Aujourd’hui (UTC)</dt><dd data-playtime="today">{{ duration_label(activity.today) }}</dd></div>
<div><dt>7 derniers jours (UTC)</dt><dd data-playtime="week">{{ duration_label(activity.week) }}</dd></div>
<div><dt>Total depuis le début du suivi</dt><dd data-playtime="total">{{ duration_label(activity.total) }}</dd></div></dl>
<h3>Colonies</h3><ul class="admin-monitor-report-list">{% for planet in row.planets %}<li>{{ planet.name }} · {{ planet.coordinates() }}</li>{% else %}<li>Aucune colonie.</li>{% endfor %}</ul>
<p><a href="{{ path('app_admin_missions',{universe:row.membership.universe.id,q:player.username}) }}">Surveiller les missions de ce joueur</a></p></section>
{% else %}<section class="panel"><h2>Participations aux univers</h2><p>Ce joueur ne participe à aucun univers.</p></section>{% endfor %}
{% endblock %}
