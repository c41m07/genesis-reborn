{% extends 'admin/layout.html.twig' %}
{% block title %}{{ player.username }} · Fiche joueur{% endblock %}
{% block body %}
<div class="admin-player-profile">
<a class="secondary admin-player-back" href="{{ path('app_admin_players') }}">← Comptes joueurs</a>
<div class="page-heading admin-design-banner">
    <div><p class="eyebrow">Fiche joueur</p><h1>{{ player.username }}</h1></div>
    <p class="admin-design-badge admin-design-badge--{{ player.lockedAt ? 'danger' : (player.emailVerifiedAt ? 'success' : 'warning') }}">{{ player.lockedAt ? 'Compte suspendu' : (player.emailVerifiedAt ? 'Compte actif' : 'Adresse à confirmer') }}</p>
</div>
<p class="admin-monitor-note">La présence et le temps de jeu sont des estimations de l’activité observée. Le suivi commence à la première visite enregistrée ; aucun historique antérieur n’est reconstitué. Les compteurs sont suspendus après cinq minutes sans activité. Les journées sont comptées en UTC.</p>
{% include 'admin/_account_diagnostic.html.twig' %}
<a class="secondary" href="{{ path('app_admin_cosmetic_grant',{id:player.id}) }}">Gérer les titres et bannières</a>
{% for row in memberships %}{% set activity = row.activity %}
<section class="panel admin-player-membership" aria-labelledby="membership-{{ row.membership.id }}"><h2 id="membership-{{ row.membership.id }}">{{ row.membership.universe.name }}</h2>
<a class="secondary" href="{{ path('app_admin_empire_state',{id:player.id,memberId:row.membership.id}) }}">Activité et conversion de l’empire</a>
<dl class="report-facts admin-player-activity"><div><dt>Présence estimée</dt><dd>{{ activity.online ? 'En ligne' : (activity.last_seen ? 'Hors ligne' : 'Non mesurée') }}</dd></div>
<div><dt>Dernière activité observée</dt><dd>{{ activity.last_seen ? activity.last_seen|date('d/m/Y H:i:s', preferences.timezone) : 'Aucune activité enregistrée' }}</dd></div>
<div><dt>Début du suivi</dt><dd>{{ activity.tracked_since ? activity.tracked_since|date('d/m/Y H:i', preferences.timezone) : 'À la prochaine visite du joueur' }}</dd></div>
<div><dt>Aujourd’hui (UTC)</dt><dd data-playtime="today">{{ duration_label(activity.today) }}</dd></div>
<div><dt>7 derniers jours (UTC)</dt><dd data-playtime="week">{{ duration_label(activity.week) }}</dd></div>
<div><dt>Total depuis le début du suivi</dt><dd data-playtime="total">{{ duration_label(activity.total) }}</dd></div></dl>
<h3>Colonies</h3>
<ul class="admin-player-colonies">
    {% for planet in row.planets %}
        <li>
            <h4>{{ planet.name }} · {{ planet.coordinates() }}</h4>
            {% include 'admin/_resource_intervention.html.twig' %}
            {% include 'admin/_ship_intervention.html.twig' %}
        </li>
    {% else %}
        <li>Aucune colonie.</li>
    {% endfor %}
</ul>
<div class="admin-player-links">
    <a class="secondary" href="{{ path('app_admin_cases',{membership:row.membership.id}) }}">Dossiers de cette participation</a>
    <a class="secondary" href="{{ path('app_admin_case_new',{membership_id:row.membership.id}) }}">Ouvrir un dossier pour ce joueur</a>
    <a class="secondary" href="{{ path('app_admin_missions',{universe:row.membership.universe.id,q:player.username}) }}">Surveiller les missions de ce joueur</a>
</div></section>
{% else %}<section class="panel"><h2>Participations aux univers</h2><p>Ce joueur ne participe à aucun univers.</p></section>{% endfor %}
</div>
{% endblock %}
