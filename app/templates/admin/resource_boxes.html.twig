{% extends 'admin/layout.html.twig' %}
{% block title %}Boîtes de ressources · {{ universe.name }}{% endblock %}
{% block body %}
<p><a class="secondary" href="{{ path('app_admin_universes') }}">← Retour aux univers</a></p>
<div class="page-heading"><div><h1>Boîtes de ressources</h1><p>{{ universe.name }} · Modèles et plafonds par boîte.</p></div></div>
<p class="admin-monitor-note">Le contenu d’une boîte attribuée est figé. Ces changements concernent les futures définitions de récompense ; les boîtes déjà gagnées et les récompenses déjà annoncées gardent leur contenu. Les quantités ci-dessous ne sont jamais aléatoires.</p>
<nav class="admin-box-sections" aria-label="Réglages des boîtes de ressources">
    <a class="secondary" href="#box-caps">Plafonds</a>
    <a class="secondary" href="#box-templates">Modèles</a>
    <a class="secondary" href="#box-confirmation">Motif et confirmation</a>
</nav>
<form method="post" class="resource-box-settings">
    <input type="hidden" name="_token" value="{{ csrf_token('admin_boxes_' ~ universe.id) }}">
    <fieldset class="panel" id="box-caps">
        <legend>Plafonds par boîte dans cet univers</legend>
        <div class="admin-box-caps">
            {% for slug, label in resources %}
                <div class="admin-box-field">
                    <label for="box-cap-{{ slug }}">{{ label }}</label>
                    <input id="box-cap-{{ slug }}" type="number" name="caps[{{ slug }}]" min="0" max="1000000000" step="0.01" value="{{ draft.caps[slug]|default(settings.caps[slug]) }}" aria-describedby="box-amount-help" required>
                </div>
            {% endfor %}
        </div>
        <p id="box-amount-help">Quantités fixes : de 0 à 1 000 000 000, avec deux décimales au maximum. Chaque modèle doit respecter les plafonds et contenir au moins une ressource.</p>
    </fieldset>
    <div class="admin-box-templates" id="box-templates">
        {% for format, label in formats %}
            <fieldset class="panel">
                <legend>{{ label }}</legend>
                <div class="admin-box-fields">
                    {% for slug, resourceLabel in resources %}
                        <div class="admin-box-field">
                            <label for="box-{{ format }}-{{ slug }}">{{ resourceLabel }}</label>
                            <input id="box-{{ format }}-{{ slug }}" type="number" name="templates[{{ format }}][{{ slug }}]" min="0" max="1000000000" step="0.01" value="{{ draft.templates[format][slug]|default(settings.templates[format][slug]) }}" aria-describedby="box-amount-help" required>
                        </div>
                    {% endfor %}
                </div>
            </fieldset>
        {% endfor %}
    </div>
    <fieldset class="panel" id="box-confirmation">
        <legend>Motif et confirmation</legend>
        <div class="admin-box-fields">
            <div class="admin-box-field">
                <label for="box-settings-reason">Motif du changement</label>
                <textarea id="box-settings-reason" name="reason" maxlength="1000" placeholder="Précisez le motif…" aria-describedby="box-reason-help" required>{{ draft.reason|default('') }}</textarea>
                <small id="box-reason-help">Obligatoire · 1 000 caractères maximum</small>
            </div>
            {# Une correction conserve le choix soumis ; le serveur vérifie toujours la confirmation. #}
            <label class="admin-intervention-confirm"><input type="checkbox" name="confirmed" value="1"{% if draft.confirmed|default('') == '1' %} checked{% endif %} required> Je confirme ces modèles et leurs plafonds pour {{ universe.name }}.</label>
            <button class="primary">Enregistrer les modèles de boîtes</button>
        </div>
    </fieldset>
</form>
{% endblock %}
