<div data-admin-list-target="results" data-controller="admin-filter">
<p role="status">{{ listPage.total }} résultat{{ listPage.total == 1 ? '' : 's' }} · 50 lignes maximum par page</p>
<div class="admin-audit-actions"><button type="button" class="secondary" data-action="click->admin-filter#exportCsv">Exporter les lignes visibles en CSV</button> <a class="secondary" href="{{ path('app_admin_audit', listFilters|merge({export:'all'})) }}">Exporter tous les résultats en CSV</a></div>
<div class="table-wrap" role="region" tabindex="0" aria-label="Tableau défilant horizontalement"><table><caption>Journal des actions administratives</caption><thead><tr><th scope="col">Date</th><th scope="col">Administrateur</th><th scope="col">Action</th><th scope="col">Cible</th><th scope="col">Détails</th></tr></thead><tbody>
{% for entry in auditLogs %}<tr data-admin-filter-target="row" data-filter-action="{{ entry.action }}"><td>{{ entry.createdAt|date('d/m/Y H:i:s') }}</td><td>{{ entry.actor ? entry.actor.username : 'Compte supprimé' }}</td><td>{{ entry.action }}</td><td>{{ entry.targetType }} #{{ entry.targetId }}</td><td>{{ entry.details|json_encode(constant('JSON_UNESCAPED_UNICODE')) }}</td></tr>{% endfor %}
</tbody></table></div>
<p {% if auditLogs %}hidden{% endif %} data-admin-filter-target="empty">{{ auditLogs or listFilters.q != '' or listFilters.action != '' ? 'Aucune entrée ne correspond à cette recherche.' : 'Aucune action consignée.' }}</p>
{% include 'admin/sections/_list_pagination.html.twig' %}
</div>
