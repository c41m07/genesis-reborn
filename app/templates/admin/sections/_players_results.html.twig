<div data-admin-list-target="results" data-controller="admin-filter">
<p role="status">{{ listPage.total }} résultat{{ listPage.total == 1 ? '' : 's' }} · 50 lignes maximum par page</p>
<div class="table-wrap" role="region" tabindex="0" aria-label="Comptes joueurs et actions"><table class="admin-players-table"><caption>Comptes joueurs</caption><thead><tr><th scope="col">Joueur</th><th scope="col">Courriel</th><th scope="col">Présence</th><th scope="col">État</th><th scope="col">Rôle</th><th scope="col">Actions</th></tr></thead><tbody>
{% for player in players %}<tr data-admin-filter-target="row" data-filter-status="{{ player.lockedAt ? 'suspended' : 'active' }}" data-filter-role="{{ 'ROLE_ADMIN' in player.roles ? 'admin' : 'player' }}"><th scope="row" class="admin-player-name"><a href="{{ path('app_admin_player',{id:player.id}) }}">{{ player.username }}</a></th><td data-label="Courriel"><span class="admin-cell-value">{{ player.email }}</span></td><td data-label="Présence"><span class="admin-cell-value">{{ playerPresence[player.id].online|default(false) ? 'En ligne' : (playerPresence[player.id].last_seen|default(null) ? 'Hors ligne' : 'Non mesurée') }}{% if playerPresence[player.id].last_seen|default(null) %}<br><small>{{ playerPresence[player.id].last_seen|date('d/m/Y H:i', preferences.timezone) }}</small>{% endif %}</span></td><td data-label="État"><span class="admin-cell-value"><span class="badge admin-player-status {{ player.lockedAt ? 'is-suspended' : '' }}">{{ player.lockedAt ? 'Suspendu' : (player.emailVerifiedAt ? 'Actif' : 'Adresse à confirmer') }}</span></span></td><td data-label="Rôle"><span class="admin-cell-value">{% if 'ROLE_ADMIN' in player.roles %}<span class="badge">Administrateur</span>{% else %}<span class="badge">Joueur</span>{% endif %}</span></td><td class="admin-player-actions" data-label="Actions"><div class="admin-cell-value admin-player-action-list">
{% if player.id == app.user.id %}<span>Compte courant</span>{% else %}
<form method="post" action="{{ path('app_admin_player_role',{id:player.id}) }}" data-controller="confirmation" data-action="submit->confirmation#confirm" data-confirmation-message-value="{{ ('ROLE_ADMIN' in player.roles ? 'Retirer les droits d’administration à ' : 'Accorder les droits d’administration à ') ~ player.username ~ ' ?' }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_role_'~player.id) }}"><input type="hidden" name="role" value="{{ 'ROLE_ADMIN' in player.roles ? 'demote' : 'promote' }}"><button class="secondary admin-sensitive-action" aria-label="{{ ('ROLE_ADMIN' in player.roles ? 'Retirer admin : retirer les droits d’administration à ' : 'Promouvoir admin : accorder les droits d’administration à ') ~ player.username }}">{{ 'ROLE_ADMIN' in player.roles ? 'Retirer admin' : 'Promouvoir admin' }}</button></form>
{% if 'ROLE_ADMIN' not in player.roles %}<form method="post" action="{{ path('app_admin_player_suspend',{id:player.id}) }}" {% if not player.lockedAt %}data-controller="confirmation" data-action="submit->confirmation#confirm" data-confirmation-message-value="Suspendre l’accès au compte {{ player.username }} ?"{% endif %}><input type="hidden" name="_token" value="{{ csrf_token('admin_suspend_'~player.id) }}"><input type="hidden" name="suspend" value="{{ player.lockedAt ? '0' : '1' }}"><button class="{{ player.lockedAt ? 'secondary' : 'admin-sensitive-action' }}" aria-label="{{ player.lockedAt ? 'Réactiver le compte ' : 'Suspendre le compte ' }}{{ player.username }}">{{ player.lockedAt ? 'Réactiver' : 'Suspendre' }}</button></form>{% endif %}
{% endif %}
</div></td></tr>{% else %}<tr><td colspan="6">Aucun compte joueur.</td></tr>{% endfor %}
</tbody></table></div>
<p hidden data-admin-filter-target="empty">Aucun compte ne correspond à cette recherche.</p>
{% include 'admin/sections/_list_pagination.html.twig' %}
</div>
