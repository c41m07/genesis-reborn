<section class="panel admin-section" id="admin-audit" aria-labelledby="admin-audit-title" data-controller="admin-list">
<h2 id="admin-audit-title">Journal d’audit</h2>
<form method="get" class="admin-search" data-admin-list-target="form" data-action="input->admin-list#schedule change->admin-list#search submit->admin-list#search">
<label for="audit-search">Rechercher dans le journal</label><input id="audit-search" name="q" type="search" placeholder="Administrateur, cible ou détails…" maxlength="150" value="{{ listFilters.q }}">
<label for="audit-action-filter">Action</label><select id="audit-action-filter" name="action"><option value="">Toutes les actions</option>{% for action in auditActions %}<option value="{{ action }}" {{ listFilters.action == action ? 'selected' : '' }}>{{ action }}</option>{% endfor %}</select><button class="secondary">Rechercher</button>
</form>
<p role="alert" data-admin-list-target="error" hidden>La recherche a échoué. Réessayez ou rechargez la page.</p>
{% include 'admin/sections/_audit_results.html.twig' %}
</section>
