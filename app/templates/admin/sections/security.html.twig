<section class="panel admin-section" id="admin-security" aria-labelledby="admin-security-title" data-controller="admin-filter">
    <h2 id="admin-security-title">Signalements de sécurité</h2>
    <p>Les tentatives d’accès refusées sont à examiner ; les événements déjà examinés restent au journal.</p>
    <div class="admin-search" data-admin-filter-target="tools" hidden>
        <label for="security-search">Rechercher</label>
        <input id="security-search" type="search" placeholder="Compte ou chemin…" data-admin-filter-target="query" data-action="input->admin-filter#filter">
        <label for="security-auth-filter">Origine</label>
        <select id="security-auth-filter" data-admin-filter-target="filter" data-filter-key="authenticated" data-action="change->admin-filter#filter">
            <option value="">Toutes</option><option value="yes">Connectée</option><option value="no">Anonyme</option>
        </select>
        <p>Recherche parmi les 50 incidents les plus récents affichés.</p>
        <output data-admin-filter-target="count"></output>
    </div>
    <div class="table-wrap" role="region" tabindex="0" aria-label="Tentatives d’accès administrateur refusées">
        <table class="admin-ops-table" role="table">
            <caption>Accès à l’administration refusés</caption>
            <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">Date</th><th scope="col" role="columnheader">Compte</th><th scope="col" role="columnheader">Méthode</th><th scope="col" role="columnheader">Chemin demandé</th><th scope="col" role="columnheader">Action</th></tr></thead>
            <tbody role="rowgroup">
                {% for incident in securityIncidents|slice(0, 50) %}
                    <tr role="row" data-admin-filter-target="row" data-filter-authenticated="{{ incident.details.authenticated|default(false) ? 'yes' : 'no' }}">
                        <th scope="row" role="rowheader">{{ incident.createdAt|date('d/m/Y H:i:s') }}</th>
                        <td role="cell" data-label="Compte">{{ incident.actor ? incident.actor.username : 'Visiteur non connecté' }}</td>
                        <td role="cell" data-label="Méthode">{{ incident.details.method|default('—') }}</td>
                        <td role="cell" data-label="Chemin demandé"><code>{{ incident.details.path|default('/admin') }}</code></td>
                        <td role="cell" data-label="Action">
                            <form method="post" action="{{ path('app_admin_security_review', {id: incident.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('admin_security_review_' ~ incident.id) }}">
                                <button class="secondary admin-security-review">Marquer examinée</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p {% if securityIncidents %}hidden{% endif %} data-admin-filter-target="empty">{{ securityIncidents ? 'Aucun incident ne correspond à cette recherche.' : 'Aucune tentative refusée en attente d’examen.' }}</p>
</section>
