{% extends 'admin/layout.html.twig' %}
{% block title %}Gérer {{ universe.name }} · Administration{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">Univers · {{ universe.slug }}</p><h1>Gérer {{ universe.name }}</h1><p>Configuration et calendrier de cet univers.</p></div><a class="secondary" href="{{ path('app_admin_universes') }}">Tous les univers</a></div>
{% set selectedSpeedProfile = 'custom' %}{% set selectedSpeedProfileLabel = 'Personnalisé' %}
{% for profile in universeProfiles %}
  {% set profileDuration = (1 / profile.speed)|round(3) %}
  {% if profileDuration == config.multipliers.building_time|round(3) and profileDuration == config.multipliers.research_time|round(3) and profileDuration == config.multipliers.ship_build_time|round(3) and profileDuration == config.multipliers.travel_time|round(3) and profile.speed == config.multipliers.resource_production|round(3) %}
    {% set selectedSpeedProfile = profile.slug %}{% set selectedSpeedProfileLabel = profile.name %}
  {% endif %}
{% endfor %}
{% set isScheduled = universe.status == 'active' and universe.startsAt and universe.startsAt > date() %}
{% set isClosingSoon = universe.endsAt and universe.endsAt > date() and universe.endsAt < date('+7 days') %}
{% set hasIncompleteConfig = config.multipliers is empty or config.limits is empty %}
<article class="panel admin-universe-card admin-universe-manage" id="admin-universe-{{ universe.id }}" tabindex="-1" aria-labelledby="universe-title-{{ universe.id }}" data-admin-filter-target="row" data-filter-status="{{ isScheduled ? 'scheduled' : universe.status }}">
    <div class="panel admin-universe-summary">
        <div class="admin-universe-heading">
            <div><h2 id="universe-title-{{ universe.id }}">{{ universe.name }}</h2><code>{{ universe.slug }}</code></div>
            <span class="admin-status-badge admin-status-badge--{{ isScheduled ? 'scheduled' : universe.status }}">{{ isScheduled ? 'Planifié' : (universe.status == 'active' ? 'Ouvert' : 'Fermé') }}</span>
        </div>
        <div class="admin-universe-facts">
            <span><small>Joueurs</small><strong>{{ universePlayerCounts[universe.id]|default(0) }}</strong></span>
            <span><small>Ouverture</small><strong>{{ universe.startsAt ? universe.startsAt|date('d/m/Y H:i', 'UTC') ~ ' UTC' : (universe.status == 'active' ? 'Immédiate' : 'Non définie') }}</strong></span>
            <span><small>Fermeture</small><strong>{{ universe.endsAt ? universe.endsAt|date('d/m/Y H:i', 'UTC') ~ ' UTC' : 'Aucune' }}</strong></span>
            <span><small>Profil</small><strong>{{ selectedSpeedProfileLabel }}</strong></span>
        </div>
        {% if isClosingSoon or universe.status == 'closed' or hasIncompleteConfig %}
            <div class="admin-universe-alerts">
                {% if isClosingSoon %}<span class="is-warning">Fermeture dans moins de 7 jours</span>{% endif %}
                {% if universe.status == 'closed' %}<span>Univers fermé</span>{% endif %}
                {% if hasIncompleteConfig %}<span class="is-warning">Configuration à vérifier</span>{% endif %}
            </div>
        {% endif %}
    </div>
    <div class="admin-universe-manage-layout">
        <section class="panel admin-universe-settings">
            <h2>Calendrier</h2>
            {% include 'admin/_universe_calendar.html.twig' %}
            <p><a class="secondary" href="{{ path('app_admin_resource_boxes', {id: universe.id}) }}">Modèles de boîtes de ressources</a></p>
        </section>
        <section class="panel admin-universe-configuration">
            <h2>Configuration</h2>
            {% include 'admin/_universe_settings.html.twig' %}
        </section>
    </div>
    <details class="admin-danger-zone">
        <summary>Zone de suppression définitive</summary>
        <p>Cette action supprime l’univers et toutes ses données de jeu. Elle ne peut pas être annulée.</p>
        <form method="post" action="{{ path('app_admin_universe_delete', {id: universe.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('admin_delete_universe_' ~ universe.id) }}">
            <label for="confirm-universe-{{ universe.id }}">Saisis <strong>{{ universe.name }}</strong> pour confirmer</label>
            <input id="confirm-universe-{{ universe.id }}" name="confirmation" type="text" autocomplete="off" required>
            <button class="danger">Supprimer définitivement l’univers</button>
        </form>
    </details>
</article>
{% endblock %}
