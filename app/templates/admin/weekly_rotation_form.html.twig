{% extends 'admin/layout.html.twig' %}
{% block title %}{{ editing ? 'Modifier '~editing.name : 'Créer une rotation hebdomadaire' }} · Administration{% endblock %}
{% block body %}<div class="page-heading"><div><p class="eyebrow">{{ universe.name }}</p><h1>{{ editing ? 'Modifier '~editing.name : 'Créer une rotation hebdomadaire' }}</h1><p>Les occurrences déjà programmées conservent leurs règles et récompenses.</p></div></div>
<p class="admin-rotation-actions"><a class="secondary" href="{{ path('app_admin_weekly_rotations', {universe: universe.id}) }}">Tous les modèles de cet univers</a></p>
<form method="post" action="{{ editing ? path('app_admin_weekly_rotation_edit', {id: universe.id, key: editing.key}) : path('app_admin_weekly_rotation_new', {universe: universe.id}) }}" class="admin-event-form admin-rotation-form">
    <input type="hidden" name="_token" value="{{ csrf_token(editing ? 'weekly_rotation_edit_' ~ universe.id ~ '_' ~ editing.key : 'weekly_rotation_create_' ~ universe.id) }}">
    <input type="hidden" name="universe" value="{{ universe.id }}"><input type="hidden" name="version" value="{{ draft.version|default('') }}">
    <section class="panel" aria-labelledby="rotation-identity-title">
        <h2 id="rotation-identity-title">Identité du modèle</h2>
        <div class="admin-rotation-fields">
            <div class="admin-rotation-field"><label for="rotation-name">Nom de la rotation</label><input id="rotation-name" name="name" maxlength="120" value="{{ draft.name|default('') }}" required></div>
            <div class="admin-rotation-field"><label for="rotation-description">Consignes pour les joueurs</label><textarea id="rotation-description" name="description" maxlength="2000">{{ draft.description|default('') }}</textarea></div>
        </div>
    </section>
    <section class="panel" aria-labelledby="rotation-conditions-title">
        <h2 id="rotation-conditions-title">Objectif et attribution</h2>
        <div class="admin-rotation-fields">
            <div class="admin-rotation-field"><label for="rotation-objective">Objectif suivi</label><select id="rotation-objective" name="objective">{% for key, objective in objectives %}<option value="{{ key }}"{{ draft.objective|default('') == key ? ' selected' : '' }}>{{ objective.label }}</option>{% endfor %}</select></div>
            <div class="admin-rotation-field"><label for="rotation-format">Format de la rotation</label><select id="rotation-format" name="format">{% for key, label in formats %}<option value="{{ key }}"{{ draft.format|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
            <div class="admin-rotation-field"><label for="rotation-reward">Attribution du boost</label><select id="rotation-reward" name="reward_mode" aria-describedby="rotation-reward-help">{% for key, label in reward_modes %}<option value="{{ key }}"{{ draft.reward_mode|default('') == key ? ' selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
            <p id="rotation-reward-help">Top 3 : objectif global obligatoire et atteint. Seuil : atteindre le minimum individuel suffit. Tous les contributeurs : toute contribution positive suffit. Attribution à la clôture, un boost maximum par joueur.</p>
            <div class="admin-rotation-field"><label for="rotation-goal">Objectif global (obligatoire pour le Top 3)</label><input id="rotation-goal" name="global_goal" type="number" min="1" max="1000000000000" step="any" value="{{ draft.global_goal|default('') }}" aria-describedby="rotation-quantity-help"></div>
            <div class="admin-rotation-field"><label for="rotation-threshold">Seuil individuel (obligatoire en mode seuil)</label><input id="rotation-threshold" name="threshold_value" type="number" min="1" max="1000000000000" step="any" value="{{ draft.threshold_value|default('') }}" aria-describedby="rotation-quantity-help"></div>
            <p id="rotation-quantity-help">De 1 à 1 000 000 000 000 si renseigné. Les découvertes utilisent des objectifs et seuils entiers.</p>
        </div>
    </section>
    <section class="panel" aria-labelledby="rotation-registration-title">
        <h2 id="rotation-registration-title">Durée et enregistrement</h2>
        <div class="admin-rotation-fields">
            <div class="admin-rotation-field"><label for="rotation-duration">Durée en heures</label><input id="rotation-duration" name="duration_hours" type="number" min="1" max="720" step="any" value="{{ draft.duration_hours }}" required></div>
            <label class="admin-rotation-enabled"><input name="enabled" type="checkbox" value="1"{{ draft.enabled|default(false) ? ' checked' : '' }}> Modèle actif pour les prochaines semaines</label>
            <div class="admin-rotation-field"><label for="rotation-create-reason">Motif de l’enregistrement</label><textarea id="rotation-create-reason" name="reason" maxlength="1000" required>{{ draft.reason|default('') }}</textarea></div>
        </div>
    </section>
    <button class="primary">{{ editing ? 'Enregistrer le modèle' : 'Créer la rotation hebdomadaire' }}</button>
</form>
{% if editing %}
    <section class="panel">
        <h2>Activation rapide</h2>
        <p>Désactiver un modèle ne supprime et n’annule aucune occurrence déjà programmée. Les contributions et récompenses acquises sont conservées.</p>
        <details class="admin-rotation-toggle">
            <summary>{{ editing.enabled ? 'Désactiver ce modèle' : 'Activer ce modèle' }}</summary>
            <form method="post" action="{{ path('app_admin_weekly_rotation_toggle', {id: universe.id}) }}" class="admin-intervention-form">
                <input type="hidden" name="_token" value="{{ csrf_token('weekly_rotation_toggle_' ~ universe.id) }}"><input type="hidden" name="key" value="{{ editing.key }}"><input type="hidden" name="enabled" value="{{ editing.enabled ? '0' : '1' }}">
                <div class="admin-rotation-field"><label for="rotation-reason-{{ editing.key }}">Motif du changement</label><input id="rotation-reason-{{ editing.key }}" name="reason" maxlength="1000" required></div>
                <button class="secondary">{{ editing.enabled ? 'Désactiver ce modèle' : 'Activer ce modèle' }}</button>
            </form>
        </details>
    </section>
{% endif %}
{% endblock %}
