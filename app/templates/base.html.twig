    {% if firstStepsPreview and fleetDecisionPage %}
        {% include 'player/_first_steps_popup.html.twig' with {planet: chrome.planet, preview: firstStepsPreview} only %}
    {% endif %}
</main>
{% if firstStepsPreview and not firstStepsInFlow %}
    {% include 'player/_first_steps_popup.html.twig' with {planet: chrome.planet, preview: firstStepsPreview} only %}
{% endif %}
<footer class="footer {{ route=='app_map_v2'?'footer--galaxy-v2':'' }}"><span>GENESIS REBORN</span><span>Explorez. Développez. Écrivez votre histoire.</span>{% include 'legal/_navigation.html.twig' %}</footer>
{% if app.user %}<nav class="mobile-bottom-nav" aria-label="Navigation mobile"><a href="{{ chrome.planet ? path('app_colony',{id:chrome.planet.id}) : path('app_home') }}" class="{{ route=='app_colony' or route=='app_home' ? 'active' : '' }}" {{ route=='app_colony' or route=='app_home' ? 'aria-current="page"' : '' }}>{{ ui.icon('overview') }}<span>Accueil</span></a><a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}">{{ ui.icon('planet') }}<span>Planètes</span></a><a href="{{ path('app_map_v2') }}" class="{{ route in ['app_map','app_map_v2'] ? 'active' : '' }}" {{ route in ['app_map','app_map_v2'] ? 'aria-current="page"' : '' }}>{{ ui.icon('galaxy') }}<span>Galaxie</span></a><a href="{{ fleetMenuUrl }}" data-message-notifications-target="fleetLink" data-missions-url="{{ path('app_fleets') }}" data-orbits-url="{{ path('app_fleet_orbits') }}" aria-label="Flottes" aria-describedby="orbit-menu-description" class="{{ (route=='app_fleets' or route starts with 'app_fleet_') ? 'active' : '' }}" {{ (route=='app_fleets' or route starts with 'app_fleet_') ? 'aria-current="page"' : '' }}>{{ ui.icon('fleet') }}<span>Flottes</span>{% include 'ui/orbit_menu_badge.html.twig' %}</a><button type="button" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false"{% if chrome.membership %} aria-describedby="report-unread-description guild-recruitment-description inventory-gift-description"{% endif %}>{{ ui.icon('menu') }}<span class="menu-unread-dot" data-menu-notifications-target="badge" role="img" aria-label="Notifications à consulter dans le menu" {% if not chrome.unreadMessages|default(0) and not unreadPatchNote and not chrome.journal.unreadCount|default(0) %}hidden{% endif %}></span>{% if chrome.membership %}{% include 'ui/menu_special_notices.html.twig' with {pendingRecruitment: pendingRecruitment, giftCount: giftNotices.count, unreadReports: unreadReports} only %}{% endif %}<span>Plus</span></button></nav>{% endif %}
</div>
{% if chrome.membership and preferences.realtimeNotifications and not campaignPage %}<div class="event-toast" hidden role="status" aria-live="polite" data-controller="events" data-events-url-value="{{ path('app_events') }}" data-events-enabled-value="{{ preferences.realtimeNotifications?'true':'false' }}"><span class="notification-mark">{{ ui.icon('check') }}</span><span data-events-target="message"></span><button class="text-button" data-action="events#refresh">Actualiser</button></div>{% endif %}
