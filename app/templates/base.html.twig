{% import 'ui/macros.html.twig' as ui %}
{% set chrome = game_shell(app.user, planet|default(null)) %}
{% set route = app.request.attributes.get('_route') %}
{% set adminNotifications = is_granted('ROLE_ADMIN') ? admin_notifications(app.user) : {total:0,reports:0,security:0,feedbacks:0} %}
{% set metadata = public_metadata(route|default('')) %}
{% set section = section|default('overview') %}
{% set unreadPatchNote = app.user and latest_patch_note_id() > (app.user.preferences.last_patch_note_read_id|default(0)) %}
{% set preferences = {'timezone':'Europe/Paris','reducedMotion':false,'realtimeNotifications':true,'theme':'dark'}|merge(app.user ? app.user.preferences|default({}) : {}) %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Genesis Reborn{% endblock %}</title>
{% if metadata %}
{% if metadata.indexable is defined and not metadata.indexable %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ metadata.description }}">
<link rel="canonical" href="{{ metadata.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ metadata.title }}">
<meta property="og:description" content="{{ metadata.description }}">
<meta property="og:url" content="{{ metadata.url }}">
<meta property="og:image" content="{{ metadata.image }}">
<meta property="og:image:alt" content="Genesis Reborn">
{% else %}<meta name="robots" content="noindex">{% endif %}
<link rel="icon" href="{{ asset('art/favicon.svg') }}" type="image/svg+xml">{{ encore_entry_link_tags('app') }}{% if preferences.theme=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}{{ encore_entry_script_tags('app', attributes={defer:true}) }}{% if preferences.reducedMotion %}<style>.reduced-motion *, .reduced-motion *::before, .reduced-motion *::after { scroll-behavior:auto !important; animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }</style>{% endif %}</head>
<body {% if app.user %}data-menu-notifications-membership-value="{{ chrome.membership.id|default(0) }}" data-menu-notifications-latest-notice-value="{{ (chrome.notifications|first).id|default(0) }}" data-menu-notifications-journal-value="{{ (route == 'app_colony' and section == 'overview') ? 'true' : 'false' }}" data-menu-notifications-messages-value="{{ chrome.unreadMessages|default(0) }}" data-menu-notifications-patch-note-value="{{ unreadPatchNote ? 'true' : 'false' }}"{% endif %} {% if chrome.membership %}data-player-activity-url-value="{{ path('app_activity_presence') }}" data-player-activity-token-value="{{ csrf_token('activity-presence') }}" data-player-activity-membership-value="{{ chrome.membership.id }}" data-message-notifications-url-value="{{ path('app_messages_unread') }}"{% endif %} class="{{ app.user?'authenticated':'public-page' }} {{ app.user and preferences.reducedMotion?'reduced-motion':'' }}" data-controller="navigation{% if app.user %} menu-notifications{% endif %}{% if chrome.membership %} message-notifications player-activity{% endif %}" data-theme="{{ preferences.theme }}" data-realtime-notifications="{{ preferences.realtimeNotifications?'true':'false' }}">
<a class="skip" href="#main">Aller au contenu</a>
{% if app.user %}
<aside class="sidebar" id="command-navigation" aria-label="Navigation de l’application" data-navigation-target="sidebar">
<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="" width="35" height="35"></span><span>GENESIS<strong>REBORN</strong></span></a>
<a class="patchnote-shortcut" href="{{ path('app_patchnotes') }}"><span>Patchnotes</span>{% if unreadPatchNote %}<i class="patchnote-unread-dot" aria-label="Patchnote non lue"></i>{% endif %}</a>
<button class="nav-close text-button" data-action="navigation#close" aria-label="Fermer le menu">{{ ui.icon('close') }}</button>
{% if chrome.planet %}<div class="sidebar-colonies" data-live-region="colony-selector"><label for="sidebar-colony">VOS COLONIES <span>{{ chrome.planets|length }}/{{ chrome.colonyLimit }}</span></label><form action="{{ path('app_home') }}" method="get"><input type="hidden" name="section" value="{{ section }}"><div class="sidebar-colony-choice"><span class="tiny-planet" aria-hidden="true"></span><select id="sidebar-colony" name="colony" data-controller="colony-switch" data-action="change->colony-switch#change" aria-label="Choisir une colonie">{% for p in chrome.planets %}<option value="{{ p.id }}" {{ p.id==chrome.planet.id?'selected':'' }}>{{ p.name }} · {{ p.coordinates() }}</option>{% endfor %}</select></div><noscript><button class="secondary full">Choisir cette colonie</button></noscript></form></div>{% endif %}
<nav aria-label="Navigation principale">
<div class="nav-section-label">Commandement</div>
{% if chrome.planet %}<a href="{{ path('app_colony',{id:chrome.planet.id}) }}" data-colony-section="overview" class="{{ route=='app_colony' and section=='overview'?'active':'' }}" {{ route=='app_colony' and section=='overview'?'aria-current="page"':'' }}>{{ ui.icon('overview') }}<span>Vue générale</span></a>{% endif %}
<a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}" {% if route=='app_planets' %}aria-current="page"{% endif %}>{{ ui.icon('galaxy') }}<span>Planètes</span></a>
<div class="nav-section-label">Développement</div>
{% if chrome.planet %}{% for item in [{group:'buildings',label:'Bâtiments',icon:'buildings'},{group:'technologies',label:'Recherche',icon:'research'},{group:'ships',label:'Chantier spatial',icon:'fleet'},{group:'defenses',label:'Défenses',icon:'diplomacy'}] %}<a href="{{ path('app_colony',{id:chrome.planet.id,section:item.group}) }}" data-colony-section="{{ item.group }}" class="{{ route=='app_colony' and section==item.group?'active':'' }}" {{ route=='app_colony' and section==item.group?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}{% endif %}
<div class="nav-section-label">Opérations</div>
{% for item in [{route:'app_fleets',label:'Flottes et missions',icon:'fleet'},{route:'app_map_v2',label:'Galaxie',icon:'galaxy'},{route:'app_boosts',label:'Inventaire',icon:'clock'}] %}<a href="{{ path(item.route) }}" class="{{ (route==item.route or (item.route=='app_map_v2' and route=='app_map'))?'active':'' }}" {{ (route==item.route or (item.route=='app_map_v2' and route=='app_map'))?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span>{% if item.route=='app_messages' %}<span class="message-unread-dot" data-message-notifications-target="badge" role="img" aria-label="Messages non lus" {% if not chrome.unreadMessages|default(0) %}hidden{% endif %}></span>{% endif %}</a>{% endfor %}
<div class="nav-section-label">Communauté</div>
{% for item in [{route:'app_combat_reports',label:'Rapports',icon:'clock'},{route:'app_messages',label:'Messages',icon:'notifications'},{route:'app_diplomacy',label:'Alliances',icon:'diplomacy'},{route:'app_leaderboard',label:'Classements',icon:'research'}] %}<a href="{{ path(item.route) }}" class="{{ (route==item.route or (item.route=='app_map_v2' and route=='app_map'))?'active':'' }}" {{ (route==item.route or (item.route=='app_map_v2' and route=='app_map'))?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span>{% if item.route=='app_messages' %}<span class="message-unread-dot" data-message-notifications-target="badge" role="img" aria-label="Messages non lus" {% if not chrome.unreadMessages|default(0) %}hidden{% endif %}></span>{% endif %}</a>{% endfor %}
<div class="nav-section-label">Compte</div>
<a href="{{ path('app_profile') }}" class="{{ route=='app_profile'?'active':'' }}" {{ route=='app_profile'?'aria-current="page"':'' }}>{{ ui.icon('user') }}<span>Profil</span></a><a href="{{ path('app_technology_tree') }}" class="{{ route=='app_technology_tree'?'active':'' }}" {{ route=='app_technology_tree'?'aria-current="page"':'' }}>{{ ui.icon('research') }}<span>Technologie</span></a>

</nav>
<div class="sidebar-bottom"><div class="connection"><i></i> Liaison établie <span>{{ ui.icon('signal') }}</span></div><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout">{{ ui.icon('logout') }} Déconnexion</button></form><p>GENESIS REBORN <span>STRATÉGIE SPATIALE</span></p></div>
</aside><button class="nav-backdrop" aria-label="Fermer la navigation" data-action="navigation#close" tabindex="-1"></button>
{% endif %}
<div class="app-frame">
<header class="topbar">{% if app.user %}<button class="mobile-menu" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false" aria-label="Ouvrir le menu">{{ ui.icon('menu') }}<span class="menu-unread-dot" data-menu-notifications-target="badge" role="img" aria-label="Notifications à consulter dans le menu" {% if not chrome.unreadMessages|default(0) and not unreadPatchNote %}hidden{% endif %}></span></button><a class="universe-context" href="{{ path('app_universes') }}" aria-label="Ouvrir les univers · {{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}" {% if route=='app_universes' %}aria-current="page"{% endif %}>{{ ui.icon('universe') }}<span>{{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}</span><span class="connection-dot"></span></a><div class="header-tools"><a class="quiet-button feedback-header-link" href="{{ path('app_wiki') }}" aria-label="Consulter le wiki">{{ ui.icon('overview') }}<span>Wiki</span></a><a class="quiet-button feedback-header-link" href="{{ path('app_feedback', {context_url: app.request.uri}) }}" aria-label="Envoyer un feedback">{{ ui.icon('notifications') }}<span>Feedback</span></a>{% if is_granted('ROLE_ADMIN') %}<a class="quiet-button admin-header-link" data-controller="admin-notifications" data-admin-notifications-url-value="{{ path('app_admin_notifications') }}" data-admin-notifications-initial-value="{{ adminNotifications|json_encode|e('html_attr') }}" aria-describedby="admin-header-notifications" aria-label="Admin{{ adminNotifications.total > 0 ? ' ' ~ (adminNotifications.total > 99 ? '99+' : adminNotifications.total) : '' }} : ouvrir la console" href="{{ path('app_admin_index') }}">{{ ui.icon('overview') }}<span>Admin</span> {% include 'ui/admin_notification_badge.html.twig' with {category:'total', count:adminNotifications.total, id:'admin-header-notifications'} only %}</a>{% endif %}<span class="server-clock" {% if preferences.timezone=='Europe/Paris' %}data-controller="server-clock" data-server-clock-timezone-value="{{ preferences.timezone }}"{% endif %}><span data-server-clock-target="time">{{ 'now'|date('H:i:s',preferences.timezone) }}</span><small>HEURE · {{ preferences.timezone }}</small></span><div class="header-account"><a class="settings-link" href="{{ path('app_preferences') }}" aria-label="Paramètres" title="Paramètres" {% if route=='app_preferences' %}aria-current="page"{% endif %}><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12.00 4.00 L13.95 2.19 L15.83 2.76 L16.44 5.35 L17.66 6.34 L20.31 6.44 L21.24 8.17 L19.85 10.44 L20.00 12.00 L21.81 13.95 L21.24 15.83 L18.65 16.44 L17.66 17.66 L17.56 20.31 L15.83 21.24 L13.56 19.85 L12.00 20.00 L10.05 21.81 L8.17 21.24 L7.56 18.65 L6.34 17.66 L3.69 17.56 L2.76 15.83 L4.15 13.56 L4.00 12.00 L2.19 10.05 L2.76 8.17 L5.35 7.56 L6.34 6.34 L6.44 3.69 L8.17 2.76 L10.44 4.15 Z"/><circle cx="12" cy="12" r="3.5"/></svg></a><a class="profile-link" href="{{ path('app_profile') }}" aria-label="Profil de {{ app.user.username }}">{{ ui.icon('user') }}<span>{{ app.user.username }}</span></a></div></div>{% else %}<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="" width="35" height="35"></span><span>GENESIS <strong>REBORN</strong></span></a><span class="public-tagline">UNE COLONIE. UN EMPIRE. VOTRE HISTOIRE.</span><a class="public-login" href="{{ path(route=='app_register'?'app_login':'app_register') }}">{{ route=='app_register'?'Se connecter':'Rejoindre les étoiles' }} {{ ui.icon('arrow') }}</a>{% endif %}</header>
{% if chrome.resources %}<div class="resource-event-stack">{% include 'ui/resource_strip.html.twig' %}</div>{% endif %}
{% if app.user and chrome.events is not empty %}{% include 'ui/event_drawer.html.twig' %}{% endif %}
<main id="main" class="shell {{ route=='app_map_v2'?'shell--galaxy-v2':'' }}">{% if chrome.membership and route != 'app_universes' %}{% include 'universe/_closing.html.twig' with {universe: chrome.membership.universe} %}{% endif %}{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main>
<footer class="footer {{ route=='app_map_v2'?'footer--galaxy-v2':'' }}"><span>GENESIS REBORN</span><span>Explorez. Développez. Écrivez votre histoire.</span>{% include 'legal/_navigation.html.twig' %}</footer>
{% if app.user %}<nav class="mobile-bottom-nav" aria-label="Navigation mobile"><a href="{{ chrome.planet ? path('app_colony',{id:chrome.planet.id}) : path('app_home') }}" class="{{ route=='app_colony' or route=='app_home' ? 'active' : '' }}" {{ route=='app_colony' or route=='app_home' ? 'aria-current="page"' : '' }}>{{ ui.icon('overview') }}<span>Accueil</span></a><a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}">{{ ui.icon('galaxy') }}<span>Planètes</span></a><a href="{{ path('app_map_v2') }}" class="{{ route in ['app_map','app_map_v2'] ? 'active' : '' }}" {{ route in ['app_map','app_map_v2'] ? 'aria-current="page"' : '' }}>{{ ui.icon('galaxy') }}<span>Galaxie</span></a><a href="{{ path('app_fleets') }}" class="{{ route=='app_fleets' ? 'active' : '' }}" {{ route=='app_fleets' ? 'aria-current="page"' : '' }}>{{ ui.icon('fleet') }}<span>Flottes</span></a><button type="button" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false">{{ ui.icon('menu') }}<span class="menu-unread-dot" data-menu-notifications-target="badge" role="img" aria-label="Notifications à consulter dans le menu" {% if not chrome.unreadMessages|default(0) and not unreadPatchNote %}hidden{% endif %}></span><span>Plus</span></button></nav>{% endif %}
</div>
{% if chrome.membership and preferences.realtimeNotifications %}<div class="event-toast" hidden role="status" aria-live="polite" data-controller="events" data-events-url-value="{{ path('app_events') }}" data-events-enabled-value="{{ preferences.realtimeNotifications?'true':'false' }}"><span class="notification-mark">{{ ui.icon('check') }}</span><span data-events-target="message"></span><button class="text-button" data-action="events#refresh">Actualiser</button></div>{% endif %}
</body></html>






