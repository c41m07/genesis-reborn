{% import 'ui/macros.html.twig' as ui %}
{% set chrome = game_shell(app.user, planet|default(null)) %}
{% set route = app.request.attributes.get('_route') %}
{# La consultation de la campagne n'arme ni la présence ni les requêtes de fond du shell. #}
{% set campaignPage = route|default('') starts with 'app_pirate_campaign' %}
{% set campaignAccessible = app.user and chrome.membership and pirate_campaign_available(app.user, chrome.membership) %}
{% set adminNotifications = is_granted('ROLE_ADMIN') ? admin_notifications(app.user) : {total:0,reports:0,security:0,feedbacks:0} %}
{% set metadata = public_metadata(route|default('')) %}
{% set section = section|default('overview') %}
{% set presentationPages = {
'app_combat_simulation':'simulateur','app_fleet_compositions':'compositions','app_fleet_composition_new':'compositions','app_fleet_composition_edit':'compositions','app_fleet_composition_load':'compositions','app_message_search':'recherche-messages','app_home':'accueil-public','app_profile':'profil','app_preferences':'preferences','app_vacation':'vacances','app_account_delete_page':'suppression-compte','app_feedback':'feedback',
'app_planets':'planetes','app_technology_tree':'guide-technologique','app_fleets':'flottes','app_fleet_prepare':'flottes','app_fleet_orbits':'flottes','app_fleet_holds':'flottes','app_market':'bourse','app_map':'galaxie','app_map_v2':'galaxie',
'app_guilds':'guilde','app_guild_hall':'guilde','app_guild_create':'guilde','app_guild_members':'guilde','app_guild_ranks':'guilde','app_guild_management':'guilde','app_personal_relations':'diplomatie','app_guild_profile_edit':'guilde','app_guild_public_profile':'guilde',
'app_boosts':'inventaire','app_inventory_boxes':'inventaire','app_inventory_pending':'inventaire','app_game_challenges':'evenements','app_game_events':'evenements','app_advent':'evenements','app_advent_edition':'evenements','app_advent_credit':'evenements','app_challenge':'defi','app_diplomacy':'diplomatie','app_messages':'messages',
'app_guild_projects_available':'projets','app_guild_projects_history':'projets','app_guild_projects':'projets','app_guild_project':'projet-detail','app_leaderboard':'classements','app_combat_reports':'rapports',
'app_combat_report':'rapport-combat','app_espionage_report':'rapport-espionnage','app_transport_report':'rapport-transport','app_player_report':'signaler-commandant','app_player_public_profile':'profil-commandant',
'app_queue_cancel_preview':'annuler-file','app_fleet_recall':'rappeler-flotte','app_planet_abandon':'abandon-colonie',
'app_wiki':'wiki','app_wiki_chapter':'wiki','app_wiki_search':'wiki','app_wiki_reference':'wiki','app_legal_mentions':'documents-legaux','app_legal_terms':'documents-legaux',
'app_legal_privacy':'documents-legaux','app_legal_cookies':'documents-legaux','app_access_denied':'erreurs'
} %}
{% set presentationPage = campaignPage ? 'campagne-pirate' : (route == 'app_colony' ? (section == 'overview' ? 'vue-generale' : 'catalogues') : presentationPages[route]|default('')) %}
{% set refinedPresentation = presentationPage != '' and presentationPage != 'catalogues' %}
{# Ne pas ouvrir la dotation dans le sélecteur d’univers, le compte ni les formulaires de confirmation. #}
{% set rewardGamePage = not campaignPage and presentationPage not in ['', 'accueil-public', 'profil', 'preferences', 'vacances', 'suppression-compte', 'wiki', 'feedback', 'documents-legaux', 'erreurs', 'annuler-file', 'rappeler-flotte', 'abandon-colonie', 'signaler-commandant'] %}
{% set rewardHeader = daily_reward_header(app.user, chrome.planet, rewardGamePage) %}
{# Les confirmations et certaines pages autonomes du jeu gardent aussi la languette. #}
{% set firstStepsGamePage = (rewardGamePage and route != 'app_map') or route in ['app_first_steps', 'app_first_steps_exercise', 'app_daily_reward', 'app_queue_cancel_preview', 'app_fleet_recall', 'app_fleet_station_resume', 'app_planet_abandon', 'app_player_report'] %}
{% set firstStepsPreview = firstStepsGamePage ? first_steps_preview(app.user, chrome.membership, chrome.planet, route == 'app_first_steps_exercise' and firstStepsExerciseInResponse|default(false)) : null %}
{% set adventPage = route in ['app_advent', 'app_advent_edition', 'app_advent_credit'] %}
{% set fleetDecisionPage = route in ['app_fleet_recall', 'app_fleet_station_resume'] %}
{% set firstStepsInFlow = fleetDecisionPage or adventPage or route in ['app_map_v2', 'app_messages', 'app_leaderboard'] %}
{% set entryPublicPage = not app.user and route in ['app_home','app_login','app_register','app_password_reset_request','app_password_reset','app_email_verify_request','app_email_verify','app_access_denied','app_legal_mentions','app_legal_terms','app_legal_privacy','app_legal_cookies'] %}

{% set unreadPatchNote = app.user and has_unread_patch_note(app.user) %}
{% set preferences = {'timezone':'Europe/Paris','reducedMotion':false,'realtimeNotifications':true,'theme':'dark'}|merge(app.user ? app.user.preferences|default({}) : {}) %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Genesis Reborn{% endblock %}</title>
{% if metadata %}
{% if metadata.indexable is defined and not metadata.indexable %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ metadata.description }}">
<link rel="canonical" href="{{ metadata.url }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ metadata.title }}">
<meta property="og:description" content="{{ metadata.description }}">
<meta property="og:url" content="{{ metadata.url }}">
<meta property="og:image" content="{{ metadata.image }}">
<meta property="og:image:alt" content="Genesis Reborn">
{% else %}<meta name="robots" content="noindex">{% endif %}
<link rel="icon" href="{{ asset('art/favicon.svg') }}" type="image/svg+xml">{{ encore_entry_link_tags('app') }}{% if preferences.theme=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}{{ encore_entry_script_tags('app', attributes={defer:true}) }}{% if preferences.reducedMotion %}<style>.reduced-motion *, .reduced-motion *::before, .reduced-motion *::after { scroll-behavior:auto !important; animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }</style>{% endif %}</head>
{% set giftNotices = chrome.membership ? inventory_gift_notices(chrome.membership) : {count: 0, through: {}} %}
{% set orbitDecisions = chrome.orbitDecisions|default({count:0, colony:null}) %}
{% set fleetMenuUrl = orbitDecisions.count ? path('app_fleet_orbits', {colony:orbitDecisions.colony}) : path('app_fleets') %}
{% set pendingRecruitment = chrome.guildRecruitmentUnread|default(0) %}
{% set recruitmentSingular = chrome.guild|default(null) ? 'candidature de guilde à traiter' : 'invitation de guilde à traiter' %}
{% set recruitmentPlural = chrome.guild|default(null) ? 'candidatures de guilde à traiter' : 'invitations de guilde à traiter' %}
{% set unreadReports = chrome.membership ? report_notice_count(chrome.membership) : 0 %}
<body data-ui-page="{{ presentationPage }}" data-timezone="{{ preferences.timezone }}" {% if app.user %}data-menu-notifications-membership-value="{{ chrome.membership.id|default(0) }}" data-menu-notifications-latest-notice-value="{{ (chrome.notifications|first).id|default(0) }}" data-menu-notifications-journal-value="{{ (route == 'app_colony' and section == 'overview') ? 'true' : 'false' }}" data-menu-notifications-unread-journal-value="{{ chrome.journal.unreadCount|default(0) > 0 ? 'true' : 'false' }}" data-menu-notifications-messages-value="{{ chrome.unreadMessages|default(0) }}" data-menu-notifications-patch-note-value="{{ unreadPatchNote ? 'true' : 'false' }}"{% endif %} {% if chrome.membership and not campaignPage %}data-player-activity-url-value="{{ path('app_activity_presence') }}" data-player-activity-token-value="{{ csrf_token('activity-presence') }}" data-player-activity-membership-value="{{ chrome.membership.id }}" data-message-notifications-url-value="{{ path('app_messages_unread') }}" data-report-badge-url-value="{{ path('app_report_notices') }}" data-report-badge-membership-value="{{ chrome.membership.id }}"{% endif %} class="{{ app.user?'authenticated':'public-page' }} {{ refinedPresentation ? 'ui-refined' : '' }} {{ app.user and preferences.reducedMotion?'reduced-motion':'' }}" data-controller="navigation{% if refinedPresentation %} page-sections{% endif %}{% if app.user %} menu-notifications{% endif %}{% if chrome.membership and not campaignPage %} message-notifications player-activity report-badge{% endif %}" data-theme="{{ preferences.theme }}" data-realtime-notifications="{{ preferences.realtimeNotifications?'true':'false' }}">
<a class="skip" href="#main">Aller au contenu</a>
{% if app.user %}
<aside class="sidebar" id="command-navigation" aria-label="Navigation de l’application" data-navigation-target="sidebar">
<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="" width="35" height="35"></span><span>GENESIS<strong>REBORN</strong></span></a>
<a class="patchnote-shortcut" href="{{ path('app_patchnotes') }}"><span>Patchnotes</span>{% if unreadPatchNote %}<i class="patchnote-unread-dot" aria-label="Patchnote non lue"></i>{% endif %}</a>
<button class="nav-close text-button" data-action="navigation#close" aria-label="Fermer le menu">{{ ui.icon('close') }}</button>
{% include 'ui/colony_selector.html.twig' %}
<nav aria-label="Navigation principale">
<div class="nav-section-label">Commandement</div>
{% if chrome.planet %}<a href="{{ path('app_colony',{id:chrome.planet.id}) }}" data-colony-section="overview" class="{{ route=='app_colony' and section=='overview'?'active':'' }}" {{ route=='app_colony' and section=='overview'?'aria-current="page"':'' }}>{{ ui.icon('overview') }}<span>Vue générale</span></a>{% endif %}
<a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}" {% if route=='app_planets' %}aria-current="page"{% endif %}>{{ ui.icon('planet') }}<span>Planètes</span></a>
<div class="nav-section-label">Développement</div>
{% if chrome.planet %}{% for item in [{group:'buildings',label:'Bâtiments',icon:'buildings'},{group:'technologies',label:'Recherche',icon:'research'},{group:'ships',label:'Chantier spatial',icon:'shipyard'},{group:'defenses',label:'Défenses',icon:'shield'}] %}<a href="{{ path('app_colony',{id:chrome.planet.id,section:item.group}) }}" data-colony-section="{{ item.group }}" class="{{ route=='app_colony' and section==item.group?'active':'' }}" {{ route=='app_colony' and section==item.group?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}{% endif %}
<a href="{{ path('app_technology_tree') }}" class="{{ route=='app_technology_tree'?'active':'' }}" {{ route=='app_technology_tree'?'aria-current="page"':'' }}>{{ ui.icon('tech-tree') }}<span>Guide technologique</span></a>
<div class="nav-section-label">Opérations</div>
{% for item in [{route:'app_fleets',label:'Flottes',icon:'fleet'},{route:'app_map_v2',label:'Galaxie',icon:'galaxy'},{route:'app_market',label:'Bourse',icon:'scales'},{route:'app_combat_simulation',label:'Simulateur de combat',icon:'target'},{route:'app_combat_reports',label:'Rapports',icon:'report'},{route:'app_boosts',label:'Inventaire',icon:'backpack'}] %}<a href="{{ item.route == 'app_fleets' ? fleetMenuUrl : path(item.route) }}"{% if item.route == 'app_fleets' %} data-message-notifications-target="fleetLink" data-missions-url="{{ path('app_fleets') }}" data-orbits-url="{{ path('app_fleet_orbits') }}" aria-label="Flottes" aria-describedby="orbit-menu-description"{% endif %}{% if item.route == 'app_combat_reports' and chrome.membership %} aria-label="Rapports" aria-describedby="report-unread-description"{% elseif item.route == 'app_boosts' and chrome.membership %} aria-describedby="inventory-gift-description"{% endif %} class="{{ (route==item.route or (item.route=='app_map_v2' and route=='app_map') or (item.route=='app_fleets' and route starts with 'app_fleet_') or (item.route=='app_boosts' and route in ['app_inventory_boxes','app_inventory_pending']))?'active':'' }}" {{ (route==item.route or (item.route=='app_map_v2' and route=='app_map') or (item.route=='app_fleets' and route starts with 'app_fleet_') or (item.route=='app_boosts' and route in ['app_inventory_boxes','app_inventory_pending']))?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span>{% if item.route == 'app_fleets' %}
{% include 'ui/orbit_menu_badge.html.twig' %}
<span id="orbit-menu-description" class="visually-hidden" data-message-notifications-target="orbitDescription">{{ orbitDecisions.count ? orbitDecisions.count ~ (orbitDecisions.count == 1 ? ' demande d’orbite à traiter' : ' demandes d’orbite à traiter') : '' }}</span>
{% elseif item.route == 'app_combat_reports' and chrome.membership %}
<span class="badge report-unread-count" data-report-badge-target="count" aria-hidden="true"{% if not unreadReports %} hidden{% endif %}>{{ unreadReports > 99 ? '99+' : unreadReports }}</span>
<span id="report-unread-description" class="visually-hidden" data-report-badge-target="description">{{ unreadReports ? unreadReports ~ (unreadReports == 1 ? ' rapport non lu' : ' rapports non lus') : '' }}</span>
{% elseif item.route == 'app_boosts' and chrome.membership %}
<span class="badge inventory-gift-count" data-message-notifications-target="inventoryGift" aria-hidden="true"{% if not giftNotices.count %} hidden{% endif %}>{{ giftNotices.count > 99 ? '99+' : giftNotices.count }}</span>
<span id="inventory-gift-description" class="visually-hidden" data-message-notifications-target="inventoryGiftDescription">{{ giftNotices.count ? giftNotices.count ~ (giftNotices.count == 1 ? ' nouveau cadeau' : ' nouveaux cadeaux') : '' }}</span>
{% endif %}</a>
{% if item.route == 'app_fleets' and campaignAccessible %}
    <a href="{{ path('app_pirate_campaign') }}" class="nav-campaign-shortcut{{ campaignPage ? ' active' : '' }}"{% if campaignPage %} aria-current="page"{% endif %}>{{ ui.icon('pirate-flag') }}<span>Campagne pirate</span></a>
{% endif %}
{% endfor %}
<div class="nav-section-label">Communauté</div>
{% set guildRoutes = ['app_guilds','app_guild_hall','app_guild_create','app_guild_members','app_guild_ranks','app_guild_management','app_guild_profile_edit','app_guild_public_profile','app_guild_projects','app_guild_project','app_guild_projects_available','app_guild_projects_history'] %}
{% for item in [
    {route:'app_guilds',label:chrome.guild|default(null) ? 'Ma guilde' : 'Guildes',icon:'guild-banner'},
    {route:'app_diplomacy',label:'Diplomatie',icon:'diplomacy'},
    {route:'app_messages',label:'Messages',icon:'envelope'},
    {route:'app_leaderboard',label:'Classements',icon:'podium'},
    {route:'app_game_events',label:'Événements',icon:'calendar'}
] %}
{% set active = route==item.route or (item.route=='app_guilds' and route in guildRoutes) or (item.route=='app_diplomacy' and route=='app_personal_relations') or (item.route=='app_game_events' and route in ['app_game_challenges','app_challenge']) or (item.route=='app_messages' and route=='app_message_search') or (item.route=='app_leaderboard' and route in ['app_player_public_profile','app_player_report']) %}
<a href="{{ path(item.route) }}"{% if active %} class="active" aria-current="page"{% endif %}{% if item.route == 'app_guilds' %} aria-describedby="guild-recruitment-description"{% endif %}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span>{% if item.route=='app_guilds' %}<span class="badge guild-action-count" data-guild-recruitment-count data-message-notifications-target="guildRecruitment" title="{{ recruitmentPlural|capitalize }}" {% if not pendingRecruitment %}hidden{% endif %} aria-hidden="true">{{ pendingRecruitment > 99 ? '99+' : pendingRecruitment }}</span><span id="guild-recruitment-description" class="visually-hidden" data-message-notifications-target="guildRecruitmentDescription" data-singular="{{ recruitmentSingular }}" data-plural="{{ recruitmentPlural }}">{{ pendingRecruitment ? pendingRecruitment ~ ' ' ~ (pendingRecruitment == 1 ? recruitmentSingular : recruitmentPlural) : '' }}</span>{% endif %}{% if item.route=='app_messages' %}<span class="message-unread-dot" data-message-notifications-target="badge" role="img" aria-label="Messages non lus" {% if not chrome.unreadMessages|default(0) %}hidden{% endif %}></span>{% endif %}</a>
{% endfor %}
<div class="nav-section-label">Compte</div>
{% set accountRoutes = ['app_profile','app_preferences','app_vacation','app_account_delete_page'] %}
<a href="{{ path('app_profile') }}" class="{{ route in accountRoutes?'active':'' }}" {{ route in accountRoutes?'aria-current="page"':'' }}>{{ ui.icon('user') }}<span>Mon compte</span></a>

</nav>
<div class="sidebar-bottom"><div class="connection"><i></i> Liaison établie <span>{{ ui.icon('signal') }}</span></div><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout">{{ ui.icon('logout') }} Déconnexion</button></form><p>GENESIS REBORN <span>STRATÉGIE SPATIALE</span></p></div>
</aside><button class="nav-backdrop" aria-label="Fermer la navigation" data-action="navigation#close" tabindex="-1"></button>
{% endif %}
<div class="app-frame">
{% set showTechnologyGoal = app.user and chrome.membership and chrome.planet and chrome.planet.owner and chrome.planet.owner.id == chrome.membership.id %}
{% set showEventDrawer = app.user and chrome.membership and chrome.events is not empty %}
<header class="topbar{{ entryPublicPage ? ' entry-public-header' : '' }}">{% if app.user %}<button class="mobile-menu" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false" aria-label="Ouvrir le menu"{% if chrome.membership %} aria-describedby="report-unread-description guild-recruitment-description inventory-gift-description"{% endif %}>{{ ui.icon('menu') }}<span class="menu-unread-dot" data-menu-notifications-target="badge" role="img" aria-label="Notifications à consulter dans le menu" {% if not chrome.unreadMessages|default(0) and not unreadPatchNote and not chrome.journal.unreadCount|default(0) %}hidden{% endif %}></span>{% if chrome.membership %}{% include 'ui/menu_special_notices.html.twig' with {pendingRecruitment: pendingRecruitment, giftCount: giftNotices.count, unreadReports: unreadReports} only %}{% endif %}</button><a class="universe-context" href="{{ path('app_universes') }}" aria-label="Ouvrir les univers · {{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}" {% if route=='app_universes' %}aria-current="page"{% endif %}>{{ ui.icon('universe') }}<span>{{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}</span><span class="connection-dot"></span></a>
{% if showTechnologyGoal %}
    {% include 'ui/header_technology_goal.html.twig' with {passive: campaignPage} %}
    {% set bonus = active_timed_boost is defined ? active_timed_boost : active_timed_bonus(chrome.membership) %}
    {% if bonus %}
        {% set remaining = bonus.ends_at.timestamp - bonus.server_now.timestamp %}
        {% set duration = constant('App\\Service\\Boost\\TimedBoostEffects::ACTIVE_SECONDS') %}
        <div class="header-timed-boost" title="{{ bonus.description }}" data-controller="countdown"
             data-countdown-end-value="{{ bonus.ends_at|date('c') }}" data-countdown-now-value="{{ bonus.server_now|date('c') }}"
             data-countdown-duration-value="{{ duration }}" data-countdown-hide-on-end-value="true" data-countdown-refresh-value="false">
            <span class="boost-dial" aria-hidden="true" data-countdown-target="dial" style="--remaining: {{ 100 * remaining / duration }}%">{{ ui.icon('electricity') }}</span>
            <strong><span class="visually-hidden">Bonus actif · </span>{{ bonus.short_effect }}</strong>
            <span class="boost-time" role="timer" aria-live="off">{{ ui.icon('clock') }}<span class="visually-hidden">Temps restant · </span><span data-countdown-target="time">{{ duration_label(remaining) }}</span></span>
            <noscript>Fin à {{ bonus.ends_at|date('H:i', preferences.timezone) }}</noscript>
        </div>
    {% endif %}
{% endif %}
{% if chrome.adventUntil|default(null) %}
<div class="event-drawer-wrap topbar-season">
    {% if showEventDrawer %}{% include 'ui/event_drawer.html.twig' %}{% endif %}
    <a class="advent-shortcut" data-controller="advent-shortcut"
       data-advent-shortcut-end-value="{{ chrome.adventUntil|date('c') }}" data-advent-shortcut-server-value="{{ chrome.serverNow }}"
       {% if route in ['app_advent', 'app_advent_edition'] %}data-advent-shortcut-return-value="{{ path('app_game_events') }}"{% endif %}
       data-action="pageshow@window->advent-shortcut#refresh visibilitychange@document->advent-shortcut#refresh" href="{{ path('app_advent') }}" aria-label="Calendrier de l’Avent"{% if route in ['app_advent', 'app_advent_edition'] %} aria-current="page"{% endif %}>
        <span aria-hidden="true">🎁</span><span><span class="advent-shortcut-long">Calendrier de l’</span>Avent</span>
    </a>
</div>
{% elseif showEventDrawer %}{% include 'ui/event_drawer.html.twig' %}{% endif %}
<div class="header-tools has-daily-reward-shortcuts" data-controller="daily-reward-ui"
    data-daily-reward-ui-auto-open-value="{{ rewardHeader.autoOpen ? 'true' : 'false' }}"
    {% if rewardHeader.available %}data-daily-reward-ui-panel-url-value="{{ path('app_daily_reward_panel', {colony: chrome.planet.id}) }}"{% endif %}
    data-action="genesis:message-count@window->daily-reward-ui#updateMail keydown.esc@window->daily-reward-ui#dismissTooltip pointerout->daily-reward-ui#resetTooltip focusout->daily-reward-ui#resetTooltip">
    {% include 'ui/_daily_reward_header.html.twig' with {chrome: chrome, route: route, adminNotifications: adminNotifications, rewardAvailable: rewardHeader.available} only %}
    <div data-daily-reward-ui-target="mount" class="daily-reward-mount"></div>
<span class="server-clock" {% if preferences.timezone=='Europe/Paris' %}data-controller="server-clock" data-server-clock-timezone-value="{{ preferences.timezone }}"{% endif %}><span data-server-clock-target="time">{{ 'now'|date('H:i:s',preferences.timezone) }}</span><small>HEURE · {{ preferences.timezone }}</small></span><div class="header-account"><a class="settings-link" href="{{ path('app_preferences') }}" aria-label="Paramètres" title="Paramètres" {% if route=='app_preferences' %}aria-current="page"{% endif %}><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M12.00 4.00 L13.95 2.19 L15.83 2.76 L16.44 5.35 L17.66 6.34 L20.31 6.44 L21.24 8.17 L19.85 10.44 L20.00 12.00 L21.81 13.95 L21.24 15.83 L18.65 16.44 L17.66 17.66 L17.56 20.31 L15.83 21.24 L13.56 19.85 L12.00 20.00 L10.05 21.81 L8.17 21.24 L7.56 18.65 L6.34 17.66 L3.69 17.56 L2.76 15.83 L4.15 13.56 L4.00 12.00 L2.19 10.05 L2.76 8.17 L5.35 7.56 L6.34 6.34 L6.44 3.69 L8.17 2.76 L10.44 4.15 Z"/><circle cx="12" cy="12" r="3.5"/></svg></a><a class="profile-link" href="{{ path('app_profile') }}" aria-label="Profil de {{ app.user.username }}">{{ ui.icon('user') }}<span>{{ app.user.username }}</span></a></div></div>{% else %}<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="{{ entryPublicPage ? 'Genesis Reborn' : '' }}" width="35" height="35"></span><span{% if entryPublicPage %} aria-hidden="true"{% endif %}>GENESIS <strong>REBORN</strong></span></a><span class="public-tagline">UNE COLONIE. UN EMPIRE. VOTRE HISTOIRE.</span>{% if entryPublicPage %}{% include 'ui/public_entry_navigation.html.twig' %}{% else %}<a class="public-login" href="{{ path(route=='app_register'?'app_login':'app_register') }}">{{ route=='app_register'?'Se connecter':'Rejoindre les étoiles' }} {{ ui.icon('arrow') }}</a>{% endif %}{% endif %}</header>
{% if chrome.resources %}
<div class="resource-event-stack" data-controller="resource-stack">
    {% include 'ui/resource_strip.html.twig' with {passive: campaignPage} %}
</div>
{% endif %}
<main id="main" class="shell {{ route=='app_map_v2'?'shell--galaxy-v2':(route=='app_messages'?'shell--messaging':(adventPage?'shell--advent':(fleetDecisionPage?'shell--fleet-decision':''))) }}">{% if chrome.membership and route != 'app_universes' %}{% include 'universe/_closing.html.twig' with {universe: chrome.membership.universe, passive: campaignPage} %}{% endif %}{% block flash_messages %}{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% endblock %}{% block incoming_fleets %}{% if chrome.membership %}{% include 'ui/incoming_attacks.html.twig' with {incoming_panel:false} %}{% endif %}{% endblock %}
    {# Galaxie v2 partage sa page avec les vues locales : seule la carte d’ensemble masque l’aide. #}
    {% if firstStepsPreview and firstStepsInFlow and not fleetDecisionPage %}
        {% if route == 'app_map_v2' %}
            {% include 'player/_first_steps_popup.html.twig' with {planet: chrome.planet, preview: firstStepsPreview, localMap: true} only %}
        {% else %}
            {% include 'player/_first_steps_popup.html.twig' with {planet: chrome.planet, preview: firstStepsPreview} only %}
        {% endif %}
    {% endif %}
    {% block body %}{% endblock %}
