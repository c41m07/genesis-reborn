<section id="inventory-boosts" class="inventory-bonuses" aria-labelledby="available-bonuses-title">
    <h2 id="available-bonuses-title" class="visually-hidden">Bonus disponibles</h2>
    <div class="inventory-boost-layout">
        <div class="inventory-board-stock">
        {% include 'boosts/_capacity.html.twig' %}
        <article class="panel mission-card inventory-boost-stock">
            {% if boost_count == 0 %}
                <div class="empty-state"><h3>Aucun bonus disponible</h3><p>Les récompenses de vos missions, événements et projets de guilde apparaîtront ici.</p></div>
            {% else %}
                <div><h3>Boost de réduction de durée</h3><p>Réduit de {{ duration_reduction_percent|number_format(2, ',', ' ') }} % le temps restant d’une commande active de construction, de recherche ou de production.</p></div>
                <span class="badge">Quantité : {{ boost_count }}</span>
            {% endif %}
        </article>
        <article class="panel inventory-board-shortcut">
            <h3>Boîtes de ressources</h3>
            <p>Vérifiez le contenu puis choisissez la colonie qui le recevra.</p>
            <a class="secondary" href="{{ path('app_inventory_boxes') }}">Voir mes boîtes</a>
        </article>
        <article class="panel inventory-board-shortcut">
            <h3>Récompenses en attente</h3>
            <p>Les récompenses conservées rejoignent l’inventaire quand une place se libère.</p>
            <a class="secondary" href="{{ path('app_inventory_pending') }}">Voir les récompenses</a>
        </article>
</div>
<section class="panel inventory-boost-use" aria-labelledby="boost-use-title">
    <h2 id="boost-use-title">Aperçu avant utilisation</h2>
    {% if vacation %}<p role="status">Les accélérations sont indisponibles pendant les vacances.</p>
    {% elseif boost_count == 0 %}<p>Aucun boost de réduction de durée disponible pour accélérer une opération.</p>
    {% else %}
        <p>Chaque utilisation consomme un bonus. Les missions de flotte ne sont pas accélérables depuis l’inventaire.</p>
        {% if active_queues is not empty %}
        {# Le sélecteur est activé par la revue JavaScript ; sinon tous les formulaires restent accessibles. #}
        <div data-inventory-review-target="picker" hidden>
            <label for="inventory-operation">Opération à accélérer</label>
            <select id="inventory-operation" data-inventory-review-target="selection" data-action="change->inventory-review#choose">
                <option value="">Choisir une opération active</option>
                <optgroup label="Commandes">{% for row in active_queues %}<option value="queue-{{ row.item.id }}">{{ row.label }} · {{ row.item.planet.name }}</option>{% endfor %}</optgroup>
            </select>
        </div>
        {% endif %}
        {% for row in active_queues %}
            {% set item = row.item %}
            <article class="boost-operation" data-inventory-review-target="operation" data-operation="queue-{{ item.id }}">
                <h3>{{ row.label }} · {{ item.planet.name }}</h3>
                <p>{% if item.itemLevel %}Niveau {{ item.itemLevel }}{% else %}Quantité : {{ item.quantity|quantity }}{% endif %} · Fin prévue : <time datetime="{{ item.finishAt|date('c') }}">{{ item.finishAt|date('d/m/Y H:i:s', preferences.timezone) }}</time></p>
                <dl class="inventory-preview-times">
                    <div><dt>Avant</dt><dd>{{ duration_label(row.seconds_before) }}</dd></div>
                    <div><dt>Après</dt><dd>{{ duration_label(row.seconds_after) }}</dd></div>
                </dl>
                <p class="muted">Estimation à l’ouverture de la page ; la durée est recalculée à la confirmation.</p>
                <form method="post" action="{{ path('app_boost_use', {type:'queue', id:item.id}) }}" data-action="submit->inventory-review#review" data-review-title="Vérifier l’accélération" data-review-copy="{{ row.label }} · {{ item.planet.name }} : utiliser un boost pour retirer {{ duration_reduction_percent|number_format(2, ',', ' ') }} % du temps restant." data-review-confirm="Utiliser un boost">
                    <input type="hidden" name="_token" value="{{ csrf_token('boost-queue-' ~ item.id) }}">
                    <input type="hidden" name="request_key" value="{{ request_key() }}">
                    <p id="boost-effect-{{ item.id }}">1 boost sur {{ boost_count }} disponible{{ boost_count > 1 ? 's' : '' }} : réduit le temps restant de {{ duration_reduction_percent|number_format(2, ',', ' ') }} %.</p>
                    <button class="primary" aria-describedby="boost-effect-{{ item.id }}">Utiliser un boost pour {{ row.label }}</button>
                </form>
            </article>
        {% endfor %}
        {% if active_queues is empty %}<p>Aucune commande active à accélérer. Les commandes en attente ne sont pas éligibles.</p><div class="empty-next-actions">{% if chrome.planet %}<a class="secondary" href="{{ path('app_colony',{id:chrome.planet.id,section:'buildings'}) }}">Choisir une construction</a>{% endif %}</div>{% endif %}
    {% endif %}
</section>
    </div>
</section>
