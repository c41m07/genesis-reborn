{% import 'ui/macros.html.twig' as ui %}
<section class="panel dashboard-journal" data-live-region="journal" data-controller="absence-journal"
         data-absence-journal-membership-value="{{ membership.id }}" aria-labelledby="dashboard-journal-title">
    <div class="dashboard-section-heading">
        <div>
            <h2 id="dashboard-journal-title">Journal de bord</h2>
            <p>Les derniers événements d’absence. Le journal est marqué comme consulté lorsque ces événements deviennent visibles.</p>
        </div>
        <span aria-hidden="true">{{ ui.icon('clock') }}</span>
    </div>
    {% if journal_page.notifications is not empty %}
        <ol class="dashboard-notifications">
            {% for notification in journal_page.notifications %}
                <li data-journal-notice="{{ notification.id }}"{% if loop.first %} data-absence-journal-target="entry"{% endif %}>
                    <span class="journal-mark" aria-hidden="true">{{ ui.icon('notifications') }}</span>
                    <span><strong>{{ notification.message }}</strong><small>{{ notification.createdAt|date('d/m/Y · H:i',preferences.timezone) }}</small></span>
                </li>
            {% endfor %}
        </ol>
        {% if journal_page.availableCount > journal_page.notifications|length %}
            <p>{{ journal_page.notifications|length }} des {{ journal_page.availableCount }} événements de cette visite sont affichés.</p>
        {% endif %}
        <form method="post" action="{{ path('app_journal_consult',{id:planet.id}) }}" data-absence-journal-target="form">
            <input type="hidden" name="_token" value="{{ csrf_token('journal-'~membership.id) }}">
            <input type="hidden" name="membership" value="{{ membership.id }}">
            <input type="hidden" name="journal_ticket" value="{{ journal_page.ticket }}">
            <button class="secondary">Marquer le journal comme consulté</button>
        </form>
        <p role="status" data-absence-journal-target="status"></p>
    {% else %}
        <p class="dashboard-empty">Aucun événement d’absence à consulter. Le suivi commence à votre première ouverture de la vue générale ; les nouvelles activités seront proposées lors d’une prochaine ouverture.</p>
    {% endif %}
    <a class="dashboard-journal-link" href="{{ path('app_combat_reports') }}">Ouvrir les rapports <span aria-hidden="true">→</span></a>
</section>
