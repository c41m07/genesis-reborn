{% set fullResources = resources|filter(resource => resource.stock >= resource.capacity) %}
{% set reducedResources = resources|filter(resource => resource.productivity is not null and resource.productivity < 100) %}
{# La région reste présente à vide pour faire apparaître ou retirer l’alerte sans rechargement. #}
<div data-live-region="overview-attention">
    {% if not chrome.vacation and (fullResources or reducedResources) %}
        <section class="overview-attention panel" aria-labelledby="attention-title">
            <h3 id="attention-title">Stocks et production · {{ planet.name }}</h3>
            {% if fullResources %}
                <p>Stockages pleins : {% for slug,resource in fullResources %}<a href="{{ path('app_colony',{id:planet.id,section:'buildings',_fragment:'item-storage_'~slug~'-basic'}) }}">{{ resource.label }}</a>{{ not loop.last ? ', ' : '.' }}{% endfor %} Les apports supplémentaires ne sont plus stockés.</p>
            {% endif %}
            {% if reducedResources %}
                <p>Production industrielle réduite : {% for resource in reducedResources %}{{ resource.label }} ({{ resource.productivity|quantity(0) }} %){{ not loop.last ? ', ' : '.' }}{% endfor %} <a href="#resource-details">Consulter les détails des ressources</a></p>
            {% endif %}
        </section>
    {% endif %}
</div>
