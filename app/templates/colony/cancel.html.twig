{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Vérifier l’annulation · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Vérifier l’annulation</h1><p>{{ planet.name }} · {{ planet.coordinates() }}</p></div></div>
<section class="panel sensitive-actions project-confirmation" aria-labelledby="queue-cancel-title">
<h2 id="queue-cancel-title">{{ ui.icon('building') }} Commandes concernées</h2>
<p><strong>{{ rows|length }} {{ rows|length == 1 ? 'commande concernée' : 'commandes concernées' }}</strong> : la commande sélectionnée et ses niveaux dépendants.</p>
<p>Estimation : 25 % des ressources payées, dans la place disponible sur chaque colonie. L’état sera revérifié à la confirmation.</p>
{# Additionne les estimations déjà préparées pour l’affichage ; la confirmation reste recalculée côté serveur. #}
{% set estimatedRefunds = {} %}
{% for row in rows %}
    {% for slug, amount in row.refund|filter(amount => amount > 0) %}
        {% set estimatedRefunds = estimatedRefunds|merge({(slug): (estimatedRefunds[slug]|default(0)) + amount}) %}
    {% endfor %}
{% endfor %}
<h3>Remboursement estimé</h3>
{% if estimatedRefunds %}
    <dl class="confirmation-refunds">
        {% for slug, amount in estimatedRefunds %}
            <div><dt>{{ resource_labels[slug] }}</dt><dd>{{ amount|quantity(2) }}</dd></div>
        {% endfor %}
    </dl>
{% else %}
    <p>Aucun remboursement estimé.</p>
{% endif %}
<details>
<summary>Détail des commandes</summary>
<ul>{% for row in rows %}<li><strong>{{ row.label }}</strong> · {{ row.item.planet.name }} · {{ row.item.itemLevel ? 'Niveau '~row.item.itemLevel : 'Quantité '~row.item.quantity }}{% if row.item.id != item.id %} · Dépendance annulée{% endif %}<ul>{% for slug,amount in row.refund|filter(amount => amount > 0) %}<li>{{ resource_labels[slug] }} : {{ amount|quantity(2) }} remboursés</li>{% else %}<li>Aucun remboursement.</li>{% endfor %}</ul></li>{% endfor %}</ul>
</details>
<p class="confirmation-risk"><strong>Les travaux concernés seront arrêtés.</strong> Vérifiez les commandes et leur colonie avant de confirmer.</p>
<div class="confirmation-buttons">
    <a class="secondary" href="{{ path('app_colony',{id:planet.id,section:section}) }}">Conserver les commandes</a>
    <form method="post" action="{{ path('app_queue_cancel',{id:planet.id,itemId:item.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('cancel'~item.id) }}">
        <input type="hidden" name="request_key" value="{{ request_key() }}">
        <input type="hidden" name="section" value="{{ section }}">
        <button class="danger" type="submit">Confirmer l’annulation de ces {{ rows|length }} commandes</button>
    </form>
</div>
</section>
{% endblock %}
