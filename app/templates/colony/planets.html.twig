{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Planètes · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Planètes</h1><p>Chaque monde, une nouvelle ambition. Gérez vos colonies et leurs opérations.</p></div>{% if chrome.planet %}<a class="quiet-button" href="{{ path('app_colony',{id:chrome.planet.id}) }}">{{ ui.icon('overview') }} Vue générale {{ ui.icon('arrow') }}</a>{% endif %}</div>
<div class="planet-index-grid">{% for world in planets %}<article id="planet-{{ world.id }}" aria-labelledby="planet-title-{{ world.id }}" class="panel planet-index-card {{ chrome.planet and world.id==chrome.planet.id?'is-current':'' }}"><div class="planet-index-art"><img src="{{ asset('art/planet-desert.png') }}" alt="" aria-hidden="true"><span>{{ world.coordinates() }}</span></div><div class="planet-index-body"><div class="planet-index-title"><div><h2 id="planet-title-{{ world.id }}">{{ world.name }}</h2><p>{{ world.coordinates() }}</p></div>{% if chrome.planet and world.id==chrome.planet.id %}<span class="badge">Planète sélectionnée</span>{% endif %}</div><details class="planet-rename"><summary aria-label="Renommer cette planète : {{ world.name }}">Renommer cette planète</summary><form method="post" action="{{ path('app_planet_rename',{id:world.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('rename-planet-'~world.id) }}"><label for="planet-name-{{ world.id }}">Nouveau nom</label><input id="planet-name-{{ world.id }}" name="name" type="text" maxlength="80" value="{{ world.name }}" required><button class="secondary" aria-label="Enregistrer le nom de {{ world.name }}">Enregistrer</button></form></details><dl><div><dt>Position orbitale</dt><dd>{{ '%02d'|format(world.position) }} / 09</dd></div><div><dt>Planète</dt><dd>{{ world.owner and world.owner.id==membership.id?'Colonie de votre empire':(world.npcPlanet?'Monde PNJ':'Planète colonisée') }}</dd></div><div><dt>Secteur</dt><dd>{{ world.solarSystem.galaxy.name }} · {{ world.solarSystem.name }}</dd></div></dl>
<p class="muted">{% if world.acquiredAt %}Acquise le {{ world.acquiredAt|date('d/m/Y · H:i',preferences.timezone) }}{% else %}Ancienneté approximative · ordre historique{% endif %}</p>
{% include 'ui/empire_details.html.twig' with {detail:planet_details[world.id],detail_label:'Vaisseaux et ressources de '~world.name} only %}
<details class="planet-production">
<summary>Bonus et malus de production</summary>
<p>Effets de la position orbitale {{ world.position }} sur la production de cette colonie.</p>
<dl>{% for modifier in position_modifiers[world.id] %}
<div><dt>{{ modifier.label }}</dt><dd>{% if modifier.percent > 0 %}Bonus +{{ modifier.percent|number_format(0, ',', ' ') }} %{% elseif modifier.percent < 0 %}Malus {{ modifier.percent|number_format(0, ',', ' ') }} %{% else %}Neutre (0 %){% endif %}</dd></div>
{% endfor %}</dl>
</details>
<a class="primary full" href="{{ path('app_colony',{id:world.id}) }}">{{ chrome.planet and world.id==chrome.planet.id?'Gérer cette planète':'Sélectionner cette planète' }} {{ ui.icon('arrow') }}</a><div class="planet-index-shortcuts"><a href="{{ path('app_colony',{id:world.id,section:'buildings'}) }}">{{ ui.icon('buildings') }} Bâtiments</a><a href="{{ path('app_colony',{id:world.id,section:'ships'}) }}">{{ ui.icon('fleet') }} Chantier</a><a href="{{ path('app_fleets',{origin:world.id}) }}">{{ ui.icon('fleet') }} Flotte</a></div></div></article>{% else %}<div class="panel empty-state"><h2>Aucune colonie dans cet univers</h2><p>Explorez la galaxie et envoyez un vaisseau colonie vers un monde libre pour commencer.</p><a class="primary" href="{{ path('app_map') }}">Explorer la galaxie</a></div>{% endfor %}</div>
{% endblock %}
