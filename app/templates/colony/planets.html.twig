{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Planètes · Genesis Reborn{% endblock %}
{% block body %}
<div class="colony-redesign" data-page-sections="disabled">
    <div class="page-heading">
        <div><h1>Planètes</h1><p>Chaque monde, une nouvelle ambition. Gérez vos colonies et leurs opérations.</p></div>
        {% if chrome.planet %}<a class="quiet-button" href="{{ path('app_colony',{id:chrome.planet.id}) }}">{{ ui.icon('overview') }} Vue générale {{ ui.icon('arrow') }}</a>{% endif %}
    </div>
    <nav class="ui-tabs" aria-label="Présentation des colonies">
        <a href="{{ path('app_planets') }}" {% if not table_view %}class="active" aria-current="page"{% endif %}>Cartes</a>
        <a href="{{ path('app_planets',{view:'table'}) }}" {% if table_view %}class="active" aria-current="page"{% endif %}>Comparer les colonies</a>
    </nav>
    {% if table_view %}
        <form class="colony-resource-picker" method="get" action="{{ path('app_planets') }}" data-controller="colony-comparison">
            <input type="hidden" name="view" value="table">
            <label for="comparison-resource">Ressource à comparer</label>
            <select id="comparison-resource" name="resource" data-action="change->colony-comparison#select">
                {% for slug,label in {metal:'Métal',nano:'Nano',hydrogen:'Hydrogène',antimatter:'Antimatière',electricity:'Électricité'} %}
                    <option value="{{ slug }}" {{ comparison_resource==slug ? 'selected' : '' }}>{{ label }}</option>
                {% endfor %}
            </select>
            <button class="secondary">Comparer cette ressource</button>
        </form>
        {% if comparison_activities.research and comparison_activities.researchOrigin is null %}
            <section class="colony-comparison-common-research" aria-label="File de recherche commune">
                <p>Recherche commune à cet empire · Colonie d’origine indisponible</p>
                {% include 'colony/_comparison_activity.html.twig' with {activity: comparison_activities.research, timezone: preferences.timezone} only %}
            </section>
        {% endif %}
        <div class="panel colony-comparison-panel">
            <div class="table-scroll" role="region" tabindex="0" aria-label="Comparaison des colonies, défilement horizontal">
            <table class="data-table colony-comparison">
                <caption>Stocks / capacités, soldes nets par heure et files de votre empire</caption>
                <thead><tr>
                    <th scope="col">Colonie</th>
                    {% for slug in ['metal','nano','hydrogen','antimatter','electricity'] %}
                        {% set resource=(planet_details|first).resources[slug]|default(null) %}
                        {% if resource %}<th scope="col" data-resource="{{ slug }}" class="{{ comparison_resource==slug ? 'is-selected-resource' : '' }}">{{ resource.label }}</th>{% endif %}
                    {% endfor %}
                    <th scope="col" data-comparison-queue="building">Bâtiments</th>
                    <th scope="col" data-comparison-queue="research">Recherche</th>
                    <th scope="col" data-comparison-queue="shipyard">Chantier spatial</th>
                </tr></thead>
                <tbody>
                    {% for world in planets %}
                        <tr>
                            <th scope="row"><a href="{{ path('app_colony',{id:world.id}) }}">{{ world.name }}</a><span class="colony-comparison-coordinates">{{ world.coordinates() }}</span></th>
                            {% for slug in ['metal','nano','hydrogen','antimatter','electricity'] %}
                                {% set resource=planet_details[world.id].resources[slug] %}
                                <td data-resource="{{ slug }}" class="{{ comparison_resource==slug ? 'is-selected-resource' : '' }}">
                                    <strong>{{ resource.stock|quantity(0) }} / {{ resource.capacity|quantity(0) }}</strong>
                                    <span class="colony-comparison-rate">{{ (resource.rate*3600)|quantity(2) }} / h</span>
                                    {% if resource.stock>resource.capacity %}<span class="storage-warning">Stock supérieur à la capacité</span>{% endif %}
                                </td>
                            {% endfor %}
                            <td data-comparison-queue="building">
                                {% include 'colony/_comparison_activity.html.twig' with {activity: comparison_activities.local[world.id].building|default(null), timezone: preferences.timezone} only %}
                            </td>
                            <td data-comparison-queue="research">
                                {% if comparison_activities.research and comparison_activities.researchOrigin == world.id %}
                                    <small>File commune · départ de cette colonie</small>
                                    {% include 'colony/_comparison_activity.html.twig' with {activity: comparison_activities.research, timezone: preferences.timezone} only %}
                                {% else %}
                                    <span class="muted">{{ comparison_activities.research ? 'Commune à cet empire' : 'Aucune recherche en file' }}</span>
                                {% endif %}
                            </td>
                            <td data-comparison-queue="shipyard">
                                {% include 'colony/_comparison_activity.html.twig' with {activity: comparison_activities.local[world.id].shipyard|default(null), timezone: preferences.timezone} only %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4">Aucune colonie à comparer. <a href="{{ path('app_map_v2') }}">Explorer la galaxie</a></td></tr>
                    {% endfor %}
                </tbody>
            </table>
            </div>
        </div>
    {% else %}
        <div class="planet-index-grid">
            {% for world in planets %}
                {% set detail_id='planet-details-'~world.id %}
                {% set detail_label='Vaisseaux et ressources de '~world.name %}
                <article data-controller="hover-details" data-action="focusout->hover-details#blur keydown->hover-details#escape" id="planet-{{ world.id }}" aria-labelledby="planet-title-{{ world.id }}" class="panel planet-index-card {{ chrome.planet and world.id==chrome.planet.id?'is-current':'' }}">
                    <div class="planet-index-art"><picture><source type="image/webp" srcset="{{ asset('art/planet-desert.webp') }}"><img src="{{ asset('art/planet-desert.png') }}" alt="" aria-hidden="true"></picture></div>
                    <div class="planet-index-body">
                        <div class="planet-index-title">
                            <div>
                                <h2 id="planet-title-{{ world.id }}" aria-label="{{ world.name }}">{% include 'ui/empire_details_trigger.html.twig' with {detail_name:world.name} %}</h2>
                                <p>{{ world.coordinates() }}</p>
                            </div>
                            {% if chrome.planet and world.id==chrome.planet.id %}<span class="badge">Planète sélectionnée</span>{% endif %}
                        </div>
                        <dl>
                            <div><dt>Position orbitale</dt><dd>{{ '%02d'|format(world.position) }} / 09</dd></div>
                            <div><dt>Planète</dt><dd>{{ world.owner and world.owner.id==membership.id?'Colonie de votre empire':(world.npcPlanet?'Monde PNJ':'Planète colonisée') }}</dd></div>
                            <div><dt>Secteur</dt><dd>{{ world.solarSystem.galaxy.name }} · {{ world.solarSystem.name }}</dd></div>
                        </dl>
                        <p class="muted">{% if world.acquiredAt %}Acquise le {{ world.acquiredAt|date('d/m/Y · H:i',preferences.timezone) }}{% else %}Ancienneté approximative · ordre historique{% endif %}</p>
                        {% include 'ui/empire_details.html.twig' with {detail:planet_details[world.id],detail_label:detail_label,detail_id:detail_id} only %}
                        <details class="planet-rename">
                            <summary aria-label="Renommer cette planète : {{ world.name }}">Renommer cette planète</summary>
                            <form method="post" action="{{ path('app_planet_rename',{id:world.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('rename-planet-'~world.id) }}">
                                <label for="planet-name-{{ world.id }}">Nouveau nom</label>
                                <input id="planet-name-{{ world.id }}" name="name" type="text" maxlength="80" value="{{ world.name }}" required>
                                <button class="secondary" aria-label="Enregistrer le nom de {{ world.name }}">Enregistrer</button>
                            </form>
                        </details>
                        <details class="planet-production">
                            <summary>Bonus et malus de production</summary>
                            <p>Effets de la position orbitale {{ world.position }} sur la production de cette colonie.</p>
                            <dl>{% for modifier in position_modifiers[world.id] %}
                                <div><dt>{{ modifier.label }}</dt><dd>{% if modifier.percent > 0 %}Bonus +{{ modifier.percent|number_format(0, ',', ' ') }} %{% elseif modifier.percent < 0 %}Malus {{ modifier.percent|number_format(0, ',', ' ') }} %{% else %}Neutre (0 %){% endif %}</dd></div>
                            {% endfor %}</dl>
                        </details>
                    </div>
                    <div class="planet-index-actions">
                        <a class="primary full" href="{{ path('app_colony',{id:world.id}) }}">{{ chrome.planet and world.id==chrome.planet.id?'Gérer cette planète':'Sélectionner cette planète' }} {{ ui.icon('arrow') }}</a>
                        <div class="planet-index-shortcuts">
                            <a href="{{ path('app_colony',{id:world.id,section:'buildings'}) }}">{{ ui.icon('buildings') }} Bâtiments</a>
                            <a href="{{ path('app_colony',{id:world.id,section:'ships'}) }}">{{ ui.icon('fleet') }} Chantier</a>
                            <a href="{{ path('app_fleets',{origin:world.id}) }}">{{ ui.icon('fleet') }} Flotte</a>
                        </div>
                        <a class="planet-abandon-link" href="{{ path('app_planet_abandon',{id:world.id}) }}" aria-label="Préparer l’abandon de {{ world.name }}">Préparer l’abandon</a>
                    </div>
                </article>
            {% else %}
                <div class="panel empty-state"><h2>Aucune colonie dans cet univers</h2><p>Explorez la galaxie et envoyez un vaisseau colonie vers un monde libre pour commencer.</p><a class="primary" href="{{ path('app_map_v2') }}">Explorer la galaxie</a></div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
