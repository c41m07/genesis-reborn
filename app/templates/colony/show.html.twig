{% extends 'base.html.twig' %}{% import 'ui/macros.html.twig' as ui %}{% import 'ui/ranking_change.html.twig' as evolution %}{% block title %}{{ planet.name }} · Genesis Reborn{% endblock %}
{% block body %}<div data-controller="colony-live" data-colony-live-url-value="{{ path('app_colony',{id:planet.id}) }}">
<div class="page-heading"><div><h1>{{ {overview:'Vue générale',buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[section] }}<span>.</span></h1></div><a class="quiet-button" href="{{ path('app_map_v2') }}">{{ ui.icon('galaxy') }} Explorer la galaxie {{ ui.icon('arrow') }}</a></div>
<div class="colony-layout colony-layout--integrated"><div class="colony-content">
{% if section=='overview' %}
<section class="colony-banner panel empire-banner"><img class="colony-scene" src="{{ asset('art/colony-overview.png') }}" alt="" aria-hidden="true"><div class="hero-content"><span class="badge"><i class="connection-dot"></i> COLONIE OPÉRATIONNELLE</span><h2>{{ planet.name }}</h2><p>{{ ui.icon('galaxy') }} {{ planet.coordinates() }}</p>
<dl class="empire-points" aria-label="Points de votre empire dans cet univers">
{% for key,label in {building_points:'Planètes',research_points:'Recherche',fleet_points:'Flotte',total_points:'Total'} %}
<div><dt>{{ label }}</dt><dd>{{ empire_points[key]|quantity(0) }} <small>pts</small>{% if key=="total_points" %}<small class="ranking-relation">Points : {{ evolution.value(ranking_changes is defined ? ranking_changes.score_changes.points : null, "Points") }}</small>{% endif %}</dd></div>
{% endfor %}
</dl>

</div>{% if section!='overview' %}{% include 'ui/colony_queues.html.twig' %}{% endif %}<span class="hero-sector">SECTEUR {{ planet.coordinates() }}</span></section><section class="dashboard-metrics" aria-label="Résumé de votre empire">
{% include 'ui/colony_summaries.html.twig' %}
<a class="metric-card" href="{{ path('app_leaderboard') }}"><span class="metric-symbol">{{ ui.icon('universe') }}</span><span><small>Classement</small><strong>{{ empire_rank ? '#'~empire_rank : '—' }}</strong><span class="metric-caption">Places : {{ evolution.value(ranking_changes is defined ? ranking_changes.rank_changes.points : null, "Places") }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_fleets') }}"><span class="metric-symbol">{{ ui.icon('fleet') }}</span><span><small>Flottes en vol</small><strong>{{ active_fleets|length }}</strong><span class="metric-caption">toutes colonies confondues</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_diplomacy') }}"><span class="metric-symbol">{{ ui.icon('diplomacy') }}</span><span><small>Guilde</small><strong>{{ empire_guild ? empire_guild.name : (guilds_enabled ? 'Sans guilde' : 'Désactivée') }}</strong><span class="metric-caption">{{ empire_guild ? 'Gérer les relations' : (guilds_enabled ? 'Découvrir la diplomatie' : 'Dans cet univers') }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
</section>

{% if section=='overview' %}

<div class="dashboard-layout">
<div class="dashboard-primary">
{% set fullResources=resources|filter(resource => resource.stock >= resource.capacity) %}
{% set reducedResources=resources|filter(resource => resource.productivity is not null and resource.productivity < 100) %}
{% if not chrome.vacation and (fullResources or reducedResources) %}
<section class="panel" aria-labelledby="attention-title"><h2 id="attention-title">À surveiller</h2>
{% if fullResources %}<p>Stockages pleins : {% for slug,resource in fullResources %}<a href="{{ path('app_colony',{id:planet.id,section:'buildings',_fragment:'item-storage_'~slug~'-basic'}) }}">{{ resource.label }}</a>{{ not loop.last ? ', ' : '.' }}{% endfor %} Les apports supplémentaires ne sont plus stockés.</p>{% endif %}
{% if reducedResources %}<p>Production industrielle réduite : {% for resource in reducedResources %}{{ resource.label }} ({{ resource.productivity|quantity(0) }} %){{ not loop.last ? ', ' : '.' }}{% endfor %} <a href="#resource-details">Consulter les détails des ressources</a></p>{% endif %}
</section>{% endif %}
<section class="dashboard-activity" aria-label="Activité et files de la colonie active">{% include 'ui/colony_queues.html.twig' %}</section>


</div>
<aside class="dashboard-secondary">
{% include 'ui/flights.html.twig' %}

</aside>
</div>
<section class="panel dashboard-journal" data-live-region="journal" aria-labelledby="dashboard-journal-title">
<div class="dashboard-section-heading"><div><h2 id="dashboard-journal-title">Journal de bord</h2><p>Événements survenus depuis votre précédente ouverture, conservés jusqu’à consultation explicite.</p></div><span aria-hidden="true">{{ ui.icon('clock') }}</span></div>
{% if chrome.journal.notifications|default([]) is not empty %}
<ol class="dashboard-notifications">{% for notification in chrome.journal.notifications %}
<li data-journal-notice="{{ notification.id }}"><span class="journal-mark" aria-hidden="true">{{ ui.icon('notifications') }}</span><span><strong>{{ notification.message }}</strong><small>{{ notification.createdAt|date('d/m/Y · H:i',preferences.timezone) }}</small></span></li>
{% endfor %}</ol>
{% if chrome.journal.availableCount > chrome.journal.notifications|length %}<p>{{ chrome.journal.notifications|length }} événements affichés sur {{ chrome.journal.availableCount }}. Les suivants seront proposés après consultation.</p>{% endif %}
<form method="post" action="{{ path('app_journal_consult',{id:planet.id}) }}">
<input type="hidden" name="_token" value="{{ csrf_token('journal-'~membership.id) }}">
<input type="hidden" name="membership" value="{{ membership.id }}">
{% for notification in chrome.journal.notifications %}<input type="hidden" name="notice_ids[]" value="{{ notification.id }}">{% endfor %}
<button class="secondary">Marquer ces événements comme consultés</button>
</form>
{% else %}<p class="dashboard-empty">Aucun événement d’absence à consulter. Le suivi commence à votre première ouverture de la vue générale ; les nouvelles activités seront proposées lors d’une prochaine ouverture.</p>{% endif %}
<a class="dashboard-journal-link" href="{{ path('app_combat_reports') }}">Ouvrir les rapports <span aria-hidden="true">→</span></a>
</section>
{% endif %}
{% else %}
<div class="colony-catalog-workspace" data-controller="catalog-sticky"><div class="catalog-operations-rail" data-catalog-sticky-target="rail"><section class="colony-catalog-activity dashboard-activity" aria-label="Activité et files de la colonie active">{% include 'ui/colony_queues.html.twig' %}</section><aside class="colony-catalog-aside">{% include 'ui/flights.html.twig' %}</aside></div><div class="workspace colony-catalog" data-live-region="catalog" aria-label="Catalogue et opérations de la colonie" data-controller="catalog-filter">
{% for group,items in cards %}{% if group==section %}
<section id="panel-{{ group }}" data-controller="building-catalog" data-building-catalog-show-locked-value="{{ show_locked_items ? 'true' : 'false' }}" data-action="hashchange@window->building-catalog#followHash click->building-catalog#rememberFilter" aria-label="{{ {buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[group] }}">
    <div class="catalog-section-title">
        <h2>{{ {buildings:'Développer la colonie',technologies:'Repousser les frontières',ships:'Préparer vos prochaines missions',defenses:'Protéger la planète'}[group] }}</h2>
        <form method="get" class="building-visibility">
            <input type="hidden" name="section" value="{{ group }}">
            <input type="hidden" name="showLockedItems" value="{{ show_locked_items ? '0' : '1' }}" data-building-catalog-target="visibilityInput">
            <button type="submit" role="switch" aria-checked="{{ show_locked_items ? 'true' : 'false' }}" data-building-catalog-target="visibilitySwitch" data-action="building-catalog#toggleLocked"><span>Afficher les éléments verrouillés</span><span class="building-switch-track" aria-hidden="true"></span><span data-building-catalog-target="visibilityLabel" aria-hidden="true">{{ show_locked_items ? 'ON' : 'OFF' }}</span></button>
        </form>
        <div class="building-visibility"><button type="button" role="switch" aria-checked="false" data-building-catalog-target="compactSwitch" data-action="building-catalog#toggleCompact" hidden><span>Vue condensée</span><span class="building-switch-track" aria-hidden="true"></span></button></div>
    </div>
    <nav class="catalog-filters ui-tabs" aria-label="Filtrer le catalogue">
        {% set filter_options = catalog_filter_options[group] %}
        {% for key,label in filter_options %}<button type="button" data-action="click->catalog-filter#apply" data-category="{{ key }}" aria-pressed="{{ key=='all'?'true':'false' }}">{{ label }}</button>{% endfor %}
    </nav>
    <p data-catalog-empty hidden role="status">Aucun élément accessible dans ce filtre. Activez l’affichage des éléments verrouillés pour explorer cette catégorie.</p>
    <div class="catalog-grid building-grid">{% include 'ui/building_cards.html.twig' %}</div>
</section>
{% endif %}{% endfor %}</div></div>
{% endif %}

</div></div></div>{% endblock %}
