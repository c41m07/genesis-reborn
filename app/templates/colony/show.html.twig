{% extends 'base.html.twig' %}{% import 'ui/macros.html.twig' as ui %}{% import 'ui/ranking_change.html.twig' as evolution %}{% block title %}{{ planet.name }} · Genesis Reborn{% endblock %}
{# Le contenu place les arrivées dans sa colonne de suivi, sans second panneau en tête. #}
{% block incoming_fleets %}{% endblock %}
{% block body %}
<div class="{{ section == 'overview' ? 'overview-page' : '' }}" data-controller="colony-live" data-colony-live-url-value="{{ path('app_colony',{id:planet.id}) }}">
{% set catalogueHeader = {
    buildings: {title:'Pont d’ingénierie', intro:'Énergie, extraction et infrastructures de cette colonie.', art:'art/catalogue-engineering-orbital.webp'},
    technologies: {title:'Laboratoire colonial', intro:'Développez les technologies partagées par vos colonies dans cet univers.', art:'images/catalog/buildings/lab__basic-768.webp'},
    ships: {title:'Hangar d’assemblage', intro:'Assemblez les vaisseaux de reconnaissance, de transport et de combat.', art:'images/catalog/buildings/shipyard__basic.webp'},
    defenses: {title:'Poste de défense planétaire', intro:'Installez les défenses adaptées aux menaces de cette colonie.', art:'images/catalog/buildings/fortress__basic.webp'},
}[section]|default(null) %}
<div class="page-heading{{ catalogueHeader ? ' core-catalogue-header core-catalogue-header--' ~ section : ' overview-heading' }}">
    {% if catalogueHeader %}
        <img class="core-catalogue-header-art" src="{{ asset(catalogueHeader.art) }}" alt="" decoding="async">
    {% endif %}
    <div>
        {% if catalogueHeader %}<p class="core-catalogue-kicker">{{ catalogueHeader.title }} · {{ planet.name }}</p>{% endif %}
        <h1>{{ {overview:'Vue générale',buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[section] }}{% if section != 'overview' %}<span>.</span>{% endif %}</h1>
        {% if catalogueHeader %}
            <p>{{ catalogueHeader.intro }}</p>
        {% elseif section == 'overview' %}
            <p class="overview-kicker">Poste de commandement</p>
        {% endif %}
    </div>
    {# Les catalogues restent accessibles dans le menu Développement, y compris dans le tiroir mobile. #}
</div>
<div class="colony-layout colony-layout--integrated"><div class="colony-content">
{% if section=='overview' %}
<div class="core-overview-top">
<section class="colony-banner panel empire-banner" aria-labelledby="overview-colony-title">
    <picture><source type="image/webp" srcset="{{ asset('art/colony-overview.webp') }}"><img class="colony-scene" src="{{ asset('art/colony-overview.png') }}" alt="" aria-hidden="true"></picture>
    <div class="hero-content">
        <div class="overview-colony-heading">
            <div>
                <span class="badge"><i class="connection-dot" aria-hidden="true"></i> {{ chrome.vacation ? 'Colonie en vacances' : 'Colonie opérationnelle' }}</span>
                <h2 id="overview-colony-title">{{ planet.name }}</h2>
                <p>{{ ui.icon('galaxy') }} {{ planet.coordinates() }} · Colonie active</p>
            </div>
            <a class="quiet-button" href="{{ path('app_map_v2') }}">{{ ui.icon('galaxy') }} Explorer la galaxie {{ ui.icon('arrow') }}</a>
        </div>
    </div>
    <div class="overview-summary">
        <nav class="dashboard-metrics" aria-label="Résumé de votre empire">
            {% include 'ui/colony_summaries.html.twig' %}
            <a class="metric-card" href="{{ path('app_leaderboard') }}"><span class="metric-symbol">{{ ui.icon('universe') }}</span><span><small>Points d’empire</small><strong>{{ empire_points.total_points|quantity(0) }} pts</strong></span></a>
            <a class="metric-card" href="{{ path('app_leaderboard') }}"><span class="metric-symbol">{{ ui.icon('universe') }}</span><span><small>Classement</small><strong>{{ empire_rank ? '#'~empire_rank : '—' }}</strong><span class="metric-caption">Places : {{ evolution.value(ranking_changes is defined ? ranking_changes.rank_changes.points : null, "Places") }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
            <a class="metric-card" href="{{ path('app_guilds') }}"><span class="metric-symbol">{{ ui.icon('diplomacy') }}</span><span><small>Guilde</small><strong>{{ empire_guild ? empire_guild.name : (guilds_enabled ? 'Sans guilde' : 'Désactivée') }}</strong><span class="metric-caption">{{ empire_guild ? 'Ouvrir ma guilde' : (guilds_enabled ? 'Trouver une guilde' : 'Dans cet univers') }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
        </nav>
        <details class="overview-score-detail">
            <summary>Détail des points</summary>
            <div class="overview-score-body">
                <h3 class="overview-points-title">Points de votre empire · {{ chrome.membership.universe.name }}</h3>
                <dl class="empire-points">
                    {% for key,label in {building_points:'Bâtiments',research_points:'Recherche',fleet_points:'Flotte'} %}
                        <div><dt>{{ label }}</dt><dd>{{ empire_points[key]|quantity(0) }} <small>pts</small></dd></div>
                    {% endfor %}
                </dl>
                <p class="overview-points-change">Évolution : {{ evolution.value(ranking_changes is defined ? ranking_changes.score_changes.points : null, 'Points') }} points · Classement à 00 h et 12 h (Europe/Paris)</p>
            </div>
        </details>
    </div>
</section>
<aside class="core-empire-watch panel" aria-labelledby="core-empire-watch-title">
    <h2 id="core-empire-watch-title">{{ ui.icon('notifications') }} À surveiller</h2>
    <p>Prochaines échéances de votre empire · {{ membership.universe.name }}</p>
    {% include 'colony/_overview_deadlines.html.twig' %}
    {% include 'colony/_overview_attention.html.twig' %}
</aside>
</div>
<div class="dashboard-layout">
<div class="dashboard-primary">
<section class="dashboard-activity" aria-label="Activité et files de la colonie active">{% include 'ui/colony_queues.html.twig' %}</section>
</div>
<aside class="dashboard-secondary">
{% include 'ui/incoming_attacks.html.twig' %}
{% include 'ui/flights.html.twig' %}
</aside>
</div>
{% include 'colony/_journal.html.twig' %}
{% else %}
<div class="colony-catalog-workspace catalog-workspace" data-controller="catalog-sticky">
    <div class="catalog-operations-rail" data-catalog-sticky-target="rail" aria-label="Suivi des files et des flottes">
        {% include 'ui/colony_queues.html.twig' %}
        <div class="catalog-flight-followups" role="group" aria-label="Suivi des flottes">
            {% include 'ui/flights.html.twig' %}
            {% include 'ui/incoming_attacks.html.twig' with {incoming_catalog:true} %}
        </div>
    </div>
    {% include 'colony/_catalog.html.twig' %}
</div>
{% endif %}

</div></div></div>{% endblock %}
