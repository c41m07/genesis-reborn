{% extends 'base.html.twig' %}
{% block title %}Rapport de combat · Genesis Reborn{% endblock %}
{% block body %}
<div class="mission-report">
<a class="inline-link report-back" href="{{ path('app_combat_reports') }}">← Tous les rapports</a>
<header class="report-heading"><p class="report-eyebrow">COMBAT · N° {{ report.id }}</p><h1>Rapport de combat</h1><p>{{ report.combatEvent.planet.name }} · {{ report.combatEvent.planet.coordinates() }} · {{ report.resolvedAt|date('d/m/Y H:i') }}</p></header>
{% set defeated = (viewer_defends and report.outcome == 'attacker_wins') or (not viewer_defends and report.outcome == 'defender_wins') %}
<section class="panel report-summary {{ defeated ? 'report-summary--defeat' : '' }}" aria-labelledby="combat-result"><h2 id="combat-result">{{ {attacker_wins:'Victoire des attaquants', defender_wins:'Victoire de la défense', draw:'Égalité'}[report.outcome]|default('Combat terminé') }}</h2><p>Le combat sur {{ report.combatEvent.planet.name }} est terminé.{% if defeated %} Votre camp a perdu le combat.{% endif %}</p><p class="muted">{{ report.rounds|length }} round(s) enregistré(s){% if report.snapshot.max_rounds is defined %} · Limite : {{ report.snapshot.max_rounds }} rounds{% endif %}</p></section>
{% set capture = report.snapshot.capture|default(null) %}
{% if capture %}<section class="panel"><h2>Conquête</h2>{% if capture.status == 'captured' %}{% if capture.captor_player_universe_id == membership.id %}<p>Vous avez conquis cette planète PNJ. Ses bâtiments et ressources sont conservés.</p>{% else %}<p>La planète a été revendiquée par un autre commandant.</p>{% endif %}{% elseif capture.reason == 'attack_lost' %}<p>La conquête a échoué car les attaquants ont perdu le combat.</p>{% elseif capture.reason == 'planet_limit' %}<p>Le combat est gagné, mais la limite de colonies empêche la prise de la planète.</p>{% elseif capture.reason == 'target_claimed' %}<p>Le combat est gagné, mais la planète a déjà été revendiquée.</p>{% else %}<p>Le combat est gagné, mais aucun vaisseau colonie n’a survécu.</p>{% endif %}</section>{% endif %}
{% if loot_rows %}<section class="panel"><h2>Butin embarqué par vos flottes</h2><p class="muted">Ressources chargées à l’issue du combat.</p><dl class="report-metrics">{% for item in loot_rows %}<div><dt>{{ item.label }}</dt><dd>{{ item.amount|number_format(0, ',', ' ') }}</dd></div>{% endfor %}</dl></section>{% endif %}
<section class="panel"><h2>Effectifs et pertes</h2>{% if rows %}<div class="table-scroll" role="region" tabindex="0" aria-label="Bilan des pertes, défilement horizontal"><table class="data-table combat-losses"><caption>Effectifs engagés et pertes par unité, avant reconstruction</caption><thead><tr><th scope="col">Camp</th><th scope="col">Unité</th><th scope="col">Rang</th><th scope="col">Engagés</th><th scope="col">Pertes</th><th scope="col">Survivants</th><th scope="col">Arrivée</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.label }}</td><th scope="row">{{ row.unit }}</th><td>{{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[row.tier]|default(row.tier) }}</td><td>{{ row.initial|number_format(0, ',', ' ') }}</td><td class="report-loss">{{ row.lost|number_format(0, ',', ' ') }}</td><td>{{ max(0, row.initial - row.lost)|number_format(0, ',', ' ') }}</td><td>R{{ row.round }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>Aucune unité engagée.</p>{% endif %}</section>
<section class="panel"><h2>Combat détaillé</h2><p class="muted">Une ligne par type de vaisseau et par flotte · Statistiques propres à chaque round.</p>
{% for round in round_details %}<section class="combat-round" aria-labelledby="round-{{ round.number }}"><h3 id="round-{{ round.number }}">Round {{ round.number }}</h3><div class="table-scroll" role="region" tabindex="0" aria-label="Round {{ round.number }}, comparaison des camps, défilement horizontal"><div class="combat-versus">
{% for side, sideLabel in {own:'Votre camp',enemy:'Camp adverse'} %}{% if side == 'enemy' %}<span class="combat-vs" aria-hidden="true">VS</span>{% endif %}<section class="combat-side combat-side--{{ side }}"><h4>{{ sideLabel }}</h4><table class="data-table round-table"><caption class="visually-hidden">{{ sideLabel }} · Round {{ round.number }}</caption><thead><tr><th scope="col">Vaisseau / défense</th><th scope="col">Début</th><th scope="col">Pertes</th><th scope="col">Fin</th><th scope="col">Tirs</th><th scope="col"><abbr title="Tirs touchés">Touch.</abbr></th><th scope="col">Ratés</th><th scope="col"><abbr title="Taux de tirs réussis">Préc.</abbr></th></tr></thead><tbody>{% for row in round[side] %}<tr><th scope="row">{{ row.unit }}<small>{{ row.label }} · {{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[row.tier]|default(row.tier) }}</small></th><td>{{ row.start }}</td><td class="report-loss">{{ row.round_lost }}</td><td>{{ row.end }}</td><td>{{ row.shots }}</td><td>{{ row.hits }}</td><td>{{ row.misses }}</td><td>{{ row.accuracy is null ? '—' : row.accuracy ~ ' %' }}</td></tr>{% else %}<tr><td colspan="8">Aucune unité présente dans ce camp à ce round.</td></tr>{% endfor %}</tbody></table></section>{% endfor %}
</div></div><p class="report-table-note">Début / fin : effectifs · Pertes : destructions de ce round · Tirs : armes principales et secondaires · Préc. : proportion de tirs touchés.</p></section>{% else %}<p>Le détail des rounds n’est pas disponible pour ce rapport historique.</p>{% endfor %}</section>
{% if reconstruction %}<section class="panel"><h2>Reconstruction après combat</h2><p class="muted">La reconstruction intervient après le verdict et ne change pas l’issue du combat.</p><div class="table-scroll" role="region" tabindex="0" aria-label="Reconstruction des défenses, défilement horizontal"><table class="data-table"><caption>Bilan des défenses planétaires par type et par rang</caption><thead><tr><th scope="col">Défense</th><th scope="col">Rang</th><th scope="col">Détruites</th><th scope="col">Reconstruites</th><th scope="col">Pertes définitives</th></tr></thead><tbody>{% for row in reconstruction %}<tr><th scope="row">{{ row.unit }}</th><td>{{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[row.tier]|default(row.tier) }}</td><td>{{ row.lost }}</td><td>{{ row.rebuilt }}</td><td>{{ row.permanent }}</td></tr>{% endfor %}</tbody></table></div></section>{% endif %}
</div>
{% endblock %}
