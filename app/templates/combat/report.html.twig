{% extends report_layout|default('base.html.twig') %}
{% block title %}Rapport de combat · Genesis Reborn{% endblock %}
{% block body %}
{% set playerBoard = not monitoring_context|default(null) %}
{% set tier_labels = {basic:'Basique', intermediate:'Intermédiaire', superior:'Supérieur'} %}
{% set defeated = viewer_verdict|default(null) ? viewer_verdict == 'loss' : ((viewer_defends and report.outcome == 'attacker_wins') or (not viewer_defends and report.outcome == 'defender_wins')) %}
<div class="mission-report report-workspace{{ playerBoard ? ' player-report-detail' : '' }}">
    {% if monitoring_context|default(null) %}<p class="admin-monitor-note">{{ monitoring_context }}</p>{% endif %}
    {% include 'ui/report_back_link.html.twig' %}
    <header class="report-heading">
        <p class="report-eyebrow">COMBAT · N° {{ report.id }}</p>
        <h1>Rapport de combat</h1>
        <p>{% if campaign_location is defined %}Campagne pirate · {{ campaign_location }} · {{ report.snapshot.location_code }}{% else %}{{ report.combatEvent.planet.name }} · {{ report.combatEvent.planet.coordinates() }}{% endif %} · {{ report.resolvedAt|date('d/m/Y H:i') }}</p>
    </header>
{% if campaign_report_id is defined %}{% include 'ui/report_notice_form.html.twig' with {report_notice_kind:'campaign'} %}{% elseif app.request.attributes.get('_route') == 'app_combat_report' %}{% include 'ui/report_notice_form.html.twig' with {report_notice_kind:'combat'} %}{% endif %}
    {% if not playerBoard %}    <section class="panel report-summary {{ defeated ? 'report-summary--defeat' : '' }}" aria-labelledby="combat-result">
        <h2 id="combat-result">{% if viewer_verdict|default(null) %}{{ {win:'Victoire de votre camp', loss:'Défaite de votre camp', hold:'Position maintenue', draw:'Égalité'}[viewer_verdict] }}{% else %}{{ {attacker_wins:'Victoire des attaquants', defender_wins:'Victoire de la défense', draw:'Égalité'}[report.outcome]|default('Combat terminé') }}{% endif %}</h2>
        <p>Le combat sur {{ report.combatEvent.planet.name }} est terminé.{% if defeated %} Votre camp a perdu le combat.{% endif %}</p>
        <p class="muted">{{ report.snapshot.rounds_played|default(report.rounds|length) }} round(s) joué(s){% if report.snapshot.max_rounds is defined %} · Limite : {{ report.snapshot.max_rounds }} rounds{% endif %}</p>
    </section>
{% endif %}
    <nav class="ui-tabs report-section-nav" aria-label="Sections du rapport">
        <a href="#combat-overview">Bilan</a><a href="#combat-losses">Effectifs et pertes</a>
        {% if loot_rows or playerBoard %}<a href="#combat-loot">Butin</a>{% endif %}
        {% if round_details %}<a href="#combat-rounds">Combat détaillé</a>{% endif %}
        {% if reconstruction %}<a href="#combat-reconstruction">Reconstruction</a>{% endif %}
    </nav>
    <div class="player-combat-layout">
        <div class="player-combat-core">
    <section id="combat-overview" aria-labelledby="combat-overview-title">
        {% if playerBoard %}
        <header class="combat-board-heading">
            <div><h2 id="combat-overview-title">Bilan de votre camp</h2>
                <p class="muted">Les chiffres ci-dessous sont ceux de votre camp.</p>
            </div>
            <p id="combat-result" class="combat-board-verdict{{ defeated ? ' combat-board-verdict--defeat' : '' }}">
                {% if viewer_verdict|default(null) %}{{ {win:'Victoire de votre camp', loss:'Défaite de votre camp', hold:'Position maintenue', draw:'Égalité'}[viewer_verdict] }}{% else %}{{ {attacker_wins:'Victoire des attaquants', defender_wins:'Victoire de la défense', draw:'Égalité'}[report.outcome]|default('Combat terminé') }}{% endif %}
            </p>
        </header>
        {% else %}
        <h2 id="combat-overview-title">Bilan de votre camp</h2>
        {% endif %}
        <dl class="report-totals">
            <div><dt>Engagés</dt><dd>{{ totals.own.initial|quantity(0) }}</dd></div>
            <div><dt>Pertes</dt><dd class="{{ totals.own.lost ? 'report-loss' : 'muted' }}">{{ totals.own.lost ? '−' : '' }}{{ totals.own.lost|quantity(0) }}</dd></div>
            <div><dt>Survivants</dt><dd class="{{ totals.own.remaining ? 'report-survivors' : 'muted' }}">{{ totals.own.remaining|quantity(0) }}</dd></div>
        </dl>
    </section>
    <section class="panel" id="combat-losses" aria-labelledby="combat-losses-title">
        <h2 id="combat-losses-title">Effectifs et pertes</h2>
        <p class="muted">Effectifs par unité, rang et flotte, avant reconstruction.</p>
        <div role="region" tabindex="0" aria-label="Bilan des pertes">
            {% include 'combat/_report_units.html.twig' %}
        </div>
    </section>
    {% if loot_rows %}
        <section class="panel" id="combat-loot"><h2>Butin embarqué par vos flottes</h2><p class="muted">Ressources chargées à l’issue du combat.</p><dl class="report-metrics">{% for item in loot_rows %}<div><dt>{{ item.label }}</dt><dd>{{ item.amount|quantity(0) }}</dd></div>{% endfor %}</dl></section>
    {% endif %}
    {% if playerBoard and not loot_rows %}
        <p class="player-report-note" id="combat-loot">Aucun butin embarqué par vos flottes dans ce rapport.</p>
    {% endif %}
        </div>
    <section class="panel" id="combat-rounds" aria-labelledby="combat-rounds-title">
        <h2 id="combat-rounds-title">Combat détaillé</h2>
        {% if playerBoard %}
        <p class="muted">{{ report.snapshot.rounds_played|default(report.rounds|length) }} round(s) joué(s){% if report.snapshot.max_rounds is defined %} · Limite : {{ report.snapshot.max_rounds }} rounds{% endif %}. {% if round_details %}Dépliez un round pour consulter les actions et effectifs.{% endif %}</p>
        {% else %}<p class="muted">Statistiques par round, par flotte et par rang.</p>{% endif %}
        {% for round in round_details %}
            {% include 'combat/_report_round.html.twig' with {first_round: loop.first} %}
        {% else %}
            <p>Le détail des rounds n’est pas disponible pour ce rapport historique.</p>
        {% endfor %}
    </section>
    </div>
    {% if reconstruction %}{% include 'combat/_report_reconstruction.html.twig' %}{% endif %}
    {% set capture = capture_state|default(report.snapshot.capture|default(null)) %}
    {% if capture %}<section class="panel"><h2>Conquête JcE</h2>{% if capture.status == 'captured' %}{% if capture.captor_player_universe_id == membership.id %}<p>Vous avez conquis cette planète PNJ. Ses bâtiments et ressources sont conservés.</p>{% else %}<p>La planète a été revendiquée par un autre commandant.</p>{% endif %}{% elseif capture.status == 'occupying' %}<p>{{ capture.captor_player_universe_id == membership.id ? 'Votre flotte occupe cette planète.' : 'Une autre flotte occupe cette planète.' }} La planète n’est pas encore acquise. L’échéance des 24 heures est le <time datetime="{{ capture.capture_at|date('c') }}">{{ capture.capture_at|date('d/m/Y à H:i',preferences.timezone) }}</time> ({{ preferences.timezone }}).</p>{% elseif capture.reason == 'occupation_lost' %}<p>{{ capture.captor_player_universe_id == membership.id ? 'Votre occupation a été remplacée par celle d’un autre commandant.' : 'Cette occupation a été remplacée par celle d’un autre commandant.' }}</p>{% elseif capture.reason == 'abandoned' %}<p>L’occupation a pris fin : aucune flotte occupante ne maintenait la position.</p>{% elseif capture.reason == 'occupant_unavailable' %}<p>L’occupation a pris fin : l’empire occupant n’est plus disponible.</p>{% elseif capture.reason == 'attack_lost' %}<p>La conquête a échoué car les attaquants ont perdu le combat.</p>{% elseif capture.reason == 'occupation_disabled' %}<p>Le combat est gagné, mais les nouvelles occupations sont suspendues. Votre flotte rentre.</p>{% elseif capture.reason == 'planet_limit' %}<p>Le combat est gagné, mais la limite de colonies empêche la prise de la planète.</p>{% elseif capture.reason == 'target_claimed' %}<p>Le combat est gagné, mais la planète a déjà été revendiquée.</p>{% else %}<p>Le combat est gagné, mais aucun vaisseau colonie n’a survécu.</p>{% endif %}</section>{% endif %}
</div>
{% endblock %}
