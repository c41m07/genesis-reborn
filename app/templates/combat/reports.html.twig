{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}{{ archived ? 'Archives des rapports' : 'Rapports' }} · Genesis Reborn{% endblock %}
{% block body %}
{% set reportFilters = {all: 'Tous', combat: 'Combats', economy: 'Économie', espionage: 'Espionnage'} %}
{% set search_filters=search_filters|default({}) %}
{% set view = archived ? 'archives' : '' %}
<div class="page-heading"><div><h1>{{ archived ? 'Archives des rapports' : 'Rapports' }}</h1><p>L’information au service de vos décisions.</p></div></div>
{% if search_error|default(null) %}<p class="flash error" role="alert">{{ search_error }}</p>{% endif %}
<form method="get" class="panel search-filters" role="search"><input type="hidden" name="type" value="{{ filter }}"><input type="hidden" name="view" value="{{ view }}"><label for="report-planet">Nom actuel de planète<input id="report-planet" name="planet" maxlength="80" value="{{ criteria.planet|default('') }}"></label><label for="report-person">Nom du participant<input id="report-person" name="participant" maxlength="80" value="{{ criteria.participant|default('') }}"></label><label for="report-from">Du<input id="report-from" name="from" type="date" value="{{ criteria.from|default('') }}"></label><label for="report-until">Au<input id="report-until" name="until" type="date" value="{{ criteria.until|default('') }}"></label><button class="primary">Rechercher les rapports</button><a class="secondary" href="{{ path('app_combat_reports',search_filters|merge({type:filter,view:view})) }}">Réinitialiser les filtres</a></form>
<details><summary>Portée des filtres</summary><p>Planète : cible des combats/espionnages, origine ou destination des transports. Participant : commandants enregistrés au combat, expéditeur du rapport d’espionnage, expéditeur ou destinataire du transport. Les rapports restent limités à vos droits et à vos archives personnelles.</p></details>
<section class="panel report-center" aria-labelledby="report-center-title">
<div class="report-center-heading"><h2 id="report-center-title">Centre de rapports</h2><span class="badge">{{ report_count }} disponible{{ report_count == 1 ? '' : 's' }}</span></div>
<nav class="report-tabs" aria-label="Liste ou archives des rapports"><a href="{{ path('app_combat_reports',search_filters|merge({type:filter})) }}" {{ not archived ? 'aria-current="page"' : '' }}>Rapports actifs</a><a href="{{ path('app_combat_reports',search_filters|merge({type:filter,view:'archives'})) }}" {{ archived ? 'aria-current="page"' : '' }}>Archives personnelles</a></nav>
<nav class="report-tabs" aria-label="Filtrer les rapports">{% for key,label in reportFilters %}<a href="{{ path('app_combat_reports',search_filters|merge({type:key,view:view})) }}" class="{{ filter == key ? 'active' : '' }}" {{ filter == key ? 'aria-current="page"' : '' }}>{{ label }}</a>{% endfor %}</nav>
{% if entries is not empty %}
<form method="post" action="{{ path('app_report_archive_change') }}" aria-label="{{ archived ? 'Restaurer des rapports' : 'Archiver des rapports' }}">
<input type="hidden" name="_token" value="{{ csrf_token('report_archive') }}"><input type="hidden" name="operation" value="{{ archived ? 'restore' : 'archive' }}">
<input type="hidden" name="type" value="{{ filter }}"><input type="hidden" name="view" value="{{ view }}"><input type="hidden" name="page" value="{{ page }}">
{% for key,value in search_filters %}<input type="hidden" name="{{ key }}" value="{{ value }}">{% endfor %}
<button type="submit" class="secondary">{{ archived ? 'Restaurer la sélection' : 'Archiver la sélection' }}</button>
<div class="report-list">
{% for entry in entries %}{% set report = entry.report %}
<div class="report-archive-entry">
<label class="report-select" for="report-select-{{ entry.key }}"><input type="checkbox" id="report-select-{{ entry.key }}" name="selected[]" value="{{ entry.key }}"><span class="visually-hidden">Sélectionner le rapport {{ reportFilters[entry.kind] }} n° {{ report.id }}</span></label>
{% if entry.kind == 'combat' %}
<a class="report-row" href="{{ path('app_combat_report',search_filters|merge({id:report.id,type:filter,view:view,page:page})) }}"><span class="report-kind report-kind--combat">{{ ui.icon('fleet') }}</span><span class="report-copy"><strong>Combat · {{ report.combatEvent.planet.name }}</strong><small>{{ report.resolvedAt|date('d/m/Y H:i') }} · {{ report.combatEvent.planet.coordinates() }} · {{ report.snapshot.participants|length }} flottes impliquées</small></span><span class="badge">{{ report.outcome=='attacker_wins'?'Victoire attaquants':(report.outcome=='defender_wins'?'Victoire défense':'Égalité') }}</span><span class="report-chevron" aria-hidden="true">›</span></a>
{% elseif entry.kind == 'espionage' %}
<a class="report-row" href="{{ path('app_espionage_report',search_filters|merge({id:report.id,type:filter,view:view,page:page})) }}"><span class="report-kind report-kind--spy">{{ ui.icon('diplomacy') }}</span><span class="report-copy"><strong>Renseignements · {{ report.target.name }}</strong><small>{{ report.createdAt|date('d/m/Y H:i') }} · {{ report.target.coordinates() }}</small></span><span class="badge">{{ report.result == 'detected' ? 'Sondes détectées' : report.intelCategories ~ ' catégorie(s)' }}</span><span class="report-chevron" aria-hidden="true">›</span></a>
{% else %}
<a class="report-row" href="{{ path('app_transport_report',search_filters|merge({id:report.id,type:filter,view:view,page:page})) }}"><span class="report-kind">{{ ui.icon('storage') }}</span><span class="report-copy"><strong>Transport · {{ report.snapshot.sender }} → {{ report.snapshot.recipient }}</strong><small>{{ report.createdAt|date('d/m/Y H:i') }} · {{ report.snapshot.destination }}</small></span><span class="badge">{{ {traveling:'En route', delivered:'Livré', refused:'Refusé'}[report.status]|default(report.status) }}</span></a>
{% endif %}
<button type="submit" class="secondary report-archive-action" name="single" value="{{ entry.key }}" aria-label="{{ archived ? 'Restaurer' : 'Archiver' }} le rapport {{ reportFilters[entry.kind] }} n° {{ report.id }}">{{ archived ? 'Restaurer' : 'Archiver' }}</button>
</div>
{% endfor %}
</div>
</form>
{% else %}
<div class="report-empty"><span class="report-kind">{{ ui.icon(filter == 'economy' ? 'storage' : 'clock') }}</span><div><h3>{% if archived %}Aucun rapport archivé dans cette catégorie{% elseif filter == 'economy' %}Aucun rapport économique{% else %}Aucun rapport dans cette catégorie{% endif %}</h3><p>{% if archived %}Les rapports que vous archivez apparaîtront ici et pourront être restaurés.{% elseif filter == 'economy' %}Les comptes rendus de transport et de production seront présentés ici.{% else %}Les rapports apparaîtront ici après la résolution de vos missions et combats.{% endif %}</p></div></div>
{% endif %}
{% if pages > 1 %}<nav class="report-pagination" aria-label="Pagination des rapports">{% if page > 1 %}<a href="{{ path('app_combat_reports',search_filters|merge({type:filter,view:view,page:page-1})) }}">Page précédente</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page < pages %}<a href="{{ path('app_combat_reports',search_filters|merge({type:filter,view:view,page:page+1})) }}">Page suivante</a>{% endif %}</nav>{% endif %}
</section>
{% endblock %}
