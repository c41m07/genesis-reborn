{% extends 'base.html.twig' %}
{% block title %}Simulateur de combat · Genesis Reborn{% endblock %}
{% block body %}
{% set steps = {
  ships: {title: 'Vaisseaux', help: 'Composez les deux flottes et leurs rounds d’arrivée.'},
  defenses: {title: 'Défenses', help: 'Précisez les défenses fixes et la forteresse de la colonie défendue.'},
  research: {title: 'Recherches', help: 'Seules les recherches qui influencent le combat sont prises en compte.'},
  simulation: {title: 'Simulation', help: 'Vérifiez vos hypothèses avant de lancer le calcul.'}
} %}
{% set keys = steps|keys %}
<div class="strategic-page simulation-workspace player-simulation-board player-simulation-board--scenario"
     data-controller="simulation-wizard" data-simulation-wizard-step-value="{{ step }}">
    <div class="page-heading"><div><p class="simulation-board-eyebrow">Opérations · outil stratégique</p><h1>Simulateur de combat</h1>
        <p>Comparez deux camps avant de simuler. Aucun vaisseau envoyé, aucune ressource dépensée.</p></div>
    </div>
    {% if result %}<p><a href="#simulation-result">Voir les résultats</a></p>{% endif %}
    {% if error %}<p class="flash error" role="alert">{{ error }}</p>{% endif %}
    <nav class="simulation-wizard-nav" aria-label="Étapes du simulateur">
    {% for key, item in steps %}
        <a href="#simulation-{{ key }}" data-step="{{ key }}" data-simulation-wizard-target="link"
           data-action="simulation-wizard#go" {% if key == step %}aria-current="step"{% endif %}>
            <b aria-hidden="true">0{{ loop.index }}</b><span>{{ item.title }}</span>
        </a>
    {% endfor %}
    </nav>
    <form method="post" action="{{ path('app_combat_simulation') }}#simulation-result" class="panel simulation-form" id="simulation-scenario"
          data-action="invalid->simulation-wizard#showInvalid:capture input->simulation-wizard#edited">
        <input type="hidden" name="_token" value="{{ csrf_token('combat_simulation') }}">
        <input type="hidden" name="report" value="{{ intel.id|default(0) }}">
        <input type="hidden" name="own_source" value="{{ own_source }}">
        <input type="hidden" name="wizard_step" value="{{ step }}" data-simulation-wizard-target="current">
        {# Entrée dans un champ numérique ne doit ni remplacer des données ni lancer un calcul.
           Ce premier bouton neutralise uniquement la soumission implicite du navigateur. #}
        <button type="submit" hidden disabled></button>
        {% include 'combat/_wizard_sources.html.twig' %}
        {% for key, item in steps %}
            <section class="simulation-wizard-stage" id="simulation-{{ key }}" data-step="{{ key }}"
                     data-simulation-wizard-target="stage" aria-labelledby="simulation-{{ key }}-title">
                <header class="simulation-wizard-heading">
                    <p class="simulation-board-eyebrow">Étape 0{{ loop.index }} / 04</p>
                    <h2 id="simulation-{{ key }}-title" tabindex="-1">{{ item.title }}</h2>
                    <p>{{ item.help }}</p>
                </header>
                {% if key != 'simulation' %}
                    <div class="simulation-wizard-camps">
                    {% for camp, title in {attacker: 'Attaquant', defender: 'Défenseur'} %}
                        <section class="simulation-wizard-camp panel" aria-labelledby="simulation-{{ key }}-{{ camp }}">
                            <p class="simulation-board-eyebrow">{{ title }}</p>
                            <h3 id="simulation-{{ key }}-{{ camp }}">{{ item.title }} · {{ title }}</h3>
                            {% if key == 'defenses' and camp == 'attacker' %}
                                <div class="simulation-wizard-not-applicable">
                                    <strong>Non applicable</strong>
                                    <p>Les défenses fixes et la forteresse n’interviennent que du côté de la colonie défendue.</p>
                                </div>
                            {% else %}
                                {% include 'combat/_wizard_table.html.twig' with {group: key, definitions: choices[key], heading: item.title} %}
                                {% if key == 'ships' %}
                                    <div class="simulation-wizard-arrival">
                                        <label for="arrival-{{ camp }}">Arrivée des vaisseaux au round</label>
                                        <input id="arrival-{{ camp }}" name="forces[{{ camp }}][arrival]" type="number" min="1" max="10" value="{{ forces[camp].arrival|default(1) }}" required>
                                    </div>
                                {% elseif key == 'defenses' %}
                                    <details class="simulation-wizard-fortress"><summary>Forteresse{% if intel and 'fortress' not in intel.known %} · non révélée{% endif %}</summary>
                                        {% include 'combat/_wizard_table.html.twig' with {group: 'fortress', definitions: {fortress: {label: 'Forteresse', max_level: 25}}, heading: 'Forteresse'} %}
                                    </details>
                                {% endif %}
                            {% endif %}
                        </section>
                    {% endfor %}
                    </div>
                {% else %}
                    <section class="panel simulation-wizard-recap" aria-labelledby="simulation-recap-title">
                        <h3 id="simulation-recap-title">Récapitulatif des deux camps</h3>
                        <div class="simulation-wizard-camps">
                            <div><strong>Attaquant</strong><p>{{ own_source ? 'Vaisseaux et recherches repris de votre empire, avec vos ajustements.' : 'Vaisseaux et recherches saisis manuellement.' }} Les défenses fixes ne s’appliquent pas.</p></div>
                            <div><strong>Défenseur</strong><p>{% if intel %}Rapport n°{{ intel.id }} ; les données non révélées et vos ajustements restent des hypothèses.{% else %}Vaisseaux, défenses et recherches saisis manuellement.{% endif %}</p></div>
                        </div>
                    </section>
                    <div class="simulation-board-options simulation-wizard-options">
                        <div>
                            <label for="simulation-seed">Graine de départ reproductible</label>
                            <input id="simulation-seed" name="seed" type="number" min="0" max="4294967295" value="{{ seed }}" required aria-describedby="simulation-seed-help">
                            <p id="simulation-seed-help">La même graine reproduit la série de dix combats.</p>
                        </div>
                        <label class="simulation-board-assumptions"><input type="checkbox" name="assumptions" value="1" required>
                            <span>Je confirme les hypothèses saisies. Un renseignement inconnu laissé vide compte pour zéro dans cet essai uniquement. Le résultat ne prédit pas un combat réel.</span>
                        </label>
                        <p class="simulation-board-note">Au plus {{ max_units }} vaisseaux et défenses au total. Les scénarios avec beaucoup de tirs peuvent être refusés même sous cette limite. Les pertes sont fictives.</p>
                    </div>
                {% endif %}
                <div class="simulation-wizard-actions">
                    {% if not loop.first %}
                        {% set previous = keys[loop.index0 - 1] %}
                        <a class="secondary" href="#simulation-{{ previous }}" data-step="{{ previous }}" data-action="simulation-wizard#go">Précédent : {{ steps[previous].title|lower }}</a>
                    {% endif %}
                    {% if not loop.last %}
                        {% set next = keys[loop.index0 + 1] %}
                        <a class="primary" href="#simulation-{{ next }}" data-step="{{ next }}" data-action="simulation-wizard#go">Continuer : {{ steps[next].title|lower }}</a>
                    {% else %}
                        <button class="primary" type="submit" name="wizard_action" value="simulate">Simuler 10 combats</button>
                    {% endif %}
                </div>
            </section>
        {% endfor %}
    </form>
{% set unit_labels=choices.ships|merge(choices.defenses) %}{% set tier_labels={basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'} %}
 {% set outcome_labels={attacker_wins:'Victoire de l’attaquant',defender_wins:'Défaite de l’attaquant',draw:'Égalité',ongoing:'Combat non terminé'} %}
{% if result %}
<section class="panel" id="simulation-result" tabindex="-1" aria-labelledby="simulation-result-title">
<header class="simulation-result-heading">
    <p class="simulation-board-eyebrow">Opérations · résultats non persistants</p>
    <h2 id="simulation-result-title">Estimation sur {{ result.count }} combats</h2>
    <p>Configuration conservée à l’écran après le calcul.</p>
</header>
<p><strong>Victoires de l’attaquant : {{ result.win_percent }} %</strong> ({{ result.outcomes.attacker_wins }} sur {{ result.count }}).</p>
<dl class="simulation-outcomes">
{% for outcome,label in {attacker_wins:'Victoires de l’attaquant',draw:'Égalités',defender_wins:'Défaites de l’attaquant',ongoing:'Combats non terminés'} %}
    <div class="simulation-outcome simulation-outcome--{{ outcome }}">
        <dt>{{ label }}</dt>
        <dd>{{ result.outcomes[outcome] }}</dd>
        <dd class="simulation-outcome-sample">Sur {{ result.count }} essais</dd>
    </div>
{% endfor %}
</dl>
<p>Cette estimation porte sur dix combats : 7 victoires donnent 70 %, sans garantir cette probabilité réelle. Le butin, la reconstruction, les voyages et l’évolution ultérieure des forces ne sont pas simulés.</p>
<p>Dépliez chaque combat pour consulter ses pertes fictives, ses survivants et ses rounds. Les pertes moyennes ne sont pas calculées.</p>
<h3>Issue et effectifs de l’attaquant</h3>
<div class="simulation-result-actions">
    <a class="secondary" href="#simulation-trial-1">Voir le détail des combats</a>
    <a href="#simulation-scenario" data-action="simulation-wizard#returnToScenario">Revenir au scénario</a>
</div>
<div class="table-scroll simulation-trial-summary" role="region" tabindex="0" aria-label="Bilan par combat">
    <table class="data-table">
        <caption>Bilan de l’attaquant dans chaque combat</caption>
        <thead><tr><th scope="col">Combat</th><th scope="col">Issue</th><th scope="col">Engagés</th><th scope="col">Survivants</th><th scope="col">Pertes</th></tr></thead>
        <tbody>
        {% for trial in result.trials %}
        <tr>
            <th scope="row"><a href="#simulation-trial-{{ loop.index }}">Combat {{ loop.index }}</a></th>
            <td><span class="simulation-outcome-label simulation-outcome--{{ trial.outcome }}">{{ outcome_labels[trial.outcome]|default(trial.outcome) }}</span></td>
            <td>{{ trial.report.attacker.initial|quantity(0) }}</td>
            <td>{{ trial.report.attacker.remaining|quantity(0) }}</td>
            <td>{{ trial.report.attacker.lost|quantity(0) }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
<h3>Détails par combat</h3>
{% for trial in result.trials %}
<details class="simulation-trial" data-simulation-seed="{{ trial.seed }}">
<summary id="simulation-trial-{{ loop.index }}">Combat {{ loop.index }} · {{ outcome_labels[trial.outcome]|default(trial.outcome) }} · graine {{ trial.seed }}</summary>
{% include 'combat/_simulation_trial.html.twig' with {trial:trial,unit_labels:unit_labels,tier_labels:tier_labels} only %}
</details>
{% endfor %}
</section>
{% endif %}
</div>
{% endblock %}
