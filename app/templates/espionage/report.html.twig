{% extends 'base.html.twig' %}
{% block title %}Rapport d’espionnage · Genesis Reborn{% endblock %}
{% block body %}
<div class="mission-report">
<a class="inline-link report-back" href="{{ path('app_combat_reports') }}">← Retour aux rapports</a>
<header class="report-heading"><p class="report-eyebrow">RENSEIGNEMENTS · N° {{ report.id }}</p><h1>Rapport d’espionnage</h1><p>{{ report.target.name }} · {{ report.target.coordinates() }} · {{ report.createdAt|date('d/m/Y H:i') }}</p></header>
<section class="panel report-summary {{ report.result == 'detected' ? 'report-summary--detected' : '' }}" role="status"><h2>{{ report.result == 'detected' ? 'Sondes détectées' : 'Renseignements obtenus' }}</h2>
{% if report.result == 'detected' %}<p>Le propriétaire a été averti et aucun renseignement n’a été obtenu.</p>{% else %}<p>{{ report.intelCategories }} catégorie(s) de renseignements obtenue(s).</p>{% endif %}<p class="muted">{{ report.probesSent }} sonde(s) envoyée(s) · Risque de détection estimé : {{ report.detectionChance }} %</p></section>
{% if report.result != 'detected' %}
<section class="panel"><h2>Renseignements détaillés</h2>
{% for category, title in {resources:'Ressources et production', buildings:'Bâtiments', research:'Recherches', fleets:'Flottes', defenses:'Défenses fixes'} %}
{% if report.snapshot[category] is defined %}
<section class="intel-section"><h3>{{ title }}</h3>{% set items = report.snapshot[category] %}
{% if items %}<div class="report-intel-grid">
{% for slug, item in items %}
    {% set variants = category in ['buildings', 'research'] and item.level is not defined ? item : {single: item} %}
    {% for tier, variant in variants %}
    <article class="report-intel-card intel-card"><h4>{{ variant.label ?? slug }}</h4>
    {% if tier != 'single' %}<span class="badge">{{ {basic:'Basique', intermediate:'Intermédiaire', superior:'Supérieur'}[tier]|default(tier) }}</span>{% endif %}
    {% if category == 'resources' %}
        <dl class="intel-facts"><div><dt>Stock</dt><dd>{{ variant.stock|number_format(0, ',', ' ') }}</dd></div><div><dt>Production / s</dt><dd>{{ variant.rate|number_format(2, ',', ' ') }}</dd></div><div><dt>Capacité</dt><dd>{{ variant.capacity|number_format(0, ',', ' ') }}</dd></div></dl>
    {% elseif category in ['buildings', 'research'] %}<p>Niveau {{ variant.level }}</p>
    {% else %}<p>Quantité : {{ variant.quantity|number_format(0, ',', ' ') }}</p>{% endif %}
    </article>
    {% endfor %}
{% endfor %}</div>{% else %}<p>Aucun élément détecté dans cette catégorie.</p>{% endif %}</section>
{% endif %}{% endfor %}</section>{% endif %}
</div>
{% endblock %}
