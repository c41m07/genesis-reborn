{% extends report_layout|default('base.html.twig') %}
{% block title %}Rapport d’espionnage · Genesis Reborn{% endblock %}
{% block body %}
{% set playerBoard = not monitoring_context|default(null) %}
<div class="mission-report report-workspace{{ playerBoard ? ' player-report-detail' : '' }}">
{% if monitoring_context|default(null) %}<p class="admin-monitor-note">{{ monitoring_context }}</p>{% endif %}
{% include 'ui/report_back_link.html.twig' %}
{% block intel_heading %}<header class="report-heading"><p class="report-eyebrow">RENSEIGNEMENTS · N° {{ report.id }}</p><h1>Rapport d’espionnage</h1><p>{{ report.target.name }} · {{ report.target.coordinates() }} · {{ report.createdAt|date('d/m/Y H:i') }}</p></header>{% endblock %}
{% if campaign_report_id|default(null) %}{% include 'ui/report_notice_form.html.twig' with {report_notice_kind:'campaign'} %}{% elseif app.request.attributes.get('_route') == 'app_espionage_report' %}{% include 'ui/report_notice_form.html.twig' with {report_notice_kind:'espionage'} %}{% endif %}
{% block intel_content %}
{% if incoming_detection|default(false) %}
<section class="panel report-summary report-summary--detected"><h2>Sonde adverse aperçue</h2><p>Votre colonie a détecté une mission d’espionnage. Les sondes adverses n’ont obtenu aucun renseignement.</p></section>
{% else %}
<section class="panel report-summary {{ report.result == 'detected' ? 'report-summary--detected' : '' }}" role="status"><h2>{{ report.result == 'detected' ? 'Sondes détectées' : 'Renseignements obtenus' }}</h2>
{% if report.result == 'detected' %}<p>Le propriétaire a été averti et aucun renseignement n’a été obtenu.</p>{% else %}<p>{{ report.intelCategories }} catégorie(s) de renseignements obtenue(s).</p>{% endif %}<p class="muted">{{ report.probesSent|quantity }} sonde(s) envoyée(s) · Risque de détection estimé : {{ report.detectionChance }} %</p></section>
{% if report.result == 'detected' %}{% if not monitoring_context|default(null) %}<p><a class="secondary" href="{{ path('app_combat_simulation',{report:report.id}) }}">Reprendre ces renseignements dans le simulateur</a></p>{% endif %}
{% endif %}
{% if report.result != 'detected' %}
{% set unknown_categories = [] %}
{% for category,title in {resources:'Ressources et production', buildings:'Bâtiments', research:'Recherches', fleets:'Flottes', defenses:'Défenses fixes'} %}
    {% if report.snapshot[category] is not defined %}{% set unknown_categories = unknown_categories|merge([title]) %}{% endif %}
{% endfor %}
{% if playerBoard %}
    <nav class="ui-tabs report-section-nav" aria-label="Sections du rapport">
        <a href="#intel-details">Renseignements détaillés</a>
        {% if unknown_categories %}<a href="#intel-missing">Catégories non obtenues</a>{% endif %}
    </nav>
{% endif %}
<div class="player-intel-layout">
<section class="panel player-intel-core" aria-labelledby="intel-details"><h2 id="intel-details">Renseignements détaillés</h2>
{% if playerBoard and report.snapshot.resources is defined %}
    {# Cette synthèse ne lit que ce que la sonde a effectivement révélé ; le cas détecté ne passe pas ici. #}
    {% set snapshotSummary = report.snapshot.resources|filter((item, slug) => slug in ['metal','nano','electricity'] and item.stock is defined) %}
    {% if snapshotSummary %}
        <dl class="report-metrics intel-board-summary">{% for slug,item in snapshotSummary %}<div><dt>{{ item.label ?? slug }} observé</dt><dd>{{ item.stock|quantity(0) }}</dd></div>{% endfor %}</dl>
    {% endif %}
{% endif %}
{% for category, title in {resources:'Ressources et production', buildings:'Bâtiments', research:'Recherches', fleets:'Flottes', defenses:'Défenses fixes'} %}
{% if report.snapshot[category] is defined %}
<details class="intel-section" open><summary><h3>{{ title }}</h3></summary>{% set items = report.snapshot[category] %}
{% if items %}<div class="report-intel-grid">
{% for slug, item in items %}
    {% set variants = category in ['buildings', 'research'] and item.level is not defined ? item : {single: item} %}
    {% for tier, variant in variants %}
    <article class="report-intel-card intel-card"><h4>{{ variant.label ?? slug }}</h4>
    {% if tier != 'single' %}<span class="badge">{{ {basic:'Basique', intermediate:'Intermédiaire', superior:'Supérieur'}[tier]|default(tier) }}</span>{% endif %}
    {% if category == 'resources' %}
        <dl class="intel-facts"><div><dt>Stock</dt><dd>{{ variant.stock|quantity(0) }}</dd></div><div><dt>Production / s</dt><dd class="{{ variant.rate < 0 ? 'report-loss' : (variant.rate > 0 ? 'report-survivors' : 'muted') }}">{{ variant.rate > 0 ? '+' : '' }}{{ variant.rate|quantity(2) }}</dd></div><div><dt>Capacité</dt><dd>{{ variant.capacity|quantity(0) }}</dd></div></dl>
    {% elseif category in ['buildings', 'research'] %}<p>Niveau {{ variant.level }}</p>
    {% else %}<p>Quantité : {{ variant.quantity|quantity(0) }}</p>{% endif %}
    </article>
    {% endfor %}
{% endfor %}</div>{% else %}<p>Aucun élément détecté dans cette catégorie.</p>{% endif %}</details>
{% endif %}{% endfor %}</section>
<aside class="panel player-intel-aside">
{% if unknown_categories %}<section class="intel-unknown" aria-labelledby="intel-missing"><h2 id="intel-missing">Catégories non obtenues</h2><p>Renseignements inconnus, sans confirmation d’absence. Ce n’est pas une valeur nulle.</p><ul>{% for category in unknown_categories %}<li><strong>{{ category }}</strong> : inconnu</li>{% endfor %}</ul></section>{% endif %}
{% if not monitoring_context|default(null) %}<p><a class="secondary" href="{{ path('app_combat_simulation',{report:report.id}) }}">Reprendre ces renseignements dans le simulateur</a></p>{% endif %}
</aside>
</div>
{% endif %}
{% endif %}
{% endblock %}
</div>
{% endblock %}
