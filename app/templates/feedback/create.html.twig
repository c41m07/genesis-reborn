{% extends 'base.html.twig' %}
{% block title %}Envoyer un feedback · Genesis Reborn{% endblock %}
{% block body %}
<section class="entry-workspace information-workspace feedback-workspace social-board social-board--feedback" data-page-sections="disabled" aria-labelledby="feedback-title">
    <h1 id="feedback-title">Envoyer un feedback</h1><p>Signalez un bug, partagez une idée ou décrivez votre expérience.</p>
    {% if errors %}<div id="feedback-errors" class="flash error feedback-errors" role="alert" tabindex="-1" autofocus aria-labelledby="feedback-errors-title"><h2 id="feedback-errors-title">Votre retour n’a pas été envoyé</h2><ul>{% for error in errors %}<li>{{ error }}</li>{% endfor %}</ul><p>Corrigez les informations ci-dessous. Si vous aviez joint une capture, sélectionnez-la de nouveau.</p></div>{% endif %}
    {% set selectedType = app.request.request.get('type', '') %}
    {% set selectedPriority = app.request.request.get('priority', 'medium') %}
    {# Le focus natif peut laisser le résumé hors écran après un POST.
       La destination du formulaire donne au navigateur l’ancre à afficher, même sans JavaScript. #}
    <form method="post" action="{{ path('app_feedback') }}#feedback-errors" enctype="multipart/form-data" class="feedback-form feedback-layout" data-controller="feedback-attachment" data-feedback-attachment-max-size-value="5242880">
        <input type="hidden" name="_token" value="{{ csrf_token('create_feedback') }}">
        <fieldset class="account-section feedback-primary"><legend>Votre retour</legend><p>Le type, le titre et la description sont obligatoires.</p>
            <div class="account-grid">
                <div><label for="type">Type</label><select id="type" name="type" required><option value="">Choisir…</option>{% for value,label in {'bug':'Bug','suggestion':'Suggestion','improvement':'Amélioration','other':'Autre'} %}<option value="{{ value }}" {{ selectedType == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
                <div><label for="priority">Priorité ressentie</label><select id="priority" name="priority">{% for value,label in {'low':'Faible','medium':'Moyenne','high':'Élevée'} %}<option value="{{ value }}" {{ selectedPriority == value ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></div>
            </div>
            <label for="title">Titre</label><input id="title" name="title" maxlength="120" required aria-describedby="feedback-title-help" value="{{ app.request.request.get('title') }}"><p id="feedback-title-help" class="field-help">Résumez votre retour en 120 caractères maximum.</p>
            <label for="description">Description détaillée</label><textarea id="description" name="description" maxlength="5000" rows="8" required aria-describedby="feedback-description-help">{{ app.request.request.get('description') }}</textarea><p id="feedback-description-help" class="field-help">Jusqu’à 5 000 caractères. Pour un bug, indiquez les étapes, le résultat attendu et le résultat obtenu.</p>
            <div class="feedback-optional-fields">
                <div class="feedback-source"><fieldset><legend>Page concernée</legend><label for="context_url">Lien de la page concernée (facultatif)</label><input id="context_url" name="context_url" type="url" maxlength="500" value="{{ contextUrl }}" aria-describedby="feedback-context-help"><p id="feedback-context-help" class="field-help">Le lien est prérempli depuis la page où vous avez ouvert ce formulaire. Vous pouvez le modifier ou l’effacer.</p></fieldset></div>
                <div class="feedback-upload">
                    <h2>Capture facultative</h2>
                    <label for="screenshot">Joindre une capture</label>
                    <input id="screenshot" name="screenshot" type="file" accept="image/jpeg,image/png,image/webp" aria-describedby="feedback-screenshot-help" data-feedback-attachment-target="input" data-action="change->feedback-attachment#update">
                    <p id="feedback-screenshot-help" class="field-help">JPEG, PNG ou WebP · 5 Mo maximum.</p>
                    <p class="field-help" role="status" data-feedback-attachment-target="status"></p>
                </div>
            </div>
            <div class="feedback-actions"><p>Votre univers, si sélectionné, accompagne votre retour.</p><button class="primary" type="submit">Envoyer mon retour</button></div>
        </fieldset>
        <div class="feedback-context">
            <section class="account-section feedback-attachment-panel" aria-labelledby="feedback-attachment-heading">
                <h2 id="feedback-attachment-heading">Aperçu de la capture</h2>
                <p>Choisissez une image pour l’apercevoir avant d’envoyer votre retour. Seule l’équipe de modération pourra consulter votre capture.</p>
                <figure class="feedback-preview" data-feedback-attachment-target="preview" hidden>
                    <img alt="Aperçu de la capture choisie" data-feedback-attachment-target="image">
                    <figcaption data-feedback-attachment-target="filename"></figcaption>
                </figure>
                <div class="feedback-preview-actions">
                    <button class="secondary" type="button" data-feedback-attachment-target="zoom" data-action="feedback-attachment#open" hidden>Agrandir la capture</button>
                    <button class="secondary" type="button" data-feedback-attachment-target="remove" data-action="feedback-attachment#clear" hidden>Retirer la capture</button>
                </div>
                <dialog class="feedback-preview-dialog" aria-labelledby="feedback-preview-title" aria-describedby="feedback-preview-keyboard-help" data-feedback-attachment-target="dialog">
                    <h2 id="feedback-preview-title">Capture choisie</h2>
                    <img alt="Capture choisie agrandie" data-feedback-attachment-target="enlarged">
                    <button class="secondary feedback-preview-close" type="button" data-action="feedback-attachment#close">Fermer</button>
                    <p id="feedback-preview-keyboard-help" class="feedback-preview-keyboard-help">Appuyez sur Échap pour fermer l’aperçu et revenir au bouton « Agrandir la capture ».</p>
                </dialog>
            </section>
            <aside class="account-section social-feedback-guidance" aria-labelledby="feedback-player-report-title">
                <h2 id="feedback-player-report-title">Signalement d’un joueur</h2>
                <p>Depuis le classement, utilisez l’action de signalement du commandant concerné. Le motif est transmis à la modération, pas au joueur.</p>
                <a class="secondary" href="{{ path('app_leaderboard') }}">Ouvrir le classement</a>
            </aside>
        </div>
    </form>
</section>
{% endblock %}


