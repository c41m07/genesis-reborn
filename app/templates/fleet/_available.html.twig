{# Garder les formulaires dans available-fleets permet de préserver leur saisie et leur focus lors des actualisations. #}{% import 'ui/macros.html.twig' as ui %}
{% set espionage_screen = prefill.mission == 'spy' %}
<div data-live-region="available-fleets">
{% if tutorial_spy|default(false) %}
    <aside class="panel account-panel" aria-labelledby="fleet-tutorial-spy">
        <h2 id="fleet-tutorial-spy">Premiers pas : espionnage PNJ</h2>
        <p>Choisissez exactement une Sonde de reconnaissance basique et une cible connue dont le propriétaire est affiché « PNJ ». Cette sonde est consommée à l’arrivée. La première sonde perdue dans ce parcours est remplacée après le rapport, même en cas de détection.</p>
        <a href="{{ path('app_first_steps') }}">Revenir au guide</a>
    </aside>
{% endif %}
{% for row in idle %}{% set f=row.fleet %}<section class="panel fleet-form"><form method="post" action="{{ path('app_fleet_send') }}" data-controller="fleet-fields fleet-preview fleet-wizard fleet-quantity fleet-destination" data-fleet-destination-url-value="{{ path('app_fleet_destinations') }}" data-fleet-wizard-origin-value="{{ f.homePlanet.name }} · {{ f.homePlanet.coordinates() }}" data-fleet-quantity-limit-value="{{ fleet_limit }}" data-fleet-preview-url-value="{{ path('app_fleet_preview') }}" data-action="input->fleet-fields#dirty change->fleet-fields#update input->fleet-quantity#invalidate change->fleet-quantity#invalidate input->fleet-preview#schedule change->fleet-preview#schedule fleet-preview:quoted->fleet-quantity#quote fleet-preview:quoted->fleet-wizard#quote input->fleet-wizard#updateRecap change->fleet-wizard#updateRecap change->fleet-destination#changed"><input type="hidden" name="_token" value="{{ csrf_token('fleet') }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="origin" value="{{ f.homePlanet.id }}">{% if tutorial_spy|default(false) %}<input type="hidden" name="tutorial_spy" value="1">{% endif %}{% if loaded_origin==f.homePlanet.id %}<input type="hidden" name="require_exact_composition" value="1"><p role="status">Composition chargée après vérification. Les quantités ne seront pas réduites automatiquement.</p>{% endif %}<p class="quantity-status" role="status" data-fleet-quantity-target="status"></p><div class="core-fleet-composition-layout">
<div class="core-fleet-side">
    {% include 'fleet/_composition_recap.html.twig' with {fleetId:f.id, origin:f.homePlanet.name ~ ' · ' ~ f.homePlanet.coordinates()} only %}
    {% if loop.first %}{% include 'fleet/_mission_summary.html.twig' %}{% endif %}
</div>
<div class="core-fleet-steps">
<div class="fleet-wizard-header"><h2>Départ de {{ f.homePlanet.name }}</h2><span class="badge" data-fleet-wizard-target="counter">Étape 1 / 3</span></div>
<nav class="fleet-wizard-steps" aria-label="Étapes de la mission">{% for step in [{number:1,label:'Composition'},{number:2,label:'Destination'},{number:3,label:'Confirmation'}] %}<span data-fleet-wizard-target="indicator" data-step="{{ step.number }}"><i>{{ step.number }}</i>{{ step.label }}</span>{% endfor %}</nav>
<p class="fleet-wizard-error" role="alert" data-fleet-wizard-target="error" hidden></p>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-1" data-fleet-wizard-target="step" data-step="1" aria-labelledby="fleet-step-title-{{ f.id }}-1">
    <h3 id="fleet-step-title-{{ f.id }}-1" tabindex="-1">Composez votre flotte</h3>
    <p class="muted">Départ depuis {{ f.homePlanet.name }} · sélectionnez les vaisseaux de cette colonie.</p>
    {% if tutorial_spy %}
        <label for="tutorial-probe-{{ f.id }}">Sonde de reconnaissance basique</label>
        <input id="tutorial-probe-{{ f.id }}" type="number" name="ships[probe][basic]" value="1" min="1" max="1" readonly
               data-fleet-wizard-target="quantity" data-ship-label="Sonde de reconnaissance basique" data-ship-family="Sonde de reconnaissance" data-ship-type="probe" data-ship-tier="basic">
    {% else %}
        {% include 'fleet/_ship_selection_table.html.twig' with {
            ships: row.ships, catalog: catalog, fleetId: f.id, fleetLimit: fleet_limit,
            headingId: 'fleet-step-title-' ~ f.id ~ '-1',
            loaded: loaded_origin == f.homePlanet.id, loadedComposition: loaded_composition
        } only %}
        <p class="fleet-wizard-note">Pour coloniser, un vaisseau de colonisation est requis. Les défenses stationnaires ne peuvent pas rejoindre une flotte.</p>
    {% endif %}
    <div class="fleet-wizard-actions" data-fleet-wizard-target="stageActions" data-step="1"><button type="button" class="primary" data-action="fleet-wizard#next" aria-controls="fleet-step-{{ f.id }}-2">Choisir la destination {{ ui.icon('arrow') }}</button></div>
</section>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-2" data-fleet-wizard-target="step" data-step="2" aria-labelledby="fleet-step-title-{{ f.id }}-2"><h3 id="fleet-step-title-{{ f.id }}-2" tabindex="-1">Choisissez la destination</h3><div class="fleet-destination-grid"><div><label for="mission-{{ f.id }}">Mission</label><select id="mission-{{ f.id }}" name="mission">{% if tutorial_spy %}<option value="spy">Espionnage PNJ guidé</option>{% else %}<option value="explore" {{ prefill.mission=='explore'?'selected':'' }}>Exploration d'un système</option><option value="colonize" {{ prefill.mission=='colonize'?'selected':'' }}>Colonisation d'une planète</option><option value="transport" {{ prefill.mission=='transport'?'selected':'' }}>Transport de ressources</option><option value="attack" {{ prefill.mission=='attack'?'selected':'' }}>Attaque d’une planète</option><option value="spy" {{ prefill.mission=='spy'?'selected':'' }}>Espionnage d’une planète connue</option>{% if conquest_enabled %}<option value="conquer" {{ prefill.mission=='conquer'?'selected':'' }}>Conquête JcE</option>{% endif %}<option value="defend" {{ prefill.mission=='defend'?'selected':'' }}>Défense d’une planète</option><option value="orbit" {{ prefill.mission=='orbit'?'selected':'' }}>Mise en orbite</option><option value="station" {{ prefill.mission=='station'?'selected':'' }}>Stationnement</option>{% endif %}</select><label for="ratio-{{ f.id }}">Vitesse</label><select name="ratio" id="ratio-{{ f.id }}">{% for i in 1..10 %}<option value="{{ i/10 }}" {{ i==10?'selected':'' }}>{{ i*10 }} %</option>{% endfor %}</select>{% if tutorial_spy %}<div data-fleet-fields-target="orbit" hidden></div>{% else %}<div data-fleet-fields-target="orbit"><label for="orbit-hours-{{ f.id }}">Durée d’orbite (heures, 1 à 168)</label><input id="orbit-hours-{{ f.id }}" name="orbit_hours" type="number" min="1" max="168" step="1" value="24"></div>{% endif %}</div><div>{% include 'ui/fleet_destination.html.twig' %}</div></div>{% if tutorial_spy %}<div data-fleet-fields-target="cargo" hidden></div>{% else %}<details data-fleet-fields-target="cargo" open><summary>Fret (transport ou stationnement)</summary><p>Transport : le surplus de stockage revient avec la flotte. Stationnement : le surplus reste embarqué sur la nouvelle base. Les dons et stationnements ne donnent aucun boost ni objectif de livraison.</p><div class="resource-grid">{% for slug in constant('App\\Service\\Colony\\ResourceService::DISPLAY_ORDER') %}{% set label = resources[slug] %}<div><label for="cargo-{{ f.id }}-{{ slug }}">{{ label }}</label><div class="quantity-input"><input id="cargo-{{ f.id }}-{{ slug }}" type="number" min="0" max="100000000" name="cargo[{{ slug }}]" value="0" data-fleet-quantity-target="cargo" data-resource="{{ slug }}" data-action="input->fleet-quantity#clampCargo"><button type="button" class="secondary quantity-max" disabled data-fleet-quantity-target="cargoMax" data-action="fleet-quantity#maximumCargo" data-input-id="cargo-{{ f.id }}-{{ slug }}" aria-label="Max : charger le maximum de {{ label }}">Max</button></div></div>{% endfor %}</div></details>{% endif %}<div class="fleet-wizard-actions" data-fleet-wizard-target="stageActions" data-step="2"><button type="button" class="secondary" data-action="fleet-wizard#previous">Retour à la composition</button><button type="button" class="primary" data-action="fleet-wizard#next" aria-controls="fleet-step-{{ f.id }}-3">Vérifier la mission {{ ui.icon('arrow') }}</button></div></section>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-3" data-fleet-wizard-target="step" data-step="3" aria-labelledby="fleet-step-title-{{ f.id }}-3"><h3 id="fleet-step-title-{{ f.id }}-3" tabindex="-1">Confirmez votre mission</h3>{# Le devis reste dans le formulaire et son contrôleur conserve le verrouillage de l’envoi. #}
<div class="fleet-review-grid"><div><h4>Votre mission</h4><div class="fleet-mission-summary" data-fleet-wizard-target="summary">La composition et la destination apparaîtront ici.</div></div><div class="core-fleet-quote" data-fleet-wizard-target="quotePanel"><h3 class="core-fleet-quote-title">Estimation du trajet</h3><div class="flight-estimate" aria-live="polite" data-fleet-preview-target="result">Estimez le trajet avant de confirmer.</div></div></div><p class="muted">Chaque vaisseau consomme du carburant; la réserve aller-retour est vérifiée au départ. À 50 % de vitesse, le trajet dure deux fois plus longtemps et consomme deux fois moins. Les sondes sont consommées à l’arrivée des missions d’exploration et d’espionnage; le vaisseau colonie est consommé lors d’une colonisation réussie. Une attaque ouvre une fenêtre de combat de dix minutes.</p><div class="fleet-wizard-actions" data-fleet-wizard-target="stageActions" data-step="3"><button type="button" class="secondary" data-action="fleet-wizard#previous">Modifier la destination</button><button type="button" class="secondary" data-action="fleet-preview#estimate">Estimer le trajet</button><button class="primary" {{ fuel_pending?'disabled':'' }}>Envoyer la flotte ↗</button></div></section></div></div></form></section>{% else %}<section class="panel empty-state fleet-empty-state">{{ ui.icon('fleet') }}<h2>{{ tutorial_spy ? 'Aucune sonde de reconnaissance basique disponible' : (espionage_screen ? 'Aucune sonde exploratrice disponible' : 'Aucun vaisseau disponible') }}</h2><p>{{ tutorial_spy ? 'Construisez une Sonde de reconnaissance basique pour cet exercice.' : (espionage_screen ? 'Construisez une sonde exploratrice pour préparer une mission d’espionnage.' : 'Construisez vos vaisseaux avant de préparer une mission.') }}</p>{% if chrome.planet %}<a class="inline-link" href="{{ path('app_colony',{id:chrome.planet.id,section:'ships',_fragment:espionage_screen?'item-probe-basic':'panel-ships'}) }}">Accéder au chantier spatial {{ ui.icon('arrow') }}</a>{% endif %}</section>{% endfor %}
</div>
