<div class="fleet-dock-layout" data-live-region="fleet-holds">
    <section class="panel fleet-dock-ships" aria-labelledby="dock-ships-title">
        <h2 id="dock-ships-title">Vaisseaux mobiles à quai · colonie active</h2>
        <p>La colonie fournit le carburant à chaque départ. Le carburant restant à l’arrivée à quai est perdu.</p>
        {% for row in idle %}
            <ul class="fleet-dock-ship-list">
                {% for ship in row.ships %}
                    <li><span>{{ catalog[ship.slug].tier_labels[ship.tier]|default(catalog[ship.slug].label) }}</span><strong>{{ ship.quantity|quantity(0) }}</strong></li>
                {% endfor %}
            </ul>
        {% else %}
            <p>Aucun vaisseau mobile disponible sur cette colonie.</p>
        {% endfor %}
        <a class="primary" href="{{ path('app_fleet_prepare') }}">Préparer un départ</a>
    </section>
{% include 'fleet/holds.html.twig' %}
</div>
