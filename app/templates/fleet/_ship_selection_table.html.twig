{% import 'ui/macros.html.twig' as ui %}
{% set isEscort = isEscort|default(false) %}
{% set readOnly = readOnly|default(false) %}
{% set ranks = {basic: 'Basique', intermediate: 'Intermédiaire', superior: 'Supérieur'} %}
<table class="data-table fleet-composition-table" aria-labelledby="{{ headingId }}">
    <thead>
        <tr>
            <th scope="col">Élément</th>
            {% for rank in ranks %}
                <th scope="col">{{ rank }}</th>
            {% endfor %}
        </tr>
    </thead>
    {% for category, families in ship_table_groups(ships, catalog) %}
    <tbody>
        <tr class="fleet-type-heading"><th scope="rowgroup" colspan="4">{{ category }}</th></tr>
        {% for slug, family in families %}
            {% set definition = family.definition %}
            {% set availableByTier = family.tiers %}
            <tr>
                <th scope="row">
                    <span class="fleet-composition-name">{{ ui.icon(ship_category_icon(definition)) }} {{ definition.label }}</span>
                    {% if not readOnly and not isEscort and definition.economic_unit is defined %}
                        <span class="fleet-composition-restriction">Stationnement entre vos colonies, sans fret</span>
                    {% endif %}
                </th>
                {% for tier, rank in ranks %}
                    {% set ship = availableByTier[tier]|default(null) %}
                    {% set quantity = ship.quantity|default(0) %}
                    {% set label = definition.tier_labels[tier]|default(definition.label) %}
                    {% if readOnly %}
                        <td>{{ quantity|number_format(0, ',', ' ') }}</td>
                    {% else %}
                        {% set inputId = 'ship-' ~ fleetId ~ '-' ~ slug ~ '-' ~ tier %}
                        {% set stockId = inputId ~ '-stock' %}
                        {# PHP ne peut pas recevoir simultanément ships[type] et ships[type][rang].
                           Le format historique reste utilisé quand seul le rang Basique est disponible. #}
                        {% set rankedName = 'ships[' ~ slug ~ '][' ~ tier ~ ']' %}
                        {% set basicAlias = tier == 'basic' ? 'ships[' ~ slug ~ ']' : null %}
                        {# Une cellule vide ne crée pas de nouveau choix et seul Flottes change les noms
                           des champs après mise à jour par son devis. #}
                        {% set inputName = isEscort ? (ship ? 'escort[' ~ ship.ordinal ~ ']' : null) : (basicAlias and availableByTier|length == 1 ? basicAlias : rankedName) %}
                        {% set selected = loaded ? loadedComposition[slug][tier]|default(0) : 0 %}
                        <td>
                            <span class="fleet-composition-stock" id="{{ stockId }}">
                                <span class="visually-hidden">Disponibles : </span><span data-fleet-stock-value>({{ quantity|number_format(0, ',', ' ') }})</span>
                            </span>
                            <div class="fleet-composition-control">
                                <input id="{{ inputId }}" type="number" min="0" max="{{ min(quantity, fleetLimit) }}" step="1" value="{{ quantity > 0 ? selected : 0 }}"
                                       aria-label="Quantité · {{ label }} · {{ rank }}" aria-describedby="{{ stockId }}"
                                       data-available="{{ quantity }}" data-ship-label="{{ label }}" data-ship-family="{{ definition.label }}" data-ship-type="{{ slug }}" data-ship-tier="{{ tier }}"
                                       data-fleet-quantity-target="ship" data-action="input->fleet-quantity#clampShip"
                                       {% if not isEscort %}
                                           data-fleet-wizard-target="quantity" data-ship-ranked-name="{{ rankedName }}"
                                           {% if basicAlias %}data-ship-basic-alias="{{ basicAlias }}"{% endif %}
                                       {% elseif quantity > 0 %}required{% endif %}
                                       {# Un rang indisponible n’a pas de clé de formulaire ; le devis peut le réactiver via type/rang. #}
                                       {% if quantity > 0 %}name="{{ inputName }}"{% else %}disabled{% endif %}>
                                <button type="button" class="secondary fleet-composition-maximum" aria-label="Max : sélectionner le maximum de {{ label }} · {{ rank }}"
                                        data-action="fleet-quantity#maximumShip" data-input-id="{{ inputId }}"
                                        {% if isEscort or progressiveMax|default(false) %}hidden data-fleet-quantity-target="progressiveMax"{% endif %}
                                        {% if quantity == 0 %}disabled{% endif %}><span aria-hidden="true">Max</span></button>
                            </div>
                        </td>
                    {% endif %}
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
    {% endfor %}
</table>
