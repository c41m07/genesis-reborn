{% extends 'base.html.twig' %}
{% block title %}Compositions de flotte · Genesis Reborn{% endblock %}
{% block body %}
<div class="strategic-page">
<div class="page-heading"><div><h1>Compositions de flotte</h1><p>{{ compositions|length }} / 20 dans cet univers. Réutilisables entre vos colonies.</p></div><a class="secondary" href="{{ path('app_fleets') }}">Préparer une mission</a></div>
{% if error %}<p role="alert" class="flash error">{{ error }}</p>{% endif %}
<section class="panel"><h2>{{ editing ? 'Modifier la composition' : 'Créer une composition' }}</h2>
<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('fleet_compositions') }}"><input type="hidden" name="id" value="{{ editing.id|default(0) }}"><input type="hidden" name="version" value="{{ editing.version|default(0) }}"><input type="hidden" name="request_key" value="{{ app.request.request.get('request_key')|default(request_key()) }}">
<label for="composition-name">Nom de la composition</label><input id="composition-name" name="name" value="{{ draft.name|default('') }}" maxlength="80" required>
<div class="table-scroll" tabindex="0" role="region" aria-label="Tableau défilant horizontalement"><table class="data-table composition-editor"><caption>Types, rangs et quantités souhaités</caption><thead><tr><th>Vaisseau</th>{% for tier,label in {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'} %}<th>{{ label }}</th>{% endfor %}</tr></thead><tbody>
{% for slug,ship in catalog %}<tr><th scope="row">{{ ship.label }}</th>{% for tier,label in {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'} %}<td><label class="visually-hidden" for="composition-{{ slug }}-{{ tier }}">{{ ship.label }} · {{ label }}</label><input id="composition-{{ slug }}-{{ tier }}" name="ships[{{ slug }}][{{ tier }}]" type="number" min="0" max="{{ limit }}" value="{{ draft.ships[slug][tier]|default(0) }}" required></td>{% endfor %}</tr>{% endfor %}</tbody></table></div>
<p>Enregistrer une composition ne construit et n’envoie aucun vaisseau. Les disponibilités seront vérifiées avant chargement.</p><button class="primary">Enregistrer la composition</button>{% if editing %}<a class="secondary" href="{{ path('app_fleet_compositions') }}">Créer une autre composition</a>{% endif %}</form></section>
<section aria-labelledby="saved-compositions-title"><h2 id="saved-compositions-title">Mes compositions</h2><div class="strategic-grid">{% for composition in compositions %}<article class="panel"><h3>{{ composition.name }}</h3><ul>{% for slug,tiers in composition.ships %}{% for tier,count in tiers %}<li>{{ catalog[slug].label|default(slug) }} · {{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[tier] }} : {{ count|quantity(0) }}</li>{% endfor %}{% endfor %}</ul><a class="primary" href="{{ path('app_fleet_composition_load',{id:composition.id}) }}">Vérifier et charger</a><a class="secondary" href="{{ path('app_fleet_compositions',{edit:composition.id}) }}">Modifier {{ composition.name }}</a>
<details><summary>Supprimer {{ composition.name }}</summary><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('fleet_compositions') }}"><input type="hidden" name="id" value="{{ composition.id }}"><input type="hidden" name="version" value="{{ composition.version }}"><input type="hidden" name="action" value="delete"><button class="secondary">Supprimer cette composition</button></form></details></article>{% else %}<p class="panel">Aucune composition enregistrée. Donnez-lui un nom et choisissez vos quantités ci-dessus.</p>{% endfor %}</div></section>
</div>
{% endblock %}
