{% for fleet in holds %}
    {% if fleet.cargo|reduce((sum, amount) => sum + amount, 0)>0 %}
        <section class="panel fleet-hold fleet-hold-reserve" aria-labelledby="hold-{{ fleet.id }}">
            <h2 id="hold-{{ fleet.id }}">Fret à quai</h2>
            <ul>
                {% for slug, amount in fleet.cargo %}
                    {% if amount>0 %}<li>{{ resources[slug] }} : {{ amount|quantity(2) }}</li>{% endif %}
                {% endfor %}
            </ul>
            <p>Le fret reste à bord jusqu’au déchargement. Les vaisseaux restant à quai doivent pouvoir porter les stocks conservés.</p>
            <div class="fleet-hold-actions">
                <form method="post" action="{{ path('app_fleet_unload',{planet:fleet.homePlanet.id}) }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('fleet_unload_'~fleet.homePlanet.id) }}">
                    <input type="hidden" name="request_key" value="{{ request_key() }}">
                    <input type="hidden" name="kind" value="cargo">
                    <button class="secondary">Décharger le fret</button>
                </form>
            </div>
            <p class="muted">Déchargement limité à la place disponible ; le surplus reste embarqué.</p>
        </section>
    {% endif %}
{% endfor %}
<section class="panel fleet-hold fleet-hold-waiting" aria-labelledby="held-fleets-title">
    <h2 id="held-fleets-title">Stationnements en attente · tout l’empire</h2>
    {% if held_fleets %}<p>Aucun coût de séjour. Les vaisseaux et les ressources sont conservés, sans nouveau combat.</p>{% endif %}
    <ul class="fleet-held-list">
        {% for fleet in held_fleets %}
            <li data-held-fleet="{{ fleet.id }}">
                <h3>Flotte {{ fleet.id }} · {{ fleet.destination.coordinates() }}</h3>
                <a class="secondary" href="{{ path('app_fleet_station_resume',{id:fleet.id}) }}">Reprendre le stationnement<span class="sr-only"> de la flotte {{ fleet.id }}</span></a>
                <details>
                    <summary>Composition et fret</summary>
                    <ul>{% for ship in held_details[fleet.id].ships %}<li>{{ ship.quantity|quantity }} × {{ ship.label }} · {{ ship.tier }}</li>{% endfor %}</ul>
                    <ul>{% for slug,resource in held_details[fleet.id].resources %}<li>{{ resource.label }} : {{ resource.stock|quantity(2) }}</li>{% endfor %}</ul>
                    <p>Carburant réservé : {{ fleet.reservedFuel|quantity(2) }} hydrogène.</p>
                </details>
            </li>
        {% else %}
            <li>Aucun stationnement en attente dans votre empire.</li>
        {% endfor %}
    </ul>
</section>
