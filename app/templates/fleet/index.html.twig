{% extends 'base.html.twig' %}{% block title %}{{ prefill.mission == 'spy' ? 'Espionnage' : 'Flottes et missions' }} · Genesis Reborn{% endblock %}{% block body %}{% import 'ui/macros.html.twig' as ui %}{% set espionage_screen = prefill.mission == 'spy' %}{% set mission_labels={explore:'Exploration',colonize:'Colonisation',transport:'Transport',attack:'Attaque',spy:'Espionnage',defend:'Défense',orbit:'Orbite',conquer:'Conquête JcE'} %}{% set status_labels={traveling:'En route',returning:'Retour en cours',attacking:'Combat en cours',defending:'En défense',completed:'Terminée',failed:'Échouée',orbiting:'En orbite',orbit_pending:'En attente d’acceptation'} %}<div class="fleet-page-layout {{ idle is empty ? 'fleet-page-layout--no-idle' : '' }} {{ espionage_screen ? 'fleet-page-layout--spy' : '' }}" data-controller="colony-live" data-colony-live-url-value="{{ path('app_fleets') }}"><div class="page-heading"><div><h1>{{ espionage_screen ? 'Espionnage' : 'Flottes et missions' }}</h1><p>{{ espionage_screen ? 'Envoyez des sondes vers une planète connue pour recueillir des renseignements. Le résultat détaillé apparaîtra dans vos rapports.' : 'Préparez vos expéditions, choisissez leur destination et suivez les mouvements de vos flottes.' }}</p></div></div>{% if fuel_pending %}<p class="flash" role="status">Les départs attendent la validation de la règle de consommation de carburant.</p>{% endif %}
<nav class="ui-tabs" aria-label="Rubriques des flottes"><a href="#prepare-mission">Préparer une mission</a><a href="#active-missions">Missions actives ({{ active_fleets|length }})</a><a href="#orbit-requests-title">Demandes d’orbite ({{ orbit_requests|length }})</a></nav><div class="fleet-workspace" id="prepare-mission"><div class="fleet-composer"><div data-live-region="available-fleets">{% for row in idle %}{% set f=row.fleet %}<section class="panel fleet-form"><div class="section-heading"><div><h2>Départ de {{ f.homePlanet.name }}</h2></div>{{ ui.icon("fleet") }}</div><form method="post" action="{{ path('app_fleet_send') }}" data-controller="fleet-fields fleet-preview fleet-wizard fleet-quantity fleet-destination" data-fleet-destination-url-value="{{ path('app_fleet_destinations') }}" data-fleet-wizard-origin-value="{{ f.homePlanet.name }} · {{ f.homePlanet.coordinates() }}" data-fleet-quantity-limit-value="{{ fleet_limit }}" data-fleet-preview-url-value="{{ path('app_fleet_preview') }}" data-action="input->fleet-fields#dirty change->fleet-fields#update input->fleet-quantity#invalidate change->fleet-quantity#invalidate input->fleet-preview#schedule change->fleet-preview#schedule fleet-preview:quoted->fleet-quantity#quote fleet-preview:quoted->fleet-wizard#updateSummary change->fleet-destination#changed"><input type="hidden" name="_token" value="{{ csrf_token('fleet') }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="origin" value="{{ f.homePlanet.id }}"><p class="quantity-status" role="status" data-fleet-quantity-target="status"></p><div class="fleet-wizard-header"><h3>Préparer une mission</h3><span class="badge" data-fleet-wizard-target="counter">Étape 1 / 3</span></div>
<nav class="fleet-wizard-steps" aria-label="Étapes de la mission">{% for step in [{number:1,label:'Composition'},{number:2,label:'Destination'},{number:3,label:'Confirmation'}] %}<span data-fleet-wizard-target="indicator" data-step="{{ step.number }}"><i>{{ step.number }}</i>{{ step.label }}</span>{% endfor %}</nav>
<p class="fleet-wizard-error" role="alert" data-fleet-wizard-target="error" hidden></p>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-1" data-fleet-wizard-target="step" data-step="1" aria-labelledby="fleet-step-title-{{ f.id }}-1"><h3 id="fleet-step-title-{{ f.id }}-1">Composez votre flotte</h3><p class="muted">Départ depuis {{ f.homePlanet.name }} · sélectionnez les vaisseaux de cette colonie.</p><div class="fleet-ship-list">{% for ship in row.ships %}{% if ship.quantity>0 %}<div class="quantity-choice"><label class="fleet-ship-choice" for="ship-{{ f.id }}-{{ ship.slug }}-{{ ship.tier }}"><span class="fleet-ship-icon">{{ ui.icon('fleet') }}</span><span class="fleet-ship-info"><strong>{{ catalog[ship.slug].tier_labels[ship.tier]|default(catalog[ship.slug].label) }}</strong><small>{{ ship.quantity|quantity }} disponible{{ ship.quantity>1?'s':'' }}</small></span><input type="number" min="0" max="{{ min(ship.quantity, fleet_limit) }}" data-available="{{ ship.quantity }}" data-fleet-quantity-target="ship" data-action="input->fleet-quantity#clampShip" value="0" {% if ship.tier=='basic' %}name="ships[{{ ship.slug }}]"{% else %}name="ships[{{ ship.slug }}][{{ ship.tier }}]"{% endif %} id="ship-{{ f.id }}-{{ ship.slug }}-{{ ship.tier }}" data-fleet-wizard-target="quantity"></label><button type="button" class="secondary quantity-max" data-action="fleet-quantity#maximumShip" data-input-id="ship-{{ f.id }}-{{ ship.slug }}-{{ ship.tier }}" aria-label="Sélectionner le maximum de {{ catalog[ship.slug].tier_labels[ship.tier]|default(catalog[ship.slug].label) }}">Max</button></div>{% endif %}{% endfor %}</div><p class="fleet-wizard-note">Pour coloniser, un vaisseau de colonisation est requis. Les défenses stationnaires ne peuvent pas rejoindre une flotte.</p><button type="button" class="primary" data-action="fleet-wizard#next" aria-controls="fleet-step-{{ f.id }}-2">Choisir la destination {{ ui.icon('arrow') }}</button></section>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-2" data-fleet-wizard-target="step" data-step="2" aria-labelledby="fleet-step-title-{{ f.id }}-2"><h3 id="fleet-step-title-{{ f.id }}-2">Choisissez la destination</h3><div class="fleet-destination-grid"><div><label for="mission-{{ f.id }}">Mission</label><select id="mission-{{ f.id }}" name="mission"><option value="explore" {{ prefill.mission=='explore'?'selected':'' }}>Exploration d'un système</option><option value="colonize" {{ prefill.mission=='colonize'?'selected':'' }}>Colonisation d'une planète</option><option value="transport" {{ prefill.mission=='transport'?'selected':'' }}>Transport de ressources</option><option value="attack" {{ prefill.mission=='attack'?'selected':'' }}>Attaque d’une planète</option><option value="spy" {{ prefill.mission=='spy'?'selected':'' }}>Espionnage d’une planète connue</option>{% if conquest_enabled %}<option value="conquer" {{ prefill.mission=='conquer'?'selected':'' }}>Conquête JcE</option>{% endif %}<option value="defend" {{ prefill.mission=='defend'?'selected':'' }}>Défense d’une planète</option><option value="orbit" {{ prefill.mission=='orbit'?'selected':'' }}>Stationnement en orbite alliée ou neutre</option></select><label for="ratio-{{ f.id }}">Vitesse</label><select name="ratio" id="ratio-{{ f.id }}">{% for i in 1..10 %}<option value="{{ i/10 }}" {{ i==10?'selected':'' }}>{{ i*10 }} %</option>{% endfor %}</select><div data-fleet-fields-target="orbit"><label for="orbit-hours-{{ f.id }}">Stationnement prévu (heures, 1 à 168)</label><input id="orbit-hours-{{ f.id }}" name="orbit_hours" type="number" min="1" max="168" step="1" value="24"></div></div><div>{% include 'ui/fleet_destination.html.twig' %}</div></div><details data-fleet-fields-target="cargo"><summary>Fret (transport uniquement)</summary><p>Vers vos colonies ou un joueur qui accepte vos livraisons. Le surplus de stockage revient avec la flotte. Les dons ne donnent aucun boost et ne font progresser aucun objectif.</p><div class="resource-grid">{% for slug,label in resources %}<div><label for="cargo-{{ f.id }}-{{ slug }}">{{ label }}</label><div class="quantity-input"><input id="cargo-{{ f.id }}-{{ slug }}" type="number" min="0" max="100000000" name="cargo[{{ slug }}]" value="0" data-fleet-quantity-target="cargo" data-resource="{{ slug }}" data-action="input->fleet-quantity#clampCargo"><button type="button" class="secondary quantity-max" disabled data-fleet-quantity-target="cargoMax" data-action="fleet-quantity#maximumCargo" data-input-id="cargo-{{ f.id }}-{{ slug }}" aria-label="Charger le maximum de {{ label }}">Max</button></div></div>{% endfor %}</div></details><div class="fleet-wizard-actions"><button type="button" class="secondary" data-action="fleet-wizard#previous">Retour à la composition</button><button type="button" class="primary" data-action="fleet-wizard#next" aria-controls="fleet-step-{{ f.id }}-3">Vérifier la mission {{ ui.icon('arrow') }}</button></div></section>
<section class="fleet-wizard-panel" id="fleet-step-{{ f.id }}-3" data-fleet-wizard-target="step" data-step="3" aria-labelledby="fleet-step-title-{{ f.id }}-3"><h3 id="fleet-step-title-{{ f.id }}-3">Confirmez votre mission</h3><div class="fleet-mission-summary" data-fleet-wizard-target="summary">La composition et la destination apparaîtront ici.</div><p class="muted">Chaque vaisseau consomme du carburant; la réserve aller-retour est vérifiée au départ. À 50 % de vitesse, le trajet dure deux fois plus longtemps et consomme deux fois moins. Les sondes sont consommées à l’arrivée des missions d’exploration et d’espionnage; le vaisseau colonie est consommé lors d’une colonisation réussie. Une attaque ouvre une fenêtre de combat de dix minutes.</p><div class="flight-estimate" aria-live="polite" data-fleet-preview-target="result">Estimez le trajet avant de confirmer.</div><div class="fleet-wizard-actions"><button type="button" class="secondary" data-action="fleet-wizard#previous">Modifier la destination</button><button type="button" class="secondary" data-action="fleet-preview#estimate">Estimer le trajet</button><button class="primary" {{ fuel_pending?'disabled':'' }}>Envoyer la flotte ↗</button></div></section></form></section>{% else %}<section class="panel empty-state fleet-empty-state">{{ ui.icon('fleet') }}<h2>{{ espionage_screen ? 'Aucune sonde exploratrice disponible' : 'Aucun vaisseau disponible' }}</h2><p>{{ espionage_screen ? 'Construisez une sonde exploratrice pour préparer une mission d’espionnage.' : 'Construisez vos vaisseaux avant de préparer une mission.' }}</p>{% if chrome.planet %}<a class="inline-link" href="{{ path('app_colony',{id:chrome.planet.id,section:'ships',_fragment:espionage_screen?'item-probe-basic':'panel-ships'}) }}">Accéder au chantier spatial {{ ui.icon('arrow') }}</a>{% endif %}</section>{% endfor %}
</div></div><aside class="fleet-operations-rail" id="active-missions">{% include 'ui/flights.html.twig' %}{% include 'ui/orbit_requests.html.twig' %}</aside></div></div>{% endblock %}
