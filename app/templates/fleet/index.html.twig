{% extends 'base.html.twig' %}
{% set pageTitle = fleet_page=='prepare' ? (prefill.mission=='spy' ? 'Espionnage' : 'Préparer une mission') : {missions:'Missions actives',orbits:'Demandes d’orbite',holds:'À quai et stationnements'}[fleet_page] %}
{% block title %}{{ pageTitle }} · Genesis Reborn{% endblock %}
{% block incoming_fleets %}{% endblock %}
{% block body %}
<div class="fleet-page-layout fleet-space{{ fleet_page in ['missions','prepare'] ? ' fleet-redesign' : '' }}" data-page-sections="disabled" data-fleet-colony="{{ fleet_planet ? fleet_planet.id : 0 }}" data-controller="colony-live" data-colony-live-url-value="{{ path(app.request.attributes.get('_route')) }}">
<div class="page-heading"><div><h1>{{ pageTitle }}</h1>{% if fleet_planet %}<p class="muted fleet-colony-scope">Colonie active : {{ fleet_planet.name }} · {{ fleet_planet.coordinates() }}</p>{% endif %}</div>{% if fleet_page=='missions' %}<a class="primary" href="{{ path('app_fleet_prepare') }}">Nouvelle mission</a>{% endif %}</div>
{% include 'fleet/_counts.html.twig' %}
{% if fleet_page=='prepare' %}
{% if fuel_pending %}<p class="flash" role="status">Les départs attendent la validation de la règle de consommation de carburant.</p>{% endif %}
<div class="fleet-workspace" id="prepare-mission"><div class="fleet-composer">{% include 'fleet/_available.html.twig' %}</div><aside class="fleet-operations-rail">{% include 'fleet/_mission_summary.html.twig' %}{% include 'ui/incoming_attacks.html.twig' %}</aside></div>
{% elseif fleet_page=='missions' %}
<div id="active-missions">{% include 'fleet/_pagination.html.twig' %}{% include 'ui/flights.html.twig' %}{% include 'ui/incoming_attacks.html.twig' %}</div>
{% elseif fleet_page=='orbits' %}
{% include 'ui/orbit_requests.html.twig' %}{% include 'ui/incoming_attacks.html.twig' with {incoming_panel:false} %}
{% elseif fleet_page=='holds' %}
{% include 'fleet/_dock.html.twig' %}{% include 'ui/incoming_attacks.html.twig' with {incoming_panel:false} %}
{% endif %}
</div>
{% endblock %}
