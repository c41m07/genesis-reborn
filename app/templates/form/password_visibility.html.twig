{% use 'form_div_layout.html.twig' with password_widget as base_password_widget %}
{% block password_widget %}
    <div class="password-field" data-controller="password-visibility">
        {% set attr = attr|merge({'data-password-visibility-target': 'input'}) %}
        {{ block('base_password_widget') }}
        {% include 'ui/password_toggle.html.twig' with {id: id} only %}
    </div>
{% endblock %}
