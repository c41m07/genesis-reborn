{% extends 'base.html.twig' %}
{% block title %}Patchnotes · Genesis Reborn{% endblock %}
{% block body %}
<div class="entry-workspace information-workspace patchnotes-workspace player-patchnotes-board" data-page-sections="disabled">
<section class="page-heading"><div><p class="patchnotes-board-eyebrow">Information · versions</p><h1>Patchnotes</h1><p>Les dernières évolutions de Genesis Reborn.</p></div></section>
{% if patchNotes is empty %}<section class="panel empty-state"><h2>Aucune patchnote publiée</h2><p>Les nouveautés du jeu apparaîtront ici.</p></section>{% else %}<div class="stack-list">{% for note in patchNotes %}<article class="panel patchnote-card"><header class="section-heading"><div><p class="badge">{{ note.version }}</p><h2>{{ note.title }}</h2><p class="muted"><time datetime="{{ note.publishedAt|date('c') }}">{{ note.publishedAt|date('d/m/Y') }}</time></p></div></header><p>{{ note.summary }}</p><details class="patchnote-details"><summary>Lire le détail<span class="visually-hidden"> de {{ note.title }}</span></summary><div class="patchnote-content">{{ note.content|nl2br }}</div></details></article>{% endfor %}</div>{% endif %}
</div>
{% endblock %}
