<details class="first-steps-popup" data-controller="first-steps-guide"
         data-first-steps-guide-scope-value="{{ planet.owner.id }}"
         data-first-steps-guide-url-value="{{ path('app_first_steps_panel', {colony: planet.id}) }}"
         data-action="toggle->first-steps-guide#rememberOpened keydown.esc->first-steps-guide#closeFromKeyboard">
    <summary class="quiet-button" data-first-steps-guide-target="summary" aria-label="Ouvrir Premiers pas"
             aria-controls="first-steps-popup-panel" title="Ouvrir Premiers pas"><span aria-hidden="true">‹</span></summary>
    <div id="first-steps-popup-panel" class="first-steps-popup-mount">
        <section class="panel first-steps-popup-panel first-steps-preview" data-first-steps-guide-target="preview"
                 aria-labelledby="first-steps-preview-title" hidden>
            <p class="first-steps-popup-eyebrow">PREMIERS PAS · {{ preview.count }}/{{ preview.total }}</p>
            <h2 id="first-steps-preview-title">{{ preview.guide.title }}</h2>
            <p>{{ preview.guide.action }}</p>
            <button type="button" class="quiet-button" data-action="first-steps-guide#showIllustrations">Voir l’étape illustrée</button>
        </section>
        <div class="panel first-steps-popup-panel" data-first-steps-guide-target="fallback">
            <p role="status" data-first-steps-guide-target="status" hidden></p>
            <a href="{{ path('app_first_steps') }}">Guide complet et remboursements</a>
        </div>
        <div data-first-steps-guide-target="content" hidden></div>
    </div>
</details>
