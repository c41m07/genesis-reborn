<div class="guild-foundation-layout">
    <section class="panel guild-create" aria-labelledby="guild-create-title">
        <h2 id="guild-create-title">Fondez votre guilde</h2>
        <p>Vous en prendrez le commandement.</p>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}">
            <input type="hidden" name="action" value="create">
            <div>
                <label for="guild-name">Nom de votre nouvelle guilde</label>
                <input id="guild-name" name="name" value="{{ guildCreationDraft.name|default('') }}" minlength="3" maxlength="60" aria-describedby="guild-name-help" required>
                <small id="guild-name-help">3 à 60 caractères.</small>
            </div>
            <div>
                <label for="guild-tag">Tag de la guilde</label>
                <input id="guild-tag" name="tag" value="{{ guildCreationDraft.tag|default('') }}" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" aria-describedby="guild-tag-help" required>
                <small id="guild-tag-help">2 à 5 lettres ou chiffres, affichés en majuscules. Unique dans cet univers.</small>
            </div>
            <button class="primary">Fonder une guilde</button>
            <a href="{{ path('app_guilds') }}">Ou trouver une guilde existante</a>
        </form>
    </section>
    <section class="panel guild-foundation-intro" aria-labelledby="guild-foundation-title">
        <h2 id="guild-foundation-title">Un empire se construit ensemble</h2>
        <p>Rassemblez des commandants autour de votre bannière.</p>
        <p>Nom et tag identifient votre guilde dans l’univers sélectionné.</p>
        <a class="secondary" href="{{ path('app_guilds') }}">Trouver une guilde</a>
    </section>
</div>
