{% set g=row.guild %}
<article class="panel guild-card"><span class="badge">{{ own ? relation_labels[row.status]|default(row.status) : 'Recrutement ouvert' }}</span><h3>{{ g.name }}</h3><p>Commandement : {{ g.leader.displayName }}<br>{{ row.members|length }} membre{{ row.members|length > 1 ? 's' : '' }}</p><details><summary>Voir les membres</summary><ul>{% for member in row.members %}<li>{{ member.playerUniverse.displayName }}</li>{% endfor %}</ul></details>
<div class="guild-hub-actions"><a href="{{ path('app_messages',{with:g.leader.id}) }}">Contacter le commandant</a></div>
{% if not own %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ g.id }}"><button class="secondary" name="action" value="join">Rejoindre · recrutement ouvert</button></form>
{% elseif guildPermissions['diplomacy.alliance'] or guildPermissions['diplomacy.hostility'] or guildPermissions['diplomacy.neutral'] %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ g.id }}"><input type="hidden" name="action" value="relation"><label for="relation-{{ g.id }}-{{ cardContext }}">Relation réciproque</label><select name="status" id="relation-{{ g.id }}-{{ cardContext }}">{% if guildPermissions['diplomacy.alliance'] %}<option value="allies">Proposer / accepter l'alliance</option>{% endif %}{% if guildPermissions['diplomacy.hostility'] %}<option value="enemies">Déclarer ennemis</option>{% endif %}{% if guildPermissions['diplomacy.neutral'] %}<option value="neutral">Revenir à la neutralité</option>{% endif %}</select><button class="secondary">Mettre à jour</button></form>{% endif %}</article>
