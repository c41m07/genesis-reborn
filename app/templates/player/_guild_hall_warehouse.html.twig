<section class="panel" aria-labelledby="hall-warehouse-title">
    <h2 id="hall-warehouse-title">Entrepôt de guilde</h2>
    <p>Niveau {{ warehouse.level }}. Ce stock est distinct des dons utilisés pour installer le Hall.</p>
    {% if not warehouse.enabled %}
        <p>Les opérations du Hall ne sont pas encore ouvertes.</p>
    {% else %}
        <dl class="hall-resource-fields">
            {% for entry in warehouse.materials %}
                <div>
                    <dt>{{ entry.label }}</dt>
                    <dd>{{ entry.held|number_format(0, ',', ' ') }} / {{ entry.capacity|number_format(0, ',', ' ') }}</dd>
                </div>
            {% endfor %}
        </dl>
        {% if warehouse.finishes_at %}
            <p>Niveau {{ warehouse.level + 1 }} en construction.</p>
        {% elseif warehouse.quote %}
            <h3>Passer au niveau {{ warehouse.level + 1 }}</h3>
            <ul>
                {% for entry in warehouse.materials %}
                    {% if entry.cost %}<li>{{ entry.label }} : {{ entry.cost|number_format(0, ',', ' ') }}</li>{% endif %}
                {% endfor %}
            </ul>
            <p>Durée : {{ warehouse.quote.duration|number_format(0, ',', ' ') }} s.</p>
            {% if not may_build %}
                <p>Seul le commandant peut lancer ce chantier hors mode vacances.</p>
            {% elseif not warehouse.can_pay %}
                <p>Le stock de guilde ne suffit pas pour lancer ce chantier.</p>
            {% else %}
                <form method="post" action="{{ path('app_guild_hall_build_warehouse') }}">
                    <input type="hidden" name="hall_id" value="{{ hall.id }}">
                    <input type="hidden" name="level" value="{{ warehouse.level }}">
                    <input type="hidden" name="_token" value="{{ csrf_token('guild_hall_build_warehouse_' ~ guild.id ~ '_' ~ hall.id) }}">
                    <label><input type="checkbox" name="confirm" value="1" required> Confirmer la dépense du stock de guilde</label>
                    <button type="submit" class="primary">Construire le niveau {{ warehouse.level + 1 }}</button>
                </form>
            {% endif %}
        {% else %}
            <p>Niveau maximal atteint.</p>
        {% endif %}
    {% endif %}
</section>
