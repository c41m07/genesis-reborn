{% import 'ui/macros.html.twig' as ui %}
{% set ownRow = null %}{% set alliedGuilds = 0 %}{% set enemyGuilds = 0 %}
{% for row in guilds %}{% if own and row.guild.id==own.id %}{% set ownRow=row %}{% elseif row.status=='allies' %}{% set alliedGuilds=alliedGuilds+1 %}{% elseif row.status=='enemies' %}{% set enemyGuilds=enemyGuilds+1 %}{% endif %}{% endfor %}
<section class="panel guild-hub-hero" aria-label="Centre de guilde">
    <span class="guild-hub-emblem" aria-hidden="true">{{ ui.icon('diplomacy') }}</span>
    <div><h2>{{ own ? own.name : 'Un empire se construit ensemble' }}</h2><p>{{ own ? 'Retrouvez votre équipage, échangez et préparez vos prochaines actions.' : 'Trouvez des alliés, partagez vos stratégies et rejoignez une guilde de votre univers.' }}</p></div>
    {% if own %}<a class="primary" href="{{ path('app_messages',{channel:'guild'}) }}">Ouvrir le canal de guilde {{ ui.icon('arrow') }}</a>{% endif %}
</section>
{% if not enabled %}<p class="panel">Les guildes sont désactivées dans cet univers. Les relations entre commandants restent accessibles dans l’onglet Relation.</p>
{% else %}
{% if own and ownRow %}
<div class="guild-hub-stats"><div class="panel"><strong>{{ ownRow.members|length }}</strong><span>Membres</span></div><div class="panel"><strong>{{ alliedGuilds }}</strong><span>Guildes alliées</span></div><div class="panel"><strong>{{ enemyGuilds }}</strong><span>Guildes ennemies</span></div><div class="panel"><strong>{{ own.leader.id==membership.id ? 'Commandant' : (ownMember.rank.name|default('Membre')) }}</strong><span>Votre rôle</span></div></div>
<div class="guild-hub-columns">
<section class="panel"><div class="section-heading"><h2>Équipage</h2><span class="badge">{{ ownRow.members|length }}</span></div><ul class="guild-member-list">
{% for member in ownRow.members %}<li><span class="avatar" aria-hidden="true">{{ member.playerUniverse.displayName|first|upper }}</span><div><strong>{{ member.playerUniverse.displayName }}</strong><small>{{ member.playerUniverse.id==own.leader.id ? 'Commandant' : (member.rank.name|default('Membre')) }}{{ member.playerUniverse.id==membership.id ? ' · Vous' : '' }}</small></div>{% if member.playerUniverse.id!=membership.id %}<a class="secondary" href="{{ path('app_messages',{with:member.playerUniverse.id}) }}" aria-label="Contacter {{ member.playerUniverse.displayName }}">Écrire</a>{% endif %}</li>{% endfor %}
</ul></section>
<div class="guild-hub-side"><section class="panel"><div class="section-heading"><h2>Derniers échanges</h2><a href="{{ path('app_messages',{channel:'guild'}) }}">Tout lire</a></div>{% for message in guildPreview %}<article class="guild-message-preview"><div><strong>{{ message.sender.displayName }}</strong><time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m H:i',preferences.timezone) }}</time></div><p>{{ message.content|length > 160 ? message.content|slice(0,160) ~ '…' : message.content }}</p></article>{% else %}<p>Le canal est prêt. Lancez la première discussion avec votre guilde.</p>{% endfor %}</section>
<section class="panel"><h2>Coordination</h2><p>Consultez vos alliés et vos adversaires avant de préparer une action commune.</p><div class="guild-hub-actions"><a class="secondary" href="{{ path('app_diplomacy',{tab:'diplomacy'}) }}">Diplomatie de guilde</a><a class="secondary" href="{{ path('app_guild_projects') }}">Projets collectifs</a><a class="secondary" href="{{ path('app_map_v2') }}">Ouvrir la galaxie</a><a class="secondary" href="{{ path('app_leaderboard') }}">Classement</a></div></section></div>
</div>
{% include 'player/_guild_ranks.html.twig' %}
<section class="guild-hub-management" aria-label="Gestion de la guilde"><p>Les dons de projet restent définitifs après un départ. Pour recevoir la récompense, vous devez appartenir à la guilde à la clôture du projet.</p>
{% if own.leader.id==membership.id %}<details class="panel"><summary>Gérer le commandement</summary><p>Transférez le commandement avant de quitter votre guilde, ou dissolvez-la. Les contrats personnels sont conservés. Dissoudre la guilde abandonne ses projets en cours, sans rembourser les dons.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><label for="successor">Nouveau commandant</label><select id="successor" name="target" {% if ownRow.members|length < 2 %}disabled{% endif %}>{% for row in guilds %}{% if row.guild.id==own.id %}{% for member in row.members %}{% if member.playerUniverse.id!=membership.id %}<option value="{{ member.playerUniverse.id }}">{{ member.playerUniverse.displayName }}</option>{% endif %}{% endfor %}{% endif %}{% endfor %}</select><button class="secondary" name="action" value="transfer" {% if ownRow.members|length < 2 %}disabled{% endif %}>Transférer le commandement</button></form><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><button class="text-button" name="action" value="disband">Dissoudre la guilde</button></form></details>{% endif %}{% if own.leader.id!=membership.id %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><button class="text-button" name="action" value="leave">Quitter la guilde</button></form>{% endif %}</section>
{% else %}<section class="panel guild-create"><div><h2>Fondez votre guilde</h2><p>Rassemblez des commandants autour de votre bannière. Vous en prendrez le commandement.</p></div><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="action" value="create"><label for="guild-name">Nom de votre nouvelle guilde</label><input id="guild-name" name="name" minlength="3" maxlength="60" required><button class="primary">Fonder une guilde</button></form></section>{% endif %}
{% if not own %}<section class="panel"><h2>Trouver une guilde</h2><p>Découvrez les guildes de votre univers depuis la recherche de diplomatie.</p><a class="secondary" href="{{ path('app_diplomacy',{tab:'diplomacy'}) }}">Rechercher une guilde</a></section>{% endif %}
{% endif %}
