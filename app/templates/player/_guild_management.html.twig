{% if own.leader.id==membership.id %}
<div class="guild-hub-management">
    <section class="panel guild-tag-settings" aria-labelledby="guild-tag-title">
        <h3 id="guild-tag-title">{{ own.tag ? 'Modifier le tag de la guilde' : 'Choisir le tag de la guilde' }}</h3>
        <form method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}">
            <input type="hidden" name="action" value="tag">
            <label for="guild-tag-edit">Tag de la guilde</label>
            <input id="guild-tag-edit" name="tag" value="{{ own.tag }}" minlength="2" maxlength="5" pattern="[A-Za-z0-9]{2,5}" autocomplete="off" aria-describedby="guild-tag-edit-help" required>
            <small id="guild-tag-edit-help">2 à 5 lettres ou chiffres, affichés en majuscules. Unique dans cet univers.</small>
            <button class="primary">Enregistrer le tag</button>
        </form>
    </section>
    <section class="panel" aria-labelledby="guild-command-title">
        <h3 id="guild-command-title">Gérer le commandement</h3>
        <form method="post" class="guild-transfer-form">
            <input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}">
            <label for="successor">Nouveau commandant</label>
            <select id="successor" name="target" {% if ownRow.members|length < 2 %}disabled{% endif %}>
                {% for member in ownRow.members %}
                    {% if member.playerUniverse.id!=membership.id %}
                        <option value="{{ member.playerUniverse.id }}">{{ member.playerUniverse.displayName }}</option>
                    {% endif %}
                {% endfor %}
            </select>
            {% if ownRow.members|length < 2 %}<p>Aucun autre membre ne peut recevoir le commandement.</p>{% endif %}
            <details class="guild-action-review">
                <summary>Vérifier le transfert</summary>
                <p>Le membre sélectionné deviendra commandant. Vous perdrez les droits réservés au commandant ; les contrats personnels seront conservés.</p>
                <button class="secondary" name="action" value="transfer" {% if ownRow.members|length < 2 %}disabled{% endif %}>Transférer le commandement</button>
            </details>
        </form>
    </section>
</div>
{% endif %}
