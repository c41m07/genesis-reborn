    <article class="panel project-overview" aria-labelledby="project-title-{{ project.id }}">
        <h2 id="project-title-{{ project.id }}">Progression et contribution</h2><p>{{ project.snapshot.description }}</p>
        <p class="badge {{ project.status }}">{{ project.status=='completed' ? 'Terminé' : (project.status=='abandoned' ? 'Abandonné' : 'En cours') }}</p>
        {% if project.status=='active' %}
            <h3>Palier {{ project.stageIndex+1 }} sur {{ project.snapshot.stages|length }} · {{ project.snapshot.stages[project.stageIndex].name }}</h3>
            <ul class="guild-stage-progress">
                {% for resource, remaining in row.remaining %}
                    {% set required = project.snapshot.stages[project.stageIndex].costs[resource] %}
                    {% set contributed = project.progress[resource]|default(0) %}
                    <li>
                        <label for="guild-project-progress-{{ project.id }}-{{ resource }}">{{ resources[resource] }}</label>
                        <span>{{ contributed|quantity(0) }} / {{ required|quantity(0) }} · reste {{ remaining|quantity(0) }}</span>
                        {% if required > 0 %}
                            <progress id="guild-project-progress-{{ project.id }}-{{ resource }}" value="{{ contributed }}" max="{{ required }}">{{ contributed }} sur {{ required }}</progress>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>

        {% endif %}
        <section class="project-personal-recap{% if row.qualified and project.status=='active' %} project-personal-recap--qualified{% endif %}" aria-labelledby="project-personal-title-{{ project.id }}">
            <h3 id="project-personal-title-{{ project.id }}">Votre contribution et les minimums</h3>
            <ul>{% for resource,minimum in project.snapshot.minimums %}<li>{{ resources[resource] }} : {{ row.own[resource]|default(0) }} / {{ minimum }}</li>{% endfor %}</ul>
            {% if row.rewarded %}<p>Vous avez déjà gagné le boost de ce modèle de projet. Il ne peut pas être gagné une seconde fois, même après changement de guilde ou création d’un nouvel empire.</p>{% elseif project.status=='active' %}<p>{{ row.qualified ? 'Minimums atteints. Restez membre jusqu’à la fin pour recevoir le boost.' : 'Atteignez tous les minimums et restez membre jusqu’à la fin pour recevoir le boost.' }}</p>{% endif %}
        </section>

        {% if project.status=='completed' %}
            <p>{{ project.rewardsDeliveredAt ? 'Distribution des récompenses terminée.' : 'Récompenses en cours de distribution.' }}</p>
            <p>{{ membership.id in project.eligibleIds ? 'Vous avez rempli les conditions à la clôture.' : 'Vous ne remplissiez pas les conditions à la clôture.' }}</p><a href="{{ path('app_boosts') }}">Consulter l’inventaire et sa file d’attente</a>
        {% endif %}
        <details id="project-contributions"{% if contributionCursor %} open{% endif %}><summary>Contributions des membres</summary><p>Contributions de la plus récente à la plus ancienne.</p><ul>{% for contribution in row.contributions %}<li>{{ contribution.name }} : {% for resource,amount in contribution.resources %}{{ resources[resource] }} {{ amount }}{{ not loop.last ? ', ' : '' }}{% endfor %}</li>{% else %}<li>Aucun don pour le moment.</li>{% endfor %}</ul>
        {% if contributionCursor or nextContributionCursor %}<nav class="ui-tabs" aria-label="Pagination des contributions">{% if contributionCursor %}<a href="{{ path('app_guild_project',{id:project.id,_fragment:'project-contributions'}) }}">Revenir aux contributions récentes</a>{% endif %}{% if nextContributionCursor %}<a rel="next" href="{{ path('app_guild_project',{id:project.id,before_contribution:nextContributionCursor,_fragment:'project-contributions'}) }}">Voir les contributions précédentes</a>{% endif %}</nav>{% endif %}
        </details>
        <details><summary>Conditions et paliers figés au lancement</summary><ol>{% for stage in project.snapshot.stages %}<li>{{ stage.name }} : {% for resource,amount in stage.costs %}{{ resources[resource] }} {{ amount }}{{ not loop.last ? ', ' : '' }}{% endfor %}</li>{% endfor %}</ol></details>
    </article>
