{% if not readOnly %}
<form method="post" action="{{ path('app_guild_project_contribute',{id:project.id}) }}">
    <input type="hidden" name="_token" value="{{ csrf_token('guild_project_donation_'~project.id) }}"><input type="hidden" name="version" value="{{ project.version }}">
    <label for="project-{{ project.id }}-planet">Colonie qui fournit les ressources</label>
    <select id="project-{{ project.id }}-planet" name="planet_id" required>{% for planet in planets %}<option value="{{ planet.id }}">{{ planet.name }}</option>{% endfor %}</select>
    <div class="form-grid">
        {% for resource,remaining in row.remaining %}{% if remaining>0 %}
        <div>
            <label for="project-{{ project.id }}-{{ resource }}">Don {{ resources[resource] }}</label>
            <input id="project-{{ project.id }}-{{ resource }}" name="resources[{{ resource }}]" type="number" min="0" max="{{ remaining }}" step="1" value="0" aria-describedby="project-{{ project.id }}-{{ resource }}-limit">
            <p class="project-donation-limit" id="project-{{ project.id }}-{{ resource }}-limit">Maximum : {{ remaining }}</p>
        </div>
        {% endif %}{% endfor %}
    </div>
    <p>Ces ressources seront prélevées définitivement sur la colonie choisie.</p><button class="primary">Donner ces ressources</button>
</form>
{% endif %}
