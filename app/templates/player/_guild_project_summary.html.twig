<article class="panel guild-project" aria-labelledby="project-title-{{ project.id }}">
<h3 id="project-title-{{ project.id }}"><a href="{{ path('app_guild_project',{id:project.id}) }}">{{ project.snapshot.name }}</a></h3>
<p class="badge">{{ project.status=='completed' ? 'Terminé' : (project.status=='abandoned' ? 'Abandonné' : 'En cours') }}</p>
{% if project.status=='active' %}<h4>Palier {{ project.stageIndex+1 }} sur {{ project.snapshot.stages|length }} · {{ project.snapshot.stages[project.stageIndex].name }}</h4>
{% for resource,remaining in row.remaining %}{% set total=project.snapshot.stages[project.stageIndex].costs[resource] %}<label>{{ resources[resource] }} : {{ project.progress[resource]|default(0) }} / {{ total }}<progress max="{{ total }}" value="{{ project.progress[resource]|default(0) }}">{{ project.progress[resource]|default(0) }} / {{ total }}</progress></label>{% endfor %}{% endif %}
<h4>Votre contribution et les minimums</h4><ul>{% for resource,minimum in project.snapshot.minimums %}<li>{{ resources[resource] }} : {{ row.own[resource]|default(0) }} / {{ minimum }}</li>{% endfor %}</ul>
{% if row.rewarded %}<p>Vous avez déjà gagné le boost de ce modèle de projet.</p>{% endif %}
<a class="secondary" href="{{ path('app_guild_project',{id:project.id}) }}">{{ project.status=='active' ? 'Consulter et contribuer' : 'Consulter le bilan' }}</a>
</article>
