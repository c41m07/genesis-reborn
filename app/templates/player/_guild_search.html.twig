{% set discoverySearch = discoverySearch|default(false) %}
{% if discoverySearch %}
<section class="panel guild-discovery-search" id="guild-search" aria-labelledby="guild-search-title">
<h2 id="guild-search-title">Rejoignez une guilde</h2>
{% endif %}
<form id="guild-search-form" method="get" action="{{ path(own ? 'app_diplomacy' : 'app_guilds') }}" class="relation-search" role="search" aria-label="Recherche de guildes">
<label for="guild-search-query">Rechercher une guilde</label>
<input id="guild-search-query" type="search" name="q" value="{{ search }}" minlength="2" maxlength="60" placeholder="Nom de guilde…" required>
<button class="secondary">Rechercher</button>
</form>
{% if discoverySearch %}
    <a class="primary guild-create-shortcut" href="{{ path('app_guild_create') }}">Créer une guilde</a>
</section>
{% endif %}
{% if showGuildSearchResults is not defined or showGuildSearchResults %}
    {% include 'player/_guild_search_results.html.twig' %}
{% endif %}
