{% if search %}<section class="relation-results" aria-label="Résultats de recherche de guildes">
<div class="section-heading"><h3>Résultats pour « {{ search }} »</h3><a href="{{ path(own ? 'app_diplomacy' : 'app_guilds') }}">Fermer la recherche</a></div>
<div class="catalog-grid guild-search-results">{% for row in guildSearchResults %}{% include 'player/_guild_diplomacy_card.html.twig' with {cardContext:'search'} %}{% else %}<p role="status">{{ search|length < 2 ? 'Saisissez au moins deux caractères.' : 'Aucune guilde trouvée dans cet univers.' }}</p>{% endfor %}</div>
</section>{% endif %}
