{% import 'ui/macros.html.twig' as ui %}
<nav class="inbox-list" aria-label="Conversations">
    <a class="inbox-item {{ activeChannel=='global' ? 'active' : '' }}" href="{{ path('app_messages',{channel:'global'}) }}" {% if activeChannel=='global' %}aria-current="page"{% endif %}><span class="inbox-icon" aria-hidden="true">{{ ui.icon('notifications') }}</span><span class="inbox-item-copy"><strong>Global</strong><small>Discussion de cet univers · sans notifications</small></span></a>
    {% if guild %}<a class="inbox-item {{ activeChannel=='guild' ? 'active' : '' }}" href="{{ path('app_messages',{channel:'guild'}) }}" {% if activeChannel=='guild' %}aria-current="page"{% endif %}><span class="inbox-icon">{{ ui.icon('diplomacy') }}</span><span class="inbox-item-copy"><strong>Canal de guilde · {{ guild.name }}</strong><small>Conversation de guilde</small></span>{% if unreadGuild %}<span class="message-unread-dot" role="img" aria-label="Messages non lus"></span>{% endif %}</a>{% endif %}
    {% for contact in contacts %}{% set member = contact.member %}<a class="inbox-item {{ peer and peer.id==member.id and activeChannel=='private' ? 'active' : '' }}" href="{{ path('app_messages',{with:member.id}) }}" {% if peer and peer.id==member.id and activeChannel=='private' %}aria-current="page"{% endif %}><span class="inbox-icon">{{ ui.icon('user') }}</span><span class="inbox-item-copy"><strong>{{ member.displayName }}</strong><small>Conversation privée</small></span>{% if contact.unread %}<span class="message-unread-dot" role="img" aria-label="Messages non lus"></span>{% endif %}</a>{% endfor %}
</nav>
{% if contacts is empty %}<div class="inbox-empty"><p>Aucune conversation privée pour le moment.</p><small>Recherchez un joueur pour démarrer un échange.</small></div>{% endif %}
