{% import 'ui/macros.html.twig' as ui %}
<nav class="inbox-list" aria-label="Conversations">
    <div class="inbox-group-label" aria-hidden="true">Canaux</div>
    <a class="inbox-item {{ activeChannel=='global' ? 'active' : '' }}" href="{{ path('app_messages',{channel:'global'}) }}" {% if activeChannel=='global' %}aria-current="page"{% endif %}><span class="inbox-icon" aria-hidden="true">{{ ui.icon('notifications') }}</span><span class="inbox-item-copy"><strong>Global</strong><small>Discussion de cet univers · sans notifications</small></span></a>
    {% if guild %}<a class="inbox-item {{ activeChannel=='guild' ? 'active' : '' }}" href="{{ path('app_messages',{channel:'guild'}) }}" {% if activeChannel=='guild' %}aria-current="page"{% endif %}><span class="inbox-icon">{{ ui.icon('diplomacy') }}</span><span class="inbox-item-copy"><strong>Canal de guilde · {{ guild.name }}</strong><small>Conversation de guilde</small></span>{% if unreadGuild %}<span class="message-unread-dot" role="img" aria-label="Messages non lus"></span>{% endif %}</a>{% else %}
        <div class="inbox-item--unavailable"><span class="inbox-icon" aria-hidden="true">{{ ui.icon('diplomacy') }}</span><span class="inbox-item-copy"><strong>Canal de guilde indisponible</strong><small><a class="inbox-guild-hint" href="{{ path('app_guilds') }}">Rejoignez une guilde pour y accéder.</a></small></span></div>
    {% endif %}
    <div class="inbox-group-label" aria-hidden="true">Conversations privées</div>
    {% for contact in contacts %}{% set member = contact.member %}<a class="inbox-item {{ peer and peer.id==member.id and activeChannel=='private' ? 'active' : '' }}" href="{{ path('app_messages',{with:member.id}) }}" {% if peer and peer.id==member.id and activeChannel=='private' %}aria-current="page"{% endif %}><span class="inbox-icon">{{ ui.icon('user') }}</span><span class="inbox-item-copy"><strong>{{ member.displayName }}</strong><small>Conversation privée</small></span><span class="inbox-contact-meta">{% if contact.sentAt|default(null) %}<time datetime="{{ contact.sentAt|date('c') }}">{{ contact.sentAt|date('d/m H:i', preferences.timezone|default(null)) }}</time>{% endif %}{% if contact.unread %}<span class="inbox-unread-count" role="img" aria-label="Messages non lus" aria-description="{{ contact.unread }} {{ contact.unread == 1 ? 'message non lu' : 'messages non lus' }}">{{ contact.unread|quantity(0) }}<span class="visually-hidden">{{ contact.unread == 1 ? ' message non lu' : ' messages non lus' }}</span></span>{% endif %}</span></a>{% endfor %}
</nav>
{% if contacts is empty %}<div class="inbox-empty"><p>Aucune conversation privée pour le moment.</p><small>Recherchez un joueur pour démarrer un échange.</small></div>{% endif %}
