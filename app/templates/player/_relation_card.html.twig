<article class="panel commander-card">
    <span class="avatar" aria-hidden="true">{{ row.player.player.username|first|upper }}</span>
    <h3>{{ row.player.player.username }}</h3>
    <p>{{ row.enemy ? 'Ennemi · diplomatie de guilde' : (row.allied ? 'Allié' : (row.contract ? (row.contract.proposer.id==membership.id ? 'Proposition envoyée' : 'Proposition reçue') : 'Neutre')) }}</p>
    <a href="{{ path('app_messages',{with:row.player.id}) }}">Envoyer un message</a>
    <form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ row.player.id }}">
        {% if not row.contract %}{% if not row.allied and not row.enemy %}<button class="secondary" name="action" value="propose">Proposer une alliance</button>{% endif %}
        {% else %}{% if row.contract.status=='pending' and row.contract.proposer.id!=membership.id %}<button class="primary" name="action" value="accept">Accepter l'alliance</button>{% endif %}<button class="text-button" name="action" value="break">{{ row.contract.status=='accepted'?'Rompre le contrat':'Annuler / refuser' }}</button>{% endif %}
    </form>
</article>
