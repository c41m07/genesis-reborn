{% extends 'base.html.twig' %}
{% block title %}Récompense quotidienne · Genesis Reborn{% endblock %}
{% block body %}
{% import 'ui/macros.html.twig' as ui %}
<div class="daily-reward-player-board">
<div class="page-heading">
    <div>
        <p class="daily-board-eyebrow">Opérations · progression</p>
        <h1>Récompense quotidienne</h1>
        <p>Un retrait par jour pour votre compte, tous univers confondus. Le jour change à minuit (heure de Paris).</p>
    </div>
    {% if planet %}<a class="quiet-button" href="{{ path('app_colony', {id: planet.id}) }}">Retour à la vue générale</a>{% endif %}
</div>
<section class="panel account-panel" aria-labelledby="daily-reward-heading">
    <h2 id="daily-reward-heading" tabindex="-1">Jour {{ status.slot }} sur 7</h2>
    <ol class="daily-board-cycle" aria-label="Les sept jours du cycle">
        {% for day in 1..7 %}<li{{ day == status.slot ? ' aria-current="step"' }}><span>Jour {{ day }}</span></li>{% endfor %}
    </ol>
    <p>Univers actif : <strong>{{ universe.name }}</strong>.</p>
    {% if status.claimed %}
        <p>Votre compte a déjà récupéré son lot du jour. Revenez après minuit (heure de Paris).</p>
        <a class="quiet-button" href="{{ path('app_daily_reward', planet ? {colony: planet.id} : {}) }}">Actualiser la récompense</a>
    {% elseif not planet %}
        <p>Vous devez contrôler une planète dans cet univers pour récupérer le lot.</p>
    {% else %}
        <dl class="daily-reward-resource-lines daily-board-kpis" aria-label="Contenu du lot">
            <div><dt>{{ ui.icon('metal') }} Métal</dt><dd>{{ status.reward.metal|quantity(0) }}</dd></div>
            <div><dt>{{ ui.icon('nano') }} Nano</dt><dd>{{ status.reward.nano|quantity(0) }}</dd></div>
        </dl>
        <p id="daily-reward-rules">Le lot doit tenir en entier dans vos stocks. Si vous manquez un jour, le cycle ne repart pas à zéro.</p>
        <p id="daily-reward-destination">Planète destinataire : <strong>{{ planet.name }}</strong> ({{ planet.coordinates() }}).</p>
        {% if destinations|length > 1 %}
        <form class="daily-board-destination" method="get" action="{{ path('app_daily_reward') }}">
            <div>
                <label for="daily-destination">Changer de destination</label>
                <select id="daily-destination" name="colony">
                    {% for destination in destinations %}<option value="{{ destination.id }}"{% if destination.id == planet.id %} selected{% endif %}>{{ destination.name }} ({{ destination.coordinates() }})</option>{% endfor %}
                </select>
            </div>
            <button type="submit" class="quiet-button">Choisir cette planète</button>
        </form>
        {% endif %}
        {% include 'player/_daily_reward_claim_form.html.twig' with {
            planet: planet,
            status: status,
            tokenId: tokenId,
            submitLabel: 'Récupérer',
            rulesId: 'daily-reward-rules daily-reward-destination'
        } only %}
    {% endif %}
</section>
</div>
{% endblock %}
