{% extends 'base.html.twig' %}
{% block title %}Événements · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Événements</h1><p>Les rendez-vous en cours et à venir dans votre univers. Horaires : {{ preferences.timezone }}.</p></div><span class="badge">{{ events|length + challenges|length }} événement{{ (events|length + challenges|length) > 1 ? 's' : '' }}</span></div>
{% set typeLabels = {'production_bonus':'Bonus de production','construction_speed':'Vitesse de construction','research_speed':'Vitesse de recherche','fleet_speed':'Vitesse des flottes','special':'Événement spécial','reward':'Récompense','announcement':'Annonce'} %}
{% set eventNow = date() %}
<div class="event-list">
{% if challenges %}<section class="panel"><h2>Défis et rotations hebdomadaires</h2><p>Objectifs de l’univers, contributions individuelles et récompenses annoncées. Les derniers défis et rotations sont accessibles ci-dessous.</p><ul class="challenge-list">{% for challenge in challenges %}<li><a href="{{ path('app_challenge',{id:challenge.event.id}) }}">{{ challenge.name }}</a><span>{{ challenge.status_label }} · {{ challenge.event.totalContribution|quantity(2) }} / {{ challenge.goal|quantity(2) }}</span></li>{% endfor %}</ul></section>{% endif %}
{% for eventGroup,groupLabel in {current:'En cours',upcoming:'À venir'} %}
<section aria-labelledby="events-{{ eventGroup }}"><h2 id="events-{{ eventGroup }}">{{ groupLabel }}</h2>
{% for event in events|filter(event => eventGroup=='upcoming' ? event.startsAt > eventNow : event.startsAt <= eventNow) %}
    {% set upcoming = event.startsAt > eventNow %}
    <article class="panel event-card" aria-labelledby="event-{{ event.id }}-title">
        <div class="event-meta"><span class="badge {{ upcoming ? '' : 'event-active' }}">{{ upcoming ? 'À venir' : 'En cours' }}</span><span class="muted">{{ typeLabels[event.type]|default(event.type|replace({'_':' '})|capitalize) }} · {{ event.universe ? event.universe.name : 'Tous les univers' }}</span></div>
        <h2 id="event-{{ event.id }}-title">{{ event.name }}</h2>
        {% if event.description %}<p class="event-description">{{ event.description }}</p>{% endif %}
        {% if event.type == 'production_bonus' %}<p class="event-effect">Production des ressources : <strong>+{{ event.parameters.percentage }} %</strong></p>{% endif %}
        <dl class="event-period"><div><dt>Début</dt><dd><time datetime="{{ event.startsAt|date('c', 'UTC') }}">{{ event.startsAt|date('d/m/Y à H:i', preferences.timezone) }}</time></dd></div><div><dt>Fin</dt><dd><time datetime="{{ event.endsAt|date('c', 'UTC') }}">{{ event.endsAt|date('d/m/Y à H:i', preferences.timezone) }}</time></dd></div></dl>
    </article>
{% else %}<p>{{ eventGroup=='current' ? 'Aucun événement en cours dans cet univers.' : 'Aucun événement à venir annoncé.' }}</p>
{% endfor %}</section>
{% endfor %}
</div>
{% endblock %}
