{% extends 'base.html.twig' %}
{% block title %}{{ pageTitle }} · Projets collectifs · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-refinement guild-project-space project-redesign social-board social-board--guild-projects" data-page-sections="disabled">
<div class="page-heading"><div><h1>{{ pageTitle }}</h1><p>{% if guild %}Projets collectifs de <strong>{{ guild.name }}</strong>, dans l’univers {{ membership.universe.name }}.{% else %}Financez les paliers avec votre guilde et gagnez un boost selon votre contribution.{% endif %}</p></div>{% if page=='ongoing' %}<a class="primary" href="{{ path('app_guild_projects_available') }}">Découvrir les projets disponibles</a>{% else %}<a class="secondary" href="{{ path('app_guild_projects') }}">Voir les projets en cours</a>{% endif %}</div>
{% include 'ui/guild_navigation.html.twig' with {compactNavigation:true} %}
{% include 'ui/guild_project_navigation.html.twig' %}
{% if not enabled %}<p class="panel">Les guildes sont désactivées dans cet univers.</p>
{% elseif not guild %}<p class="panel">Rejoignez une guilde pour participer à ses projets collectifs. <a href="{{ path('app_guilds') }}">Rejoindre une guilde</a></p>
{% else %}
{% if page=='available' %}
<p>Choisissez un projet à financer ensemble. Chaque modèle ne peut être lancé qu’une fois par guilde.</p>
{% if readOnly %}<p class="panel">Pendant les vacances, vous pouvez consulter les projets mais pas les lancer ni donner de ressources.</p>{% endif %}
<section id="available-projects-title" aria-label="Projets disponibles" class="guild-project-grid">
{% for row in available %}{% set definition=row.definition %}
<article class="panel project-model">
    <div class="project-model-description">
        <h2>{{ definition.name }}</h2><p>{{ definition.description }}</p>
        <details><summary>Conditions et paliers du projet</summary><ol>{% for stage in definition.stages %}<li>{{ stage.name }} : {% for resource,amount in stage.costs %}{{ resources[resource] }} {{ amount }}{{ not loop.last ? ', ' : '' }}{% endfor %}</li>{% endfor %}</ol></details>
    </div>
    <div class="project-model-launch">
        <h3>Pour recevoir un boost</h3>
        {# Les minimums restent visibles avant le lancement ; seul le détail des paliers est dépliable. #}
        <p>Contribuez au moins {% for resource,amount in definition.minimums %}{{ amount }} {{ resources[resource] }}{{ not loop.last ? ' et ' : '' }}{% endfor %}, et restez membre jusqu’à la fin.</p>
        {% if row.rewarded %}<p>Votre compte a déjà obtenu ce boost pour ce modèle ; vous pouvez aider sans gagner une nouvelle récompense.</p>{% endif %}
        {% if canStart %}<form method="post" action="{{ path('app_guild_project_start',{id:definition.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('guild_project_start_'~definition.id) }}"><input type="hidden" name="version" value="{{ definition.version }}"><button class="primary">Lancer {{ definition.name }}</button></form>{% else %}<p>Le dirigeant ou un membre autorisé peut lancer ce projet.</p>{% endif %}
    </div>
</article>
{% else %}<p class="panel">Aucun nouveau projet disponible dans cet univers.</p>{% endfor %}
</section>
{% else %}
<section id="{{ page=='history' ? 'completed-projects-title' : 'ongoing-projects-title' }}" aria-label="{{ pageTitle }}">
{% if page=='history' %}<p>Retrouvez les projets terminés ou abandonnés et le bilan de vos contributions.</p>{% else %}<p>Choisissez un projet pour consulter ses besoins et contribuer depuis l’une de vos colonies. Les dons sont définitifs.</p>{% endif %}
<div class="guild-project-grid">{% for row in rows %}{% set project=row.project %}{% include 'player/_guild_project_summary.html.twig' %}{% else %}<div class="panel"><p>{{ page=='history' ? 'Aucun projet terminé ou abandonné.' : 'Aucun projet en cours.' }}</p><a href="{{ path('app_guild_projects_available') }}">Consulter les projets disponibles</a></div>{% endfor %}</div>
</section>
{% endif %}
{% if beforeCursor or nextCursor %}<nav class="ui-tabs" aria-label="Pagination des projets">{% if beforeCursor %}<a href="{{ path(route) }}">Revenir au début</a>{% endif %}{% if nextCursor %}<a rel="next" href="{{ path(route,{before:nextCursor}) }}">Voir la suite</a>{% endif %}</nav>{% endif %}
{% endif %}
</div>
{% endblock %}
