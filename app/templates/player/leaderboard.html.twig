{% extends 'base.html.twig' %}
{% import 'ui/ranking_change.html.twig' as evolution %}
{% block title %}Classement · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Classement</h1><p>Classement des commandants par catégorie. Les points suivent les ressources engagées dans les entités encore possédées. La flotte inclut les vaisseaux et les défenses fixes.</p><p>Actualisation chaque jour à 00 h, heure de Paris. Dernier calcul : <time datetime="{{ daily.updated_at|date('c') }}">{{ daily.updated_at|date('d/m/Y à H:i', 'Europe/Paris') }}</time>. Prochain : <time datetime="{{ daily.next_update|date('c') }}">{{ daily.next_update|date('d/m/Y à H:i', 'Europe/Paris') }}</time>.</p><p>{% if daily.comparison_at %}Évolutions depuis le calcul du {{ daily.comparison_at|date('d/m/Y à H:i', 'Europe/Paris') }} : + gain, − perte, = inchangé.{% else %}Premier calcul : les évolutions apparaîtront à la prochaine mise à jour.{% endif %} Les nouveaux joueurs et guildes rejoignent le classement au prochain calcul.</p></div></div>
<nav class="alliance-tabs ui-tabs" aria-label="Classements">{% for key,label in {players:'Joueurs',guilds:'Guildes'} %}<a href="{{ path('app_leaderboard',{tab:key,category:category}) }}" {% if tab==key %}class="active" aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
{% if tab=='players' %}
<form method="get" class="ranking-category">
    <input type="hidden" name="tab" value="players">
    <label for="ranking-category">Catégorie du classement</label>
    <select id="ranking-category" name="category">{% for key,label in categories %}<option value="{{ key }}" {{ key==category ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>
    <button class="secondary">Afficher</button>
</form>
<p class="ranking-legend"><span class="ranking-label ranking-label--enemy">Ennemi</span><span class="ranking-label ranking-label--guild">Allié de guilde</span><span class="ranking-label ranking-label--commander">Allié commandant</span></p>
<div class="panel table-scroll" role="region" tabindex="0" aria-label="Classement défilant horizontalement">
<table class="data-table ranking-table"><caption>Classement de l’univers {{ membership.universe.name }} · {{ categories[category] }}</caption>
<thead><tr><th scope="col">Rang</th><th scope="col">Commandant</th>{% for key,label in categories|filter((label,key) => key != "points") %}<th scope="col" {% if category==key %}aria-sort="descending"{% endif %}>{{ label }}{% if category==key %} <span aria-hidden="true">↓</span>{% endif %}</th>{% endfor %}<th scope="col" {% if category=="points" %}aria-sort="descending"{% endif %}>Points totaux{% if category=="points" %} <span aria-hidden="true">↓</span>{% endif %}</th><th scope="col">Actions</th></tr></thead>
<tbody>{% for row in rows %}<tr class="ranking-row--{{ row.relation }}" {% if row.membership.id==membership.id %}aria-current="true"{% endif %}>
<td>#{{ row.ranks[category] }} {{ evolution.inline(row.rank_changes[category], "Places") }}</td><th scope="row">{% if row.guild_tag %}[{{ row.guild_tag }}] {% endif %}{{ row.membership.player.username }}{% if row.relation in ['enemy','guild','commander'] %}<small class="ranking-relation">{{ {enemy:'Ennemi',guild:'Allié de guilde',commander:'Allié commandant'}[row.relation] }}</small>{% endif %}
{% if row.protection.active %}<span class="player-protection-shield" role="img" aria-label="Protection temporaire active" title="{{ row.protection.reason }} · jusqu’au {{ row.protection.until|date('d/m/Y H:i',preferences.timezone) }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6L12 2z"/></svg></span>{% endif %}{% if row.membership.id==membership.id %}<span class="badge">Vous</span>{% endif %}</th>
{% for key,field in {buildings:'building_points',research:'research_points',fleet:'fleet_points',planets:'planets',points:'total_points'} %}<td data-category="{{ key }}">{{ row[field]|quantity(0) }} {{ evolution.inline(row.score_changes[key], key=='planets' ? 'Planètes' : 'Points') }}</td>{% endfor %}
<td>{% if row.membership.id!=membership.id %}<a class="leaderboard-contact" href="{{ path('app_messages',{with:row.membership.id}) }}" aria-label="Contacter {{ row.membership.player.username }}" title="Contacter {{ row.membership.player.username }}"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a><a class="leaderboard-report" href="{{ path('app_player_report',{id:row.membership.id,category:category,page:page}) }}" aria-label="Signaler {{ row.membership.player.username }}" title="Signaler {{ row.membership.player.username }}"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 2 21h20Z" fill="#f5c542" stroke="#765500" stroke-width="1.5"/><path d="M12 9v5" stroke="#302400" stroke-width="2"/><circle cx="12" cy="17" r="1" fill="#302400"/></svg></a>{% else %}<span class="muted">Vous</span>{% endif %}</td></tr>
{% else %}<tr><td colspan="8">Aucun commandant dans cet univers.</td></tr>{% endfor %}</tbody></table></div>
<nav aria-label="Pages du classement">{% if page > 1 %}<a class="secondary" href="{{ path('app_leaderboard',{category:category,page:page-1}) }}">Page précédente</a>{% endif %}<span>Page {{ page }} / {{ pages }}</span>{% if page < pages %}<a class="secondary" href="{{ path('app_leaderboard',{category:category,page:page+1}) }}">Page suivante</a>{% endif %}</nav>
{% else %}
<p class="ranking-legend"><span class="ranking-label ranking-label--guild">Guilde alliée</span><span class="ranking-label ranking-label--enemy">Guilde ennemie</span></p>
<div class="panel table-scroll" role="region" tabindex="0" aria-label="Classement des guildes défilant horizontalement"><table class="data-table ranking-table"><caption>Classement des guildes de l’univers {{ membership.universe.name }}</caption><thead><tr><th scope="col">Rang</th><th scope="col">Guilde</th><th scope="col">Joueurs</th><th scope="col">Points bâtiments</th><th scope="col">Points recherches</th><th scope="col">Points flotte</th><th scope="col" aria-sort="descending">Points totaux <span aria-hidden="true">↓</span></th><th scope="col">Médiane des points joueurs</th></tr></thead><tbody>
{% for row in guildRows %}<tr class="ranking-row--{{ row.relation }}" {% if ownGuild and ownGuild.id==row.guild.id %}aria-current="true"{% endif %}><td>#{{ row.rank }}<small class="ranking-relation">Places : {{ evolution.value(row.rank_change, "Places") }}</small></td><th scope="row">{{ row.guild.name }}{% if row.relation in ['guild','enemy'] and (not ownGuild or ownGuild.id!=row.guild.id) %}<small class="ranking-relation">{{ row.relation=='guild' ? 'Guilde alliée' : 'Guilde ennemie' }}</small>{% endif %}{% if ownGuild and ownGuild.id==row.guild.id %} <span class="badge">Votre guilde</span>{% endif %}</th><td>{{ row.members }}</td>{% for key in ['building_points','research_points','fleet_points','total_points'] %}<td>{{ row[key]|quantity(0) }}{% if key=="total_points" %}<small class="ranking-relation">Points : {{ evolution.value(row.points_change, "Points") }}</small>{% endif %}</td>{% endfor %}<td>{{ row.median_points|quantity(row.median_points != row.median_points|round(0,'floor') ? 1 : 0) }}</td></tr>{% else %}<tr><td colspan="8">Aucune guilde dans cet univers.</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
{% endblock %}
