{% extends 'base.html.twig' %}
{% block title %}Rechercher dans les messages · Genesis Reborn{% endblock %}
{% block body %}
<div class="strategic-page"><div class="page-heading"><div><h1>Rechercher dans les messages</h1><p>La recherche ne marque aucun message comme lu. Ouvrir une conversation conserve son fonctionnement habituel.</p></div><a class="secondary" href="{{ path('app_messages') }}">Messagerie</a></div>
{% if error %}<p role="alert" class="flash error">{{ error }}</p>{% endif %}
<form method="get" class="panel search-filters" role="search"><label for="message-content">Contenu<input id="message-content" type="search" name="q" maxlength="150" value="{{ criteria.q }}"></label><label for="search-channel">Conversation<select id="search-channel" name="channel">{% for key,label in {all:'Toutes mes conversations',private:'Messages privés',guild:'Ma guilde actuelle',global:'Global de cet univers'} %}<option value="{{ key }}" {{ key==channel ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label><label for="message-person">Auteur ou interlocuteur<input id="message-person" name="participant" maxlength="80" value="{{ criteria.participant }}"></label><label for="message-from">Du<input id="message-from" type="date" name="from" value="{{ criteria.from }}"></label><label for="message-until">Au<input id="message-until" type="date" name="until" value="{{ criteria.until }}"></label>{% if peerId %}<input type="hidden" name="with" value="{{ peerId }}"><p>Recherche limitée à la conversation sélectionnée. <a href="{{ path('app_message_search') }}">Toutes mes conversations</a></p>{% endif %}<button class="primary">Rechercher les messages</button></form>
<p role="status">{{ count }} résultat{{ count>1?'s':'' }} · page {{ page }} / {{ pages }}</p>
{% for message in entries %}<article class="panel message-search-result" id="message-result-{{ message.id }}"><h2>{{ message.sender.displayName }}{% if message.recipient %} → {{ message.recipient.displayName }}{% elseif message.guild %} · Guilde{% else %} · Global{% endif %}</h2><time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y à H:i',preferences.timezone) }}</time><p>{{ message.content|length>240 ? message.content|slice(0,240)~'…' : message.content }}</p>{% if message.content|length>240 %}<details><summary>Lire le message complet sans marquage</summary><div class="message-content">{{ message|social_message }}</div></details>{% endif %}<a class="secondary" href="{{ path('app_messages',message.guild ? {channel:'guild'} : (message.recipient ? {with:message.sender.id==membership.id ? message.recipient.id : message.sender.id} : {channel:'global'})) }}">Ouvrir la conversation</a></article>{% else %}<section class="panel"><h2>Aucun message correspondant</h2><p>Essayez une autre période ou un autre terme dans les conversations auxquelles vous avez accès.</p><a class="secondary" href="{{ path('app_messages') }}">Ouvrir la messagerie</a></section>{% endfor %}
<nav aria-label="Pages des résultats">{% set context=filters|merge({channel:channel,with:peerId}) %}{% if page>1 %}<a class="secondary" href="{{ path('app_message_search',context|merge({page:page-1})) }}">Page précédente</a>{% endif %}{% if page<pages %}<a class="secondary" href="{{ path('app_message_search',context|merge({page:page+1})) }}">Page suivante</a>{% endif %}</nav>
</div>
{% endblock %}
