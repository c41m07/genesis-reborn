{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Messages · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Messages</h1><p>Votre centre de communication dans cet univers.</p></div></div>
<div class="inbox-layout">
    <aside class="panel inbox-sidebar" aria-label="Boîte de réception">
        <header class="inbox-heading"><h2>Messagerie</h2>{% if unreadPrivate %}<span class="badge">{{ unreadPrivate }} non lu{{ unreadPrivate>1?'s':'' }}</span>{% endif %}</header>
        <form class="message-search" method="get" action="{{ path('app_messages') }}" role="search">
            <label for="message-recipient-search">Rechercher un joueur</label>
            <div><input id="message-recipient-search" type="search" name="q" value="{{ search }}" minlength="2" maxlength="40" placeholder="Pseudo du commandant"><button class="secondary">Rechercher</button></div>
        </form>
        {% if search %}<section class="message-search-results" aria-label="Résultats de recherche">
            {% if search|length < 2 %}<p>Saisissez au moins deux caractères.</p>{% else %}
                {% for member in searchResults %}<a class="inbox-item" href="{{ path('app_messages', {with: member.id}) }}"><span class="inbox-item-copy"><strong>{{ member.displayName }}</strong><small>Écrire un message</small></span></a>{% else %}<p>Aucun joueur trouvé dans cet univers.</p>{% endfor %}
            {% endif %}
        </section>{% endif %}
        <div data-message-notifications-target="conversations">{% include 'player/_message_contacts.html.twig' %}</div>
        {% if not guild %}<a class="inbox-guild-hint" href="{{ path('app_diplomacy') }}">Le canal de guilde est accessible après avoir rejoint une guilde.</a>{% endif %}
    </aside>
    <section class="panel message-pane" aria-label="Conversation sélectionnée">
        {% if peer and activeChannel!='guild' %}
            <header class="message-pane-heading"><div class="message-avatar" aria-hidden="true">{{ peer.displayName|first|upper }}</div><div><h2>Conversation avec {{ peer.displayName }}</h2><p>{{ membership.universe.name }}</p></div></header>
            <div class="message-thread" data-controller="message-thread" tabindex="0" aria-label="Historique de la conversation" aria-live="polite">
                {% for message in conversation %}<article class="message-bubble {{ message.sender.id==membership.id ? 'message-bubble--own' : '' }}"><div class="message-meta"><strong>{{ message.sender.displayName }}</strong><span class="message-direction">{{ message.sender.id==membership.id ? 'Vous' : 'Reçu' }}</span><time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y H:i') }}</time></div><p>{{ message.content }}</p>{% if message.moderatedAt is null and message.sender.id!=membership.id %}{% include 'ui/message_report.html.twig' with {message: message, peer_id: peer.id} only %}{% endif %}</article>{% else %}<p class="message-empty">Aucun message échangé avec ce commandant.</p>{% endfor %}
            </div>
            {% if peer.playerControlled %}<form class="message-compose" method="post"><input type="hidden" name="_token" value="{{ csrf_token('private_message') }}"><input type="hidden" name="action" value="private"><input type="hidden" name="recipient" value="{{ peer.id }}"><label class="visually-hidden" for="private-content">Votre message</label><textarea id="private-content" name="content" maxlength="2000" rows="2" placeholder="Écrire un message à {{ peer.displayName }}…" required></textarea><button class="primary">Envoyer {{ ui.icon('arrow') }}</button></form>{% else %}<p>Ce commandant ne contrôle plus cet empire. Les anciens échanges restent consultables.</p>{% endif %}
        {% elseif activeChannel=='guild' and guild %}
            <header class="message-pane-heading"><div class="message-avatar" aria-hidden="true">{{ ui.icon('diplomacy') }}</div><div><h2>Canal de guilde · {{ guild.name }}</h2><p>{{ guildConversation|length }} derniers messages</p></div></header>
            <div class="message-thread" data-controller="message-thread" tabindex="0" aria-label="Historique de la conversation" aria-live="polite">{% for message in guildConversation %}<article class="message-bubble {{ message.sender.id==membership.id ? 'message-bubble--own' : '' }}"><div class="message-meta"><strong>{{ message.sender.displayName }}</strong><span class="message-direction">{{ message.sender.id==membership.id ? 'Vous' : 'Reçu' }}</span><time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y H:i') }}</time></div><p>{{ message.content }}</p>{% if message.moderatedAt is null and message.sender.id!=membership.id %}{% include 'ui/message_report.html.twig' with {message: message, peer_id: null} only %}{% endif %}</article>{% else %}<p class="message-empty">Aucun message dans le canal pour l’instant.</p>{% endfor %}</div>
            <form class="message-compose" method="post"><input type="hidden" name="_token" value="{{ csrf_token('guild_message') }}"><input type="hidden" name="action" value="guild"><label class="visually-hidden" for="guild-content">Message pour la guilde</label><textarea id="guild-content" name="content" maxlength="2000" rows="2" placeholder="Écrire un message à votre guilde…" required></textarea><button class="primary">Envoyer {{ ui.icon('arrow') }}</button></form>
        {% else %}<div class="message-placeholder"><span class="message-avatar">{{ ui.icon('notifications') }}</span><h2>Sélectionnez une conversation</h2><p>Choisissez un commandant dans votre messagerie pour consulter l’échange.</p></div>{% endif %}
    </section>
</div>
{% endblock %}
