{# Les dates, pertes et retours viennent uniquement du dossier déjà autorisé. #}
{% if briefing.dates %}
    <dl class="pirate-campaign-dates">
        {% for event in briefing.dates %}
            <div>
                <dt>{{ event.label }}</dt>
                <dd{% if event.countdown %} data-controller="pirate-countdown" data-pirate-countdown-deadline-value="{{ event.at }}"
                    data-pirate-countdown-server-value="{{ date()|date('c','UTC') }}"{% endif %}>
                    <time datetime="{{ event.at }}">{{ event.at|date('d/m/Y à H:i:s', 'UTC') }} UTC</time>
                    {% if event.countdown %}<span data-pirate-countdown-target="remaining" hidden></span>{% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>
{% endif %}
{% if briefing.losses is not null %}
    <section class="pirate-campaign-losses report-summary" aria-labelledby="pirate-losses-title">
        <h3 id="pirate-losses-title">Rapport de combat · {{ briefing.status }}</h3>
        {% if briefing.combat_report_id|default(null) %}<a href="{{ path('app_pirate_mission_report', {id: briefing.combat_report_id}) }}">Ouvrir le rapport de combat</a>{% endif %}
        {% if briefing.combat_rounds|default(null) is not null %}
            <p class="muted">Rounds joués : {{ briefing.combat_rounds }}.</p>
        {% endif %}
        {% if briefing.losses %}
            <div class="table-scroll" tabindex="0" role="region" aria-label="Vaisseaux perdus">
                <table class="data-table">
                    <thead><tr><th scope="col">Vaisseau</th><th scope="col">Rang</th><th scope="col">Pertes</th></tr></thead>
                    <tbody>
                    {% for ship in briefing.losses %}
                        <tr><th scope="row">{{ ship.label }}</th><td>{{ ship.tier }}</td><td class="report-loss">−{{ ship.quantity|quantity(0) }}</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
            <p>Ces pertes sont définitives.</p>
        {% else %}
            <p>Aucun vaisseau perdu.</p>
        {% endif %}
    </section>
{% endif %}
{% if briefing.return %}<p>{{ briefing.return }}</p>{% endif %}
