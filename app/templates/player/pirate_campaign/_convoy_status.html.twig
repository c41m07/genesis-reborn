{% set oldest = convoy.oldest_pending %}
{% set reward = convoy.selected_reward %}
{% if oldest and oldest.mission != selected %}
    <p><a href="{{ path('app_pirate_campaign', {missionNumber: oldest.mission}) }}">
        Consulter le plus ancien convoi en attente : mission {{ oldest.mission }}
    </a></p>
{% endif %}
{% if reward %}
    {% set visualState = {protected_travel: 'transit', full_pending: 'capacity'}[reward.state]|default('') %}
    <section class="pirate-campaign-command{{ visualState ? ' pirate-campaign-economy-card pirate-campaign-economy-card--' ~ visualState : '' }}" aria-labelledby="pirate-convoy-title">
        <h3 id="pirate-convoy-title">Convoi de remerciement</h3>
        {% set convoyStates = {
            unassigned: 'Destination à attribuer',
            protected_travel: 'En convoi',
            arrival_confirmed: 'Arrivée confirmée',
            full_pending: 'À déposer',
            destination_lost: 'Destination perdue',
            credited: reward.boxed|default(false) ? 'Boîte reçue' : 'Lot crédité',
        } %}
        {% if convoyStates[reward.state] is defined %}
            <p class="badge{{ visualState ? ' pirate-economy-badge' : '' }}">{{ convoyStates[reward.state] }}</p>
        {% endif %}
        {% if reward.state == 'unassigned' %}
            <p>Destination non attribuée. Aucun départ n’est confirmé.</p>
        {% elseif reward.state == 'protected_travel' %}
            <p>Convoi protégé en route. Arrivée prévue :
                <time datetime="{{ reward.expected_arrival_at }}">{{ reward.expected_arrival_at|date('d/m/Y à H:i:s', 'UTC') }} UTC</time>.
                {% if reward.awaiting_arrival_confirmation %}L’arrivée reste à confirmer.{% endif %}
            </p>
            <a class="secondary" href="{{ path('app_fleets') }}">Voir le trajet dans Flottes</a>
        {% elseif reward.state == 'arrival_confirmed' %}
            <p>Arrivée confirmée, versement non confirmé.</p>
        {% elseif reward.state == 'full_pending' %}
            <p><strong>Stockage insuffisant.</strong> Le convoi attend depuis la précédente tentative de livraison.</p>
            {% if deposit_token|default(null) %}
                <p>Récupérez maintenant la boîte dans votre inventaire. Vous aurez ensuite 24 h pour l’ouvrir.</p>
                <form method="post" action="{{ path('app_pirate_campaign_convoy_deposit', {missionNumber: selected}) }}">
                    <input type="hidden" name="_token" value="{{ deposit_token }}">
                    <button type="submit" class="primary">Recevoir la boîte de ressources</button>
                </form>
            {% endif %}
        {% elseif reward.state == 'destination_lost' %}
            <p>Destination perdue. Aucun nouveau trajet n’est confirmé.</p>
        {% elseif reward.state == 'credited' %}
            <p>{{ reward.boxed|default(false) ? 'Boîte de ressources reçue le' : 'Lot entier crédité le' }}
                <time datetime="{{ reward.credited_at }}">{{ reward.credited_at|date('d/m/Y à H:i:s', 'UTC') }} UTC</time>.
            </p>
            {% if reward.boxed|default(false) %}<a href="{{ path('app_inventory_boxes') }}">Voir mes boîtes</a>{% endif %}
        {% endif %}
        {% set labels = {metal: 'Métal', nano: 'Nanos', antimatter: 'Antimatière', hydrogen: 'Hydrogène'} %}
        <dl{% if visualState %} class="pirate-campaign-reward"{% endif %}>
            {% for resource, amount in reward.amounts %}
                {% if visualState %}<div>{% endif %}
                <dt>{{ labels[resource] }}</dt><dd>{{ amount }}</dd>
                {% if visualState %}</div>{% endif %}
            {% endfor %}
        </dl>
    </section>
{% endif %}
