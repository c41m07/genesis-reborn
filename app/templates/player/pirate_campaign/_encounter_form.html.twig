<section class="pirate-campaign-command" aria-labelledby="pirate-command-title">
    <h3 id="pirate-command-title">
        {% if form.action == 'reconnaissance' %}Préparer la reconnaissance
        {% elseif form.kind == 'selection' %}Choisir l’escorte
        {% else %}Confirmer l’attaque{% endif %}
    </h3>
    <p>Colonie de départ : <strong>{{ origin }}</strong></p>
    {% if form.kind == 'selection' %}
        <p>Choisissez jusqu’à {{ form.total_limit }} vaisseaux au total. L’aperçu ne déclenche aucun départ.</p>
        <form method="post" class="pirate-escort-form" action="{{ path('app_pirate_campaign_attack_preview', {missionNumber: mission}) }}"
              data-controller="fleet-quantity" data-fleet-quantity-limit-value="{{ form.total_limit }}">
            <input type="hidden" name="_token" value="{{ form.token }}">
            {% include 'fleet/_ship_selection_table.html.twig' with {
                ships: form.ships, catalog: form.catalog, fleetId: 'pirate-' ~ mission,
                fleetLimit: form.total_limit, headingId: 'pirate-command-title', isEscort: true, loaded: false
            } only %}
            <p class="quantity-status" role="status" data-fleet-quantity-target="status"></p>
            <button type="submit" class="{{ primary ? 'primary' : 'secondary' }}">Vérifier le devis d’attaque</button>
        </form>
    {% else %}
        <div class="fleet-mission-summary">
            <h4>Votre mission</h4>
            {% if form.notice is defined %}<p>{{ form.notice }}</p>{% endif %}
            {% if form.selected is defined %}
                <ul aria-label="Escorte choisie">
                    {% for ship in form.selected %}<li>{{ ship.label }} : {{ ship.quantity|quantity(0) }}</li>{% endfor %}
                </ul>
            {% endif %}
        </div>
        <div class="flight-estimate core-fleet-quote">
            <h4 class="core-fleet-quote-title">Estimation du trajet</h4>
            <dl>
                <div><dt>Durée du trajet aller</dt><dd>{{ duration_label(form.quote.seconds) }}</dd></div>
                <div><dt>Hydrogène prélevé sur la colonie</dt><dd>{{ form.quote.hydrogen|replace({'.': ','}) }} H</dd></div>
                {% if form.quote.orbit is defined %}
                    <div><dt>Dont réserve d’orbite</dt><dd>{{ form.quote.orbit|replace({'.': ','}) }} H</dd></div>
                {% endif %}
            </dl>
        </div>
        <form method="post" action="{{ path(form.action == 'reconnaissance' ? 'app_pirate_campaign_scout' : 'app_pirate_campaign_attack', {missionNumber: mission}) }}">
            <input type="hidden" name="_token" value="{{ form.token }}">
            {% for ordinal, quantity in form.hidden_escort %}
                <input type="hidden" name="escort[{{ ordinal }}]" value="{{ quantity }}">
            {% endfor %}
            <button type="submit" class="{{ primary ? 'primary' : 'secondary' }}">{{ form.action == 'reconnaissance' ? 'Envoyer la sonde' : 'Confirmer et envoyer l’escorte' }}</button>
        </form>
        {% if form.action == 'attack' %}<p><a href="{{ path('app_pirate_campaign', {missionNumber: mission}) }}">Modifier l’escorte</a></p>{% endif %}
    {% endif %}
</section>
