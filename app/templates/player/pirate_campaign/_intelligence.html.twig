{% import 'ui/macros.html.twig' as ui %}
<aside class="pirate-campaign-intel" aria-label="Renseignements de la mission">
    {% if briefing.formation is not null %}
        <section aria-labelledby="pirate-intel-title">
            <h3 id="pirate-intel-title">{{ ui.icon('fleet') }} Flotte pirate révélée</h3>
            <ul class="pirate-campaign-formation">
                {% for ship in briefing.formation %}
                    <li><strong>{{ ship.quantity }} ×</strong> {{ ship.label }} <span class="muted">({{ ship.tier }})</span></li>
                {% endfor %}
            </ul>
            {% if briefing.tactical_guidance %}<p>{{ briefing.tactical_guidance }}</p>{% endif %}
            <p class="muted">Gardez si possible des vaisseaux en réserve. Remplacer des pertes peut demander de l’électricité en plus des matériaux.</p>
        </section>
    {% endif %}
    {% if briefing.quote is not null and not has_durable_reward %}
        <section aria-labelledby="pirate-potential-title">
            <h3 id="pirate-potential-title">{{ ui.icon('overview') }} Gain potentiel</h3>
            <p>Estimation du convoi après victoire : 50 % du coût catalogue de la flotte révélée, hors électricité. Ce montant n’a pas été versé.</p>
            <dl class="pirate-campaign-reward">
                {% for resource in briefing.quote %}
                    <div><dt>{{ resource.label }}</dt><dd>+{{ resource.amount }}</dd></div>
                {% endfor %}
            </dl>
            <p class="muted">Vérifiez le stockage avant une livraison. Ce n’est pas une condition pour combattre.</p>
        </section>
    {% endif %}
</aside>
