{% import 'ui/macros.html.twig' as ui %}
{% set tag = embedded|default(false) ? 'section' : 'aside' %}
<{{ tag }} class="{{ embedded|default(false) ? 'pirate-campaign-intel pirate-campaign-intel--embedded' : 'panel pirate-campaign-intel' }}" aria-labelledby="pirate-intelligence-title">
    <h2 id="pirate-intelligence-title" tabindex="-1">Renseignements de la mission</h2>
    {% if briefing.formation is not null %}
        <section aria-labelledby="pirate-intel-title">
            <h3 id="pirate-intel-title">{{ ui.icon('fleet') }} Flotte pirate révélée</h3>
            <ul class="pirate-campaign-formation">
                {% for ship in briefing.formation %}
                    <li><strong>{{ ship.quantity }} ×</strong> {{ ship.label }} <span class="muted">({{ ship.tier }})</span></li>
                {% endfor %}
            </ul>
            {% if briefing.recon_report_id|default(null) %}
                <p><a class="secondary" href="{{ path('app_pirate_recon_report', {id: briefing.recon_report_id}) }}">Ouvrir le rapport d’espionnage</a></p>
            {% endif %}
            {% if briefing.tactical_guidance %}<p>{{ briefing.tactical_guidance }}</p>{% endif %}
            <p class="muted">Gardez si possible des vaisseaux en réserve. Remplacer des pertes peut demander de l’électricité en plus des matériaux.</p>
        </section>
    {% endif %}
    {% if not embedded|default(false) %}
        {% include 'player/pirate_campaign/_potential_reward.html.twig' with {briefing: briefing, has_durable_reward: has_durable_reward} only %}
    {% endif %}
</{{ tag }}>
