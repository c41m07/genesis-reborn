<header class="pirate-campaign-mission-heading">
    <span class="badge">{{ status }}</span>
    <h2 id="pirate-mission-title">{{ narrative.title }}</h2>
    {% if not compact|default(false) %}
        <p>{{ narrative.message }}</p>
        {% if narrative.guidance %}<p>{{ narrative.guidance }}</p>{% endif %}
    {% endif %}
</header>
