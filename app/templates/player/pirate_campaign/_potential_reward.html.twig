{% import 'ui/macros.html.twig' as ui %}
{% if briefing.quote is not null and not has_durable_reward %}
    <section class="pirate-campaign-economy-card pirate-campaign-economy-card--estimate" aria-labelledby="pirate-potential-title">
        <h3 id="pirate-potential-title">{{ ui.icon('overview') }} Gain potentiel</h3>
        <p class="badge pirate-economy-badge">Non versé</p>
        <p>Estimation du convoi après victoire : 50 % du coût catalogue de la flotte révélée, hors électricité. Ce montant n’a pas été versé.</p>
        <dl class="pirate-campaign-reward">
            {% for resource in briefing.quote %}
                <div><dt>{{ resource.label }}</dt><dd>+{{ resource.amount }}</dd></div>
            {% endfor %}
        </dl>
        <p class="muted">Vérifiez le stockage avant une livraison. Ce n’est pas une condition pour combattre.</p>
    </section>
{% endif %}
