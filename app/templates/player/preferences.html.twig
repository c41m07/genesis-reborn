{% extends 'base.html.twig' %}
{% block title %}Préférences · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-refinement account-space preferences-page account-redesign" data-page-sections="disabled">
<div class="page-heading"><div><h1>Préférences</h1><p>Ces réglages sont communs à votre compte, dans tous vos univers.</p></div></div>
{% include 'ui/account_navigation.html.twig' %}
{{ form_start(form, {attr: {class: 'account-preferences-form'}}) }}
    {% if form.vars.submitted and not form.vars.valid %}<div class="form-error" role="alert"><strong>Paramètres non enregistrés.</strong><p>Corrigez les champs signalés puis réessayez.</p>{{ form_errors(form) }}</div>{% endif %}
    <section class="panel account-panel">
        <fieldset class="account-section"><legend>Affichage et horloge</legend><div class="account-grid">{{ form_row(form.theme) }}{{ form_row(form.timezone) }}</div></fieldset>
    </section>
    <div class="account-preference-columns">
        <section class="panel account-panel">
            <fieldset class="account-section"><legend>Raccourcis de la galaxie</legend><p>Vitesse utilisée par défaut pour les missions rapides depuis la galaxie.</p><div class="account-shortcuts">{{ form_row(form.galaxySpySpeed) }}{{ form_row(form.galaxyColonizeSpeed) }}</div></fieldset>
        </section>
        <section class="panel account-panel">
            <fieldset class="account-section"><legend>Réception des transports</legend>{{ form_row(form.transportReception) }}</fieldset>
        </section>
    </div>
    <section class="panel account-panel">
        <fieldset class="account-section"><legend>Confort de lecture</legend>
            <div class="preference-toggle">{{ form_widget(form.reducedMotion) }}{{ form_label(form.reducedMotion) }}{{ form_errors(form.reducedMotion) }}</div>
            <div class="preference-toggle">{{ form_widget(form.realtimeNotifications) }}{{ form_label(form.realtimeNotifications) }}{{ form_errors(form.realtimeNotifications) }}</div>
            <div class="preference-toggle">{{ form_widget(form.showLockedItems) }}{{ form_label(form.showLockedItems) }}{{ form_errors(form.showLockedItems) }}</div>
        </fieldset>
    </section>
    <button class="primary account-preferences-save">Enregistrer les paramètres</button>
{{ form_end(form) }}
<form method="post" action="{{ path('app_first_steps_preference') }}" class="panel account-panel first-steps-preference-form" data-turbo="false">
    <fieldset class="account-section">
        <legend>Guide Premiers pas</legend>
        <input type="hidden" name="_token" value="{{ csrf_token('first-steps-preference') }}">
        <input type="hidden" name="guide_enabled" value="0">
        <div class="preference-toggle">
            <input type="checkbox" name="guide_enabled" id="first-steps-guide-setting" value="1" aria-describedby="first-steps-guide-help"
                   {% if app.user.preferences.firstStepsGuide ?? true %}checked{% endif %}>
            <label for="first-steps-guide-setting">Afficher le guide Premiers pas</label>
        </div>
        <p id="first-steps-guide-help">Vous retrouverez vos étapes et récompenses acquises en le réactivant.</p>
        <p><a href="{{ path('app_first_steps') }}">Voir le guide complet et les remboursements</a></p>
        <button class="primary" type="submit">Enregistrer le réglage du guide</button>
    </fieldset>
</form>
</div>
{% endblock %}
