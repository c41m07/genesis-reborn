{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}

{% block title %}{{ profile.username }} · Profil du commandant · Genesis Reborn{% endblock %}

{% block body %}
<div class="social-profile-page social-workspace public-player-profile" data-page-sections="disabled">
    <nav class="social-page-actions commander-profile-navigation" aria-label="Retour au classement">
        <a class="secondary" href="{{ path('app_leaderboard') }}"><span aria-hidden="true">←</span> Classement</a>
    </nav>

    <header class="panel page-heading commander-profile-identity">
        {% if profile.cosmetics.bannerArt is defined %}
            {% set art = profile.cosmetics.bannerArt %}
            <img class="commander-profile-art editorial-art" src="{{ asset(art.art) }}" style="--art-crop:{{ art.desktop }}%;--art-mobile:{{ art.mobile }}%" alt="Bannière {{ art.label }}">
        {% elseif profile.cosmetics.banner is defined %}
            <img class="commander-profile-art" src="{{ asset('art/genesis-avent-panorama-720.webp') }}"
                 srcset="{{ asset('art/genesis-avent-panorama-720.webp') }} 720w, {{ asset('art/genesis-avent-panorama-1536.webp') }} 1536w"
                 sizes="(max-width: 760px) 100vw, 85vw" alt="Bannière {{ profile.cosmetics.banner }}">
        {% endif %}
        <div>
            <p class="eyebrow">Profil du commandant</p>
            <h1>{{ profile.username }}</h1>
            {% if profile.cosmetics.titles is defined %}
                <div class="ranking-badges">
                    {% for title in profile.cosmetics.titles %}
                        <span class="badge ranking-label ranking-label--title editorial-{{ profile.cosmetics.colors[loop.index0]|default('gold') }}">{{ title }}</span>
                    {% endfor %}
                </div>
            {% endif %}
            <p>Univers {{ membership.universe.name }}</p>
        </div>
        {% if profile.id != membership.id %}
            <a class="primary commander-profile-write" href="{{ path('app_messages', {with: profile.id}) }}">Écrire à {{ profile.username }}</a>
        {% endif %}
    </header>

    <div class="commander-profile-details">
        <section class="panel" aria-labelledby="player-public-scores">
            <h2 id="player-public-scores">{{ ui.icon('overview') }} Classement quotidien</h2>
            <p>Valeurs du <time datetime="{{ profile.updated_at|date('c') }}">{{ profile.updated_at|date('d/m/Y à H:i', preferences.timezone) }}</time>. Les points de flotte incluent les défenses fixes.</p>
            <dl class="social-profile-scores">
                {% for score in profile.scores %}
                    <div{% if score.category == 'points' %} class="commander-profile-score-total"{% endif %}>
                        <dt>{{ score.label }}</dt>
                        <dd>
                            {% if score.value is not null %}
                                <strong>{{ score.value|quantity(0) }}</strong>
                                <span>rang #{{ score.rank }}</span>
                            {% else %}
                                <span>Pas encore classé</span>
                            {% endif %}
                        </dd>
                    </div>
                {% endfor %}
            </dl>
        </section>

        <section class="panel" aria-labelledby="player-public-guild">
            <h2 id="player-public-guild">{{ ui.icon('diplomacy') }} Guilde</h2>
            {% if profile.guild %}
                {% set guildLabel = (profile.guild.tag ? '[' ~ profile.guild.tag ~ '] ' : '') ~ profile.guild.name %}
                <p>
                    {% if profile.guild.can_view %}
                        <a class="commander-profile-guild-link" href="{{ path('app_guild_public_profile', {id: profile.guild.id}) }}">{{ guildLabel }}</a>
                    {% else %}
                        {{ guildLabel }}
                    {% endif %}
                </p>
            {% else %}
                <p>Aucune guilde.</p>
                {% if can_invite %}
                    <form method="post" action="{{ path('app_guild_invite', {id:profile.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('guild_invite_' ~ profile.id) }}">
                        <button class="primary">Inviter dans ma guilde</button>
                    </form>
                {% endif %}
            {% endif %}
        </section>
    </div>
</div>
{% endblock %}
