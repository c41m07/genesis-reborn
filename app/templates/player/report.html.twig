{% extends 'base.html.twig' %}
{% block title %}Signaler un commandant · Genesis Reborn{% endblock %}
{% block body %}
<div class="social-board social-board--report social-workspace player-report-workspace" data-page-sections="disabled">
<div class="page-heading"><div><h1>Signaler un commandant</h1><p>Votre signalement sera accessible uniquement à la modération.</p></div></div>
<section class="panel player-report-form" aria-labelledby="player-report-title">
<header class="social-report-identity">
    <span aria-hidden="true">{{ target.player.username|first|upper }}</span>
    <div>
        <h2 id="player-report-title">Commandant signalé : {{ target.player.username }}</h2>
        <p>Univers : {{ membership.universe.name }} · {{ categories[context.category] }} · rang #{{ context.rank }}.</p>
    </div>
</header>
{% if error %}<p role="alert" class="flash error" id="player-report-error">{{ error }}</p>{% endif %}
<form method="post">
<input type="hidden" name="_token" value="{{ csrf_token('player_report_'~target.id) }}"><input type="hidden" name="request_key" value="{{ request_key }}">
<label for="player-report-reason">Motif du signalement</label><select id="player-report-reason" name="reason" required aria-describedby="player-report-title"><option value="">Choisir un motif</option>{% for key,label in reasons %}<option value="{{ key }}" {{ draft.reason==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select>
<label for="player-report-comment">Commentaire (facultatif)</label><textarea id="player-report-comment" name="comment" maxlength="1000" rows="5" aria-describedby="player-report-comment-help">{{ draft.comment }}</textarea><small id="player-report-comment-help">1000 caractères maximum.</small>
<div class="social-report-actions">
    <button class="primary" type="submit">Transmettre le signalement</button>
    <a class="secondary" href="{{ path('app_leaderboard',{category:context.category,direction:context.direction|default('desc'),page:context.page}) }}">Revenir au classement</a>
</div>
</form>
<aside class="social-report-privacy">
    <h3>Confidentialité</h3>
    <p>Le signalement joint automatiquement le joueur visé, son pseudonyme au moment de l’envoi, votre identité, la date et le contexte du classement. Il est uniquement accessible à la modération.</p>
</aside>
</section>
</div>
{% endblock %}
