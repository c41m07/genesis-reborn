{% extends 'base.html.twig' %}
{% block title %}Mode vacances · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-refinement account-space vacation-page account-redesign" data-page-sections="disabled">
<div class="page-heading"><div><h1>Mode vacances</h1><p class="vacation-universe-scope">{% if vacation_membership %}Réglage propre à votre empire dans l’univers <strong>{{ vacation_membership.universe.name }}</strong>.{% else %}Choisissez un univers pour consulter les vacances de votre empire.{% endif %}</p></div></div>
{% include 'ui/account_navigation.html.twig' %}
<div id="vacances-info" tabindex="-1">
{% if vacation_state and (vacation_state.enabled or vacation_state.active) %}
    <section id="vacances" class="account-workspace{% if not vacation_state.active %} vacation-workspace--inactive{% endif %}" aria-labelledby="vacation-heading" tabindex="-1">
        <div class="panel account-panel vacation-information">
            <h2 id="vacation-heading">Vacances dans cet univers</h2>
            {% if not vacation_state.active %}
                <div class="vacation-inactive-notice">
                    <strong>Mode vacances inactif</strong>
                    <p>Consultez les restrictions de cet univers avant de confirmer.</p>
                </div>
                <h3 id="vacation-universe">Univers concerné</h3>
                <p>{{ vacation_membership.universe.name }}</p>
            {% else %}
                <p>Univers : <strong>{{ vacation_membership.universe.name }}</strong>.</p>
            {% endif %}
            {% if vacation_state.active %}
                <p class="badge">Vacances actives</p>
                <dl class="account-grid">
                    <div><dt>Début</dt><dd><time datetime="{{ vacation_state.active.startedAt|date('c') }}">{{ vacation_state.active.startedAt|date('d/m/Y à H:i',preferences.timezone) }}</time></dd></div>
                    <div><dt>Fin automatique</dt><dd><time datetime="{{ vacation_state.active.scheduledEndAt|date('c') }}">{{ vacation_state.active.scheduledEndAt|date('d/m/Y à H:i',preferences.timezone) }}</time></dd></div>
                </dl>
            {% endif %}
            {% if not vacation_state.active %}<h3>Restrictions avant activation</h3>{% endif %}
            <ul id="vacation-rules">
                <li>Production et files suspendues ; missions indisponibles ; protection contre les attaques et l’espionnage.</li>
                <li>48 heures minimum avant une sortie volontaire et 90 jours maximum.</li>
                <li>Après la fin des vacances, attendez 15 jours avant une nouvelle activation.</li>
                <li>Toutes vos flottes doivent être rentrées. Les demandes d’orbite en attente seront refusées ; les stations alliées déjà acceptées garderont leur échéance.</li>
                <li>Le compteur d’inactivité est suspendu. Consulter le jeu pendant les vacances ne le remet pas à zéro.</li>
            </ul>
        </div>
        <section class="panel account-panel account-confirmation" aria-labelledby="vacation-action-heading">
        {% if vacation_state.active %}
            <h2 id="vacation-action-heading">Terminer mes vacances</h2>
            <p id="vacation-end-help">La sortie met fin immédiatement à la protection et reprend la production et les files. Fuseau horaire : {{ preferences.timezone }}.</p>
            {% if not vacation_state.can_finish %}<p id="vacation-minimum">Sortie possible à partir du <time datetime="{{ vacation_state.earliest_end_at|date('c') }}">{{ vacation_state.earliest_end_at|date('d/m/Y à H:i',preferences.timezone) }}</time>.</p>{% endif %}
            <form method="post" action="{{ path('app_vacation_finish') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('vacation-finish-'~vacation_membership.id) }}">
                <input type="hidden" name="membership_id" value="{{ vacation_membership.id }}">
                <button class="secondary full" aria-describedby="vacation-end-help{{ not vacation_state.can_finish ? ' vacation-minimum' : '' }}" {% if not vacation_state.can_finish %}disabled{% endif %}>Terminer mes vacances dans cet univers</button>
            </form>
        {% else %}
            <h2 id="vacation-action-heading">Activer mes vacances</h2>
            {% if vacation_state.cooldown %}<p>Nouvelle activation possible le <time datetime="{{ vacation_state.next_activation_at|date('c') }}">{{ vacation_state.next_activation_at|date('d/m/Y à H:i',preferences.timezone) }}</time> ({{ preferences.timezone }}).</p>{% endif %}
            {% if vacation_state.start_blocker %}
                <div class="vacation-unavailable-notice" id="vacation-start-blocker">
                    <strong>Activation indisponible</strong>
                    <p>{{ vacation_state.start_blocker }}</p>
                </div>
            {% endif %}
            <form method="post" action="{{ path('app_vacation_start') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('vacation-start-'~vacation_membership.id) }}">
                <input type="hidden" name="membership_id" value="{{ vacation_membership.id }}">
                {% if vacation_state.can_start %}<p class="preference-toggle"><input id="vacation-confirm" type="checkbox" name="confirm" value="1" required aria-describedby="vacation-rules"><label for="vacation-confirm">J’ai lu ces conditions et je souhaite activer les vacances pour cet univers.</label></p>{% endif %}
                <div class="vacation-start-actions">
                    <button class="primary full" aria-label="Activer le mode vacances dans cet univers" {% if not vacation_state.can_start %}disabled aria-describedby="vacation-start-blocker"{% else %}aria-describedby="vacation-rules"{% endif %}>Activer le mode vacances</button>
                    <a class="secondary" href="{{ path('app_preferences') }}">Retour aux préférences</a>
                </div>
            </form>
        {% endif %}
        </section>
    </section>
{% else %}
    <section class="panel account-panel" aria-labelledby="vacation-heading" tabindex="-1"><h2 id="vacation-heading">Vacances dans cet univers</h2><p>Le mode vacances n’est pas disponible pour l’empire actuellement sélectionné. <a href="{{ path('app_universes') }}">Consulter mes univers</a></p></section>
{% endif %}
</div>
</div>
{% endblock %}
