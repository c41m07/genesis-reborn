{% extends 'base.html.twig' %}

{% block body %}
<div class="entry-workspace entry-access" data-page-sections="disabled">
    {# L'action est la première information de la page, y compris dans l'ordre de lecture. #}
    {% set compactAccess = app.request.attributes.get('_route') not in ['app_login', 'app_register'] %}
    <div class="entry-access-layout{{ compactAccess ? ' core-entry-access--compact' : ' core-entry-access--task-first' }}">
        <section class="panel auth-card entry-access-panel" aria-labelledby="{{ access_heading_id }}">
            {% block access_content %}{% endblock %}
            {% if compactAccess %}
                {% block access_footer %}
                    <p class="auth-back"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
                {% endblock %}
            {% endif %}
        </section>
        {% if not compactAccess %}
            <div class="entry-access-context">
                <p class="entry-context-title">Votre empire vous attend.</p>
                <p>Explorez les systèmes, développez vos colonies et préparez vos flottes.</p>
                <picture><source type="image/webp" srcset="{{ asset('art/genesis-reborn-planet.webp') }}"><img src="{{ asset('art/genesis-reborn-planet.png') }}" alt="" width="1448" height="1086"></picture>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
