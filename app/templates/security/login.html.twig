{% extends 'security/layout.html.twig' %}
{% set access_heading_id = 'login-title' %}
{% block title %}Connexion · Genesis Reborn{% endblock %}
{% block access_content %}
<h1 id="login-title">Reprendre le commandement</h1>
<p>Connectez-vous pour retrouver vos univers.</p>
{% if error %}<p id="login-error" class="flash error" role="alert">Connexion impossible. Vérifiez vos identifiants ou réessayez dans une minute.</p>{% endif %}
<form class="auth-form" method="post" action="{{ path('app_login') }}">
    <label for="email">Adresse email</label>
    <input id="email" name="_username" type="email" value="{{ last_email }}" autocomplete="username" required autofocus {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
    <label for="password">Mot de passe</label>
    <div class="password-field" data-controller="password-visibility">
        <input data-password-visibility-target="input" id="password" name="_password" type="password" autocomplete="current-password" required {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>
        {% include 'ui/password_toggle.html.twig' with {id: 'password'} only %}
    </div>
    <a class="entry-recovery-link" href="{{ path('app_password_reset_request') }}">Mot de passe oublié ?</a>
    <div class="preference-toggle">
        <input id="remember-me" name="_remember_me" type="checkbox" value="1">
        <label for="remember-me">Se souvenir de moi pendant 30 jours</label>
    </div>
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <button class="primary full" type="submit">Connexion <span aria-hidden="true">↗</span></button>
</form>
<nav class="entry-access-links" aria-label="Autres accès au compte">
    <a href="{{ path('app_email_verify_request') }}">Recevoir un lien de confirmation</a>
    <a href="{{ path('app_register') }}">Première mission ? Créer un compte</a>
</nav>
{% endblock %}
