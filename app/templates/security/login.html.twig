{% extends 'base.html.twig' %}{% block title %}Connexion · Genesis Reborn{% endblock %}
{% block body %}<div class="auth-layout"><section class="intro"><h1>Votre empire<br>commence <em>ici.</em></h1><p class="lead">Explorez des systèmes inconnus, développez vos colonies et préparez votre flotte. Chaque décision dessine votre avenir.</p><div class="orbit-art" aria-hidden="true"><i></i><b></b><span>GENESIS / SECTEUR ALPHA</span></div><div class="intro-stats"><span>01 <small>Compte</small></span><span>∞ <small>Horizons</small></span><span>05 <small>Ressources</small></span></div></section><section class="panel auth-panel" aria-labelledby="login-title"><h2 id="login-title">Reprendre le commandement</h2><p>Connectez-vous pour retrouver vos univers.</p>{% if error %}<p id="login-error" class="flash error" role="alert">Connexion impossible. Vérifiez vos identifiants ou réessayez dans une minute.</p>{% endif %}<form class="auth-form" method="post" action="{{ path('app_login') }}"><label for="email">Adresse email</label><input id="email" name="_username" type="email" value="{{ last_email }}" autocomplete="username" required autofocus {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}><label for="password">Mot de passe</label><div class="password-field" data-controller="password-visibility"><input data-password-visibility-target="input" id="password" name="_password" type="password" autocomplete="current-password" required {% if error %}aria-invalid="true" aria-describedby="login-error"{% endif %}>{% include 'ui/password_toggle.html.twig' with {id: 'password'} only %}</div><div class="preference-toggle"><input id="remember-me" name="_remember_me" type="checkbox" value="1"><label for="remember-me">Se souvenir de moi pendant 30 jours</label></div><input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}"><button class="primary full">Connexion <span aria-hidden="true">↗</span></button></form><p class="auth-note"><a href="{{ path('app_email_verify_request') }}">Recevoir un lien de confirmation</a></p><p class="auth-note"><a href="{{ path('app_password_reset_request') }}">Mot de passe oublié ?</a></p><p class="auth-note">Première mission ? <a href="{{ path('app_register') }}">Créer un compte</a></p></section></div>{% endblock %}
