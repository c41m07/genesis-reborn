{% extends 'security/layout.html.twig' %}
{% form_theme form 'form/registration_errors.html.twig' %}
{% set access_heading_id = 'reset-title' %}
{% block title %}Nouveau mot de passe · Genesis Reborn{% endblock %}
{% block access_content %}
<h1 id="reset-title">Choisir un nouveau mot de passe</h1>
{% include 'security/_access_notices.html.twig' %}
<p>Le lien est valable une heure et ne peut servir qu’une fois.</p>
{{ form_start(form, {attr: {class: 'auth-form'}}) }}
    {{ form_errors(form) }}
    <div class="entry-password-pair">
        {{ form_errors(form.plainPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
    </div>
    <button class="primary full" type="submit">Modifier le mot de passe</button>
{{ form_end(form) }}
{% endblock %}

{% block access_footer %}
<p class="auth-back"><a href="{{ path('app_password_reset_request') }}">Demander un nouveau lien</a></p>
{% endblock %}
