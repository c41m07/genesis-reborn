{% extends 'security/layout.html.twig' %}
{% set access_heading_id = 'reset-invalid-title' %}
{% block title %}Lien invalide · Genesis Reborn{% endblock %}
{% block access_content %}
<h1 id="reset-invalid-title">Lien expiré ou invalide</h1>
<p>Ce lien a expiré, a déjà été utilisé ou n’est pas valide. Demandez un nouveau lien pour réinitialiser votre mot de passe.</p>
<a class="primary full" href="{{ path('app_password_reset_request') }}">Demander un nouveau lien</a>
{% endblock %}
