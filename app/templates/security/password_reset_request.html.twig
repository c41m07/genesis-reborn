{% extends 'security/layout.html.twig' %}
{% form_theme form 'form/registration_errors.html.twig' %}
{% set access_heading_id = 'reset-request-title' %}
{% block title %}Mot de passe oublié · Genesis Reborn{% endblock %}
{% block access_content %}
<h1 id="reset-request-title">Mot de passe oublié</h1>
<p>Indiquez l’adresse email associée à votre compte. Si elle existe, nous vous enverrons un lien temporaire.</p>
{{ form_start(form, {attr: {class: 'auth-form'}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.email) }}
    <button class="primary full" type="submit">Envoyer le lien</button>
{{ form_end(form) }}
<p class="auth-back"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
