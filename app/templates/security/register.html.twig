{% extends 'security/layout.html.twig' %}
{% form_theme form 'form/registration_errors.html.twig' %}
{% set access_heading_id = 'register-title' %}
{% block title %}Inscription · Genesis Reborn{% endblock %}
{% block access_content %}
<h1 id="register-title">Rejoignez les étoiles.</h1>
{% include 'security/_access_notices.html.twig' %}
<p>Un compte vous permet de jouer dans plusieurs univers indépendants.</p>
{{ form_start(form, {attr: {class: 'auth-form'}}) }}
    {{ form_errors(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.username, {help: '3 à 40 lettres, chiffres, espaces, tirets ou tirets bas.'}) }}
    <div class="entry-password-pair">
        {{ form_errors(form.plainPassword) }}
        {{ form_row(form.plainPassword.first) }}
        {{ form_row(form.plainPassword.second) }}
    </div>
    <button class="primary full" type="submit">Créer mon compte</button>
{{ form_end(form) }}
<p class="auth-back"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
