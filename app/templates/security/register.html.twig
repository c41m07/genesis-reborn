{% extends 'base.html.twig' %}{% form_theme form 'form/registration_errors.html.twig' %}{% block title %}Inscription · Genesis Reborn{% endblock %}
{% block body %}<section class="panel narrow auth-card" aria-labelledby="register-title"><h1 id="register-title">Rejoignez les étoiles.</h1><p>Un compte vous permet de jouer dans plusieurs univers indépendants.</p>
{{ form_start(form, {attr: {class: 'auth-form'}}) }}{{ form_errors(form) }}{{ form_row(form.email) }}{{ form_row(form.username, {help: '3 à 40 lettres, chiffres, espaces, tirets ou tirets bas.'}) }}{{ form_row(form.plainPassword) }}<button class="primary full">Créer mon compte</button>{{ form_end(form) }}<p class="auth-back"><a href="{{ path('app_login') }}">Retour à la connexion</a></p></section>{% endblock %}
