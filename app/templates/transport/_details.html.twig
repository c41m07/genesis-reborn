{% set snapshot = report.snapshot %}
{% set trip %}<section class="panel transport-board-route"><h2>Trajet de la mission</h2><dl class="report-facts">
    <div><dt>Expéditeur</dt><dd>{{ snapshot.sender }}</dd></div>
    <div><dt>Destinataire</dt><dd>{{ snapshot.recipient }}</dd></div>
    <div><dt>Départ</dt><dd>{{ snapshot.origin }}</dd></div>
    <div><dt>Destination</dt><dd>{{ snapshot.destination }}</dd></div>
    <div><dt>État</dt><dd>{{ {traveling:'En route', delivered:'Livraison effectuée', refused:'Livraison refusée',destination_lost:'Destination perdue',waiting_capacity:'En attente de retrait',arrived:'Arrivée confirmée'}[report.status]|default(report.status) }}</dd></div>
    <div><dt>Départ de la mission</dt><dd>{{ report.createdAt|date('d/m/Y H:i') }}</dd></div>
    {% if report.resolvedAt %}<div><dt>Résolution de la livraison</dt><dd>{{ report.resolvedAt|date('d/m/Y H:i') }}</dd></div>{% endif %}
</dl></section>{% endset %}
{% set balance %}<section class="panel transport-board-balance"><h2>Bilan des ressources</h2>
<div class="table-scroll" role="region" tabindex="0" aria-label="Ressources transportées"><table class="data-table report-resource-table" role="table"><caption>Quantités envoyées, livrées et retournées</caption><thead><tr><th scope="col">Ressource</th><th scope="col">Envoyé</th><th scope="col">Livré</th><th scope="col">Retour prévu</th>{% if snapshot.returned_at is defined %}<th scope="col">Déposé au retour</th><th scope="col">Perdu au retour</th>{% endif %}</tr></thead><tbody>
{% for slug, amount in snapshot.sent %}<tr><th scope="row">{{ resources[slug]|default(slug) }}</th><td data-label="Envoyé">{{ amount|quantity(2) }}</td><td data-label="Livré">{{ snapshot.delivered[slug]|default(0)|quantity(2) }}</td><td data-label="Retour prévu">{{ snapshot.returned[slug]|default(0)|quantity(2) }}</td>{% if snapshot.returned_at is defined %}<td data-label="Déposé au retour">{{ snapshot.returned_deposited[slug]|default(0)|quantity(2) }}</td><td data-label="Perdu au retour" class="{{ snapshot.return_overflow[slug]|default(0) > 0 ? 'report-loss' : 'muted' }}">{{ snapshot.return_overflow[slug]|default(0) > 0 ? '−' : '' }}{{ snapshot.return_overflow[slug]|default(0)|quantity(2) }}</td>{% endif %}</tr>{% else %}<tr><td class="report-empty-row" colspan="{{ snapshot.returned_at is defined ? 6 : 4 }}">Aucune ressource chargée.</td></tr>{% endfor %}
</tbody></table></div>{% if snapshot.returned_at is defined %}<p class="muted">Flotte rentrée le {{ snapshot.returned_at|date('d/m/Y H:i') }}. Les pertes au retour correspondent au stockage insuffisant à l’arrivée.</p>{% endif %}</section>
{% endset %}
{% if balance_first|default(false) %}{{ balance }}{{ trip }}{% else %}{{ trip }}{{ balance }}{% endif %}
