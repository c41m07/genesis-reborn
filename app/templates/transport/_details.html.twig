{% set snapshot = report.snapshot %}
<section class="panel"><h2>Trajet de la mission</h2><dl class="report-facts">
    <div><dt>Expéditeur</dt><dd>{{ snapshot.sender }}</dd></div>
    <div><dt>Destinataire</dt><dd>{{ snapshot.recipient }}</dd></div>
    <div><dt>Départ</dt><dd>{{ snapshot.origin }}</dd></div>
    <div><dt>Destination</dt><dd>{{ snapshot.destination }}</dd></div>
    <div><dt>État</dt><dd>{{ {traveling:'En route', delivered:'Livraison effectuée', refused:'Livraison refusée'}[report.status]|default(report.status) }}</dd></div>
    <div><dt>Départ de la mission</dt><dd>{{ report.createdAt|date('d/m/Y H:i') }}</dd></div>
    {% if report.resolvedAt %}<div><dt>Résolution de la livraison</dt><dd>{{ report.resolvedAt|date('d/m/Y H:i') }}</dd></div>{% endif %}
</dl></section>
<section class="panel"><h2>Bilan des ressources</h2>
<div class="table-scroll" role="region" tabindex="0" aria-label="Ressources transportées, défilement horizontal"><table class="data-table"><caption>Quantités envoyées, livrées et retournées</caption><thead><tr><th scope="col">Ressource</th><th scope="col">Envoyé</th><th scope="col">Livré</th><th scope="col">Retour prévu</th>{% if snapshot.returned_at is defined %}<th scope="col">Déposé au retour</th><th scope="col">Perdu au retour</th>{% endif %}</tr></thead><tbody>
{% for slug, amount in snapshot.sent %}<tr><th scope="row">{{ resources[slug]|default(slug) }}</th><td>{{ amount|number_format(2, ',', ' ') }}</td><td>{{ snapshot.delivered[slug]|default(0)|number_format(2, ',', ' ') }}</td><td>{{ snapshot.returned[slug]|default(0)|number_format(2, ',', ' ') }}</td>{% if snapshot.returned_at is defined %}<td>{{ snapshot.returned_deposited[slug]|default(0)|number_format(2, ',', ' ') }}</td><td>{{ snapshot.return_overflow[slug]|default(0)|number_format(2, ',', ' ') }}</td>{% endif %}</tr>{% else %}<tr><td colspan="{{ snapshot.returned_at is defined ? 6 : 4 }}">Aucune ressource chargée.</td></tr>{% endfor %}
</tbody></table></div>{% if snapshot.returned_at is defined %}<p class="muted">Flotte rentrée le {{ snapshot.returned_at|date('d/m/Y H:i') }}. Les pertes au retour correspondent au stockage insuffisant à l’arrivée.</p>{% endif %}</section>
