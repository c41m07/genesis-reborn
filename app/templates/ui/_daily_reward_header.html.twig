{% import 'ui/macros.html.twig' as ui %}

{% if rewardAvailable %}
    <a class="quiet-button daily-reward-shortcut daily-reward-gift" href="{{ path('app_daily_reward', {colony: chrome.planet.id}) }}"
       aria-label="Quotidiennes" aria-description="Récompense disponible" data-header-tooltip="Quotidiennes"
       data-daily-reward-ui-target="gift" data-action="click->daily-reward-ui#openFromGift">
        {{ ui.gift_icon() }}
        <span class="daily-reward-indicator" aria-hidden="true"></span>
    </a>
{% endif %}
{% if chrome.membership %}
    {% set unreadMessages = chrome.unreadMessages|default(0) %}
    <a class="quiet-button daily-reward-shortcut daily-reward-mail" href="{{ path('app_messages') }}"
       aria-label="Messages" aria-description="{{ unreadMessages }} {{ unreadMessages == 1 ? 'message non lu' : 'messages non lus' }}"
       data-header-tooltip="Messages" data-daily-reward-ui-target="mail" {% if unreadMessages == 0 %}hidden{% endif %}>
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="m4 7 8 6 8-6"/></svg>
        <span class="daily-reward-indicator" aria-hidden="true"></span>
    </a>
{% endif %}
<a class="quiet-button daily-reward-shortcut" href="{{ path('app_wiki') }}" aria-label="Wiki" data-header-tooltip="Wiki"
   data-daily-reward-ui-target="wiki" {% if route starts with 'app_wiki' %}aria-current="{{ route == 'app_wiki' ? 'page' : 'location' }}"{% endif %}>
    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 6.5C9.5 4.8 6.4 4.6 3.5 5.5v13c2.9-.9 6-.7 8.5 1 2.5-1.7 5.6-1.9 8.5-1v-13c-2.9-.9-6-.7-8.5 1Zm0 0v13"/></svg>
</a>
<a class="quiet-button daily-reward-shortcut" href="{{ path('app_feedback', {context_url: app.request.uri}) }}"
   aria-label="Feedback" data-header-tooltip="Feedback">
    {{ ui.icon('notifications') }}
</a>
{% if is_granted('ROLE_ADMIN') %}
    <a class="quiet-button daily-reward-shortcut admin-header-link" href="{{ path('app_admin_index') }}"
       data-header-tooltip="Admin" data-controller="admin-notifications"
       data-admin-notifications-url-value="{{ path('app_admin_notifications') }}"
       data-admin-notifications-initial-value="{{ adminNotifications|json_encode|e('html_attr') }}"
       aria-describedby="admin-header-notifications"
       aria-label="Admin{{ adminNotifications.total > 0 ? ' ' ~ (adminNotifications.total > 99 ? '99+' : adminNotifications.total) : '' }} : ouvrir la console">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3.5 20 7v5c0 4.1-3.4 7.3-8 8.8C7.4 19.3 4 16.1 4 12V7l8-3.5Z"/><path d="M9 12l2 2 4-4"/></svg>
        {% include 'ui/admin_notification_badge.html.twig' with {category:'total', count:adminNotifications.total, id:'admin-header-notifications'} only %}
    </a>
{% endif %}
