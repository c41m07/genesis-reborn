{% set accountDestinations = [] %}
{% set currentLabel = '' %}
{% for destination in [
    {route:'app_profile',label:'Mes identifiants'},
    {route:'app_preferences',label:'Préférences'},
    {route:'app_vacation',label:'Mode vacances'},
    {route:'app_account_delete_page',label:'Suppression du compte'}
] %}
{% set active = app.request.attributes.get('_route') == destination.route %}
{% set accountDestinations = accountDestinations|merge([destination|merge({active:active})]) %}
{% if active %}{% set currentLabel = destination.label %}{% endif %}
{% endfor %}
{% include 'ui/space_navigation.html.twig' with {
    destinations:accountDestinations,
    navigationLabel:'Compte et préférences',
    currentLabel:currentLabel,
    compact:true
} only %}
