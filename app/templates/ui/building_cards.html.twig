{% import 'ui/macros.html.twig' as ui %}
{% set vacation = chrome.vacation|default(null) %}
{% set families = {} %}
{% set leveled = group in ['buildings', 'technologies'] %}
{% set queueType = group == 'buildings' ? 'building' : (group == 'technologies' ? 'research' : 'shipyard') %}
{% set queueFull = queues[queueType]|default([])|length >= 30 %}
{% for card in items %}
    {% set slug = card.definition.slug %}
    {% set families = families|merge({(slug): (families[slug]|default([]))|merge([card])}) %}
{% endfor %}
{% for slug, ranks in families %}
    {% set definition = (ranks|first).definition %}
    {% set category = (ranks|first).filter_category %}
    {% set accessible = ranks|filter(card => not card.failures or card.maximum) %}
    <article class="panel catalog-card card--{{ group }} building-card" data-building-catalog-target="family" data-slug="{{ slug }}" data-catalog-filter-target="card" data-category="{{ category }}" data-catalog-visible="{{ show_locked_items or accessible ? 'true' : 'false' }}" {% if not show_locked_items and not accessible %}hidden{% endif %}>
        <nav class="building-rank-tabs" aria-label="Rangs de {{ definition.label }}">
            {% for card in ranks %}
                {% set locked = card.failures and not card.maximum %}
                {% set affordable = true %}
                {% for resource, cost in card.costs %}{% if cost > resources[resource].stock %}{% set affordable = false %}{% endif %}{% endfor %}
                {% set count = leveled ? card.level : card.quantity %}
                {% set compactCount = leveled ? count|number_format(0, ',', ' ') : count|compact_number %}
                {% set upgradeable = not vacation and not locked and not card.maximum and affordable and not queueFull %}
                {% set tabId = 'building-tab-'~slug~'-'~card.tier %}
                <a id="{{ tabId }}" href="#item-{{ slug }}-{{ card.tier }}" class="building-rank-tab {{ locked ? 'is-locked' : '' }}" data-building-catalog-target="tab" data-tier="{{ card.tier }}" data-locked="{{ locked ? 'true' : 'false' }}" data-action="building-catalog#select keydown->building-catalog#navigate" aria-labelledby="{{ tabId }}-name {{ tabId }}-count" aria-describedby="{{ tabId }}-status" {% if locked and not show_locked_items %}hidden{% endif %}>
                    <span id="{{ tabId }}-name"><span class="building-rank-full">{{ card.definition._tier_label }}</span><span class="building-rank-short" aria-hidden="true">{{ {basic:'Basique',intermediate:'Interm.',superior:'Sup.'}[card.tier] }}</span></span>
                    <span class="building-rank-indicators" aria-hidden="true">{% if locked %}<span id="{{ tabId }}-count" class="building-rank-cross">×</span>{% else %}{% if upgradeable %}<span class="building-rank-up">{{ ui.icon('arrow') }}</span>{% endif %}<span id="{{ tabId }}-count" class="building-rank-level" title="{{ count|number_format(0, ',', ' ') }} {{ leveled ? 'niveaux' : 'unités possédées' }}">{{ compactCount }}</span>{% endif %}</span>
                    <span id="{{ tabId }}-status" hidden>{{ card.definition._tier_label }} · {{ locked ? 'Rang verrouillé, consulter les prérequis' : (leveled ? 'Niveau '~card.level : card.quantity|number_format(0, ',', ' ')~' unités possédées')~(upgradeable ? (group=='buildings' ? ' · Amélioration disponible' : (group=='technologies' ? ' · Recherche disponible' : ' · Construction d’une unité disponible')) : (card.maximum ? ' · Niveau maximum atteint' : (vacation ? ' · Mode vacances, commandes suspendues' : (queueFull ? ' · File pleine' : ' · Ressources insuffisantes')))) }}</span>
                </a>
            {% endfor %}
        </nav>
        {% for card in ranks %}
            {% set d = card.definition %}
            <div id="item-{{ slug }}-{{ card.tier }}" class="building-rank {{ card.failures and not card.maximum ? 'is-locked' : '' }}" data-building-catalog-target="panel" data-tier="{{ card.tier }}" {% if card.failures and not card.maximum and not show_locked_items %}hidden{% endif %}>
                <div class="catalog-card-art"><img src="{{ asset('images/catalog/'~group~'/'~slug~'__'~card.tier~'.webp') }}" alt="{{ d.label }}" loading="lazy" decoding="async"></div>
                <div class="card-body">
                    <div class="catalog-card-heading"><h3>{{ d.label }}</h3>{% include 'ui/catalogue_info.html.twig' %}</div>
                    <div class="build-duration">{{ ui.icon('clock') }} {{ duration_label(card.duration) }}</div>
                    <div class="costs building-costs" aria-label="{{ leveled ? 'Coût du prochain niveau' : 'Coût d’une unité' }}">
                        {% for resource, cost in card.costs %}{% if cost > 0 %}
                            <span class="{{ cost > resources[resource].stock ? 'insufficient' : '' }}" title="{{ resources[resource].label }} : {{ cost|number_format(0, ',', ' ') }}{{ cost > resources[resource].stock ? ' · Manque '~(cost-resources[resource].stock)|round(0,'ceil')|number_format(0, ',', ' ')~' '~resources[resource].label : '' }}" aria-label="{{ resources[resource].label }} : {{ cost|number_format(0, ',', ' ') }}{{ cost > resources[resource].stock ? ' · Manque '~(cost-resources[resource].stock)|round(0,'ceil')|number_format(0, ',', ' ')~' '~resources[resource].label : '' }}">{{ ui.icon(resource) }}<span>{{ cost|compact_number }}<small><span class="cost-label-full">{{ resources[resource].label }}</span><abbr class="cost-label-short" title="{{ resources[resource].label }}">{{ {metal:'Métal',nano:'Nano',hydrogen:'Hydro.',antimatter:'Antim.',electricity:'Élec.'}[resource]|default(resources[resource].label) }}</abbr></small></span></span>
                        {% endif %}{% endfor %}
                    </div>
                    {% include 'ui/catalogue_benefits.html.twig' %}
                    {% if card.maximum %}<p class="requirement complete">{{ ui.icon('check') }} Niveau maximum atteint</p>
                    {% elseif card.failures %}<p class="requirement">{{ ui.icon('diplomacy') }} <span>Nécessite : {% for requirement in card.details.requirements|filter(requirement => not requirement.met) %}<a href="{{ path('app_colony',{id:planet.id,section:requirement.group,showLockedItems:1,focusItem:1}) }}#item-{{ requirement.slug }}-{{ requirement.rank }}">{{ requirement.label }} · {{ requirement.tier }}{% if requirement.required is not null %} · niveau {{ requirement.required }}{% endif %}</a>{% if not loop.last %}, {% endif %}{% else %}{{ card.failures|join(', ') }}{% endfor %}</span></p>
                    {% elseif vacation %}<p class="requirement">Mode vacances : les constructions et recherches sont suspendues.</p>
                    {% else %}
                        {% set missingResources = [] %}
                        {% for resource, cost in card.costs %}{% if cost > resources[resource].stock %}{% set missingResources = missingResources|merge([(cost-resources[resource].stock)|round(0,'ceil')|number_format(0, ',', ' ')~' '~resources[resource].label]) %}{% endif %}{% endfor %}
                        {% set actionLabel = group=='buildings' ? 'Améliorer au niveau '~card.target : (group=='technologies' ? 'Rechercher le niveau '~card.target : 'Construire') %}
                        {% set blocked = missingResources is not empty or queueFull %}
                        <form method="post" action="{{ path('app_queue_add', {id: planet.id}) }}" {% if not leveled %}data-controller="construction-quantity" data-construction-quantity-url-value="{{ path('app_construction_maximum', {id: planet.id}) }}"{% endif %}>
                            <input type="hidden" name="_token" value="{{ csrf_token('build'~planet.id) }}">
                            <input type="hidden" name="request_key" value="{{ request_key() }}">
                            <input type="hidden" name="group" value="{{ group }}">
                            <input type="hidden" name="section" value="{{ group }}">
                            <input type="hidden" name="slug" value="{{ slug }}">
                            <input type="hidden" name="tier" value="{{ card.tier }}">
                            {% if not leveled %}<label for="quantity-{{ slug }}-{{ card.tier }}">Quantité</label><div class="quantity-input"><input id="quantity-{{ slug }}-{{ card.tier }}" name="quantity" type="number" min="1" value="1" required data-construction-quantity-target="input" data-action="change->construction-quantity#change" aria-describedby="quantity-status-{{ slug }}-{{ card.tier }}"><button type="button" class="secondary quantity-max" data-construction-quantity-target="max" data-action="construction-quantity#maximum" aria-label="Quantité maximale de {{ d.label }}" hidden>Max</button></div><small id="quantity-status-{{ slug }}-{{ card.tier }}" class="quantity-status" role="status" data-construction-quantity-target="status"></small>{% endif %}
                            <button class="secondary full"{% if blocked %} disabled{% endif %}{% if not leveled %} data-construction-quantity-target="submit" data-action-label="{{ actionLabel }}"{% endif %}><span{% if not leveled %} data-construction-quantity-target="label"{% endif %}>{{ queueFull ? 'File pleine' : (missingResources ? 'Manque '~missingResources|join(' · ') : actionLabel) }}</span><span{% if blocked %} hidden{% endif %}{% if not leveled %} data-construction-quantity-target="arrow"{% endif %}>{{ ui.icon('arrow') }}</span></button>
                        </form>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </article>
{% endfor %}
