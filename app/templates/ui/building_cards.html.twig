{% import 'ui/macros.html.twig' as ui %}
{% set vacation = chrome.vacation|default(null) %}
{# Variantes mesurées sur les cartes les plus demandées à l’ouverture des catalogues. #}
{% set cardVariants = {
    buildings: ['power_plant', 'mine_metal', 'mine_nano', 'lab'],
    technologies: ['engineering_foundations', 'naval_engineering', 'nanomaterial_synthesis', 'weapon_calibration', 'structural_armor', 'target_acquisition', 'shield_harmonics', 'evasive_navigation', 'signature_reduction', 'rapid_fire_cycle', 'weapons_engineering', 'vector_propulsion', 'cryogenic_reserves', 'modular_cargo_bays', 'colonial_expansion', 'automated_defense_repair', 'tactical_intelligence', 'intelligence_countermeasures', 'signature_masking'],
} %}
{% set families = {} %}
{% set leveled = group in ['buildings', 'technologies'] %}
{% set queueType = group == 'buildings' ? 'building' : (group == 'technologies' ? 'research' : 'shipyard') %}
{% set currentQueue = queues[queueType]|default([]) %}
{% set queueFull = currentQueue|length >= 30 %}
{% for card in items %}
    {% set slug = card.definition.slug %}
    {% set families = families|merge({(slug): (families[slug]|default([]))|merge([card])}) %}
{% endfor %}
{# La première ligne présente les familles représentatives des planches ; aucune entrée n’est ajoutée au catalogue. #}
{% set highlightedFamilies = {
    technologies: ['engineering_foundations','naval_engineering','nanomaterial_synthesis','colonial_expansion'],
    ships: ['fighter','probe','transport','interceptor'],
}[group]|default([])|filter(key => families[key] is defined) %}
{% set orderedFamilies = highlightedFamilies|merge(families|keys|filter(key => key not in highlightedFamilies)) %}
{% for slug in orderedFamilies %}
    {% set ranks = families[slug] %}
    {% set definition = (ranks|first).definition %}
    {% set category = (ranks|first).filter_category %}
    {% set accessible = ranks|filter(card => not card.failures or card.maximum) %}
    {% set familyLabels = {
        buildings:{power_plant:'Énergie', mine_metal:'Extraction', mine_nano:'Fabrication', mine_hydrogen:'Raffinage'},
        ships:{probe:'Reconnaissance', transport:'Transport'},
    } %}
    {% set familyLabel = familyLabels[group][slug]|default(catalog_filter_options[group][category]|default(group == 'buildings' ? 'Installation' : '')) %}
    {% set familyIcon = {buildings:'buildings', technologies:'research', ships:'fleet', defenses:'diplomacy'}[group] %}
    <article class="panel catalog-card card--{{ group }} building-card" data-building-catalog-target="family" data-slug="{{ slug }}" data-catalog-filter-target="card" data-category="{{ category }}" data-catalog-visible="{{ show_locked_items or accessible ? 'true' : 'false' }}" {% if not show_locked_items and not accessible %}hidden{% endif %}>
        <nav class="building-rank-tabs" aria-label="Rangs de {{ definition.label }}">
            {% for card in ranks %}
                {% set locked = card.failures and not card.maximum %}
                {% set affordable = true %}
                {% for resource, cost in card.costs %}{% if cost > resources[resource].stock %}{% set affordable = false %}{% endif %}{% endfor %}
                {% set count = leveled ? card.level : card.quantity %}
                {% set compactCount = leveled ? count|number_format(0, ',', ' ') : count|compact_number %}
                {% set stockStatus = leveled ? 'Niveau '~card.level : card.quantity|number_format(0, ',', ' ')~' unités possédées' %}
                {% set missingLocalLaboratory = card.missing_research_laboratory|default(null) %}
                {% set upgradeable = not missingLocalLaboratory and not vacation and not locked and not card.maximum and affordable and not queueFull and not card.capacity_full|default(false) %}
                {% set tabId = 'building-tab-'~slug~'-'~card.tier %}
                {# Le nom accessible suit le libellé et le compteur visibles ; le statut décrit les conditions. #}
                <a id="{{ tabId }}" href="#item-{{ slug }}-{{ card.tier }}" class="building-rank-tab {{ locked ? 'is-locked' : '' }}" data-building-catalog-target="tab" data-tier="{{ card.tier }}" data-locked="{{ locked ? 'true' : 'false' }}" data-action="building-catalog#select keydown->building-catalog#navigate" aria-describedby="{{ tabId }}-status" {% if locked and not show_locked_items %}hidden{% endif %}>
                    <span id="{{ tabId }}-name"><span class="building-rank-full">{{ card.definition._tier_label }}</span><span class="building-rank-short">{{ {basic:'Basique',intermediate:'Interm.',superior:'Sup.'}[card.tier] }}</span></span>
                    {# Le verrou porte sur les nouvelles commandes, pas sur les possessions conservées. #}
                    <span class="building-rank-indicators">{% if locked and count == 0 %}<span id="{{ tabId }}-count" class="building-rank-cross">×</span>{% else %}{% if upgradeable %}<span class="building-rank-up">{{ ui.icon('arrow') }}</span>{% endif %}<span id="{{ tabId }}-count" class="building-rank-level" title="{{ count|number_format(0, ',', ' ') }} {{ leveled ? 'niveaux' : 'unités possédées' }}">{{ compactCount }}</span>{% endif %}</span>
                    <span id="{{ tabId }}-status" hidden>
                        {{ card.definition._tier_label }} ·
                        {% if locked %}
                            {% if count > 0 %}{{ stockStatus }} · {% endif %}Rang verrouillé, consulter les prérequis
                        {% else %}
                            {{ stockStatus }} ·
                            {% if card.maximum %}{{ card.level < card.max_level ? 'Niveau maximum en file' : 'Niveau maximum atteint' }}
                            {% elseif missingLocalLaboratory %}{{ missingLocalLaboratory }} de niveau 1 requis sur cette colonie
                            {% elseif upgradeable %}{{ {buildings:'Amélioration disponible', technologies:'Recherche disponible'}[group]|default('Construction d’une unité disponible') }}
                            {% elseif vacation %}Mode vacances, commandes suspendues
                            {% elseif queueFull %}File pleine
                            {% elseif card.capacity_full|default(false) %}Aucune place de satellite disponible
                            {% else %}Ressources insuffisantes
                            {% endif %}
                        {% endif %}
                    </span>
                </a>
            {% endfor %}
        </nav>
        {% for card in ranks %}
            {% set d = card.definition %}
            {% set maximumPending = leveled and card.maximum and card.level < card.max_level %}
            {% set cardState = card.maximum ? (maximumPending ? 'queued' : 'maximum') : ((card.failures or card.missing_research_laboratory|default(null)) ? 'locked' : (vacation ? 'paused' : ((card.payment.missing|default([])) ? 'shortage' : 'ready'))) %}
            <div id="item-{{ slug }}-{{ card.tier }}" class="building-rank {{ card.failures and not card.maximum ? 'is-locked' : '' }}" data-building-catalog-target="panel" data-tier="{{ card.tier }}"{% if not leveled and not card.failures and not vacation %} data-controller="construction-quantity" data-construction-quantity-url-value="{{ path('app_construction_maximum', {id: planet.id}) }}"{% endif %} {% if card.failures and not card.maximum and not show_locked_items %}hidden{% endif %}>
                {% set imagePath = 'images/catalog/'~group~'/'~slug~'__'~card.tier %}
                {% set imageVariant = d.artwork|default('') is empty and card.tier == 'basic' and slug in (cardVariants[group]|default([])) %}
                <div class="catalog-card-art catalogue-card-visual" data-catalogue-state="{{ cardState }}">
                    <img src="{{ asset(d.artwork|default(imagePath~'.webp')) }}"
                         {% if imageVariant %}srcset="{{ asset(imagePath~'-768.webp') }} 768w, {{ asset(imagePath~'.webp') }} 1448w"
                         sizes="auto, (max-width: 640px) calc(100vw - 34px), 360px" width="1448" height="1086"{% endif %}
                         alt="{{ d.label }}" loading="lazy" decoding="async">
                    {% if familyLabel or cardState in ['queued', 'maximum', 'locked', 'paused', 'shortage'] %}
                        <span class="catalogue-family-mark">
                            {{ ui.icon(familyIcon) }}
                            {% if familyLabel %}<span>{{ familyLabel }}</span>{% endif %}
                            {% if cardState in ['queued', 'maximum', 'locked', 'paused', 'shortage'] %}<strong>{{ {
                                queued:'Maximum en file', maximum:'Au maximum', locked:'Verrouillé',
                                paused:'En vacances', shortage:'Ressources insuffisantes',
                            }[cardState] }}</strong>{% endif %}
                        </span>
                    {% endif %}
                </div>
                <div class="card-body">
                    <div class="catalog-card-heading catalogue-card-identity">
                        <h3>{{ d.label }}</h3>
                        <span class="catalogue-level-badge" data-catalogue-state="{{ cardState }}">
                            {% if leveled %}
                                {{ cardState == 'maximum' ? 'Max. ' ~ card.level : 'Niv. ' ~ card.level }}
                            {% else %}
                                {{ card.quantity|quantity }} {{ group == 'defenses' ? (card.quantity > 1 ? 'installés' : 'installé') : 'en réserve' }}
                            {% endif %}
                        </span>
                        {% include 'ui/catalogue_info.html.twig' %}
                    </div>
                    {% set guidedCard = training_hint is defined and training_hint is not null and training_hint.item == slug and card.tier == 'basic' %}
                    {% if guidedCard %}{% include 'player/_first_steps_catalog_hint.html.twig' %}{% endif %}
                    <p class="catalog-level">{% if leveled %}{{ maximumPending ? 'Dernier niveau en file' : (card.maximum ? 'Aucune amélioration pour ce rang' : 'Objectif : niveau ' ~ card.target) }}{% else %}{% if d.countered_ship_labels|default([]) %}Cibles : {{ d.countered_ship_labels|join(', ') }}{% else %}{{ group == 'defenses' ? 'Défense de cette colonie' : (slug == 'probe' ? 'Reconnaissance et espionnage' : (category == 'transport' ? 'Transport de ressources' : 'Hangar de cette colonie')) }}{% endif %}{% if card.failures %} · Verrouillé{% endif %}{% endif %}</p>
                    {% if card.queued %}<p class="catalog-queued">{{ card.target-card.level-1 }} niveau{{ card.target-card.level-1 > 1 ? 'x' : '' }} en file</p>{% endif %}
                    {% if not leveled or not card.maximum %}
                    <div class="build-duration">{{ ui.icon('clock') }} <small>Durée estimée</small> <span{% if not leveled %} data-construction-quantity-target="duration"{% endif %}>{{ duration_label(card.duration) }}</span></div>
                    {% set costsOverview %}
                    <p class="catalog-cost-heading"{% if not leveled %} data-construction-quantity-target="costHeading"{% endif %}>{{ leveled ? 'Coût du niveau '~card.target : 'Coût du lot × 1' }}</p>
                    <div class="costs building-costs" aria-label="{{ leveled ? 'Coût du prochain niveau' : 'Coût du lot' }}">
                        {% for resource, cost in card.costs %}{% if cost > 0 %}
                            <span data-resource="{{ resource }}" data-resource-label="{{ resources[resource].label }}"{% if not leveled %} data-construction-quantity-target="cost"{% endif %} class="{{ cost > resources[resource].stock ? 'insufficient' : '' }}" title="{{ resources[resource].label }} : {{ cost|number_format(0, ',', ' ') }}{{ cost > resources[resource].stock ? ' · Manque '~(cost-resources[resource].stock)|round(0,'ceil')|number_format(0, ',', ' ')~' '~resources[resource].label : '' }}" aria-label="{{ resources[resource].label }} : {{ cost|number_format(0, ',', ' ') }}{{ cost > resources[resource].stock ? ' · Manque '~(cost-resources[resource].stock)|round(0,'ceil')|number_format(0, ',', ' ')~' '~resources[resource].label : '' }}">{{ ui.icon(resource) }}<span><strong data-cost-amount>{{ cost|compact_number }}</strong><small><span class="cost-label-full">{{ resources[resource].label }}</span><abbr class="cost-label-short" title="{{ resources[resource].label }}">{{ {metal:'Métal',nano:'Nano',hydrogen:'Hydro.',antimatter:'Antim.',electricity:'Élec.'}[resource]|default(resources[resource].label) }}</abbr></small></span></span>
                        {% endif %}{% endfor %}
                    </div>
                    {% endset %}
                    {% if leveled %}{{ costsOverview }}{% endif %}
                    {% elseif card.maximum %}
                        <dl class="catalogue-no-quote" aria-label="Aucune nouvelle commande à payer">
                            <div><dt>Durée</dt><dd>—</dd></div>
                            <div><dt>Coût du niveau</dt><dd>—</dd></div>
                        </dl>
                    {% endif %}
                    {% if leveled %}
                        {% include 'ui/core_catalogue_gain.html.twig' %}
                    {% else %}
                        {% include 'ui/core_construction_benefit.html.twig' %}
                    {% endif %}
                    {% if card.economic|default(null) %}{% include 'ui/economic_units.html.twig' with {state:card.economic,definition:d} %}{% endif %}
                    {% if card.maximum or card.failures or vacation %}<div class="catalog-blocked">
                        {% if not leveled %}
                            <div class="core-construction-order">
                                {% include 'ui/core_construction_quantity.html.twig' with {inactive: true} %}
                                <div class="core-construction-cost">{{ costsOverview }}</div>
                            </div>
                        {% endif %}
                    {% endif %}
                    {% if card.maximum %}<p class="requirement{{ maximumPending ? '' : ' complete' }}">{{ ui.icon(maximumPending ? 'clock' : 'check') }} {{ maximumPending ? 'Dernier niveau programmé' : 'Niveau maximum atteint' }}</p>
                        {% set nextTier = {basic:'intermediate',intermediate:'superior'}[card.tier]|default(null) %}
                        {% set nextRank = ranks|filter(rank => rank.tier == nextTier)|first %}
                        {% if nextRank and not maximumPending %}
                            <p class="catalogue-next-rank"><a href="{{ catalogue_item_url(planet.id, group, slug, nextRank.tier) }}">Rang suivant : {{ nextRank.definition.label }} · {{ nextRank.definition._tier_label }} {{ ui.icon('arrow') }}</a></p>
                        {% endif %}
                    {% elseif card.failures %}<p class="requirement">{{ ui.icon('diplomacy') }} <span>Nécessite : {% for requirement in card.details.requirements|filter(requirement => not requirement.met) %}<a href="{{ catalogue_item_url(planet.id, requirement.group, requirement.slug, requirement.rank) }}">{{ requirement.label }} · {{ requirement.tier }}{% if requirement.required is not null %} · niveau {{ requirement.required }}{% endif %}</a>{% if not loop.last %}, {% endif %}{% else %}{{ card.failures|join(', ') }}{% endfor %}</span></p>
                    {% elseif card.missing_research_laboratory|default(null) %}
                        <p class="requirement">
                            {{ ui.icon('diplomacy') }}
                            <span>Installez le bâtiment
                                <a href="{{ catalogue_item_url(planet.id, 'buildings', 'lab', card.tier) }}">{{ card.missing_research_laboratory }} de niveau 1</a>
                                sur cette colonie pour lancer la recherche.
                            </span>
                        </p>
                    {% elseif vacation %}<p class="requirement">Mode vacances : les constructions et recherches sont suspendues.</p>
                    {% else %}
                        {% set missingResources = card.payment.missing %}
                        {% set wait = not queueFull ? card.payment.paymentWait : null %}
                        {% set estimate = wait ? card.payment.paymentEstimate : null %}
                        {% set actionLabel = group=='buildings' ? 'Améliorer au niveau '~card.target : (group=='technologies' ? 'Rechercher le niveau '~card.target : ((currentQueue ? 'Ajouter à la file' : 'Construire') ~ ' : ' ~ d.label ~ ' × 1')) %}
                        {% set blocked = missingResources is not empty or queueFull or card.capacity_full|default(false) %}
                        <form method="post" action="{{ path('app_queue_add', {id: planet.id}) }}"{% if not leveled %} data-construction-quantity-target="form"{% endif %}>
                            <input type="hidden" name="_token" value="{{ csrf_token('build'~planet.id) }}">
                            <input type="hidden" name="request_key" value="{{ request_key() }}">
                            <input type="hidden" name="group" value="{{ group }}">
                            <input type="hidden" name="section" value="{{ group }}">
                            <input type="hidden" name="slug" value="{{ slug }}">
                            {% if guidedCard and card.target == 1 and slug in ['mine_metal', 'engineering_foundations'] %}<input type="hidden" name="guided_first_step" value="1">{% endif %}
                            <input type="hidden" name="tier" value="{{ card.tier }}">
                            {% if not leveled %}
                                <div class="core-construction-order">
                                    {% include 'ui/core_construction_quantity.html.twig' with {inactive: false} %}
                                    <div class="core-construction-cost">{{ costsOverview }}</div>
                                </div>
                            {% endif %}
                            <div class="catalog-payment">
                                <button class="{{ not blocked ? 'primary' : 'secondary' }} full catalog-build-action{{ missingResources and not queueFull ? ' has-missing-resources' : '' }}"{% if blocked %} disabled{% endif %}{% if not leveled %} data-construction-quantity-target="submit" data-order-name="{{ d.label }}" data-queue-occupied="{{ currentQueue ? 'true' : 'false' }}"{% endif %}><span class="catalog-action-label"{% if not leveled %} data-construction-quantity-target="label"{% endif %}>{% if queueFull %}File pleine{% elseif missingResources %}Il manque :{% for missing in missingResources %}<span class="catalog-missing-resource">{{ missing.label }} : {{ missing.amount|number_format(0, ',', ' ') }}</span>{% endfor %}{% elseif card.capacity_full|default(false) %}Aucune place disponible{% else %}{{ actionLabel }}{% endif %}</span><span{% if blocked %} hidden{% endif %}{% if not leveled %} data-construction-quantity-target="arrow"{% endif %}>{{ ui.icon('arrow') }}</span></button>
                                {% if wait or not leveled %}
                                    {% set wait_id = 'catalog-wait-' ~ group ~ '-' ~ slug ~ '-' ~ card.tier %}
                                    <div class="catalog-wait"{% if not wait %} hidden{% endif %} data-construction-quantity-target="wait" data-controller="hover-details"
                                         data-action="pointerenter->hover-details#enter pointerleave->hover-details#leave focusout->hover-details#blur keydown->hover-details#escape">
                                        <span data-construction-quantity-target="waitText" data-resource-eta-target="timer"
                                            {% if estimate %}role="timer" aria-live="off" data-observed-at="{{ estimate.observedAt }}" data-deadline="{{ estimate.deadline }}" data-limiting-resource="{{ estimate.resource }}"{% endif %}>{{ wait }}</span>
                                        <button type="button" class="secondary" popovertarget="{{ wait_id }}" aria-label="Comprendre le délai de financement" aria-expanded="false" data-hover-details-target="trigger" data-action="focus->hover-details#focus click->hover-details#pin">i</button>
                                        <p id="{{ wait_id }}" class="catalog-wait-info" popover data-hover-details-target="panel" data-action="toggle->hover-details#changed">
                                            Estimation au rythme actuel de cette colonie, sans tenir compte des dépenses, opérations ou changements de production à venir. Le temps écoulé ne garantit pas de pouvoir commander.
                                        </p>
                                    </div>
                                {% endif %}
                            </div>
                        </form>
                    {% endif %}
                    {% if card.maximum or card.failures or vacation %}<button type="button" class="secondary full catalog-blocked-action" disabled>{{ card.maximum ? (maximumPending ? 'Niveau maximum en file' : 'Niveau maximum atteint') : (card.failures ? 'Prérequis manquants' : 'Mode vacances') }}</button></div>{% endif %}
                    {% if not leveled or (not card.maximum and card.benefits) %}
                        <div class="core-unit-details">{% include 'ui/catalogue_benefits.html.twig' %}</div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </article>
{% endfor %}
