{%- if benefit.before is defined -%}
    {%- set delta = benefit.after - benefit.before -%}
    {%- set signedDelta = benefit.consumption|default(false) ? -delta : delta -%}
    {{- signedDelta > 0 ? '+' : (signedDelta < 0 ? '−' : '') -}}
    {{- (benefit.unit == '%' ? (signedDelta|abs)|number_format(2, ',', ' ')|trim('0', 'right')|trim(',', 'right') : (signedDelta|abs)|quantity(2, true)) -}}
{%- else -%}
    {{- (benefit.unit in ['%', 's', 'UA/s'] ? benefit.value|number_format(benefit.decimals|default(0), ',', ' ') : benefit.value|quantity(benefit.decimals|default(0))) -}}
{%- endif %} {{ benefit.unit }}
