{% if card.maximum %}<p class="catalog-level-complete">Niveau maximum atteint pour ce rang.</p>{% elseif card.benefits %}<details class="card-benefits" aria-label="Bénéfice de {{ d.label }}"><summary>{{ group == 'ships' ? 'Caractéristiques du vaisseau' : (group == 'defenses' ? 'Cibles et caractéristiques' : (group == 'buildings' ? 'Gain du prochain niveau' : 'Effets de recherche · prochain niveau')) }}</summary><div class="card-benefits-content">{% for benefit in card.benefits %}{% if benefit.text is defined %}{% if benefit.label is defined %}<div><span>{{ benefit.label }}</span><strong>{{ benefit.text }}</strong></div>{% else %}<p>{{ benefit.text }}</p>{% endif %}{% else %}<div class="{{ benefit.consumption|default(false) ? 'card-benefit-consumption' : '' }}"><span>{{ benefit.label }}</span><strong>{% include 'ui/catalogue_benefit_value.html.twig' with {benefit: benefit} only %}</strong></div>{% endif %}{% endfor %}</div></details>{% endif %}
