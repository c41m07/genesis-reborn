{% import 'ui/macros.html.twig' as ui %}
{% set vacation=chrome.vacation|default(null) %}
{% set catalogue = section in ['buildings','technologies','ships','defenses'] %}
{% set orderLimit = constant('App\\Service\\Queue\\QueueService::MAX_ORDERS') %}
<div class="scene-operations{{ catalogue ? ' catalog-queue-ribbon' : '' }}" data-live-region="queues"{% if catalogue %} id="colony-catalog-queues"{% endif %} aria-label="Files d’attente de {{ planet.name }}">
{% if not catalogue %}<div class="section-heading"><h2>{{ section == 'overview' ? 'Activité de ' ~ planet.name : 'Activité de la colonie' }}</h2><span class="scene-live"><i class="connection-dot"></i> {{ section == 'overview' ? 'COLONIE ACTIVE · ' : '' }}EN DIRECT</span></div>{% endif %}
{% if vacation %}<p role="status">Mode vacances : production et files suspendues jusqu’au <time datetime="{{ vacation.scheduledEndAt|date('c') }}">{{ vacation.scheduledEndAt|date('d/m/Y à H:i',preferences.timezone) }}</time>. <a href="{{ path('app_vacation') }}#vacances">Gérer mes vacances</a></p>{% endif %}
{% set queueLabels = {building:'Bâtiment', research:'Recherche commune', shipyard:'Vaisseaux & défenses'} %}
{% set selectedQueue = {buildings:'building', technologies:'research', ships:'shipyard', defenses:'shipyard'}[section]|default(null) %}
{% set queueTypes = queueLabels|keys %}
{% if catalogue %}
    <p class="catalog-queue-caption">{{ ui.icon('buildings') }} <strong>Files de la colonie</strong></p>
    {# La file de l’écran prend la première place ; les autres usages gardent leur ordre naturel. #}
    {% set queueTypes = [selectedQueue]|merge(queueTypes|filter(type => type != selectedQueue)) %}
{% endif %}
{% for type in queueTypes %}{% set label = queueLabels[type] %}
{% set items=queues[type]|default([]) %}{% set head=items|first %}
{% if catalogue %}
<details class="scene-operation catalog-disclosure{{ type == selectedQueue ? ' catalog-queue-current' : '' }}" data-queue-type="{{ type }}" data-catalog-disclosure="queue-{{ type }}" data-queue-occupied="{{ head ? 'true' : 'false' }}">
    <summary class="catalog-follow-summary">
        {% set runningCount = items|filter(row => row.item.startedAt)|length %}
        <strong>{{ {building:'Bâtiments', research:'Recherche commune', shipyard:'Vaisseaux et défenses'}[type] }}</strong>
        {% if head %}<small class="catalog-queue-state">
            {% if vacation %}En pause{% elseif runningCount %}{{ runningCount }} en cours{% else %}En attente{% endif %}
            {% if items|length > runningCount and runningCount %} · {{ items|length - runningCount }} en attente{% endif %}
        </small>{% endif %}
        <span>{% if head %}{{ head.label }}{% if head.item.itemLevel %} · niv. {{ head.item.itemLevel }}{% else %} × {{ head.item.quantity|quantity }}{% endif %}{% else %}File disponible{% endif %} <span aria-hidden="true">⌄</span></span>
        {% if head and head.item.startedAt and not vacation %}{{ ui.progress(head.progress.start,head.finish,'Progression : '~label,null,head.progress.percent) }}{% endif %}
    </summary>
    <div class="catalog-follow-panel">
{% else %}<div class="scene-operation" data-queue-type="{{ type }}">{% endif %}
<div class="operation-heading"><span class="operation-type">{{ ui.icon(type=='building'?'buildings':(type=='research'?'research':'fleet')) }}{{ label }}</span>{% if catalogue and head %}<span class="queue-capacity">{{ items|length }}/{{ orderLimit }} commandes</span>{% endif %}{% if items|length>1 %}<span class="queue-extra" title="{{ items|length-1 }} {{ type=='research' ? 'autres recherches dans la file commune' : 'commandes supplémentaires en attente' }}">+{{ items|length-1 }}</span>{% endif %}</div>
{% if catalogue and items|length > orderLimit %}<p class="muted">Les commandes déjà lancées sont conservées. Attendez qu’il reste moins de {{ orderLimit }} commandes pour en ajouter.</p>{% endif %}
{% if type=='research' %}<p class="muted">File commune à vos colonies de cet univers.{% if head %} Recherche en cours depuis {{ head.item.planet.name }}.{% endif %}</p>{% if research_parallel_count|default(0)>1 %}<p role="status">Les recherches déjà commencées se terminent. Les suivantes attendent dans la file commune.</p>{% endif %}{% endif %}
{% if head %}<div class="operation-name"><strong>{{ head.label }}</strong><small>{% if head.item.itemLevel %}Niveau {{ head.item.itemLevel }}{% else %}× {{ head.item.quantity|quantity }}{% endif %}</small></div>
{% if vacation %}
{% set elapsed=max(0,vacation.scheduledEndAt|date('U')-head.progress.start|date('U')) %}
{% set span=max(1,head.finish|date('U')-head.progress.start|date('U')) %}
{% set percent=max(0,min(100,head.progress.percent + elapsed/span*(100-head.progress.percent))) %}
<div class="operation-progress" data-vacation-paused="true"><div class="progress-track" role="progressbar" aria-label="Progression suspendue : {{ label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent|round }}" aria-valuetext="{{ percent|round }} %, en pause pendant les vacances"><span style="width:{{ percent }}%"></span></div><div class="progress-times"><span>En pause · <strong>{{ duration_label(max(0,head.finish|date('U')-vacation.scheduledEndAt|date('U'))) }}</strong> de travail restant</span><span>File complète · <strong>{{ duration_label(max(0,(items|last).finish|date('U')-vacation.scheduledEndAt|date('U'))) }}</strong> de travail restant</span></div></div>
{% else %}{{ ui.progress(head.progress.start,head.finish,'Progression : '~label,(items|last).finish,head.progress.percent) }}{% endif %}
<details class="queue-details"{% if catalogue %} open{% endif %}><summary>{{ vacation?'Consulter':'Gérer' }} la file <span>({{ items|length }})</span></summary><div class="queue-detail-list">{% for row in items %}{% set q=row.item %}<div class="queue-detail-item"><span><strong>{{ row.label }}</strong><small>{% if q.itemLevel %}Niveau {{ q.itemLevel }}{% else %}× {{ q.quantity|quantity }}{% endif %} · {{ q.startedAt?(vacation?'En pause':'En cours'):'En attente' }}{% if not q.startedAt %} · {{ duration_label(row.duration) }} estimé{% endif %}{% if type=='research' %} · {{ q.planet.name }}{% endif %}</small></span>{% if not vacation %}<a class="text-button" href="{{ path('app_queue_cancel_preview',{id:planet.id,itemId:q.id,section:section}) }}" aria-label="Préparer l’annulation de {{ row.label }} et ses dépendances">Préparer l’annulation</a>{% endif %}</div>{% endfor %}<p>{{ vacation?'Les annulations et accélérations sont indisponibles pendant les vacances.':'Les annulations suppriment les niveaux dépendants, avec remboursement de 25 % des ressources de chaque commande annulée, dans la limite du stockage.' }}</p></div></details>
{% else %}
    <p class="operation-idle">{{ catalogue and type == 'research' ? 'Aucune recherche en cours' : 'Aucune commande en cours' }}</p>
    <div class="progress-track empty-track" aria-hidden="true"></div>
    {% if catalogue and type == 'research' %}
        <a class="secondary catalogue-empty-queue-link" href="{{ path('app_technology_tree') }}">Voir le guide technologique</a>
    {% endif %}
{% endif %}
{% if section == 'overview' %}
    <div class="overview-queue-links">
        {% if type == 'building' %}
            <a href="{{ path('app_colony',{id:planet.id,section:'buildings'}) }}">Ouvrir les bâtiments {{ ui.icon('arrow') }}</a>
        {% elseif type == 'research' %}
            <a href="{{ path('app_colony',{id:planet.id,section:'technologies'}) }}">Ouvrir la recherche {{ ui.icon('arrow') }}</a>
        {% else %}
            <a href="{{ path('app_colony',{id:planet.id,section:'ships'}) }}">Chantier spatial {{ ui.icon('arrow') }}</a>
            <a href="{{ path('app_colony',{id:planet.id,section:'defenses'}) }}">Défenses {{ ui.icon('arrow') }}</a>
        {% endif %}
    </div>
{% endif %}
{% if catalogue %}</div></details>{% else %}</div>{% endif %}{% endfor %}
</div>
