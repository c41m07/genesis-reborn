{% import 'ui/macros.html.twig' as ui %}
{% set vacation=chrome.vacation|default(null) %}
<div class="scene-operations" data-live-region="queues" aria-label="Files d’attente de {{ planet.name }}">
<div class="section-heading"><h2>Activité de la colonie</h2><span class="scene-live"><i class="connection-dot"></i> EN DIRECT</span></div>
{% if vacation %}<p role="status">Mode vacances : production et files suspendues jusqu’au <time datetime="{{ vacation.scheduledEndAt|date('c') }}">{{ vacation.scheduledEndAt|date('d/m/Y à H:i',preferences.timezone) }}</time>. <a href="{{ path('app_preferences') }}#vacances">Gérer mes vacances</a></p>{% endif %}
{% for type,label in {'building':'Bâtiment','research':'Recherche','shipyard':'Vaisseaux & défenses'} %}
{% set items=queues[type]|default([]) %}{% set head=items|first %}
<div class="scene-operation" data-queue-type="{{ type }}">
<div class="operation-heading"><span class="operation-type">{{ ui.icon(type=='building'?'buildings':(type=='research'?'research':'fleet')) }}{{ label }}</span>{% if items|length>1 %}<span class="queue-extra" title="{{ items|length-1 }} commandes supplémentaires en attente">+{{ items|length-1 }}</span>{% endif %}</div>
{% if head %}<div class="operation-name"><strong>{{ head.label }}</strong><small>{% if head.item.itemLevel %}Niveau {{ head.item.itemLevel }}{% else %}× {{ head.item.quantity|quantity }}{% endif %}</small></div>
{% if vacation %}
{% set elapsed=max(0,vacation.scheduledEndAt|date('U')-head.item.startedAt|date('U')) %}{% set percent=max(0,min(100,elapsed/max(1,head.item.durationSeconds)*100)) %}
<div class="operation-progress" data-vacation-paused="true"><div class="progress-track" role="progressbar" aria-label="Progression suspendue : {{ label }}" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent|round }}" aria-valuetext="{{ percent|round }} %, en pause pendant les vacances"><span style="width:{{ percent }}%"></span></div><div class="progress-times"><span>En pause · <strong>{{ duration_label(max(0,head.finish|date('U')-vacation.scheduledEndAt|date('U'))) }}</strong> de travail restant</span><span>File complète · <strong>{{ duration_label(max(0,(items|last).finish|date('U')-vacation.scheduledEndAt|date('U'))) }}</strong> de travail restant</span></div></div>
{% else %}{{ ui.progress(head.item.startedAt,head.finish,'Progression : '~label,(items|last).finish) }}{% endif %}
<details class="queue-details"><summary>{{ vacation?'Consulter':'Gérer' }} la file <span>({{ items|length }})</span></summary><div class="queue-detail-list">{% for row in items %}{% set q=row.item %}<div class="queue-detail-item"><span><strong>{{ row.label }}</strong><small>{% if q.itemLevel %}Niveau {{ q.itemLevel }}{% else %}× {{ q.quantity|quantity }}{% endif %} · {{ loop.first?(vacation?'En pause':'En cours'):'En attente' }}</small></span>{% if not vacation %}<form method="post" action="{{ path('app_queue_cancel',{id:planet.id,itemId:q.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('cancel'~q.id) }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="section" value="{{ section }}"><button class="text-button" aria-label="Annuler {{ row.label }} et ses dépendances">Annuler</button></form>{% endif %}</div>{% endfor %}<p>{{ vacation?'Les annulations et accélérations sont indisponibles pendant les vacances.':'Les annulations suppriment les niveaux dépendants, avec remboursement de 25 % des ressources de chaque commande annulée, dans la limite du stockage.' }}</p></div></details>
{% else %}<p class="operation-idle">Aucune commande en cours</p><div class="progress-track empty-track" aria-hidden="true"></div>{% endif %}
</div>{% endfor %}
</div>
