{% if chrome.planet %}<div class="sidebar-colonies" data-live-region="colony-selector"><label for="sidebar-colony">VOS COLONIES <span>{{ chrome.planets|length }}/{{ chrome.colonyLimit }}</span></label><form action="{{ path('app_home') }}" method="get"><input type="hidden" name="section" value="{{ section }}"><div class="sidebar-colony-choice"><span class="tiny-planet" aria-hidden="true"></span><select id="sidebar-colony" name="colony" data-controller="colony-switch" data-action="change->colony-switch#change" aria-label="Choisir une colonie">{% for p in chrome.planets %}<option value="{{ p.id }}" {{ p.id==chrome.planet.id?'selected':'' }}>{{ p.name }} · {{ p.coordinates() }}{{ p.acquiredAt ? '' : ' · ancienneté approximative' }}</option>{% endfor %}</select></div><noscript><button class="secondary full">Choisir cette colonie</button></noscript></form></div>{% endif %}
