{% set eventDestinations = [] %}
{% set currentLabel = '' %}
{% for destination in [{route:'app_game_events',label:'Événements et bonus'},{route:'app_game_challenges',label:'Défis et rotations'}] %}
{% set active = route == destination.route or destination.route == 'app_game_challenges' and route == 'app_challenge' %}
{% set eventDestinations = eventDestinations|merge([destination|merge({active:active})]) %}
{% if active %}{% set currentLabel = destination.label %}{% endif %}
{% endfor %}
{% include 'ui/space_navigation.html.twig' with {
    destinations:eventDestinations,
    navigationLabel:'Navigation des événements',
    currentLabel:currentLabel,
    currentAriaValue:route == 'app_challenge' ? 'location' : 'page',
    compact:true
} only %}
