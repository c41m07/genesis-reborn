<fieldset class="fleet-destination-modes">
<legend>Type de destination</legend>
{% for value,label in {friendly:'Mes planètes et alliés',enemies:'Ennemis',custom:'Destination personnalisée'} %}
<label for="destination-mode-{{ f.id }}-{{ value }}"><input type="radio" id="destination-mode-{{ f.id }}-{{ value }}" name="destination_mode" value="{{ value }}" {{ prefill.mode==value?'checked':'' }}><span>{{ label }}</span></label>
{% endfor %}
</fieldset>
<p class="muted" data-fleet-destination-target="choicesStatus" role="status"></p>
{% for value,label in {friendly:'Planète de mon empire ou alliée',enemies:'Planète ennemie ou PNJ'} %}
<div data-fleet-destination-target="panel" data-mode="{{ value }}">
<label for="destination-{{ f.id }}-{{ value }}">{{ label }}</label>
<select id="destination-{{ f.id }}-{{ value }}" name="{{ value }}_destination" data-fleet-destination-target="{{ value }}">
<option value="">Choisir une planète découverte compatible</option>
{% for target in destination_choices.groups[value] %}{% if target.id!=f.homePlanet.id %}
<option value="{{ target.id }}" data-system-coordinates="{{ target.systemCoordinates }}" {{ prefill.planet==target.id?'selected':'' }}>{{ target.label }}</option>
{% endif %}{% endfor %}
</select>
</div>
{% endfor %}
<div data-fleet-destination-target="panel" data-mode="custom">
<label for="destination-search-{{ f.id }}">Pseudonyme du commandant</label>
<div class="fleet-destination-search">
<input id="destination-search-{{ f.id }}" type="search" maxlength="40" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="destination-results-{{ f.id }}" aria-describedby="destination-search-help-{{ f.id }}" data-fleet-destination-target="search" data-action="input->fleet-destination#search keydown->fleet-destination#navigate blur->fleet-destination#blur">
<ul id="destination-results-{{ f.id }}" class="fleet-destination-suggestions" role="listbox" aria-label="Planètes découvertes proposées" data-fleet-destination-target="results" hidden></ul>
</div>
<small id="destination-search-help-{{ f.id }}">Deux caractères minimum. Seules les planètes découvertes dans cet univers et compatibles avec la mission sont proposées.</small>
<p class="muted" role="status" data-fleet-destination-target="searchStatus"></p>
<div data-fleet-fields-target="coordinate">
<label for="coordinates-{{ f.id }}">Coordonnées de destination</label>
<input id="coordinates-{{ f.id }}" name="coordinates" type="text" maxlength="30" autocomplete="off" placeholder="A:12:3" value="{{ prefill.coordinates }}" data-fleet-destination-target="coordinates">
<small data-fleet-fields-target="coordinateHelp">Système : A:12 · planète : A:12:3</small>
</div>
<noscript><p>Utilisez les coordonnées pour une destination personnalisée.</p></noscript>
</div>
<p class="muted fleet-pnj-help">PNJ : Attaque pour combattre sans capture ni butin ; Conquête JcE pour capturer selon les conditions de l’univers. Pour explorer un système inconnu, utilisez Destination personnalisée.</p>
