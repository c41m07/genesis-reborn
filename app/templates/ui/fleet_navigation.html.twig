{% set fleetRoute = app.request.attributes.get('_route') %}
{% set fleetDestinations = [] %}
{% set currentLabel = 'Missions actives' %}
{% for destination in [
    {route:'app_fleets',label:'Missions actives'},
    {route:'app_fleet_prepare',label:'Préparer une mission'},
    {route:'app_fleet_empire',label:'Flotte de l’empire'},
    {route:'app_fleet_orbits',label:'Demandes d’orbite'},
    {route:'app_fleet_holds',label:'À quai et stationnements'},
    {route:'app_fleet_compositions',label:'Mes compositions'}
] %}
{% set active = fleetRoute==destination.route or (destination.route=='app_fleet_compositions' and fleetRoute in ['app_fleet_composition_new','app_fleet_composition_edit','app_fleet_composition_load']) or (destination.route=='app_fleet_holds' and fleetRoute=='app_fleet_station_resume') or (destination.route=='app_fleets' and fleetRoute=='app_fleet_recall') %}
{% set fleetDestinations = fleetDestinations|merge([destination|merge({active:active})]) %}
{% if active %}{% set currentLabel = destination.label %}{% endif %}
{% endfor %}
{% include 'ui/space_navigation.html.twig' with {
    destinations:fleetDestinations,
    navigationLabel:'Navigation des flottes',
    currentLabel:currentLabel,
    compact:fleetRoute in ['app_fleets','app_fleet_empire','app_fleet_prepare','app_fleet_recall','app_fleet_orbits','app_fleet_holds','app_fleet_station_resume','app_fleet_compositions','app_fleet_composition_new','app_fleet_composition_edit','app_fleet_composition_load']
} only %}
