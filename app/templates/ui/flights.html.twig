{% import 'ui/macros.html.twig' as ui %}
{% set mission_labels={explore:'Exploration',colonize:'Colonisation',transport:'Transport',attack:'Attaque',spy:'Espionnage',defend:'Défense',orbit:'Mise en orbite',station:'Stationnement',conquer:'Conquête JcE'} %}
<section class="panel flight-operations" data-live-region="active-flights" aria-label="Flottes en vol dans votre empire">
<div class="section-heading"><div><h2>{{ ui.icon('fleet') }} Flottes en vol <span class="badge">{{ active_fleets|length }}</span></h2></div><a href="{{ path('app_fleets') }}" class="inline-link">Gérer les flottes {{ ui.icon('arrow') }}</a></div>
{% for f in active_fleets %}{% set combat_event = combat_events[f.id]|default(null) %}{% set detail_id="fleet-details-"~f.id %}{% set detail_label="Composition et fret" %}<article class="flight-operation" id="fleet-{{ f.id }}" data-active-fleet="{{ f.id }}" data-status="{{ f.status }}" data-mission="{{ f.mission }}" {% if fleet_details[f.id] is defined %}data-controller="hover-details" data-action="pointerenter->hover-details#enter pointerleave->hover-details#leave focusout->hover-details#blur keydown->hover-details#escape click->hover-details#card"{% endif %}><div class="operation-heading"><span class="operation-type">{{ ui.icon(f.status=='returning'?'arrow':'fleet') }}{% if fleet_details[f.id] is defined %}{% include 'ui/empire_details_trigger.html.twig' with {detail_name:mission_labels[f.mission]|default(f.mission)} %}{% else %}{{ mission_labels[f.mission]|default(f.mission) }}{% endif %}</span><span class="badge {{ f.status=='returning'?'returning':'' }}">{{ {returning:'RETOUR',attacking:'EN COMBAT',defending:'EN DÉFENSE',orbiting:'EN ORBITE',orbit_pending:'À ACCEPTER',occupying:'OCCUPATION JcE',station_waiting:'EN ATTENTE'}[f.status]|default('ALLER') }}</span></div><p class="flight-ownership">Votre flotte</p><div class="flight-route"><span>{{ f.status=='returning'?(f.navigation.recall is defined?'Position du rappel':(f.navigation.station.route_origin_id is defined?'Position de repli':(f.destination?f.destination.name:f.destinationSystem.name))):f.homePlanet.name }}</span>{{ ui.icon('arrow') }}<span>{{ f.status=='returning'?(f.returnPlanet?f.returnPlanet.name:f.homePlanet.name):(f.destination?f.destination.name:f.destinationSystem.name) }}</span></div>{% if combat_event and f.status in ['attacking','defending'] %}<div class="combat-timers" aria-label="Combat en cours, round {{ combat_event.currentRound + 1 }}"><strong class="combat-round">Round {{ combat_event.currentRound + 1 }}</strong><span>Prochain round dans <span data-controller="countdown" data-countdown-end-value="{{ combat_event.startedAt|date_modify('+' ~ ((combat_event.currentRound + 1) * 60) ~ ' seconds')|date('c') }}"><span data-countdown-target="time">{{ combat_event.startedAt|date_modify('+' ~ ((combat_event.currentRound + 1) * 60) ~ ' seconds')|date('H:i:s') }}</span></span></span><span class="combat-window">Fin estimée dans <span data-controller="countdown" data-countdown-end-value="{{ combat_event.resolveAt|date('c') }}"><span data-countdown-target="time">{{ combat_event.resolveAt|date('H:i:s') }}</span></span></span></div>{% endif %}{% if f.status=='occupying' %}<p>Occupation en cours : la planète ne vous appartient pas encore.</p>{% endif %}<div class="flight-progress-row"><div class="flight-progress-timing">{% if f.status=='station_waiting' %}<p class="flight-idle">Stationnement en attente. <a href="{{ path('app_fleet_station_resume',{id:f.id}) }}">Reprendre après devis</a></p>{% elseif f.status=='orbit_pending' %}<p class="flight-idle">En attente de l’accord du propriétaire.</p>{% elseif f.arrivalAt %}{{ ui.progress(f.departureAt,f.arrivalAt,({returning:'Retour',defending:'Fin de défense',orbiting:'Fin d’orbite',occupying:'Échéance d’occupation'}[f.status]|default('Arrivée'))~' de la flotte '~f.id) }}{% else %}<p class="flight-idle">Flotte engagée dans un combat.</p>{% endif %}</div>{% if f.status in ['traveling','orbiting','orbit_pending'] and not combat_event %}<a class="secondary fleet-recall-link" href="{{ path('app_fleet_recall',{id:f.id}) }}" aria-label="Préparer le rappel de la flotte {{ f.id }}">Rappeler</a>{% endif %}</div>{% if fleet_details[f.id] is defined %}{% include 'ui/empire_details.html.twig' with {detail:fleet_details[f.id],detail_label:detail_label,detail_id:detail_id,fleet_detail:true} only %}{% endif %}{% if f.navigation.recall is defined %}<p>Flotte rappelée · retour vers {{ f.returnPlanet ? f.returnPlanet.name : f.homePlanet.name }}.</p>{% endif %}</article>{% else %}<p class="flight-idle">{{ fleet_colony_scope|default(false) ? 'Aucune mission en cours au départ de cette colonie.' : 'Aucune flotte en vol. Les départs et les retours de toutes vos colonies apparaissent ici.' }}</p>{% endfor %}
</section>
