{# La surveillance de carte reste active hors des pages qui affichent les deux cadres. #}
{% set showPanel = incoming_panel ?? true %}
<div class="incoming-attacks" data-controller="incoming-attacks" data-incoming-attacks-url-value="{{ path('app_fleet_surveillance') }}" data-incoming-attacks-membership-value="{{ chrome.membership.id }}" data-incoming-attacks-now-value="{{ chrome.serverNow }}" data-incoming-attacks-panel-value="{{ showPanel ? 'true' : 'false' }}">
<div data-incoming-attacks-target="content">{% if showPanel %}{% include 'ui/incoming_attacks_list.html.twig' with {attacks:chrome.incomingAttacks|default([])} %}{% endif %}</div>
<p class="visually-hidden" aria-live="polite" aria-atomic="true" data-incoming-attacks-target="status"></p>
{% if showPanel %}<noscript><p>Actualisez la page pour vérifier les flottes entrantes et leurs échéances.</p></noscript>{% endif %}
</div>
