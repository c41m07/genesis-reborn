{# Les attributs d’actualisation existants gardent les pages déjà ouvertes compatibles. #}
{% set fleets = attacks|default([]) %}
{% set threats = fleets|filter(fleet => fleet.mission in ['attack', 'conquer'])|length %}
<section class="incoming-attack-panel{{ threats ? ' has-hostile' : '' }}{{ fleets is empty ? ' is-empty' : '' }}" aria-labelledby="incoming-attacks-heading">
<h2 id="incoming-attacks-heading">Flottes entrantes · {{ fleets|length }}</h2>
{% if fleets is empty %}
<p class="incoming-empty-message">Aucune flotte entrante visible vers vos colonies.</p>
{% else %}
{% if threats %}<p>{{ threats }} attaque{{ threats == 1 ? '' : 's' }} détectée{{ threats == 1 ? '' : 's' }} · Organisez votre défense et vos renforts avant l’impact.</p>{% endif %}
<div class="incoming-attack-grid">
{% for fleet in fleets %}
{% set hostile = fleet.mission in ['attack', 'conquer'] %}
{% set pendingOrbit = fleet.mission == 'orbit' and fleet.status == 'orbit_pending' %}
<article data-incoming-attack="{{ fleet.id }}" data-incoming-kind="{{ hostile ? 'attack' : 'arrival' }}" class="{{ hostile ? 'is-hostile' : '' }}">
<p>{{ fleet.missionLabel }} · {{ pendingOrbit ? 'Demande en attente' : 'Flotte entrante' }}</p>
<h3>{{ fleet.destinationName }} · {{ fleet.destinationCoordinates }}</h3>
<p><strong>{{ fleet.ownerName }}</strong> · {{ fleet.shipCount|quantity(0) }} vaisseau{{ fleet.shipCount == 1 ? '' : 'x' }} · {{ fleet.fleetPoints|quantity(0) }} point{{ fleet.fleetPoints == 1 ? '' : 's' }}</p>
{% if pendingOrbit %}<p>Demande d’orbite à traiter.</p>
{% elseif fleet.arrivalAt %}<p>{{ hostile ? 'Impact dans' : 'Arrivée dans' }} <time datetime="{{ fleet.arrivalAt }}" data-incoming-impact="{{ fleet.arrivalAt }}" data-incoming-kind="{{ hostile ? 'attack' : 'arrival' }}" aria-live="off">{{ fleet.arrivalAt|date('d/m/Y H:i:s',preferences.timezone|default(app.user.preferences.timezone|default('Europe/Paris'))) }}</time></p>{% endif %}
<p>{{ fleet.originName }}{% if fleet.originCoordinates %} · {{ fleet.originCoordinates }}{% endif %}</p>
<a class="secondary" href="{{ path('app_colony',{id:fleet.destinationPlanetId}) }}">Ouvrir la colonie {{ fleet.destinationName }}</a>
{% if fleet.mission == 'orbit' %}<a class="secondary" href="{{ path('app_fleets',{colony:fleet.destinationPlanetId}) }}">Consulter la demande d’orbite</a>{% endif %}
</article>
{% endfor %}
</div>
{% endif %}
</section>
