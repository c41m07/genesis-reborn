{% set inventoryDestinations = [] %}
{% set currentLabel = '' %}
{% for destination in [
    {page:'boosts',route:'app_boosts',label:'Boosts',count:inventory_counts.boosts},
    {page:'boxes',route:'app_inventory_boxes',label:'Boîtes',count:inventory_counts.boxes},
    {page:'pending',route:'app_inventory_pending',label:'Récompenses en attente',count:inventory_counts.pending}
] %}
{% set active = inventory_page == destination.page %}
{% set inventoryDestinations = inventoryDestinations|merge([destination|merge({active:active, newCount:giftNotices[destination.page], noticePage:destination.page})]) %}
{% if active %}{% set currentLabel = destination.label ~ ' · ' ~ destination.count %}{% endif %}
{% endfor %}
{% include 'ui/space_navigation.html.twig' with {
    destinations:inventoryDestinations,
    navigationLabel:'Navigation de l’inventaire',
    currentLabel:currentLabel,
    compact:true
} only %}
