{% set ranks = map_mission_ships[quick_mission == 'colonize' ? 'colony_ship' : 'probe']|default([]) %}
{% if quick_mission == 'colonize' and not map_can_colonize %}
    <small>{% if ranks is empty %}Vaisseau colonie absent. {% if map_origin %}<a href="{{ path('app_colony',{id:map_origin.id,section:'ships'}) }}">Construire un colonisateur</a>{% endif %}{% else %}Limite de colonies atteinte. <a href="{{ path('app_technology_tree') }}#tech-colonial_expansion-basic">Consulter l’expansion coloniale</a>{% endif %}</small>
{% elseif map_origin and ranks is not empty %}
    {% include 'ui/map_quick_mission_form.html.twig' with {ship:ranks|first} %}
    {% if quick_mission != 'spy' and ranks|length > 1 %}
        {# Une quantité est liée à un seul rang, y compris sans JavaScript. #}
        <details class="map-quick-ranks">
            <summary>Autres rangs disponibles</summary>
            {% for ship in ranks|slice(1) %}
                {% include 'ui/map_quick_mission_form.html.twig' with {ship:ship} %}
            {% endfor %}
        </details>
    {% endif %}
{% elseif map_origin %}
    <small>Aucune sonde disponible sur {{ map_origin.name }}. <a href="{{ path('app_colony',{id:map_origin.id,section:'ships',_fragment:'item-probe-basic'}) }}">Choisir une sonde au chantier</a></small>
{% else %}
    <small><a href="{{ path('app_planets') }}">Choisir une colonie de départ</a></small>
{% endif %}
