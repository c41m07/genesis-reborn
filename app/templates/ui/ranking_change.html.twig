{% macro value(change, unit) %}{% if change is null %}<span title="Pas encore de comparaison">=</span>{% elseif change == 0 %}<span title="Aucune variation des {{ unit|lower }}">=</span>{% else %}<span>{{ change > 0 ? '+' : '−' }}{{ (change < 0 ? -change : change)|quantity(0) }}</span>{% endif %}{% endmacro %}

{% macro inline(change, unit) %}<span class="ranking-change {{ change is not null and change != 0 ? (change > 0 ? 'ranking-change--gain' : 'ranking-change--loss') : '' }}" aria-label="{{ unit }} : {{ change is null ? 'comparaison indisponible' : (change == 0 ? 'aucune variation' : (change > 0 ? 'gain de ' : 'perte de ')~(change < 0 ? -change : change)|quantity(0)) }}">({% if change is null %}—{% elseif change == 0 %}= 0{% else %}{{ change > 0 ? '+' : '−' }}{{ (change < 0 ? -change : change)|quantity(0) }}{% endif %})</span>{% endmacro %}
