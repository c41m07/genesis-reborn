{% import 'ui/macros.html.twig' as ui %}
<section class="resource-strip" aria-label="Ressources de {{ chrome.planet.name }}" data-live-region="resources" data-controller="resource-strip" data-resource-strip-url-value="{{ path('app_resources',{id:chrome.planet.id}) }}">
    <div class="resource-planet"><span class="tiny-planet"></span><div><small>COLONIE ACTIVE</small><strong title="{{ chrome.planet.name }}">{{ chrome.planet.name }}</strong><span class="resource-protection-indicator" data-resource-strip-target="protection" data-until="{{ chrome.protection.until|default('') }}" title="{{ chrome.protection.reason|default('Aucune protection temporaire') }}"><small data-resource-strip-target="protectionLabel">{{ chrome.protection.active|default(false) ? 'Protégé du pillage' : 'Aucune protection temporaire' }}</small><small class="resource-protection-duration" data-resource-strip-target="protectionTime">{% if chrome.protection.active|default(false) %}({{ duration_label(chrome.protection.remaining) }}){% endif %}</small></span></div></div>
    <button class="resource-toggle" type="button" aria-expanded="false" aria-controls="resource-details" data-resource-strip-target="toggle" data-action="resource-strip#toggleDetails">
        <span class="visually-hidden">Ressources de {{ chrome.planet.name }} : afficher ou masquer les détails</span>
        <span aria-hidden="true">⌄</span>
    </button>
    <div class="resource-summary" aria-label="Stocks disponibles">
        {% for slug in ['metal','nano','hydrogen','antimatter','electricity'] %}
            {% set r = chrome.resources[slug]|default(null) %}
            {% if r %}
                <span class="resource-summary-item" data-compact-resource="{{ slug }}" title="{{ r.label }}">
                    {{ ui.icon(slug, 'resource-summary-icon') }}
                    <span class="visually-hidden">{{ r.label }} : </span>
                    <strong data-resource-strip-target="compactStock" data-slug="{{ slug }}" title="{{ r.stock|round(0, 'floor')|number_format(0,',',' ') }}">{{ r.stock|round(0, 'floor')|compact_number }}</strong>
                </span>
            {% endif %}
        {% endfor %}
    </div>
    <div id="resource-details" class="resource-details" data-action="resource:stock->resource-strip#updateSummary">
    {% for slug in ['metal','nano','hydrogen','antimatter','electricity'] %}
        {% set r=chrome.resources[slug]|default(null) %}
        {% if r %}
            {% set protection = 'Stock : '~(r.stock|number_format(0,',',' '))~' / '~(r.capacity|number_format(0,',',' '))~'. Repère : jusqu’à '~(r.protectedCapacity|number_format(0,',',' '))~' protégés du pillage ; zone verte : '~(min(r.stock,r.protectedCapacity)|number_format(0,',',' '))~' actuellement protégés.' %}
            <div class="resource resource--{{ slug }} {{ slug in ['electricity','hydrogen'] and r.rate < 0 ? 'resource--deficit' : '' }}" data-controller="resource" data-resource-slug="{{ slug }}" data-action="resource:update->resource#update" data-resource-stock-value="{{ r.stock }}" data-resource-rate-value="{{ r.rate }}" data-resource-cap-value="{{ r.capacity }}" data-resource-protected-cap-value="{{ r.protectedCapacity }}">
                {{ ui.icon(slug,'resource-icon') }}
                <div class="resource-values">
                    <span class="resource-name">{{ r.label }}</span>
                    <strong data-resource-target="stock" title="{{ r.stock|round(0, 'floor')|number_format(0,',',' ') }}">{{ r.stock|round(0, 'floor')|compact_number }}</strong>
                    <div class="resource-rate-line">
                        <small class="resource-rate" data-resource-target="rate" title="{{ (r.rate*3600)|compact_number }} / h">{{ r.rate >= 0 ? '+' : '' }}{{ (r.rate*3600)|compact_number }} / h</small>
                        <small class="resource-productivity {{ r.productivity is not null and r.productivity < 99.999999 ? 'resource-productivity--reduced' : '' }}" data-resource-target="productivity" {{ r.productivity is null ? 'hidden' : '' }} title="Productivité des usines : 100 % au régime nominal. Elle baisse en cas de pénurie d’électricité et, pour l’antimatière, d’hydrogène. Le débit horaire affiché tient compte de ces pénuries.">{{ r.productivity is not null and r.productivity < 99.999999 ? '↓ ' : '' }}{{ r.productivity|default(100)|number_format(1,',',' ') }} %</small>
                    </div>
                </div>
                <div class="storage-meter" data-resource-target="meter" role="img" tabindex="0" aria-label="{{ protection }}" title="{{ protection }}">
                    <span class="storage-meter-stock" data-resource-target="fill" style="width:{{ min(100,r.stock/r.capacity*100) }}%"></span>
                    <span class="storage-meter-protected" data-resource-target="protectedFill" style="width:{{ min(r.stock,r.protectedCapacity)/r.capacity*100 }}%" aria-hidden="true"></span>
                    <span class="storage-meter-limit" data-resource-target="protectedLimit" style="left:{{ r.protectedCapacity/r.capacity*100 }}%" aria-hidden="true"></span>
                </div>
            </div>
        {% endif %}
    {% endfor %}
    </div>
</section>
