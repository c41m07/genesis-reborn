{% set nodeCount = 0 %}{% for nodes in technology_tree %}{% set nodeCount = nodeCount + nodes|length %}{% endfor %}
{% set tierLabels = {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'} %}
{% set kindLabels = {buildings:'Bâtiment',technologies:'Recherche',ships:'Vaisseau',defenses:'Défense'} %}
{% set domains = {economy:'Économie',research:'Recherche',fleet:'Flotte',defense:'Défense'} %}
{% set priority = {lab:0,engineering_foundations:1,naval_engineering:2,vector_propulsion:3} %}
<section class="panel technology-tree" data-controller="technology-graph" data-technology-graph-storage-key-value="technology-goal:{{ membership.id }}:{{ planet.id }}" aria-label="Guide technologique">
    <p>Choisissez un élément pour consulter ses prérequis et ses déblocages.</p>
    {% if nodeCount == 0 %}
        <div class="empty-state"><h2>Aucun élément affiché</h2><p>Aucun élément à afficher actuellement.</p></div>
    {% else %}
    <div class="catalogue-search" role="search" aria-label="Rechercher dans le guide technologique" data-technology-graph-target="tools" hidden>
        <div><label for="technology-query">Rechercher un élément</label><input id="technology-query" type="search" placeholder="Nom ou identifiant · tous les domaines" data-technology-graph-target="query" data-action="input->technology-graph#filter"></div>
        <div><label for="technology-rank">Rang</label><select id="technology-rank" data-technology-graph-target="filter" data-filter-key="tier" data-action="change->technology-graph#filter">{% for tier,label in tierLabels %}<option value="{{ tier }}">{{ label }}</option>{% endfor %}<option value="">Tous les rangs</option></select></div>
        <div><label for="technology-state">État</label><select id="technology-state" data-technology-graph-target="filter" data-filter-key="state" data-action="change->technology-graph#filter"><option value="">Tous les états</option><option value="developed">Développé</option><option value="available">Accessible</option><option value="locked">Verrouillé</option></select></div>
        <button type="button" class="secondary" data-action="technology-graph#clear" data-technology-graph-target="clearButton" hidden>Effacer les filtres</button>
    </div>
    <nav class="technology-navigation" aria-label="Domaines technologiques" data-technology-graph-target="tools" hidden>
        {% for domain,label in domains %}<button type="button" class="secondary" data-domain="{{ domain }}" aria-pressed="false" aria-controls="technology-domain-{{ domain }}" data-technology-graph-target="domainButton" data-action="technology-graph#chooseDomain">{{ label }} <span data-domain-count></span></button>{% endfor %}
    </nav>
    <div class="technology-goal" data-technology-graph-target="tools goalBar" hidden>
        <div><span>Objectif suivi dans ce navigateur</span><strong data-technology-graph-target="goal" aria-live="polite">Aucun objectif sélectionné</strong></div>
        <button type="button" class="secondary" data-action="technology-graph#showGoal" data-technology-graph-target="goalButton" hidden>Voir mon objectif</button>
        <button type="button" class="secondary" data-action="technology-graph#removeGoal" data-technology-graph-target="goalButton" hidden>Retirer l’objectif</button>
    </div>
    <div class="technology-layout">
        <div class="technology-overview" data-technology-graph-target="overview">
            <output class="technology-count" data-technology-graph-target="count" aria-live="polite" hidden></output>
            <p class="empty-state" data-technology-graph-target="empty" hidden>Aucun élément ne correspond à ces filtres.</p>
            <section class="technology-results" data-technology-graph-target="results" hidden><h2>Résultats dans tous les domaines</h2><div class="technology-cards" data-technology-graph-target="resultCards"></div></section>
            {% for domain,domainLabel in domains %}
            {% set domainNodes = [] %}
            {% for nodes in technology_tree %}{% for node in nodes %}
                {% set nodeDomain = node.group == 'buildings' ? (node.slug == 'lab' ? 'research' : (node.slug == 'shipyard' ? 'fleet' : (node.slug == 'fortress' ? 'defense' : 'economy'))) : (node.group == 'technologies' ? 'research' : (node.group == 'ships' ? 'fleet' : 'defense')) %}
                {% if nodeDomain == domain %}{% set domainNodes = domainNodes|merge([node]) %}{% endif %}
            {% endfor %}{% endfor %}
            <section id="technology-domain-{{ domain }}" class="technology-domain" data-technology-graph-target="domain" data-domain="{{ domain }}" aria-labelledby="technology-heading-{{ domain }}">
                <h2 id="technology-heading-{{ domain }}">{{ domainLabel }}</h2>
                <div class="technology-cards">
                {% for node in domainNodes|sort((a,b) => ((priority[a.slug] ?? 10) <=> (priority[b.slug] ?? 10)) ?: (a.definition.label <=> b.definition.label)) %}
                    {% set developed = node.group in ['buildings','technologies'] and node.level > 0 %}
                    <details id="tech-{{ node.group == 'technologies' ? '' : node.group ~ '-' }}{{ node.slug }}-{{ node.tier }}" class="tech-node {{ node.available ? 'available' : 'locked' }}" data-technology-graph-target="node" data-node-key="{{ node.key }}" data-tier="{{ node.tier }}" data-domain="{{ domain }}" data-parents="{{ node.parents|json_encode|e('html_attr') }}" data-requirements="{{ node.prerequisites|json_encode|e('html_attr') }}" data-acquired="{{ node.acquired ? 'true' : 'false' }}" data-label="{{ node.definition.label }}" data-filter-state="{{ developed ? 'developed' : (node.available ? 'available' : 'locked') }}" data-search-text="{{ node.definition.label }} {{ node.slug }} {{ tierLabels[node.tier] }}">
                        <summary data-action="click->technology-graph#select" aria-controls="technology-detail">
                            <span class="tech-node-kind">{{ kindLabels[node.group] }} · {{ tierLabels[node.tier] }}</span>
                            <strong>{{ node.definition.label }}</strong>
                            <span class="tech-node-bottom">{% if node.group in ['buildings','technologies'] %}<span>Niveau {{ node.level }}{% if node.definition.max_level is defined %} / {{ node.definition.max_level }}{% endif %}</span>{% endif %}<small>{{ developed ? '✓ Développé' : (node.available ? '◇ Accessible' : '○ Verrouillé') }}</small></span>
                        </summary>
                        <div class="tech-node-details">
                            <h3>Prérequis de déblocage</h3>
                            <p>{{ node.group == 'technologies' ? 'Accès conservé dans cet univers.' : 'Accès conservé sur cette colonie.' }} Conditions du déblocage initial uniquement.</p>
                            {% if node.acquired %}<p>Accès acquis définitivement dans ce périmètre. Les conditions ci-dessous sont historiques.</p>{% endif %}
                            {% if node.prerequisites %}<ul>{% for requirement in node.prerequisites %}
                                <li class="{{ requirement.met ? 'met' : 'missing' }}"><a href="{{ path('app_colony',{id:planet.id,section:requirement.group,showLockedItems:1}) }}#item-{{ requirement.slug }}-{{ requirement.tier }}">{{ requirement.met ? '✓' : '○' }} {{ requirement.label }}{% if requirement.level is not null %} · niveau {{ requirement.level }} requis (actuel : {{ requirement.current }}){% else %} · prérequis de déblocage{% endif %}</a></li>
                            {% endfor %}</ul>{% else %}<p>Accessible sans prérequis</p>{% endif %}
                            <a class="tech-node-open" href="{{ path('app_colony',{id:planet.id,section:node.group,showLockedItems:1}) }}#item-{{ node.slug }}-{{ node.tier }}">Voir la fiche →</a>
                        </div>
                    </details>
                {% endfor %}
                </div>
            </section>
            {% endfor %}
            <button type="button" class="technology-more" data-technology-graph-target="more" data-action="technology-graph#showMore" hidden></button>
        </div>
        <aside id="technology-detail" class="technology-detail" data-technology-graph-target="panel" aria-label="Détails de l’élément sélectionné" hidden>
            <button type="button" class="secondary technology-detail-close" data-action="technology-graph#close">Fermer les détails</button>
            <div data-technology-graph-target="detail" aria-live="polite"></div>
        </aside>
    </div>
    {% endif %}
</section>
