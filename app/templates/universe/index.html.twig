{% extends 'base.html.twig' %}

{% block title %}Univers · Genesis Reborn{% endblock %}

{% block body %}
<div class="page-heading">
  <div>
    
    <h1>Les univers</h1>
    <p>Comparez les règles avant de choisir votre univers.</p>
  </div>
  <span class="badge">{{ universes|length }} UNIVERS</span>
</div>

<div class="universe-grid">
  {% for u in universes %}
    {% set c = configs[u.slug] %}
    {% set opensLater = u.status == 'active' and u.startsAt and u.startsAt > now %}
    {% set accessible = u.isAccessible(now) %}
    {% set current = app.user.currentPlayerUniverse and app.user.currentPlayerUniverse.universe.id == u.id %}
    {% set buildingSpeed = (1 / c.multipliers.building_time)|round(2) %}
    {% set researchSpeed = (1 / c.multipliers.research_time)|round(2) %}
    {% set shipSpeed = (1 / c.multipliers.ship_build_time)|round(2) %}
    {% set travelSpeed = (1 / c.multipliers.travel_time)|round(2) %}
    <article class="panel universe-card {{ current ? 'universe-card--current' : '' }}" aria-labelledby="universe-{{ u.id }}-title">
      <div class="mini-planet {{ loop.index == 2 ? 'violet' : '' }}" aria-hidden="true"></div>
      {% if accessible %}
        <span class="badge">OUVERT</span>
      {% elseif opensLater %}
        <span class="badge">OUVERTURE PROGRAMMÉE</span>
      {% else %}
        <span class="badge">INACCESSIBLE</span>
      {% endif %}
      {% if current %}<span class="badge universe-current">Univers actuel</span>{% endif %}
      <h2 id="universe-{{ u.id }}-title">{{ u.name }}</h2>
      <p>Consultez les vitesses, les limites et les fonctionnalités avant de rejoindre cet univers.</p>

      {% include 'universe/_closing.html.twig' with {universe: u} %}
      <section class="universe-rules" aria-label="Règles de {{ u.name }}">
        <h3>Vitesses de jeu</h3>
        <dl>
          <div><dt>Constructions</dt><dd>× {{ buildingSpeed }}</dd></div>
          <div><dt>Recherches</dt><dd>× {{ researchSpeed }}</dd></div>
          <div><dt>Construction des vaisseaux</dt><dd>× {{ shipSpeed }}</dd></div>
          <div><dt>Production des ressources</dt><dd>× {{ c.multipliers.resource_production|round(2) }}</dd></div>
          <div><dt>Déplacements des flottes</dt><dd>× {{ travelSpeed }}</dd></div>
        </dl>
        <h3>Limites et fonctionnalités</h3>
        <dl>
          <div><dt>Planètes maximum</dt><dd>{{ c.limits.max_planets }}</dd></div>
          <div><dt>Vaisseaux maximum par flotte</dt><dd>{{ c.limits.max_fleet_size }}</dd></div>
          <div><dt>Guildes</dt><dd>{{ c.features.guilds_enabled ? 'Activées' : 'Désactivées' }}</dd></div>
          <div><dt>Conquête JcE</dt><dd>{{ c.features.planet_conquest ? 'Autorisée' : 'Désactivée' }}</dd></div>
        </dl>
      </section>

      {% if accessible %}
        <form method="post" action="{{ path('app_universe_join', {id: u.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('join' ~ u.id) }}">
          <button class="primary full">{{ joined[u.id]|default(false) ? 'Reprendre mon empire' : 'Créer mon empire dans cet univers' }} ↗</button>
        </form>
      {% elseif opensLater %}
        <p class="universe-availability">Ouverture le <time datetime="{{ u.startsAt|date('c', 'UTC') }}">{{ u.startsAt|date('d/m/Y à H:i', 'UTC') }} UTC</time>.</p>
        <div class="universe-opening-timer" data-controller="universe-opening" data-universe-opening-opens-at-value="{{ u.startsAt|date('c') }}" role="timer" aria-label="Compte à rebours avant l’ouverture de {{ u.name }}">
          <span>OUVERTURE DANS</span>
          <strong data-universe-opening-target="time">{{ u.startsAt|date('d/m/Y à H:i', 'UTC') }} UTC</strong>
        </div>
      {% else %}
        <p class="universe-availability">Cet univers n’est pas accessible actuellement.</p>
      {% endif %}
    </article>
  {% else %}
    <section class="panel empty-state"><h2>Aucun univers disponible</h2><p>Les univers apparaîtront ici dès leur annonce.</p></section>
  {% endfor %}
</div>
{% endblock %}
