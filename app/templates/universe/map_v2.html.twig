{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Galaxie · Genesis Reborn{% endblock %}
{% block body %}
{% set relation_labels = {own:'Votre monde', allied:'Joueur allié', enemy:'Joueur ennemi', neutral:'Joueur neutre', npc:'Faction PNJ', uninhabited:'Inhabitée'} %}
{% set relation_symbols = {own:'⌂', allied:'⬟', enemy:'⚔', neutral:'⬟', npc:'◆', uninhabited:'○'} %}
{% include 'ui/galaxy_tabs.html.twig' %}
<h1 class="visually-hidden">Carte interactive de la galaxie</h1>

<div class="galaxy-v2" data-controller="galaxy-v2" data-surveillance-galaxy="{{ selected_galaxy.id|default(0) }}" data-action="keydown->galaxy-v2#navigateBack"
     data-galaxy-v2-map-value="{{ galaxy_v2_json|e('html_attr') }}"
     data-galaxy-v2-reduced-motion-value="{{ preferences.reducedMotion|default(false)?'true':'false' }}">
    <div class="gv2-scene" data-galaxy-v2-target="scene">
        <canvas class="gv2-canvas gv2-canvas--galaxy is-active" data-galaxy-v2-target="galaxyCanvas" aria-label="Carte animée de la galaxie. Glissez pour déplacer, molette pour zoomer, cliquez sur un système pour l’examiner."></canvas>
        <canvas class="gv2-canvas gv2-canvas--system" data-galaxy-v2-target="systemCanvas" aria-label="Vue du système solaire. Cliquez sur une planète pour ouvrir sa vue rapprochée ; sa fiche est accessible dans la liste."></canvas>
        <canvas class="gv2-canvas gv2-canvas--planet" data-galaxy-v2-target="planetCanvas" aria-label="Vue rapprochée de la planète"></canvas>
        <div class="gv2-scanlines" aria-hidden="true"></div><div class="gv2-vignette" aria-hidden="true"></div>
        <div class="gv2-hud">
            <div class="gv2-locator"><span class="gv2-live-dot"></span><span data-galaxy-v2-target="location">{{ selected_galaxy.name|default(membership.universe.name) }}</span></div>
            <form class="gv2-galaxy-form" method="get" action="{{ path('app_map_v2') }}">
                <label class="visually-hidden" for="gv2-galaxy">Choisir une galaxie</label>
                <select id="gv2-galaxy" name="galaxy" data-galaxy-v2-target="galaxySelect" data-action="change->galaxy-v2#changeGalaxy">
                    {% for galaxy in galaxies %}<option value="{{ galaxy.id }}" {{ selected_galaxy and selected_galaxy.id==galaxy.id?'selected':'' }}>{{ galaxy.name }}</option>{% endfor %}
                </select>
            </form>
            <div class="gv2-search">
                <span aria-hidden="true">⌕</span><label class="visually-hidden" for="gv2-search">Rechercher un système ou une planète connue</label>
                <input id="gv2-search" type="search" placeholder="Système ou planète…" autocomplete="off" spellcheck="false" aria-controls="gv2-search-results" aria-describedby="gv2-search-help" data-galaxy-v2-target="searchInput" data-action="input->galaxy-v2#search keydown->galaxy-v2#searchKeydown">
                <span class="visually-hidden" id="gv2-search-help">Saisissez au moins deux caractères. Flèches haut et bas pour parcourir les résultats, Entrée pour ouvrir, Échap pour fermer. Douze résultats maximum sont affichés.</span>
                <button type="button" class="gv2-search-clear" aria-label="Effacer la recherche" data-galaxy-v2-target="searchClear" data-action="click->galaxy-v2#clearSearch" hidden>×</button>
                <div id="gv2-search-results" class="gv2-search-results" role="region" aria-label="Résultats de recherche" data-galaxy-v2-target="searchResults" data-action="keydown->galaxy-v2#searchKeydown" hidden></div>
                <span class="visually-hidden" role="status" data-galaxy-v2-target="searchStatus"></span>
            </div>
            <div class="gv2-coordinate" aria-live="polite" data-galaxy-v2-target="coordinates">{% if selected_galaxy %}{{ selected_galaxy.coordinateCode() }}{% else %}—{% endif %}</div>
        </div>
        <section class="gv2-map-settings is-collapsed" aria-label="Affichage de la carte" data-galaxy-v2-target="mapSettings">
            <button type="button" class="gv2-filter-toggle" data-galaxy-v2-target="filterToggle" data-action="click->galaxy-v2#toggleMapFilters" aria-expanded="false" aria-controls="gv2-filter-content">Filtres · <span data-galaxy-v2-target="mapModeLabel">Exploration</span></button>
            <div id="gv2-filter-content">
            <div class="gv2-map-modes" role="group" aria-label="Mode de carte">
                <button type="button" data-map-mode="exploration" data-galaxy-v2-target="mapMode" data-action="click->galaxy-v2#changeMapMode" aria-pressed="true">Exploration</button>
                <button type="button" data-map-mode="npc" data-galaxy-v2-target="mapMode" data-action="click->galaxy-v2#changeMapMode" aria-pressed="false">PNJ</button>
                <button type="button" data-map-mode="players" data-galaxy-v2-target="mapMode" data-action="click->galaxy-v2#changeMapMode" aria-pressed="false">Joueurs</button>
            </div>
            <details class="gv2-legend">
                <summary>Légende · <span data-galaxy-v2-target="mapModeLabel">Exploration</span></summary>
                <ul data-galaxy-v2-target="legend"></ul>
                <p>Quarts : PNJ ↖ · allié ↗ · neutre/vierge ↘ · ennemi ↙. Gris : absent ou masqué.</p>
                <p>Cercle extérieur vert : au moins une de vos planètes.</p>
            </details>
            </div>
        </section>
        <button type="button" class="gv2-back" data-galaxy-v2-target="systemBack" data-action="click->galaxy-v2#toGalaxy" hidden>‹ Galaxie</button>
        <button type="button" class="gv2-back" data-galaxy-v2-target="planetBack" data-action="click->galaxy-v2#toSystem" hidden>‹ Système</button>
        <div class="gv2-tooltip" role="status" data-galaxy-v2-target="tooltip" hidden></div>

        <aside class="gv2-system-panel is-collapsed" aria-label="Informations sur le système sélectionné" data-galaxy-v2-target="systemPanel" hidden>
            <button type="button" class="gv2-sheet-toggle" data-galaxy-v2-target="systemPanelToggle" data-action="click->galaxy-v2#toggleSystemPanel" aria-expanded="false" aria-controls="gv2-system-content" aria-label="Afficher les informations du système">Planètes du système</button>
            <div id="gv2-system-content" data-galaxy-v2-target="systemContent"></div>
        </aside>
        <aside class="gv2-planet-panel" aria-label="Informations sur la planète sélectionnée" data-galaxy-v2-target="planetPanel" hidden>
            <div data-galaxy-v2-target="planetContent"></div>
        </aside>

        <div class="gv2-minimap" data-galaxy-v2-target="minimapWrap">
            <span>CARTE LOCALE</span><canvas data-galaxy-v2-target="minimapCanvas" aria-label="Mini-carte interactive ; cliquez pour déplacer la caméra"></canvas>
        </div>
        <details class="gv2-flight-log {{ galaxy_v2_flights is empty?'is-empty':'' }}" {{ galaxy_v2_flights is not empty?'open':'' }}>
            <summary><span class="gv2-live-dot" aria-hidden="true"></span>Journal de flotte<span class="visually-hidden" data-galaxy-v2-empty-label {% if galaxy_v2_flights is not empty %}hidden{% endif %}> · aucune mission</span></summary>
            <div data-galaxy-v2-target="fleetLog">
                {% include 'universe/_fleet_log.html.twig' %}
            </div>
        </details>
        <div class="gv2-map-controls">
            <button type="button" aria-label="Zoomer" data-action="click->galaxy-v2#zoomIn">+</button>
            <button type="button" aria-label="Dézoomer" data-action="click->galaxy-v2#zoomOut">−</button>
            <button type="button" aria-pressed="false" data-galaxy-v2-target="motionToggle" data-action="click->galaxy-v2#toggleMotion" title="Réduire ou rétablir les animations">◌</button>
        </div>
        <div class="gv2-map-help" data-galaxy-v2-target="mapHelp">Glisser pour naviguer · Molette pour zoomer · Cliquer sur un système pour l’examiner</div>
    </div>

    {% for row in systems %}
        {% set system = row.system %}
        <template data-gv2-system="{{ system.id }}">
            <header class="gv2-panel-heading"><div><h2>{{ system.galaxy.coordinateCode() }}:{{ system.number() }}</h2><p>{{ system.name }}</p></div><button type="button" aria-label="Fermer la vue système" data-action="click->galaxy-v2#toGalaxy">×</button></header>
            <div class="gv2-system-state">{% if row.known %}<span class="gv2-state-dot is-known"></span>{% else %}<span class="gv2-marker gv2-marker--unknown" aria-hidden="true">?</span>{% endif %}{% if row.known %}Système exploré · {{ row.planets|length }} planètes cartographiées{% else %}Signal inconnu · aucune planète révélée{% endif %}</div>
            {% if row.known %}
                <details class="gv2-legend gv2-system-legend">
                    <summary>Légende des planètes</summary>
                    <ul>{% for type in ['own','npc','allied','neutral','enemy','uninhabited'] %}
                        <li><span class="gv2-marker gv2-marker--{{ type }}" aria-hidden="true">{{ relation_symbols[type] }}</span>{{ relation_labels[type] }}</li>
                    {% endfor %}</ul>
                    <p>Chiffre près du PNJ : niveau. Couleur du globe : décorative.</p>
                </details>
                <ul class="gv2-planet-list">{% for p in row.planets|sort((a,b)=>a.position<=>b.position) %}
                    <li><button type="button" class="gv2-planet-choice" data-action="click->galaxy-v2#selectPlanet" data-planet-id="{{ p.id }}">
                        <span class="gv2-planet-number">{{ '%02d'|format(p.position) }}</span><span class="gv2-planet-choice-name">{{ p.name }}</span>
                        {% set relation = map_planet_relations[p.id] %}
                        <span class="gv2-planet-owner"><span class="gv2-marker gv2-marker--{{ relation }}" aria-hidden="true">{{ relation_symbols[relation] }}</span> {{ relation_labels[relation] }}{% if relation == 'npc' %} · niv. {{ p.conquestLevel }}{% elseif p.owner and relation != 'own' %} · {{ p.owner.displayName }}{% endif %}</span>
                    </button></li>
                {% endfor %}</ul>
            {% else %}
                <p class="gv2-panel-note">Les coordonnées sont connues, mais le système n’a pas encore été cartographié.</p>
                {% if map_can_explore %}{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'explore',quick_target:system.id,quick_return_to:'app_map_v2'} %}{% else %}<p class="gv2-panel-note">Aucune sonde exploratrice disponible sur {{ map_origin ? map_origin.name : 'une planète de départ' }}.</p>{% endif %}
            {% endif %}
        </template>
        {% if row.known %}{% for p in row.planets %}
        <template data-gv2-planet="{{ p.id }}">
            {% set relation = map_planet_relations[p.id] %}
            <header class="gv2-panel-heading"><div><span class="muted">PLANÈTE · {{ p.coordinates() }}</span><h2>{{ p.name }}</h2><p><span class="gv2-marker gv2-marker--{{ relation }}" aria-hidden="true">{{ relation_symbols[relation] }}</span> {{ relation_labels[relation] }}{% if relation == 'npc' %} · niveau {{ p.conquestLevel }}{% elseif p.owner and relation != 'own' %} · {{ p.owner.displayName }}{% endif %}</p></div><button type="button" aria-label="Fermer les informations de la planète" data-action="click->galaxy-v2#closePlanet">×</button></header>
            <button type="button" class="gv2-action-link gv2-system-return" data-action="click->galaxy-v2#returnToPlanetSystem">‹ Revenir au système {{ p.solarSystem.galaxy.coordinateCode() }}:{{ p.solarSystem.number() }}</button>
            <div class="gv2-visual-note">REPRÉSENTATION VISUELLE · DONNÉES DE JEU CI-DESSOUS</div>
            <dl class="gv2-facts"><div><dt>Coordonnées</dt><dd>{{ p.coordinates() }}</dd></div><div><dt>Statut</dt><dd>{{ relation_labels[relation] }}</dd></div>{% if relation == 'npc' %}<div><dt>Niveau PNJ</dt><dd>{{ p.conquestLevel }}</dd></div>{% endif %}</dl>
            <div class="gv2-action-list">
                {% if p.owner and p.owner.id==membership.id %}<a class="gv2-action-link" href="{{ path('app_colony',{id:p.id}) }}">Gérer cette planète →</a>
                {% elseif p.owner or p.npcPlanet %}
                    {% if map_can_spy %}{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'spy',quick_target:p.id,quick_return_to:'app_map_v2'} %}{% else %}<p class="gv2-panel-note">Aucune sonde d’espionnage disponible. {% if map_origin %}<a href="{{ path('app_colony',{id:map_origin.id,section:'ships',_fragment:'item-probe-basic'}) }}">Construire des sondes</a>{% endif %}</p>{% endif %}
                    {% include 'ui/map_conquest_actions.html.twig' with {map_action_class:'gv2-action-link gv2-action-link--amber',map_note_class:'gv2-panel-note'} %}
                {% elseif map_can_colonize %}{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'colonize',quick_target:p.id,quick_return_to:'app_map_v2'} %}
                {% else %}<p class="gv2-panel-note">{% if map_stock.colony_ship|default(0) < 1 %}Vaisseau colonie absent. {% if map_origin %}<a href="{{ path('app_colony',{id:map_origin.id,section:'ships'}) }}">Construire un colonisateur</a>{% endif %}{% else %}Limite de colonies atteinte. <a href="{{ path('app_technology_tree') }}#tech-colonial_expansion-basic">Consulter l’expansion coloniale</a>{% endif %}</p>{% endif %}
            </div>
            <button type="button" class="gv2-action-link" data-action="click->galaxy-v2#enterPlanetView">◉ Vue rapprochée</button>
        </template>
        {% endfor %}{% endif %}
    {% endfor %}
</div>
{% endblock %}
