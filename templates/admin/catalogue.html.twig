{% extends 'admin/layout.html.twig' %}
{% block title %}Équilibrage · {{ universe.name }}{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">ADMINISTRATION · {{ universe.name }}</p><h1>Équilibrage des catalogues</h1><p>Ces valeurs ne s’appliquent qu’à cet univers. Les opérations déjà en file conservent leurs coûts et durées enregistrés; la production est matérialisée puis recalculée au moment de l’enregistrement.</p></div><a class="secondary" href="{{ path('app_admin_index') }}">Retour à l’administration</a></div>
{% for message in app.flashes('success') %}<p class="flash success" role="status">{{ message }}</p>{% endfor %}{% for message in app.flashes('error') %}<p class="flash error" role="alert">{{ message }}</p>{% endfor %}
<style>.catalog-balance-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:12px 18px}.catalog-balance-grid>div{min-width:0}.catalog-balance-grid label{margin-top:8px}.catalog-balance-grid input{margin-bottom:5px}details.panel{margin-top:12px}details.panel>summary{cursor:pointer;padding:4px}.button-row{display:flex;gap:12px;flex-wrap:wrap}@media(max-width:520px){.catalog-balance-grid{grid-template-columns:1fr}}</style>
<nav aria-label="Familles de catalogues">{% set groupLabels = {'buildings':'Bâtiments','technologies':'Technologies','ships':'Vaisseaux','defenses':'Défenses'} %}{% for group,items in catalogues %}<a class="secondary" href="#group-{{ group }}">{{ groupLabels[group] }} · {{ items|length }}</a> {% endfor %}</nav>
{% for group,items in catalogues %}<section class="panel" id="group-{{ group }}"><h2>{{ groupLabels[group] }}</h2><p>Les valeurs de référence restent intactes et peuvent être restaurées pour chaque entrée.</p>
{% for item in items %}<details class="panel" id="{{ group }}-{{ item.slug }}"><summary><strong>{{ item.label }}</strong> <small>{{ item.slug }}</small></summary>
<form method="post" action="{{ path('app_admin_catalogue_save',{id:universe.id,group:group,slug:item.slug}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_catalogue_'~universe.id~'_'~group~'_'~item.slug) }}"><div class="catalog-balance-grid">
{% for field in item.fields %}<div><label for="{{ group }}-{{ item.slug }}-{{ field.path|replace({'.':'-'}) }}">{{ field.label }}</label><input id="{{ group }}-{{ item.slug }}-{{ field.path|replace({'.':'-'}) }}" type="number" name="values[{{ field.path|split('.')|join('][') }}]" value="{{ field.value }}" min="{{ field.min }}" max="{{ field.max }}" step="{{ field.integer?'1':'0.01' }}" required></div>{% endfor %}
</div><div class="button-row"><button class="primary">Enregistrer cet équilibrage</button></div></form>
<form method="post" action="{{ path('app_admin_catalogue_save',{id:universe.id,group:group,slug:item.slug}) }}"><input type="hidden" name="_token" value="{{ csrf_token('admin_catalogue_'~universe.id~'_'~group~'_'~item.slug) }}"><input type="hidden" name="reset" value="1"><button class="secondary">Restaurer les valeurs de référence</button></form></details>{% endfor %}</section>{% endfor %}
{% endblock %}
