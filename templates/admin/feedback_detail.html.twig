{% extends 'admin/layout.html.twig' %}
{% block title %}{{ feedback.title }} · Feedback{% endblock %}
{% block body %}
<a class="feedback-back-link" href="{{ path('app_admin_feedbacks') }}">← Tous les feedbacks</a>
<header class="feedback-detail-heading"><div><p class="eyebrow">DOSSIER #{{ feedback.id }} · {{ feedback.createdAt|date('d/m/Y à H:i') }}</p><h1>{{ feedback.title }}</h1><div class="feedback-admin-meta"><span>{{ {'bug':'Bug','suggestion':'Suggestion','improvement':'Amélioration','other':'Autre'}[feedback.type] }}</span><span class="priority-{{ feedback.priority }}">Priorité {{ {'low':'faible','medium':'moyenne','high':'élevée'}[feedback.priority] }}</span></div></div><span class="feedback-status status-{{ feedback.status }}">{{ {'open':'Ouvert','in_progress':'En cours','resolved':'Résolu','rejected':'Rejeté','archived':'Archivé'}[feedback.status] }}</span></header>
<div class="feedback-detail-grid"><div class="feedback-detail-main"><section class="feedback-detail-card"><h2>Description du joueur</h2><div class="feedback-description">{{ feedback.description|nl2br }}</div></section>{% if feedback.attachmentFilename %}<section class="feedback-detail-card"><h2>Capture d’écran</h2><a href="{{ path('app_feedback_attachment',{id:feedback.id}) }}" target="_blank" rel="noopener"><img class="feedback-screenshot" src="{{ path('app_feedback_attachment',{id:feedback.id}) }}" alt="Capture jointe au feedback : {{ feedback.title }}"></a><a href="{{ path('app_feedback_attachment',{id:feedback.id}) }}" target="_blank" rel="noopener">Ouvrir la capture dans un nouvel onglet ↗</a></section>{% endif %}<section class="feedback-detail-card"><h2>Contexte</h2><dl class="feedback-facts"><div><dt>Joueur</dt><dd>{{ feedback.player.username }}</dd></div><div><dt>Univers</dt><dd>{{ feedback.universe ? feedback.universe.name : '—' }}</dd></div><div><dt>Page signalée</dt><dd>{% if feedback.contextUrl %}<a href="{{ feedback.contextUrl }}" target="_blank" rel="noopener noreferrer">{{ feedback.contextUrl }}</a>{% else %}—{% endif %}</dd></div></dl></section></div>
<aside class="feedback-detail-card feedback-manage-card"><p class="eyebrow">TRAITEMENT ADMIN</p><h2>Mettre à jour</h2><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('feedback_' ~ feedback.id) }}"><label for="status">Statut</label><select id="status" name="status">{% for v,l in {'open':'Ouvert','in_progress':'En cours','resolved':'Résolu','rejected':'Rejeté','archived':'Archivé'} %}<option value="{{ v }}" {{ feedback.status==v?'selected':'' }}>{{ l }}</option>{% endfor %}</select><label for="note">Note interne <span>(visible par les admins)</span></label><textarea id="note" name="internalNote" maxlength="5000" rows="8" placeholder="Ajouter un contexte de suivi…">{{ feedback.internalNote }}</textarea><button class="primary">Enregistrer les changements</button></form>{% if feedback.internalNote %}<div class="feedback-internal-note"><strong>Note actuelle</strong><p>{{ feedback.internalNote|nl2br }}</p></div>{% endif %}</aside></div>
{% endblock %}
