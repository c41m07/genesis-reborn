{% import 'ui/macros.html.twig' as ui %}
{% set adminUniverses = adminUniverses|default(universes|default([])) %}
{% set currentRoute = app.request.attributes.get('_route') %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Console d’administration · Genesis Reborn{% endblock %}</title><link rel="icon" href="{{ asset('art/genesis-reborn-emblem.png') }}" type="image/png">{{ encore_entry_link_tags('app') }}{% if app.user.preferences.theme|default('dark')=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}{{ encore_entry_script_tags('app',attributes={defer:true}) }}</head><body class="admin-console" data-theme="{{ app.user.preferences.theme|default('dark') }}"><a class="skip" href="#admin-main">Aller au contenu</a><div class="admin-shell"><aside class="admin-sidebar"><a class="admin-brand" href="{{ path('app_admin_index') }}"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt=""><span>GENESIS<br><strong>OPERATIONS</strong></span></a><nav aria-label="Console d’administration"><a href="{{ path('app_admin_index') }}" class="{{ currentRoute=='app_admin_index'?'active':'' }}" {% if currentRoute=='app_admin_index' %}aria-current="page"{% endif %}>{{ ui.icon('overview') }} Vue d’ensemble</a><a href="{{ path('app_admin_index') }}#admin-reports">{{ ui.icon('notifications') }} Signalements</a><a href="{{ path('app_admin_index') }}#admin-security">{{ ui.icon('clock') }} Sécurité</a><a href="{{ path('app_admin_index') }}#admin-players">{{ ui.icon('user') }} Comptes joueurs</a><a href="{{ path('app_admin_index') }}#admin-universes">{{ ui.icon('universe') }} Tous les univers</a><a href="{{ path('app_admin_index') }}#admin-audit">{{ ui.icon('clock') }} Journal d’audit</a></nav>{% if adminUniverses is not empty %}<div class="admin-universe-switcher"><p class="eyebrow">GÉRER UN UNIVERS</p>{% for universe in adminUniverses %}<a href="{{ path('app_admin_catalogue',{id:universe.id}) }}" class="{{ app.request.attributes.get('id')==universe.id?'active':'' }}">{{ universe.name }} <span>Catalogue ↗</span></a>{% endfor %}</div>{% endif %}<div class="admin-sidebar-footer"><a class="secondary" href="{{ path('app_home') }}">← Retour au jeu</a><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="secondary">Déconnexion</button></form><small>Accès administrateur · actions consignées</small></div></aside><div class="admin-main"><header class="admin-topbar"><span>CONSOLE SÉCURISÉE <i class="connection-dot"></i></span><span>{{ app.user.username }} · ADMIN</span></header><main id="admin-main" class="admin-content">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main></div></div></body></html>
