{% extends 'admin/layout.html.twig' %}
{% block title %}Patchnotes · Console d’administration{% endblock %}
{% block body %}
<section class="page-heading"><div><p class="eyebrow">COMMUNICATION</p><h1>Patchnotes</h1><p>Rédigez et publiez les nouveautés du jeu.</p></div></section>
<details class="panel patchnote-create" {% if app.request.isMethod('POST') %}open{% endif %}><summary>Nouvelle patchnote</summary><form method="post" action="{{ path('app_admin_patchnotes') }}" class="form-grid patchnote-form"><input type="hidden" name="_token" value="{{ csrf_token('patchnote_create') }}"><label>Titre<input required maxlength="160" name="title" value="{{ draft.title }}"></label><label>Version / tag<input required maxlength="40" name="version" value="{{ draft.version }}" placeholder="v1.2"></label><label>Résumé<textarea required maxlength="500" name="summary" rows="5">{{ draft.summary }}</textarea></label><label>Contenu détaillé<textarea required name="content" rows="12">{{ draft.content }}</textarea></label><label>Statut<select name="status"><option value="draft" {{ draft.status=='draft'?'selected':'' }}>Brouillon</option><option value="published" {{ draft.status=='published'?'selected':'' }}>Publié</option></select></label><label>Date de publication<input type="datetime-local" name="publishedAt" value="{{ draft.publishedAt ? (draft.publishedAt|date('Y-m-d') ~ 'T' ~ draft.publishedAt|date('H:i')) : '' }}"></label><button class="primary">Créer</button></form></details>
<form method="get" class="panel form-grid patchnote-filters" aria-label="Filtrer les patchnotes"><label>Statut<select name="status"><option value="">Tous</option><option value="draft" {{ statusFilter=='draft'?'selected':'' }}>Brouillons</option><option value="published" {{ statusFilter=='published'?'selected':'' }}>Publiées</option></select></label><label>Recherche<input name="q" value="{{ search }}" placeholder="Titre ou version"></label><button class="secondary">Filtrer</button></form>
{% for note in patchNotes %}<details class="panel patchnote-editor"><summary><span>{{ note.title }}</span><span class="badge">{{ note.version }} · {{ note.status=='published'?'Publié':'Brouillon' }}</span></summary><form method="post" action="{{ path('app_admin_patchnote_edit',{id:note.id}) }}" class="form-grid patchnote-form"><input type="hidden" name="_token" value="{{ csrf_token('patchnote_edit_'~note.id) }}"><label>Titre<input required maxlength="160" name="title" value="{{ note.title }}"></label><label>Version<input required maxlength="40" name="version" value="{{ note.version }}"></label><label>Résumé<textarea required maxlength="500" name="summary" rows="5">{{ note.summary }}</textarea></label><label>Contenu<textarea required name="content" rows="12">{{ note.content }}</textarea></label><label>Statut<select name="status"><option value="draft" {{ note.status=='draft'?'selected':'' }}>Brouillon</option><option value="published" {{ note.status=='published'?'selected':'' }}>Publié</option></select></label><label>Publication<input type="datetime-local" name="publishedAt" value="{{ note.publishedAt ? (note.publishedAt|date('Y-m-d') ~ 'T' ~ note.publishedAt|date('H:i')) : '' }}"></label><button class="primary">Enregistrer</button></form><form method="post" action="{{ path('app_admin_patchnote_delete',{id:note.id}) }}" onsubmit="return confirm('Supprimer cette patchnote ?')"><input type="hidden" name="_token" value="{{ csrf_token('patchnote_delete_'~note.id) }}"><button class="danger" aria-label="Supprimer la patchnote {{ note.title }}">Supprimer</button></form></details>{% else %}<p class="panel">Aucune patchnote pour ces filtres.</p>{% endfor %}
{% endblock %}
