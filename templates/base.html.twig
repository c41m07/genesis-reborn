{% import 'ui/macros.html.twig' as ui %}
{% set chrome = game_shell(app.user, planet|default(null)) %}
{% set route = app.request.attributes.get('_route') %}
{% set section = section|default('overview') %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Genesis Reborn{% endblock %}</title><link rel="icon" href="{{ asset('art/favicon.svg') }}" type="image/svg+xml">{{ encore_entry_link_tags('app') }}{{ encore_entry_script_tags('app', attributes={defer:true}) }}</head>
<body class="{{ app.user?'authenticated':'public-page' }}" data-controller="navigation">
<a class="skip" href="#main">Aller au contenu</a>
{% if app.user %}
<aside class="sidebar" id="command-navigation" data-navigation-target="sidebar">
<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark">{{ ui.icon('galaxy') }}</span><span>GENESIS<strong>REBORN</strong></span></a>
<button class="nav-close text-button" data-action="navigation#close" aria-label="Fermer le menu">{{ ui.icon('close') }}</button>
{% if chrome.planet %}<div class="sidebar-colonies" data-live-region="colony-selector"><label for="sidebar-colony">VOS COLONIES <span>{{ chrome.planets|length }}</span></label><form action="{{ path('app_home') }}" method="get"><input type="hidden" name="section" value="{{ section }}"><div class="sidebar-colony-choice"><span class="tiny-planet" aria-hidden="true"></span><select id="sidebar-colony" name="colony" data-controller="colony-switch" data-action="change->colony-switch#change" aria-label="Choisir une colonie">{% for p in chrome.planets %}<option value="{{ p.id }}" {{ p.id==chrome.planet.id?'selected':'' }}>{{ p.name }} · {{ p.coordinates() }}</option>{% endfor %}</select></div><noscript><button class="secondary full">Choisir cette colonie</button></noscript></form><small>{{ chrome.planet.coordinates() }}</small></div>{% endif %}
<nav aria-label="Navigation principale">
{% if chrome.planet %}<div class="nav-section-label">COLONIE</div>{% for item in [{group:'buildings',label:'Bâtiments',icon:'buildings'},{group:'ships',label:'Chantier spatial',icon:'fleet'},{group:'defenses',label:'Défenses',icon:'diplomacy'}] %}<a href="{{ path('app_colony',{id:chrome.planet.id,section:item.group}) }}" data-colony-section="{{ item.group }}" class="{{ route=='app_colony' and section==item.group?'active':'' }}" {{ route=='app_colony' and section==item.group?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}{% endif %}
<div class="nav-section-label">EMPIRE</div>
{% if chrome.planet %}<a href="{{ path('app_colony',{id:chrome.planet.id}) }}" data-colony-section="overview" class="{{ route=='app_colony' and section=='overview'?'active':'' }}" {{ route=='app_colony' and section=='overview'?'aria-current="page"':'' }}>{{ ui.icon('overview') }}<span>Vue générale</span></a><a href="{{ path('app_colony',{id:chrome.planet.id,section:'technologies'}) }}" data-colony-section="technologies" class="{{ route=='app_colony' and section=='technologies'?'active':'' }}" {{ route=='app_colony' and section=='technologies'?'aria-current="page"':'' }}>{{ ui.icon('research') }}<span>Recherche</span></a>{% endif %}
{% for item in [{route:'app_map',label:'Carte stellaire',icon:'galaxy'},{route:'app_fleets',label:'Flottes',icon:'fleet'},{route:'app_diplomacy',label:'Diplomatie',icon:'diplomacy'},{route:'app_combat_reports',label:'Rapports',icon:'clock'}] %}<a href="{{ path(item.route) }}" class="{{ route==item.route?'active':'' }}" {{ route==item.route?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}
<div class="nav-section-label">COMMANDEMENT</div><a href="{{ path('app_universes') }}" class="{{ route=='app_universes'?'active':'' }}" {{ route=='app_universes'?'aria-current="page"':'' }}>{{ ui.icon('universe') }}<span>Univers</span></a><a href="{{ path('app_profile') }}" class="{{ route=='app_profile'?'active':'' }}" {{ route=='app_profile'?'aria-current="page"':'' }}>{{ ui.icon('user') }}<span>Profil</span></a>
</nav>
<div class="sidebar-bottom"><div class="connection"><i></i> Liaison établie <span>{{ ui.icon('signal') }}</span></div><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout">{{ ui.icon('logout') }} Déconnexion</button></form><p>GENESIS REBORN <span>STRATÉGIE SPATIALE</span></p></div>
</aside><button class="nav-backdrop" aria-label="Fermer la navigation" data-action="navigation#close" tabindex="-1"></button>
{% endif %}
<div class="app-frame">
<header class="topbar">{% if app.user %}<button class="mobile-menu" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false" aria-label="Ouvrir le menu">{{ ui.icon('menu') }}</button><div class="universe-context">{{ ui.icon('universe') }}<span>{{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}</span><span class="connection-dot"></span></div><div class="header-tools"><span class="server-clock" data-controller="server-clock"><span data-server-clock-target="time">{{ 'now'|date('H:i:s','Europe/Paris') }}</span><small>HEURE LOCALE</small></span><a class="profile-link" href="{{ path('app_profile') }}">{{ ui.icon('user') }}<span>{{ app.user.username }}</span></a></div>{% else %}<a class="brand" href="{{ path('app_login') }}"><span class="brand-mark">{{ ui.icon('galaxy') }}</span><span>GENESIS <strong>REBORN</strong></span></a><span class="public-tagline">UNE COLONIE. UN EMPIRE. VOTRE HISTOIRE.</span><a class="public-login" href="{{ path(route=='app_register'?'app_login':'app_register') }}">{{ route=='app_register'?'Se connecter':'Rejoindre les étoiles' }} {{ ui.icon('arrow') }}</a>{% endif %}</header>
{% if chrome.resources %}<section class="resource-strip" aria-label="Ressources de {{ chrome.planet.name }}" data-live-region="resources"><div class="resource-planet"><span class="tiny-planet"></span><div><small>COLONIE ACTIVE</small><strong>{{ chrome.planet.name }}</strong></div></div>{% for slug,r in chrome.resources %}<div class="resource resource--{{ slug }}" data-controller="resource" data-resource-stock-value="{{ r.stock }}" data-resource-rate-value="{{ r.rate }}" data-resource-cap-value="{{ r.capacity }}">{{ ui.icon(slug,'resource-icon') }}<div><span class="resource-name">{{ r.label }}</span><strong data-resource-target="stock">{{ r.stock|number_format(0,',',' ') }}</strong><small>+{{ (r.rate*3600)|number_format(0,',',' ') }} / h</small></div><div class="storage-meter" title="Capacité : {{ r.capacity|number_format(0,',',' ') }}"><span style="width:{{ min(100,r.stock/r.capacity*100) }}%"></span></div></div>{% endfor %}</section>{% endif %}
<main id="main" class="shell">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main>
<footer class="footer"><span>GENESIS REBORN</span><span>Explorez. Développez. Écrivez votre histoire.</span></footer>
</div>
{% if chrome.membership %}<div class="event-toast" hidden role="status" aria-live="polite" data-controller="events" data-events-url-value="{{ path('app_events') }}"><span class="notification-mark">{{ ui.icon('check') }}</span><span data-events-target="message"></span><button class="text-button" data-action="events#refresh">Actualiser</button></div>{% endif %}
</body></html>
