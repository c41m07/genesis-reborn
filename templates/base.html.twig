{% import 'ui/macros.html.twig' as ui %}
{% set chrome = game_shell(app.user, planet|default(null)) %}
{% set route = app.request.attributes.get('_route') %}
{% set section = section|default('overview') %}
{% set preferences = {'timezone':'Europe/Paris','reducedMotion':false,'realtimeNotifications':true,'theme':'dark'}|merge(app.user ? app.user.preferences|default({}) : {}) %}
<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#090f1b"><title>{% block title %}Genesis Reborn{% endblock %}</title><link rel="icon" href="{{ asset('art/genesis-reborn-emblem.png') }}" type="image/png">{{ encore_entry_link_tags('app') }}{% if preferences.theme=='light' %}<link rel="stylesheet" href="{{ asset('styles/wireframe-theme.css') }}">{% endif %}{{ encore_entry_script_tags('app', attributes={defer:true}) }}{% if preferences.reducedMotion %}<style>.reduced-motion *, .reduced-motion *::before, .reduced-motion *::after { scroll-behavior:auto !important; animation-duration:0.01ms !important; animation-iteration-count:1 !important; transition-duration:0.01ms !important; }</style>{% endif %}</head>
<body class="{{ app.user?'authenticated':'public-page' }} {{ app.user and preferences.reducedMotion?'reduced-motion':'' }}" data-controller="navigation" data-theme="{{ preferences.theme }}" data-realtime-notifications="{{ preferences.realtimeNotifications?'true':'false' }}">
<a class="skip" href="#main">Aller au contenu</a>
{% if app.user %}
<aside class="sidebar" id="command-navigation" aria-label="Navigation de l’application" data-navigation-target="sidebar">
<a class="brand" href="{{ path('app_home') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="" width="35" height="35"></span><span>GENESIS<strong>REBORN</strong></span></a>
<button class="nav-close text-button" data-action="navigation#close" aria-label="Fermer le menu">{{ ui.icon('close') }}</button>
{% if chrome.planet %}<div class="sidebar-colonies" data-live-region="colony-selector"><label for="sidebar-colony">VOS COLONIES <span>{{ chrome.planets|length }}</span></label><form action="{{ path('app_home') }}" method="get"><input type="hidden" name="section" value="{{ section }}"><div class="sidebar-colony-choice"><span class="tiny-planet" aria-hidden="true"></span><select id="sidebar-colony" name="colony" data-controller="colony-switch" data-action="change->colony-switch#change" aria-label="Choisir une colonie">{% for p in chrome.planets %}<option value="{{ p.id }}" {{ p.id==chrome.planet.id?'selected':'' }}>{{ p.name }} · {{ p.coordinates() }}</option>{% endfor %}</select></div><noscript><button class="secondary full">Choisir cette colonie</button></noscript></form><small>{{ chrome.planet.coordinates() }}</small></div>{% endif %}
<nav aria-label="Navigation principale">
<div class="nav-section-label">Commandement</div>
{% if chrome.planet %}<a href="{{ path('app_colony',{id:chrome.planet.id}) }}" data-colony-section="overview" class="{{ route=='app_colony' and section=='overview'?'active':'' }}" {{ route=='app_colony' and section=='overview'?'aria-current="page"':'' }}>{{ ui.icon('overview') }}<span>Vue générale</span></a>{% endif %}
<a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}" {% if route=='app_planets' %}aria-current="page"{% endif %}>{{ ui.icon('galaxy') }}<span>Planètes</span></a>
<div class="nav-section-label">Développement</div>
{% if chrome.planet %}{% for item in [{group:'buildings',label:'Bâtiments',icon:'buildings'},{group:'technologies',label:'Recherche',icon:'research'},{group:'ships',label:'Chantier spatial',icon:'fleet'},{group:'defenses',label:'Défenses',icon:'diplomacy'}] %}<a href="{{ path('app_colony',{id:chrome.planet.id,section:item.group}) }}" data-colony-section="{{ item.group }}" class="{{ route=='app_colony' and section==item.group?'active':'' }}" {{ route=='app_colony' and section==item.group?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}{% endif %}
<div class="nav-section-label">Opérations</div>
{% for item in [{route:'app_fleets',label:'Flottes et missions',icon:'fleet'},{route:'app_map',label:'Galaxie',icon:'galaxy'},{route:'app_boosts',label:'Inventaire',icon:'clock'}] %}<a href="{{ path(item.route) }}" class="{{ route==item.route?'active':'' }}" {{ route==item.route?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}
<div class="nav-section-label">Communauté</div>
{% for item in [{route:'app_combat_reports',label:'Rapports',icon:'clock'},{route:'app_messages',label:'Messages',icon:'notifications'},{route:'app_diplomacy',label:'Alliances',icon:'diplomacy'},{route:'app_leaderboard',label:'Classements',icon:'research'}] %}<a href="{{ path(item.route) }}" class="{{ route==item.route?'active':'' }}" {{ route==item.route?'aria-current="page"':'' }}>{{ ui.icon(item.icon) }}<span>{{ item.label }}</span></a>{% endfor %}
<div class="nav-section-label">Compte</div>
<a href="{{ path('app_universes') }}" class="{{ route=='app_universes'?'active':'' }}" {{ route=='app_universes'?'aria-current="page"':'' }}>{{ ui.icon('universe') }}<span>Univers</span></a><a href="{{ path('app_profile') }}" class="{{ route=='app_profile'?'active':'' }}" {{ route=='app_profile'?'aria-current="page"':'' }}>{{ ui.icon('user') }}<span>Profil</span></a><a href="{{ path('app_technology_tree') }}" class="{{ route=='app_technology_tree'?'active':'' }}" {{ route=='app_technology_tree'?'aria-current="page"':'' }}>{{ ui.icon('research') }}<span>Technologie</span></a>

</nav>
<div class="sidebar-bottom"><div class="connection"><i></i> Liaison établie <span>{{ ui.icon('signal') }}</span></div><form method="post" action="{{ path('app_logout') }}"><input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}"><button class="logout">{{ ui.icon('logout') }} Déconnexion</button></form><p>GENESIS REBORN <span>STRATÉGIE SPATIALE</span></p></div>
</aside><button class="nav-backdrop" aria-label="Fermer la navigation" data-action="navigation#close" tabindex="-1"></button>
{% endif %}
<div class="app-frame">
<header class="topbar">{% if app.user %}<button class="mobile-menu" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false" aria-label="Ouvrir le menu">{{ ui.icon('menu') }}</button><div class="universe-context">{{ ui.icon('universe') }}<span>{{ chrome.membership?chrome.membership.universe.name:'Centre de commandement' }}</span><span class="connection-dot"></span></div><div class="header-tools"><span class="server-clock" {% if preferences.timezone=='Europe/Paris' %}data-controller="server-clock" data-server-clock-timezone-value="{{ preferences.timezone }}"{% endif %}><span data-server-clock-target="time">{{ 'now'|date('H:i:s',preferences.timezone) }}</span><small>HEURE · {{ preferences.timezone }}</small></span><a class="profile-link" href="{{ path('app_profile') }}" aria-label="Profil de {{ app.user.username }}">{{ ui.icon('user') }}<span>{{ app.user.username }}</span></a></div>{% else %}<a class="brand" href="{{ path('app_login') }}"><span class="brand-mark"><img src="{{ asset('art/genesis-reborn-emblem.webp') }}" alt="" width="35" height="35"></span><span>GENESIS <strong>REBORN</strong></span></a><span class="public-tagline">UNE COLONIE. UN EMPIRE. VOTRE HISTOIRE.</span><a class="public-login" href="{{ path(route=='app_register'?'app_login':'app_register') }}">{{ route=='app_register'?'Se connecter':'Rejoindre les étoiles' }} {{ ui.icon('arrow') }}</a>{% endif %}</header>
{% if chrome.resources %}<section class="resource-strip" aria-label="Ressources de {{ chrome.planet.name }}" data-live-region="resources"><div class="resource-planet"><span class="tiny-planet"></span><div><small>COLONIE ACTIVE</small><strong>{{ chrome.planet.name }}</strong></div></div>{% for slug,r in chrome.resources %}<div class="resource resource--{{ slug }}" data-controller="resource" data-resource-stock-value="{{ r.stock }}" data-resource-rate-value="{{ r.rate }}" data-resource-cap-value="{{ r.capacity }}">{{ ui.icon(slug,'resource-icon') }}<div><span class="resource-name">{{ r.label }}</span><strong data-resource-target="stock">{{ r.stock|number_format(0,',',' ') }}</strong><small>+{{ (r.rate*3600)|number_format(0,',',' ') }} / h</small></div><div class="storage-meter" title="Capacité : {{ r.capacity|number_format(0,',',' ') }}"><span style="width:{{ min(100,r.stock/r.capacity*100) }}%"></span></div></div>{% endfor %}</section>{% endif %}
<main id="main" class="shell {{ route=='app_map_v2'?'shell--galaxy-v2':'' }}">{% for type,messages in app.flashes %}{% for message in messages %}<div class="flash {{ type }}" role="{{ type=='error'?'alert':'status' }}">{{ message }}</div>{% endfor %}{% endfor %}{% block body %}{% endblock %}</main>
<footer class="footer {{ route=='app_map_v2'?'footer--galaxy-v2':'' }}"><span>GENESIS REBORN</span><span>Explorez. Développez. Écrivez votre histoire.</span></footer>
{% if app.user %}<nav class="mobile-bottom-nav" aria-label="Navigation mobile"><a href="{{ chrome.planet ? path('app_colony',{id:chrome.planet.id}) : path('app_home') }}" class="{{ route=='app_colony' or route=='app_home' ? 'active' : '' }}" {{ route=='app_colony' or route=='app_home' ? 'aria-current="page"' : '' }}>{{ ui.icon('overview') }}<span>Accueil</span></a><a href="{{ path('app_planets') }}" class="{{ route=='app_planets'?'active':'' }}">{{ ui.icon('galaxy') }}<span>Planètes</span></a><a href="{{ path('app_map') }}" class="{{ route=='app_map' ? 'active' : '' }}" {{ route=='app_map' ? 'aria-current="page"' : '' }}>{{ ui.icon('galaxy') }}<span>Galaxie</span></a><a href="{{ path('app_fleets') }}" class="{{ route=='app_fleets' ? 'active' : '' }}" {{ route=='app_fleets' ? 'aria-current="page"' : '' }}>{{ ui.icon('fleet') }}<span>Flottes</span></a><button type="button" data-navigation-target="toggle" data-action="navigation#toggle" aria-controls="command-navigation" aria-expanded="false">{{ ui.icon('menu') }}<span>Plus</span></button></nav>{% endif %}
</div>
{% if chrome.membership and preferences.realtimeNotifications %}<div class="event-toast" hidden role="status" aria-live="polite" data-controller="events" data-events-url-value="{{ path('app_events') }}" data-events-enabled-value="{{ preferences.realtimeNotifications?'true':'false' }}"><span class="notification-mark">{{ ui.icon('check') }}</span><span data-events-target="message"></span><button class="text-button" data-action="events#refresh">Actualiser</button></div>{% endif %}
</body></html>
