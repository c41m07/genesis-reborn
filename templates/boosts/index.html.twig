{% extends 'base.html.twig' %}
{% block title %}Inventaire · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading">
    <div>
        <p class="eyebrow">{{ membership.universe.name }}</p>
        <h1>Inventaire</h1>
        <p>Retrouvez ici les bonus attribués à votre joueur.</p>
    </div>
</div>

<section class="panel" aria-labelledby="boost-inventory-title">
    <div class="section-heading">
        <h2 id="boost-inventory-title">Bonus disponibles</h2>
        <span class="badge">{{ boosts|length }} / {{ inventory_capacity }}</span>
    </div>
    {% if boosts is empty %}
        <p class="muted">Aucun item disponible pour le moment.</p>
    {% else %}
        <article class="mission-card">
            <div>
                <h3>Boost de réduction de durée</h3>
                <p>Bonus attribué à votre joueur.</p>
            </div>
            <span class="badge">Quantité : {{ boosts|length }}</span>
        </article>
    {% endif %}
    {% if pending_boost_count > 0 %}
        <p class="muted">{{ pending_boost_count }} bonus en attente d’une place dans l’inventaire.</p>
    {% endif %}
</section>
{% endblock %}
