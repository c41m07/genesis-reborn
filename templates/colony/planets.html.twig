{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Planètes · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">POSTE DE COMMANDEMENT</p><h1>Planètes</h1><p>Chaque monde, une nouvelle ambition. Gérez vos colonies et leurs opérations.</p></div><a class="quiet-button" href="{{ path('app_colony',{id:chrome.planet.id}) }}">{{ ui.icon('overview') }} Vue générale {{ ui.icon('arrow') }}</a></div>
<section class="planet-index-summary panel"><div><span class="planet-index-mark">{{ ui.icon('galaxy') }}</span><div><h2>{{ planets|length }} monde{{ planets|length==1?'':'s' }}, un seul empire.</h2><p>{{ available_planets|length }} position{{ available_planets|length==1?'':'s' }} colonisable{{ available_planets|length==1?'':'s' }} actuellement disponible{{ available_planets|length==1?'':'s' }} dans cet univers.</p></div></div><a class="primary" href="{{ path('app_map') }}">{{ available_planets is not empty ? 'Coloniser un monde' : 'Explorer la galaxie' }} {{ ui.icon('arrow') }}</a></section>
<div class="planet-index-grid">{% for world in planets %}<article class="panel planet-index-card {{ chrome.planet and world.id==chrome.planet.id?'is-current':'' }}"><div class="planet-index-art"><img src="{{ asset('art/genesis-reborn-planet.webp') }}" alt="" loading="lazy"><span>{{ world.solarSystem.galaxy.name|upper }} / {{ world.solarSystem.coordX }}:{{ world.solarSystem.coordY }}</span></div><div class="planet-index-body"><div class="planet-index-title"><div><h2>{{ world.name }}</h2><p>{{ world.coordinates() }}</p></div>{% if chrome.planet and world.id==chrome.planet.id %}<span class="badge">Planète sélectionnée</span>{% endif %}</div><dl><div><dt>Position orbitale</dt><dd>{{ '%02d'|format(world.position) }} / 09</dd></div><div><dt>Planète</dt><dd>{{ world.owner and world.owner.id==membership.id?'Colonie de votre empire':(world.npcPlanet?'Monde PNJ':'Planète colonisée') }}</dd></div><div><dt>Secteur</dt><dd>{{ world.solarSystem.galaxy.name }} · {{ world.solarSystem.name }}</dd></div></dl><a class="primary full" href="{{ path('app_colony',{id:world.id}) }}">{{ chrome.planet and world.id==chrome.planet.id?'Gérer cette planète':'Sélectionner cette planète' }} {{ ui.icon('arrow') }}</a><div class="planet-index-shortcuts"><a href="{{ path('app_colony',{id:world.id,section:'buildings'}) }}">{{ ui.icon('buildings') }} Bâtiments</a><a href="{{ path('app_colony',{id:world.id,section:'ships'}) }}">{{ ui.icon('fleet') }} Chantier</a><a href="{{ path('app_fleets',{origin:world.id}) }}">{{ ui.icon('fleet') }} Flotte</a></div></div></article>{% else %}<div class="panel empty-state"><h2>Aucune colonie dans cet univers</h2><p>Explorez la galaxie et envoyez un vaisseau colonie vers un monde libre pour commencer.</p><a class="primary" href="{{ path('app_map') }}">Explorer la galaxie</a></div>{% endfor %}</div>
{% endblock %}
