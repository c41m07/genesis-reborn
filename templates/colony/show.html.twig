{% extends 'base.html.twig' %}{% import 'ui/macros.html.twig' as ui %}{% block title %}{{ planet.name }} · Genesis Reborn{% endblock %}
{% block body %}<div data-controller="colony-live" data-colony-live-url-value="{{ path('app_colony',{id:planet.id}) }}">
<div class="page-heading"><div><p class="eyebrow">COMMANDEMENT / VUE PLANÉTAIRE</p><h1>{{ {overview:'Vue générale',buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[section] }}<span>.</span></h1></div><a class="quiet-button" href="{{ path('app_map') }}">{{ ui.icon('galaxy') }} Explorer la galaxie {{ ui.icon('arrow') }}</a></div>
<div class="colony-layout colony-layout--integrated"><div class="colony-content">
{% include 'ui/flights.html.twig' %}
<section class="colony-banner panel"><img src="{{ asset('art/colony.svg') }}" alt="" class="colony-scene"><div class="hero-content"><span class="badge"><i class="connection-dot"></i> COLONIE OPÉRATIONNELLE</span><h2>{{ planet.name }}</h2><p>{{ ui.icon('galaxy') }} {{ planet.coordinates() }}</p><div class="planet-facts"><span><small>POSITION ORBITALE</small><strong>{{ '%02d'|format(planet.position) }} <em>/ 09</em></strong></span><span><small>COLONIES DANS L'UNIVERS</small><strong>{{ '%02d'|format(planets|length) }}</strong></span></div></div>{% include 'ui/colony_queues.html.twig' %}<span class="hero-sector">{{ planet.solarSystem.galaxy.name|upper }} / SECTEUR {{ planet.solarSystem.coordX }}:{{ planet.solarSystem.coordY }}</span></section>
{% if section!='overview' %}<div class="workspace colony-catalog" data-live-region="catalog">{% if section=='technologies' %}{% include 'ui/technology_tree.html.twig' %}{% endif %}
{% for group,items in cards %}{% if group==section %}<section id="panel-{{ group }}" aria-label="{{ {buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[group] }}"><div class="catalog-section-title"><h2>{{ {'buildings':'Développer la colonie','technologies':'Repousser les frontières','ships':'Préparer vos prochaines missions','defenses':'Protéger la planète'}[group] }}</h2><span>{{ items|length }} {{ group=='technologies'?'technologies':'structures & unités' }}</span></div><div class="catalog-grid">{% for card in items %}{% set d=card.definition %}{% set art=group=='technologies'?'lab':(group=='ships'?'ship':(group=='defenses'?'defense':(d.slug starts with 'mine_'?'mine':(d.slug starts with 'storage_'?'storage':(d.slug=='lab'?'lab':(d.slug=='shipyard'?'shipyard':'defense')))))) %}
<article id="item-{{ d.slug }}" class="panel catalog-card card--{{ group }} {{ card.failures?'locked':'' }}"><div class="card-art art--{{ art }}">{{ ui.structure(art) }}<span class="badge">{{ group in ['buildings','technologies']?'NIVEAU '~card.level:(group=='ships'?(ships[d.slug]|default(0))~' EN RÉSERVE':(defense_quantities[d.slug]|default(0))~' EN RÉSERVE') }}</span></div><div class="card-body"><h3>{{ d.label }}</h3><p class="card-detail">{% if group=='buildings' %}{{ d.production_resource is defined?'Production de '~resources[d.production_resource].label|lower:(d.storage_resource is defined?'Capacité de stockage':(d.slug=='lab'?'Vitesse de recherche':(d.slug=='shipyard'?'Construction des vaisseaux':'Défense planétaire'))) }}{% elseif group=='technologies' %}{{ d.effect.type=='stat_bonus'?'Précision accrue · combats à venir':'Nouvelles possibilités' }}{% elseif group=='ships' %}{{ d.cargo_capacity>0?'Transport & logistique':(d.slug=='probe'?'Exploration des systèmes':(d.slug=='colony_ship'?'Fondation de colonies':'Unité de flotte')) }}{% else %}Défense fixe · {{ d.hp }} points de structure{% endif %}</p><div class="build-duration">{{ ui.icon('clock') }} {{ duration_label(card.duration) }} <span>{{ group in ['ships','defenses']?'par unité':'niveau '~card.target }}</span></div><div class="costs">{% for resource,cost in card.costs %}<span class="{{ cost>resources[resource].stock?'insufficient':'' }}" title="{{ resources[resource].label }}">{{ ui.icon(resource) }}<span>{{ cost|number_format(0,',',' ') }}<small>{{ resources[resource].label }}</small></span></span>{% endfor %}</div>
{% include 'ui/catalogue_benefits.html.twig' %}{% if card.maximum %}<p class="requirement complete">{{ ui.icon('check') }} Niveau maximum atteint</p>{% elseif card.failures %}<p class="requirement">{{ ui.icon('diplomacy') }} <span>Nécessite : {{ card.failures|join(', ') }}</span></p>{% else %}<form method="post" action="{{ path('app_queue_add',{id:planet.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('build'~planet.id) }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="group" value="{{ group }}"><input type="hidden" name="section" value="{{ group }}"><input type="hidden" name="slug" value="{{ d.slug }}">{% if group in ['ships','defenses'] %}<label for="quantity-{{ d.slug }}">Quantité</label><input id="quantity-{{ d.slug }}" name="quantity" type="number" min="1" max="100" value="1">{% endif %}<button class="secondary full">{{ group=='technologies'?'Rechercher le niveau '~card.target:(group=='buildings'?'Améliorer au niveau '~card.target:'Construire') }} {{ ui.icon('arrow') }}</button></form>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}{% endfor %}</div>{% endif %}

</div></div></div>{% endblock %}
