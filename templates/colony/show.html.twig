{% extends 'base.html.twig' %}{% import 'ui/macros.html.twig' as ui %}{% block title %}{{ planet.name }} · Genesis Reborn{% endblock %}
{% block body %}<div data-controller="colony-live" data-colony-live-url-value="{{ path('app_colony',{id:planet.id}) }}">
<div class="page-heading"><div><p class="eyebrow">COMMANDEMENT / VUE PLANÉTAIRE</p><h1>{{ {overview:'Vue générale',buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[section] }}<span>.</span></h1></div><a class="quiet-button" href="{{ path('app_map') }}">{{ ui.icon('galaxy') }} Explorer la galaxie {{ ui.icon('arrow') }}</a></div>
<div class="colony-layout colony-layout--integrated"><div class="colony-content">
{% if section=='overview' %}
<section class="colony-banner panel"><img src="{{ asset('art/colony.svg') }}" alt="" class="colony-scene"><img src="{{ asset('art/genesis-reborn-planet.webp') }}" alt="" class="colony-world" loading="lazy"><div class="hero-content"><span class="badge"><i class="connection-dot"></i> COLONIE OPÉRATIONNELLE</span><h2>{{ planet.name }}</h2><p>{{ ui.icon('galaxy') }} {{ planet.coordinates() }}</p><div class="planet-facts"><span><small>POSITION ORBITALE</small><strong>{{ '%02d'|format(planet.position) }} <em>/ 09</em></strong></span><span><small>COLONIES DANS L'UNIVERS</small><strong>{{ '%02d'|format(planets|length) }}</strong></span></div></div>{% if section!='overview' %}{% include 'ui/colony_queues.html.twig' %}{% endif %}<span class="hero-sector">{{ planet.solarSystem.galaxy.name|upper }} / SECTEUR {{ planet.solarSystem.coordX }}:{{ planet.solarSystem.coordY }}</span></section>

{% if section=='overview' %}
<section class="dashboard-metrics" aria-label="Résumé de votre empire">
<a class="metric-card" href="{{ path('app_planets') }}"><span class="metric-symbol">{{ ui.icon('galaxy') }}</span><span><small>Planètes</small><strong>{{ planets|length }}</strong><span class="metric-caption">dans cet univers</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_leaderboard') }}"><span class="metric-symbol">{{ ui.icon('universe') }}</span><span><small>Classement</small><strong>{{ empire_rank ? '#'~empire_rank : '—' }}</strong><span class="metric-caption">par points dans cet univers</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_fleets') }}"><span class="metric-symbol">{{ ui.icon('fleet') }}</span><span><small>Flottes en vol</small><strong>{{ active_fleets|length }}</strong><span class="metric-caption">toutes colonies confondues</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_diplomacy') }}"><span class="metric-symbol">{{ ui.icon('diplomacy') }}</span><span><small>Alliance</small><strong>{{ empire_guild ? empire_guild.name : (guilds_enabled ? 'Sans alliance' : 'Désactivée') }}</strong><span class="metric-caption">{{ empire_guild ? 'Gérer les relations' : (guilds_enabled ? 'Découvrir la diplomatie' : 'Dans cet univers') }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
</section>
<div class="dashboard-layout">
<div class="dashboard-primary">
<section class="dashboard-activity" aria-label="Activité et files de la colonie active">{% include 'ui/colony_queues.html.twig' %}</section>
<section class="panel dashboard-planets" aria-labelledby="dashboard-planets-title">
<div class="dashboard-section-heading"><div><h2 id="dashboard-planets-title">Mes planètes</h2><p>{{ planets|length }} colonie{{ planets|length==1?'':'s' }} dans cet univers</p></div><a href="{{ path('app_map') }}">Carte stellaire <span aria-hidden="true">→</span></a></div>
<div class="dashboard-planet-grid">{% for colony in planets %}<a class="dashboard-planet {{ colony.id==planet.id?'is-current':'' }}" href="{{ path('app_colony',{id:colony.id}) }}"><span class="dashboard-planet-art" aria-hidden="true">{{ ui.icon('galaxy') }}</span><span class="dashboard-planet-info"><strong>{{ colony.name }}</strong><small>{{ colony.coordinates() }}</small><small>Position {{ '%02d'|format(colony.position) }} · {{ colony.solarSystem.galaxy.name }}</small></span>{% if colony.id==planet.id %}<span class="badge">Active</span>{% endif %}</a>{% endfor %}</div>
</section>
</div>
<aside class="dashboard-secondary">
{% include 'ui/flights.html.twig' %}
<section class="panel dashboard-journal" aria-labelledby="dashboard-journal-title">
<div class="dashboard-section-heading"><div><h2 id="dashboard-journal-title">Journal de bord</h2><p>Dernières notifications de votre empire</p></div><span aria-hidden="true">{{ ui.icon('clock') }}</span></div>
{% if chrome.notifications|default([]) is not empty %}<ol class="dashboard-notifications">{% for notification in chrome.notifications %}<li><span class="journal-mark" aria-hidden="true">{{ ui.icon('notifications') }}</span><span><strong>{{ notification.message }}</strong><small>{{ notification.createdAt|date('d/m/Y · H:i',preferences.timezone) }}</small></span></li>{% endfor %}</ol>{% else %}<p class="dashboard-empty">Aucune activité récente. Les nouvelles étapes de votre empire apparaîtront ici.</p>{% endif %}
<a class="dashboard-journal-link" href="{{ path('app_combat_reports') }}">Ouvrir les rapports <span aria-hidden="true">→</span></a>
</section>
</aside>
</div>
{% endif %}
{% else %}
<div class="colony-catalog-workspace"><main class="workspace colony-catalog" data-live-region="catalog" data-controller="catalog-filter">
{% for group,items in cards %}{% if group==section %}<section id="panel-{{ group }}" aria-label="{{ {buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[group] }}"><div class="catalog-section-title"><h2>{{ {'buildings':'Développer la colonie','technologies':'Repousser les frontières','ships':'Préparer vos prochaines missions','defenses':'Protéger la planète'}[group] }}</h2><span>{{ items|length }} {{ group=='technologies'?'technologies':'structures & unités' }}</span></div><nav class="catalog-filters" aria-label="Filtrer le catalogue">{% set filter_options = group=='buildings' ? {all:'Tous',economy:'Économie',infrastructure:'Infrastructures',storage:'Stockage'} : (group=='technologies' ? {all:'Tous',combat:'Combat',propulsion:'Propulsion',infrastructure:'Infrastructures'} : {all:'Tous',combat:'Combat',utility:'Utilitaires'}) %}{% for key,label in filter_options %}<button type="button" data-action="click->catalog-filter#apply" data-category="{{ key }}" aria-pressed="{{ key=='all'?'true':'false' }}">{{ label }}</button>{% endfor %}</nav><div class="catalog-grid">{% for card in items %}{% set d=card.definition %}{% set category = group=='buildings' ? (d.production_resource is defined ? 'economy' : (d.storage_resource is defined ? 'storage' : 'infrastructure')) : (group=='technologies' ? (d.slug in ['precision_fire','advanced_targeting'] ? 'combat' : (d.slug=='advanced_propulsion' ? 'propulsion' : 'infrastructure')) : (group=='ships' ? (d.category=='support' ? 'utility' : 'combat') : 'combat')) %}{% set art=group=='technologies'?'lab':(group=='ships'?'ship':(group=='defenses'?'defense':(d.slug starts with 'mine_'?'mine':(d.slug starts with 'storage_'?'storage':(d.slug=='lab'?'lab':(d.slug=='shipyard'?'shipyard':'defense')))))) %}
<article id="item-{{ d.slug }}" data-catalog-filter-target="card" data-category="{{ category }}" class="panel catalog-card card--{{ group }} {{ card.failures?'locked':'' }}"><div class="card-art art--{{ art }}">{{ ui.structure(art) }}<span class="badge">{{ group in ['buildings','technologies']?'NIVEAU '~card.level:(group=='ships'?(ships[d.slug]|default(0))~' EN RÉSERVE':(defense_quantities[d.slug]|default(0))~' EN RÉSERVE') }}</span></div><div class="card-body"><h3>{{ d.label }}</h3><p class="card-detail">{% if group=='buildings' %}{{ d.production_resource is defined?'Production de '~resources[d.production_resource].label|lower:(d.storage_resource is defined?'Capacité de stockage':(d.slug=='lab'?'Vitesse de recherche':(d.slug=='shipyard'?'Construction des vaisseaux':'Défense planétaire'))) }}{% elseif group=='technologies' %}{{ d.effect.type=='stat_bonus'?'Précision accrue · combats à venir':'Nouvelles possibilités' }}{% elseif group=='ships' %}{{ d.cargo_capacity>0?'Transport & logistique':(d.slug=='probe'?'Exploration des systèmes':(d.slug=='colony_ship'?'Fondation de colonies':'Unité de flotte')) }}{% else %}Défense fixe · {{ d.hp }} points de structure{% endif %}</p><div class="build-duration">{{ ui.icon('clock') }} {{ duration_label(card.duration) }} <span>{{ group in ['ships','defenses']?'par unité':'niveau '~card.target }}</span></div><div class="costs">{% for resource,cost in card.costs %}<span class="{{ cost>resources[resource].stock?'insufficient':'' }}" title="{{ resources[resource].label }}">{{ ui.icon(resource) }}<span>{{ cost|number_format(0,',',' ') }}<small>{{ resources[resource].label }}</small></span></span>{% endfor %}</div>
{% include 'ui/catalogue_benefits.html.twig' %}{% if card.maximum %}<p class="requirement complete">{{ ui.icon('check') }} Niveau maximum atteint</p>{% elseif card.failures %}<p class="requirement">{{ ui.icon('diplomacy') }} <span>Nécessite : {{ card.failures|join(', ') }}</span></p>{% else %}<form method="post" action="{{ path('app_queue_add',{id:planet.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('build'~planet.id) }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="group" value="{{ group }}"><input type="hidden" name="section" value="{{ group }}"><input type="hidden" name="slug" value="{{ d.slug }}">{% if group in ['ships','defenses'] %}<label for="quantity-{{ d.slug }}">Quantité</label><input id="quantity-{{ d.slug }}" name="quantity" type="number" min="1" max="100" value="1">{% endif %}<button class="secondary full">{{ group=='technologies'?'Rechercher le niveau '~card.target:(group=='buildings'?'Améliorer au niveau '~card.target:'Construire') }} {{ ui.icon('arrow') }}</button></form>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}{% endfor %}{% if section=='technologies' %}{% include 'ui/technology_tree.html.twig' %}{% endif %}</main><aside class="colony-catalog-aside">{% include 'ui/colony_queues.html.twig' %}{% include 'ui/flights.html.twig' %}</aside></div>
{% endif %}

</div></div></div>{% endblock %}
