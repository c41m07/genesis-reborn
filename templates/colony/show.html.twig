{% extends 'base.html.twig' %}{% import 'ui/macros.html.twig' as ui %}{% block title %}{{ planet.name }} · Genesis Reborn{% endblock %}
{% block body %}<div data-controller="colony-live" data-colony-live-url-value="{{ path('app_colony',{id:planet.id}) }}">
<div class="page-heading"><div><p class="eyebrow">COMMANDEMENT / VUE PLANÉTAIRE</p><h1>{{ {overview:'Vue générale',buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[section] }}<span>.</span></h1></div><a class="quiet-button" href="{{ path('app_map') }}">{{ ui.icon('galaxy') }} Explorer la galaxie {{ ui.icon('arrow') }}</a></div>
<div class="colony-layout colony-layout--integrated"><div class="colony-content">
{% if section=='overview' %}
<section class="colony-banner panel"><img class="colony-scene" src="{{ asset('art/colony-overview.png') }}" alt="" aria-hidden="true"><div class="hero-content"><span class="badge"><i class="connection-dot"></i> COLONIE OPÉRATIONNELLE</span><h2>{{ planet.name }}</h2><p>{{ ui.icon('galaxy') }} {{ planet.coordinates() }}</p><div class="planet-facts"><span><small>POSITION ORBITALE</small><strong>{{ '%02d'|format(planet.position) }} <em>/ 09</em></strong></span><span><small>COLONIES DANS L'UNIVERS</small><strong>{{ '%02d'|format(planets|length) }}</strong></span></div></div>{% if section!='overview' %}{% include 'ui/colony_queues.html.twig' %}{% endif %}<span class="hero-sector">SECTEUR {{ planet.coordinates() }}</span></section>

{% if section=='overview' %}
<section class="dashboard-metrics" aria-label="Résumé de votre empire">
<a class="metric-card" href="{{ path('app_planets') }}"><span class="metric-symbol">{{ ui.icon('galaxy') }}</span><span><small>Planètes</small><strong>{{ planets|length }}</strong><span class="metric-caption">dans cet univers</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_leaderboard') }}"><span class="metric-symbol">{{ ui.icon('universe') }}</span><span><small>Classement</small><strong>{{ empire_rank ? '#'~empire_rank : '—' }}</strong><span class="metric-caption">par points dans cet univers</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_fleets') }}"><span class="metric-symbol">{{ ui.icon('fleet') }}</span><span><small>Flottes en vol</small><strong>{{ active_fleets|length }}</strong><span class="metric-caption">toutes colonies confondues</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
<a class="metric-card" href="{{ path('app_diplomacy') }}"><span class="metric-symbol">{{ ui.icon('diplomacy') }}</span><span><small>Alliance</small><strong>{{ empire_guild ? empire_guild.name : (guilds_enabled ? 'Sans alliance' : 'Désactivée') }}</strong><span class="metric-caption">{{ empire_guild ? 'Gérer les relations' : (guilds_enabled ? 'Découvrir la diplomatie' : 'Dans cet univers') }}</span></span><span class="metric-arrow" aria-hidden="true">→</span></a>
</section>
<div class="dashboard-layout">
<div class="dashboard-primary">
<section class="dashboard-activity" aria-label="Activité et files de la colonie active">{% include 'ui/colony_queues.html.twig' %}</section>

</div>
<aside class="dashboard-secondary">
{% include 'ui/flights.html.twig' %}
<section class="panel dashboard-journal" aria-labelledby="dashboard-journal-title">
<div class="dashboard-section-heading"><div><h2 id="dashboard-journal-title">Journal de bord</h2><p>Dernières notifications de votre empire</p></div><span aria-hidden="true">{{ ui.icon('clock') }}</span></div>
{% if chrome.notifications|default([]) is not empty %}<ol class="dashboard-notifications">{% for notification in chrome.notifications %}<li><span class="journal-mark" aria-hidden="true">{{ ui.icon('notifications') }}</span><span><strong>{{ notification.message }}</strong><small>{{ notification.createdAt|date('d/m/Y · H:i',preferences.timezone) }}</small></span></li>{% endfor %}</ol>{% else %}<p class="dashboard-empty">Aucune activité récente. Les nouvelles étapes de votre empire apparaîtront ici.</p>{% endif %}
<a class="dashboard-journal-link" href="{{ path('app_combat_reports') }}">Ouvrir les rapports <span aria-hidden="true">→</span></a>
</section>
</aside>
</div>
{% endif %}
{% else %}
<div class="colony-catalog-workspace"><div class="workspace colony-catalog" data-live-region="catalog" aria-label="Catalogue et opérations de la colonie" data-controller="catalog-filter">
{% for group,items in cards %}{% if group==section %}<section id="panel-{{ group }}" aria-label="{{ {buildings:'Bâtiments',technologies:'Recherche',ships:'Chantier spatial',defenses:'Défenses'}[group] }}"><div class="catalog-section-title"><h2>{{ {'buildings':'Développer la colonie','technologies':'Repousser les frontières','ships':'Préparer vos prochaines missions','defenses':'Protéger la planète'}[group] }}</h2><span>{{ items|length }} {{ group=='technologies'?'technologies':'structures & unités' }}</span>{% if show_locked_items %}<small class="catalog-visibility-note">Éléments verrouillés affichés</small>{% else %}<small class="catalog-visibility-note">Éléments verrouillés masqués · <a href="{{ path('app_preferences') }}">Modifier</a></small>{% endif %}</div><nav class="catalog-filters" aria-label="Filtrer le catalogue">{% set filter_options = group=='buildings' ? {all:'Tous',economy:'Production',infrastructure:'Infrastructures',storage:'Stockage',defense:'Défense'} : (group=='technologies' ? {all:'Toutes',combat:'Combat',propulsion:'Propulsion',infrastructure:'Infrastructures',espionage:'Espionnage'} : (group=='ships' ? {all:'Tous',combat:'Combat',transport:'Transport',utility:'Utilitaires'} : {all:'Toutes',combat:'Défense'})) %}{% for key,label in filter_options %}<button type="button" data-action="click->catalog-filter#apply" data-category="{{ key }}" aria-pressed="{{ key=='all'?'true':'false' }}">{{ label }}</button>{% endfor %}</nav><div class="catalog-grid">{% for card in items %}{% set d=card.definition %}{% set category = group=='buildings' ? (d.production_resource is defined ? 'economy' : (d.storage_resource is defined ? 'storage' : (d.slug=='fortress' ? 'defense' : 'infrastructure'))) : (group=='technologies' ? (d.slug in ['weapon_calibration','target_acquisition','weapons_engineering','shield_harmonics','structural_armor','evasive_navigation','signature_reduction','rapid_fire_cycle','cryogenic_reserves','modular_cargo_bays'] ? 'combat' : (d.slug=='vector_propulsion' ? 'propulsion' : (d.slug in ['tactical_intelligence','intelligence_countermeasures','signature_masking'] ? 'espionage' : 'infrastructure'))) : (group=='ships' ? ((d.cargo_capacity|default(0)) > 0 ? 'transport' : (d.category=='support' ? 'utility' : 'combat')) : 'combat')) %}<article id="item-{{ d.slug }}-{{ card.tier }}" data-catalog-filter-target="card" data-category="{{ category }}" class="panel catalog-card card--{{ group }} {{ card.failures?'locked':'' }}">{% if (group=='technologies' and d.slug in ['vector_propulsion','automated_defense_repair','colonial_expansion','cryogenic_reserves','engineering_foundations','evasive_navigation','intelligence_countermeasures','modular_cargo_bays','nanomaterial_synthesis','naval_engineering','rapid_fire_cycle','shield_harmonics','signature_masking','signature_reduction','structural_armor','tactical_intelligence','target_acquisition','weapon_calibration','weapons_engineering']) or (group=='buildings' and d.slug=='power_plant') or (group=='defenses' and d.slug in ['ground_turret_anti_light','ground_turret_anti_escort','ground_turret_anti_heavy','ground_turret_anti_capital']) or (group=='ships' and d.slug in ['battleship','bomber','capital','colony_ship','corvette','cruiser','destroyer','frigate','heavy_fighter','interceptor','probe','stealth_fighter','transport','fighter']) or (group=='buildings' and d.slug in ['shipyard','storage_antimatter','storage_electricity','storage_hydrogen','storage_metal','storage_nano','fortress','lab','mine_antimatter','mine_hydrogen','mine_metal','mine_nano']) %}<div class="catalog-card-art"><img src="{{ asset('images/catalog/'~group~'/'~d.slug~'__'~card.tier~'.webp') }}" alt="" loading="lazy" decoding="async" onerror="this.parentElement.hidden=true"></div>{% endif %}<div class="card-body"><div class="catalog-card-heading"><h3>{{ d.label }}</h3><span class="tier-label tier-label--{{ card.tier }}">{{ d._tier_label }}</span><span class="badge card-stock-badge">{{ group in ['buildings','technologies']?'NIVEAU '~card.level:(group=='ships'?card.quantity~' EN RÉSERVE':(card.quantity|default(0))~' EN RÉSERVE') }}</span>{% include 'ui/catalogue_info.html.twig' %}</div><p class="card-detail">{% if group=='buildings' %}{{ d.production_resource is defined?'Production de '~resources[d.production_resource].label|lower:(d.storage_resource is defined?'Capacité de stockage':(d.slug=='lab'?'Vitesse de recherche':(d.slug=='shipyard'?'Construction des vaisseaux':'Défense planétaire'))) }}{% elseif group=='technologies' %}{{ d.effect.type=='stat_bonus'?'Bonus de combat · '~(d.effect.stats|default([d.effect.stat|default('statistique')])|join(', ')):'Nouvelles possibilités' }}{% elseif group=='ships' %}{{ d.cargo_capacity>0?'Transport & logistique':(d.slug=='probe'?'Exploration des systèmes':(d.slug=='colony_ship'?'Fondation de colonies':'Unité de flotte')) }}{% else %}Défense fixe{% if d.countered_class_label is defined %} · {{ d.countered_class_label }} · {{ d.weapon_type|default('') }}{% endif %}{% endif %}</p><div class="build-duration">{{ ui.icon('clock') }} {{ duration_label(card.duration) }}</div><div class="costs">{% for resource,cost in card.costs %}{% if cost>0 %}<span class="{{ cost>resources[resource].stock?'insufficient':'' }}" title="{{ resources[resource].label }}">{{ ui.icon(resource) }}<span>{{ cost|number_format(0,',',' ') }}<small>{{ resources[resource].label }}</small></span></span>{% endif %}{% endfor %}</div>
{% include 'ui/catalogue_benefits.html.twig' %}{% if card.maximum %}<p class="requirement complete">{{ ui.icon('check') }} Niveau maximum atteint</p>{% elseif card.failures %}<p class="requirement">{{ ui.icon('diplomacy') }} <span>Nécessite : {{ card.failures|join(', ') }}</span></p>{% else %}<form method="post" action="{{ path('app_queue_add',{id:planet.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('build'~planet.id) }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="group" value="{{ group }}"><input type="hidden" name="section" value="{{ group }}"><input type="hidden" name="slug" value="{{ d.slug }}"><input type="hidden" name="tier" value="{{ card.tier }}">{% if group in ['ships','defenses'] %}<label for="quantity-{{ d.slug }}-{{ card.tier }}">Quantité</label><input id="quantity-{{ d.slug }}-{{ card.tier }}" name="quantity" type="number" min="1" max="100" value="1">{% endif %}<button class="secondary full">{{ group=='technologies'?'Rechercher '~d._tier_label~' niveau '~card.target:(group=='buildings'?'Améliorer '~d._tier_label~' au niveau '~card.target:'Construire '~d._tier_label) }} {{ ui.icon('arrow') }}</button></form>{% endif %}</div></article>{% endfor %}</div></section>{% endif %}{% endfor %}</div><aside class="colony-catalog-aside">{% include 'ui/colony_queues.html.twig' %}{% include 'ui/flights.html.twig' %}</aside></div>
{% endif %}

</div></div></div>{% endblock %}
