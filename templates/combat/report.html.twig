{% extends 'base.html.twig' %}
{% block title %}Rapport de combat · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">{{ report.resolvedAt|date('d/m/Y H:i:s') }}</p><h1>Rapport · {{ report.combatEvent.planet.name }}</h1><p>{{ report.combatEvent.planet.coordinates() }} · Issue : {% if report.outcome=='attacker_wins' %}victoire des attaquants{% elseif report.outcome=='defender_wins' %}victoire de la défense{% else %}égalité{% endif %}</p></div><a class="secondary" href="{{ path('app_combat_reports') }}">Tous les rapports</a></div>
{% set capture = report.snapshot.capture|default(null) %}
{% if capture %}<section class="panel"><h2>Conquête</h2>{% if capture.status == 'captured' %}{% if capture.captor_player_universe_id == membership.id %}<p>Vous avez conquis cette planète PNJ. Ses bâtiments et ressources sont conservés.</p>{% else %}<p>La planète a été revendiquée par un autre commandant.</p>{% endif %}{% elseif capture.reason == 'attack_lost' %}<p>La conquête a échoué car les attaquants ont perdu le combat.</p>{% elseif capture.reason == 'planet_limit' %}<p>Le combat est gagné, mais la limite de colonies empêche la prise de la planète.</p>{% elseif capture.reason == 'target_claimed' %}<p>Le combat est gagné, mais la planète a déjà été revendiquée.</p>{% else %}<p>Le combat est gagné, mais aucun vaisseau colonie n’a survécu.</p>{% endif %}</section>{% endif %}
<section class="panel"><h2>Pertes constatées</h2>{% if rows %}<div class="table-scroll" role="region" tabindex="0" aria-label="Tableau des pertes, défilant horizontalement"><table class="data-table combat-losses"><caption>Effectifs engagés et pertes par unité</caption><thead><tr><th scope="col">Camp</th><th scope="col">Unité</th><th scope="col">Au combat</th><th scope="col">Pertes</th><th scope="col">Round d’arrivée</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.label }}</td><th scope="row">{{ row.unit }}</th><td>{{ row.initial|number_format(0, ",", " ") }}</td><td>{{ row.lost|number_format(0, ",", " ") }}</td><td>{{ row.round }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>Aucune unité engagée.</p>{% endif %}</section>
{% if loot_rows %}<section class="panel"><h2>Butin embarqué par vos flottes</h2><ul class="resource-list">{% for item in loot_rows %}<li>{{ item.label }} : {{ item.amount|number_format(0, ",", " ") }}</li>{% endfor %}</ul></section>{% endif %}
{% endblock %}
