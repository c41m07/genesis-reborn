{% extends 'base.html.twig' %}
{% block title %}Rapport de combat · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">{{ report.resolvedAt|date('d/m/Y H:i:s') }}</p><h1>Rapport · {{ report.combatEvent.planet.name }}</h1><p>{{ report.combatEvent.planet.coordinates() }} · Issue : {% if report.outcome=='attacker_wins' %}victoire des attaquants{% elseif report.outcome=='defender_wins' %}victoire de la défense{% else %}égalité{% endif %}</p></div><a class="secondary" href="{{ path('app_combat_reports') }}">Tous les rapports</a></div>
<section class="panel"><h2>Pertes constatées</h2>{% if rows %}<div class="table-scroll"><table><thead><tr><th scope="col">Camp</th><th scope="col">Unité</th><th scope="col">Au combat</th><th scope="col">Pertes</th><th scope="col">Round d’arrivée</th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.label }}</td><td>{{ row.unit }}</td><td>{{ row.initial }}</td><td>{{ row.lost }}</td><td>{{ row.round }}</td></tr>{% endfor %}</tbody></table></div>{% else %}<p>Aucune unité engagée.</p>{% endif %}</section>
{% endblock %}
