{% extends 'base.html.twig' %}
{% block title %}Rapport d’espionnage · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><p class="eyebrow">RENSEIGNEMENTS</p><h1>{{ report.target.name }}</h1><p>{{ report.target.coordinates() }} · {{ report.createdAt|date('d/m/Y H:i') }}</p></div><a class="inline-link" href="{{ path('app_combat_reports') }}">Retour aux rapports</a></div>
<section class="panel"><p>Sondes envoyées : {{ report.probesSent }} · Risque de détection estimé : {{ report.detectionChance }} %</p>
{% if report.result == 'detected' %}<div class="flash" role="status"><strong>Sondes détectées.</strong> Le propriétaire a été averti et aucun renseignement n’a été obtenu.</div>
{% else %}<p class="badge" role="status">{{ report.intelCategories }} catégorie(s) de renseignements obtenue(s)</p>
{% for category, title in {resources:'Ressources et production', buildings:'Bâtiments', research:'Recherches', fleets:'Flottes', defenses:'Défenses fixes'} %}
{% if report.snapshot[category] is defined %}
<section class="intel-section"><h2>{{ title }}</h2>{% set items = report.snapshot[category] %}
{% if items %}<div class="catalog-grid">
{% for slug, item in items %}
    {% set variants = category in ['buildings', 'research'] and item.level is not defined ? item : {single: item} %}
    {% for tier, variant in variants %}
    <article class="panel intel-card"><strong>{{ variant.label ?? slug }}</strong>
    {% if tier != 'single' %}<span class="badge">{{ {basic:'Basique', intermediate:'Intermédiaire', superior:'Supérieur'}[tier]|default(tier) }}</span>{% endif %}
    {% if category == 'resources' %}
        <dl class="intel-facts"><div><dt>Stock</dt><dd>{{ variant.stock|number_format(0, ',', ' ') }}</dd></div><div><dt>Production / s</dt><dd>{{ variant.rate|number_format(2, ',', ' ') }}</dd></div><div><dt>Capacité</dt><dd>{{ variant.capacity|number_format(0, ',', ' ') }}</dd></div></dl>
    {% elseif category in ['buildings', 'research'] %}<p>Niveau {{ variant.level }}</p>
    {% else %}<p>Quantité : {{ variant.quantity|number_format(0, ',', ' ') }}</p>{% endif %}
    </article>
    {% endfor %}
{% endfor %}</div>{% else %}<p>Aucun élément détecté dans cette catégorie.</p>{% endif %}</section>
{% endif %}{% endfor %}{% endif %}</section>
{% endblock %}
