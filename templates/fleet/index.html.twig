{% extends 'base.html.twig' %}{% block title %}Flottes · Genesis Reborn{% endblock %}{% block body %}{% import 'ui/macros.html.twig' as ui %}{% set mission_labels={explore:'Exploration',colonize:'Colonisation',transport:'Transport',attack:'Attaque'} %}{% set status_labels={traveling:'En route',returning:'Retour en cours',attacking:'Combat en cours',defending:'En défense',completed:'Terminée',failed:'Échouée',orbiting:'En orbite'} %}<div data-controller="colony-live" data-colony-live-url-value="{{ path('app_fleets') }}"><div class="page-heading"><div><p class="eyebrow">{{ membership.universe.name }}</p><h1>Commandement des flottes</h1><p>Explorez, colonisez, transportez vos ressources ou attaquez une planète ennemie.</p></div></div>{% if fuel_pending %}<p class="flash">Les départs attendent la validation de la règle de consommation de carburant.</p>{% endif %}
{% include 'ui/flights.html.twig' %}<div data-live-region="available-fleets">{% for row in idle %}{% set f=row.fleet %}<section class="panel fleet-form" data-system-x="{{ f.homePlanet.solarSystem.coordX }}" data-system-y="{{ f.homePlanet.solarSystem.coordY }}"><div class="section-heading"><div><p class="eyebrow">PRÉPARER UNE EXPÉDITION</p><h2>Départ de {{ f.homePlanet.name }}</h2></div>{{ ui.icon("fleet") }}</div><form method="post" action="{{ path('app_fleet_send') }}" data-controller="fleet-fields fleet-preview" data-fleet-preview-url-value="{{ path('app_fleet_preview') }}" data-action="input->fleet-fields#dirty change->fleet-fields#update input->fleet-preview#schedule change->fleet-preview#schedule"><input type="hidden" name="_token" value="{{ csrf_token('fleet') }}"><input type="hidden" name="request_key" value="{{ request_key() }}"><input type="hidden" name="origin" value="{{ f.homePlanet.id }}"><div class="catalog-grid"><div><label for="mission-{{ f.id }}">Mission</label><select id="mission-{{ f.id }}" name="mission"><option value="explore" {{ prefill.mission=='explore'?'selected':'' }}>Exploration d'un système</option><option value="colonize" {{ prefill.mission=='colonize'?'selected':'' }}>Colonisation d'une planète</option><option value="transport" {{ prefill.mission=='transport'?'selected':'' }}>Transport vers une de vos colonies</option><option value="attack" {{ prefill.mission=='attack'?'selected':'' }}>Attaque d’une planète ennemie</option></select><label for="ratio-{{ f.id }}">Vitesse</label><select name="ratio" id="ratio-{{ f.id }}">{% for i in 1..10 %}<option value="{{ i/10 }}" {{ i==10?'selected':'' }}>{{ i*10 }} %</option>{% endfor %}</select></div><div><div data-fleet-fields-target="system"><label for="system-{{ f.id }}">Système cible (exploration)</label><select name="system" id="system-{{ f.id }}">{% for s in systems %}<option value="{{ s.id }}" {{ prefill.system==s.id?'selected':'' }}>{{ s.name }} ({{ s.coordX }}, {{ s.coordY }})</option>{% endfor %}</select></div><div data-fleet-fields-target="planet"><label for="planet-{{ f.id }}">Planète cible (colonisation / transport / attaque)</label><select name="planet" id="planet-{{ f.id }}">{% for p in targets %}<option value="{{ p.id }}" {{ prefill.planet==p.id?'selected':'' }}>{{ p.name }} · {{ p.owner?'colonisée':'libre' }}</option>{% endfor %}</select></div></div><div><h3>Composition</h3>{% for ship in row.ships %}{% if ship.quantity>0 %}<label for="ship-{{ f.id }}-{{ ship.slug }}">{{ catalog[ship.slug].label }} · {{ ship.quantity }} disponibles</label><input type="number" min="0" max="{{ ship.quantity }}" value="0" name="ships[{{ ship.slug }}]" id="ship-{{ f.id }}-{{ ship.slug }}">{% endif %}{% endfor %}</div></div><details data-fleet-fields-target="cargo"><summary>Fret (transport uniquement)</summary><div class="resource-grid">{% for slug,label in resources %}<div><label for="cargo-{{ f.id }}-{{ slug }}">{{ label }}</label><input id="cargo-{{ f.id }}-{{ slug }}" type="number" min="0" max="100000000" name="cargo[{{ slug }}]" value="0"></div>{% endfor %}</div></details><p class="muted">Chaque vaisseau dispose d’un réservoir de carburant. Les transporteurs ajoutent une soute pour le fret ou du carburant supplémentaire. À 50 % de vitesse, le trajet dure deux fois plus longtemps et consomme deux fois moins. Le carburant aller-retour est réservé dès le départ. Une sonde ou un vaisseau colonie est consommé à l'arrivée d'une mission réussie. Une attaque ouvre une fenêtre de combat de dix minutes; les flottes en garnison défendent la planète.</p><div class="flight-estimate" aria-live="polite" data-fleet-preview-target="result">Sélectionnez vos vaisseaux pour estimer le trajet.</div><button type="button" class="secondary" data-action="fleet-preview#estimate">Estimer le trajet</button><button class="primary" {{ fuel_pending?'disabled':'' }}>Envoyer la flotte ↗</button></form></section>{% else %}<p class="panel">Construisez d'abord vos vaisseaux dans le chantier spatial de votre colonie.</p>{% endfor %}
</div><section data-live-region="missions"><div class="section-heading"><h2>Journal des missions</h2>{{ ui.icon('clock') }}</div><div class="mission-list">{% set mission_count=0 %}{% for f in fleets %}{% if f.status!='idle' %}{% set mission_count=mission_count+1 %}<article class="panel mission-card" data-status="{{ f.status }}"><span class="mission-symbol">{{ ui.icon(f.mission=='transport'?'storage':'fleet') }}</span><div><p class="eyebrow">EXPÉDITION {{ f.id }}</p><h3>{{ mission_labels[f.mission]|default(f.mission) }}</h3><p>{{ f.homePlanet.name }} <span aria-hidden="true">→</span> {{ f.destination?f.destination.name:f.destinationSystem.name }}</p></div><div class="mission-state"><span class="badge status--{{ f.status }}">{{ status_labels[f.status]|default(f.status) }}</span>{% if f.arrivalAt and f.status in ['traveling','returning'] %}<span class="mission-timer" data-controller="countdown" data-countdown-end-value="{{ f.arrivalAt|date('c') }}"><span data-countdown-target="time">{{ f.arrivalAt|date('H:i:s') }}</span></span>{% endif %}</div></article>{% endif %}{% endfor %}{% if mission_count==0 %}<div class="panel empty-state">{{ ui.icon('galaxy') }}<h3>L'horizon vous attend.</h3><p>Vos expéditions apparaîtront ici après leur lancement.</p></div>{% endif %}</div></section></div>{% endblock %}
