{% use 'form_div_layout.html.twig' %}
{% block form_errors %}
    {% if errors|length > 0 %}
        <div id="{{ id }}_errors" role="alert"><ul>
            {% for error in errors %}
                <li>{{ error.message }}</li>
            {% endfor %}
        </ul></div>
    {% endif %}
{% endblock form_errors %}
