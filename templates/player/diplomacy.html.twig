{% extends 'base.html.twig' %}{% block title %}Diplomatie · Genesis Reborn{% endblock %}{% block body %}{% import 'ui/macros.html.twig' as ui %}{% set relation_labels={allies:'Alliés',enemies:'Ennemis',neutral:'Neutre',pending:'Proposition en attente'} %}<div class="page-heading"><div><p class="eyebrow">{{ membership.universe.name }}</p><h1>Alliances</h1><p>Les alliances directes sont réciproques et nécessitent l'accord des deux commandants.</p></div></div><nav class="alliance-tabs" aria-label="Sections des alliances"><a href="#alliance-overview">Vue d’ensemble</a><a href="#alliance-members">Membres</a><a href="#alliance-diplomacy">Diplomatie</a><a href="#alliance-guilds">Guildes</a></nav><section class="alliance-banner panel" id="alliance-overview"><span class="alliance-banner-icon">{{ ui.icon('diplomacy') }}</span><div>{% if own %}<p class="eyebrow">VOTRE GUILDE</p><h2>{{ own.name }}</h2><p>Commandement : {{ own.leader.player.username }}</p>{% elseif enabled %}<p class="eyebrow">VOTRE DIPLOMATIE</p><h2>Aucune alliance</h2><p>Créez une guilde ou gérez vos relations directes avec les autres commandants.</p>{% else %}<p class="eyebrow">ÉTAT DES ALLIANCES</p><h2>Diplomatie directe</h2><p>Les guildes sont désactivées dans cet univers; les contrats entre commandants restent disponibles.</p>{% endif %}</div>{% if own %}<span class="badge">{{ own.leader.id==membership.id?'Commandant':'Membre' }}</span>{% elseif enabled %}<a class="secondary" href="#alliance-guilds">Découvrir les guildes {{ ui.icon('arrow') }}</a>{% else %}<span class="badge">Guildes désactivées</span>{% endif %}</section><div class="section-heading" id="alliance-diplomacy"><h2>Relations entre commandants</h2>{{ ui.icon("diplomacy") }}</div><div class="catalog-grid" id="alliance-members">{% for row in players %}<article class="panel commander-card"><span class="avatar">{{ row.player.player.username|first|upper }}</span><h3>{{ row.player.player.username }}</h3><p>{{ row.allied?'Allié':(row.contract?'Proposition en attente':'Neutre') }}</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ row.player.id }}">{% if not row.contract %}<button class="secondary" name="action" value="propose">Proposer une alliance</button>{% else %}{% if row.contract.status=='pending' and row.contract.proposer.id!=membership.id %}<button class="primary" name="action" value="accept">Accepter l'alliance</button>{% endif %}<button class="text-button" name="action" value="break">{{ row.contract.status=='accepted'?'Rompre le contrat':'Annuler / refuser' }}</button>{% endif %}</form></article>{% else %}<p>Aucun autre commandant dans cet univers pour le moment.</p>{% endfor %}</div><div class="section-heading spaced" id="alliance-guilds"><h2>Guildes de l’univers</h2>{{ ui.icon("diplomacy") }}</div>{% if not enabled %}<p class="panel">Les guildes sont désactivées dans cet univers.</p>{% else %}{% if not own %}<form method="post" class="panel narrow"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="action" value="create"><label for="guild-name">Nom de votre nouvelle guilde</label><input id="guild-name" name="name" minlength="3" maxlength="60" required><button class="primary">Fonder une guilde</button></form>{% else %}<div class="guild-banner panel"><p class="eyebrow">VOTRE GUILDE</p><h2>{{ own.name }}</h2><p>Commandement : {{ own.leader.player.username }}</p></div>{% if own.leader.id==membership.id %}<details class="panel"><summary>Gérer le commandement</summary><p>Transférez le commandement avant de quitter votre guilde, ou dissolvez-la. Les contrats personnels sont conservés.</p><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><label for="successor">Nouveau commandant</label><select id="successor" name="target">{% for row in guilds %}{% if row.guild.id==own.id %}{% for member in row.members %}{% if member.playerUniverse.id!=membership.id %}<option value="{{ member.playerUniverse.id }}">{{ member.playerUniverse.player.username }}</option>{% endif %}{% endfor %}{% endif %}{% endfor %}</select><button class="secondary" name="action" value="transfer">Transférer le commandement</button></form><form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><button class="text-button" name="action" value="disband">Dissoudre la guilde</button></form></details>{% endif %}{% if own.leader.id!=membership.id %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><button class="text-button" name="action" value="leave">Quitter la guilde</button></form>{% endif %}{% endif %}<div class="catalog-grid">{% for row in guilds %}{% set g=row.guild %}<article class="panel guild-card"><span class="badge">{{ relation_labels[row.status]|default(row.status) }}</span><h3>{{ g.name }}</h3><p>Commandement : {{ g.leader.player.username }}</p><ul>{% for member in row.members %}<li>{{ member.playerUniverse.player.username }}</li>{% endfor %}</ul>{% if not own %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ g.id }}"><button class="secondary" name="action" value="join">Rejoindre · recrutement ouvert</button></form>{% elseif own.id!=g.id and own.leader.id==membership.id %}<form method="post"><input type="hidden" name="_token" value="{{ csrf_token('diplomacy') }}"><input type="hidden" name="target" value="{{ g.id }}"><input type="hidden" name="action" value="relation"><label for="relation-{{ g.id }}">Relation réciproque</label><select name="status" id="relation-{{ g.id }}"><option value="allies">Proposer / accepter l'alliance</option><option value="enemies">Déclarer ennemis</option><option value="neutral">Revenir à la neutralité</option></select><button class="secondary">Mettre à jour</button></form>{% endif %}</article>{% endfor %}</div>{% endif %}{% endblock %}
