{% extends 'base.html.twig' %}
{% block title %}Classement · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading">
    <div><p class="eyebrow">{{ membership.universe.name }}</p><h1>Classement</h1><p>Les points suivent les ressources engagées dans les entités encore possédées. Les points de flotte incluent les vaisseaux mobiles et les défenses fixes; une perte retire les points correspondants.</p></div>
</div>
<div class="section-heading"><h2>Commandants</h2></div>
<div class="panel table-scroll" role="region" tabindex="0" aria-label="Classement défilant horizontalement">
<table class="data-table">
    <caption>Classement de l’univers {{ membership.universe.name }}</caption>
    <thead><tr><th scope="col">Rang</th><th scope="col">Commandant</th><th scope="col" aria-sort="{{ sort=='points'?'descending':'none' }}"><a href="{{ path('app_leaderboard',{by:'points'}) }}">Points</a></th><th scope="col" aria-sort="{{ sort=='fleet'?'descending':'none' }}"><a href="{{ path('app_leaderboard',{by:'fleet'}) }}">Flotte et défenses</a></th><th scope="col" aria-sort="{{ sort=='planets'?'descending':'none' }}"><a href="{{ path('app_leaderboard',{by:'planets'}) }}">Planètes</a></th><th scope="col">Action</th></tr></thead>
    <tbody>
    {% for row in rows %}
        <tr{% if row.membership.id==membership.id %} aria-current="true"{% endif %}>
            <td>#{{ row.ranks[sort] }}</td><th scope="row">{{ row.membership.player.username }}{% if row.membership.id==membership.id %} <span class="badge">Vous</span>{% endif %}</th>
            <td title="Recherche : {{ row.research_points }} · Flotte : {{ row.fleet_points }} · Bâtiments : {{ row.building_points }}">{{ row.total_points|number_format(0,',',' ') }}</td>
            <td title="{{ row.ship_units }} vaisseaux mobiles · {{ row.defense_units }} défenses fixes">{{ row.fleet_points|number_format(0,',',' ') }}</td>
            <td>{{ row.planets }}</td><td>{% if row.membership.id!=membership.id %}<a class="secondary" href="{{ path('app_messages',{with:row.membership.id}) }}">Contacter {{ row.membership.player.username }}</a>{% else %}<span class="muted">Vous</span>{% endif %}</td>
        </tr>
    {% else %}
        <tr><td colspan="6">Aucun commandant dans cet univers.</td></tr>
    {% endfor %}
    </tbody>
</table>
</div>
{% endblock %}
