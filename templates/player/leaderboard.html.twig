{% extends 'base.html.twig' %}
{% block title %}Classement · Genesis Reborn{% endblock %}
{% block body %}
<div class="page-heading"><div><h1>Classement</h1><p>Classement par points totaux. Les points suivent les ressources engagées dans les entités encore possédées. La flotte inclut les vaisseaux et les défenses fixes.</p></div></div>
<nav class="alliance-tabs ui-tabs" aria-label="Classements">{% for key,label in {players:'Joueurs',guilds:'Guildes'} %}<a href="{{ path('app_leaderboard',{tab:key}) }}" {% if tab==key %}class="active" aria-current="page"{% endif %}>{{ label }}</a>{% endfor %}</nav>
{% if tab=='players' %}
<p class="ranking-legend"><span class="ranking-label ranking-label--enemy">Ennemi</span><span class="ranking-label ranking-label--guild">Allié de guilde</span><span class="ranking-label ranking-label--commander">Allié commandant</span></p>
<div class="panel table-scroll" role="region" tabindex="0" aria-label="Classement défilant horizontalement">
<table class="data-table ranking-table"><caption>Classement de l’univers {{ membership.universe.name }}</caption>
<thead><tr><th scope="col">Rang</th><th scope="col">Commandant</th><th scope="col">Points bâtiments</th><th scope="col">Points recherches</th><th scope="col">Points flotte</th><th scope="col" aria-sort="descending">Points totaux <span aria-hidden="true">↓</span></th><th scope="col">Action</th></tr></thead>
<tbody>{% for row in rows %}<tr class="ranking-row--{{ row.relation }}" {% if row.membership.id==membership.id %}aria-current="true"{% endif %}>
<td>#{{ row.ranks.points }}</td><th scope="row">{{ row.membership.player.username }}{% if row.relation in ['enemy','guild','commander'] %}<small class="ranking-relation">{{ {enemy:'Ennemi',guild:'Allié de guilde',commander:'Allié commandant'}[row.relation] }}</small>{% endif %}
{% if row.protection.active %}<span class="player-protection-shield" role="img" aria-label="Protection temporaire active" title="{{ row.protection.reason }} · jusqu’au {{ row.protection.until|date('d/m/Y H:i',preferences.timezone) }}"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6L12 2z"/></svg></span>{% endif %}{% if row.membership.id==membership.id %}<span class="badge">Vous</span>{% endif %}</th>
<td>{{ row.building_points|number_format(0,',',' ') }}</td><td>{{ row.research_points|number_format(0,',',' ') }}</td><td title="{{ row.ship_units }} vaisseaux mobiles · {{ row.defense_units }} défenses fixes">{{ row.fleet_points|number_format(0,',',' ') }}</td><td><strong>{{ row.total_points|number_format(0,',',' ') }}</strong></td>
<td>{% if row.membership.id!=membership.id %}<a class="leaderboard-contact" href="{{ path('app_messages',{with:row.membership.id}) }}" aria-label="Contacter {{ row.membership.player.username }}" title="Contacter {{ row.membership.player.username }}"><svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 6 9 7 9-7"/></svg></a>{% else %}<span class="muted">Vous</span>{% endif %}</td></tr>
{% else %}<tr><td colspan="7">Aucun commandant dans cet univers.</td></tr>{% endfor %}</tbody></table></div>
{% else %}
<p class="ranking-legend"><span class="ranking-label ranking-label--guild">Guilde alliée</span><span class="ranking-label ranking-label--enemy">Guilde ennemie</span></p>
<div class="panel table-scroll" role="region" tabindex="0" aria-label="Classement des guildes défilant horizontalement"><table class="data-table ranking-table"><caption>Classement des guildes de l’univers {{ membership.universe.name }}</caption><thead><tr><th scope="col">Rang</th><th scope="col">Guilde</th><th scope="col">Joueurs</th><th scope="col">Points bâtiments</th><th scope="col">Points recherches</th><th scope="col">Points flotte</th><th scope="col" aria-sort="descending">Points totaux <span aria-hidden="true">↓</span></th><th scope="col">Médiane des points joueurs</th></tr></thead><tbody>
{% for row in guildRows %}<tr class="ranking-row--{{ row.relation }}" {% if ownGuild and ownGuild.id==row.guild.id %}aria-current="true"{% endif %}><td>#{{ row.rank }}</td><th scope="row">{{ row.guild.name }}{% if row.relation in ['guild','enemy'] and (not ownGuild or ownGuild.id!=row.guild.id) %}<small class="ranking-relation">{{ row.relation=='guild' ? 'Guilde alliée' : 'Guilde ennemie' }}</small>{% endif %}{% if ownGuild and ownGuild.id==row.guild.id %} <span class="badge">Votre guilde</span>{% endif %}</th><td>{{ row.members }}</td>{% for key in ['building_points','research_points','fleet_points','total_points'] %}<td>{{ row[key]|number_format(0,',',' ') }}</td>{% endfor %}<td>{{ row.median_points|number_format(row.median_points != row.median_points|round(0,'floor') ? 1 : 0,',',' ') }}</td></tr>{% else %}<tr><td colspan="8">Aucune guilde dans cet univers.</td></tr>{% endfor %}
</tbody></table></div>
{% endif %}
{% endblock %}
