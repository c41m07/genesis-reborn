{% extends 'base.html.twig' %}
{% block title %}Paramètres · Genesis Reborn{% endblock %}
{% block body %}<section class="panel narrow"><p class="eyebrow">PERSONNALISATION</p><h1>Paramètres</h1><p>Ces réglages s’appliquent à votre compte et à cette interface.</p>{{ form_start(form) }}{{ form_row(form.theme) }}{{ form_row(form.timezone) }}<h2>Raccourcis de la galaxie</h2><p>Choisissez la vitesse initiale des missions rapides. Vous pourrez encore l’ajuster depuis l’écran des flottes.</p>{{ form_row(form.galaxySpySpeed) }}{{ form_row(form.galaxyColonizeSpeed) }}<div class="preference-toggle">{{ form_widget(form.reducedMotion) }}{{ form_label(form.reducedMotion) }}{{ form_errors(form.reducedMotion) }}</div><div class="preference-toggle">{{ form_widget(form.realtimeNotifications) }}{{ form_label(form.realtimeNotifications) }}{{ form_errors(form.realtimeNotifications) }}</div><div class="preference-toggle">{{ form_widget(form.showLockedItems) }}{{ form_label(form.showLockedItems) }}{{ form_errors(form.showLockedItems) }}</div><button class="primary full">Enregistrer les paramètres</button>{{ form_end(form) }}<p><a class="profile-preferences-link" href="{{ path('app_profile') }}">Retour au profil</a></p></section>{% endblock %}
