{% extends 'base.html.twig' %}{% form_theme form 'form/registration_errors.html.twig' %}{% block title %}Nouveau mot de passe · Genesis Reborn{% endblock %}
{% block body %}<section class="panel narrow auth-card" aria-labelledby="reset-title"><h1 id="reset-title">Choisir un nouveau mot de passe</h1><p>Le lien est valable une heure et ne peut servir qu’une fois.</p>{{ form_start(form, {attr: {class: 'auth-form'}}) }}{{ form_widget(form) }}<button class="primary full" type="submit">Modifier le mot de passe</button>{{ form_end(form) }}<p class="auth-back"><a href="{{ path('app_password_reset_request') }}">Demander un nouveau lien</a></p></section>{% endblock %}
