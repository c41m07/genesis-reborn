{% extends 'base.html.twig' %}{% block title %}Mot de passe oublié · Genesis Reborn{% endblock %}
{% block body %}<section class="panel narrow" aria-labelledby="reset-request-title"><p class="eyebrow">ACCÈS COMMANDANT</p><h1 id="reset-request-title">Mot de passe oublié</h1><p>Indiquez l’adresse email associée à votre compte. Si elle existe, nous vous enverrons un lien temporaire.</p>{{ form_start(form) }}{{ form_row(form.email) }}<button class="primary full" type="submit">Envoyer le lien</button>{{ form_end(form) }}<p><a href="{{ path('app_login') }}">Retour à la connexion</a></p></section>{% endblock %}
