{% if card.benefits %}<div class="card-benefits" aria-label="Bénéfice de {{ d.label }}">{% for benefit in card.benefits %}{% if benefit.text is defined %}{% if benefit.label is defined %}<div><span>{{ benefit.label }}</span><strong>{{ benefit.text }}</strong></div>{% else %}<p>{{ benefit.text }}</p>{% endif %}{% else %}<div><span>{{ benefit.label }}</span><strong>{% if benefit.before is defined %}{{ benefit.before|number_format(0,',',' ') }} <span aria-hidden="true">→</span> {% endif %}{{ (benefit.after is defined?benefit.after:benefit.value)|number_format(0,',',' ') }} {{ benefit.unit }}</strong></div>{% endif %}{% endfor %}</div>{% endif %}
{% if show_locked_items and card.unlocks %}<details class="card-unlocks"><summary>Débloque {{ card.unlocks|length }} possibilité{{ card.unlocks|length>1?'s':'' }}</summary><ul>{% for unlock in card.unlocks %}<li><a href="{{ path('app_colony',{id:planet.id,section:unlock.group}) }}#item-{{ unlock.slug }}">{{ unlock.label }}</a><small>Dès le niveau {{ unlock.requiredLevel }} · autres prérequis possibles</small></li>{% endfor %}</ul></details>{% endif %}
