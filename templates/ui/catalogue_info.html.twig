{% set info = card.details %}
<div class="catalog-info" data-controller="catalog-info">
    <button class="catalog-info-trigger" type="button" data-action="catalog-info#open" aria-haspopup="dialog" aria-label="Informations sur {{ d.label }}">i</button>
    <dialog class="catalog-info-dialog" data-catalog-info-target="dialog" data-action="click->catalog-info#outside" aria-labelledby="catalog-info-title-{{ group }}-{{ d.slug }}-{{ card.tier }}">
        <div class="catalog-info-content">
            <header>
                <div><h2 id="catalog-info-title-{{ group }}-{{ d.slug }}-{{ card.tier }}">{{ d.label }}</h2></div>
                <form method="dialog"><button type="submit" class="catalog-info-close" aria-label="Fermer la fiche de {{ d.label }}">×</button></form>
            </header>
            <p class="catalog-info-intro">{{ info.intro }}</p>
            <p class="catalog-info-scope"><strong>Portée :</strong> {{ info.scope }}</p>

            {% if group in ['buildings','technologies'] %}
                <section aria-label="Progression">
                    <h3>Progression de ce rang</h3>
                    <dl class="catalog-info-stats catalog-info-progression">
                        <div><dt>Niveau actuel</dt><dd>{{ card.level }}</dd></div>
                        <div><dt>{{ card.maximum ? 'Progression terminée' : 'Niveau visé' }}</dt><dd>{{ card.maximum ? 'Niveau maximum atteint' : card.target }}</dd></div>
                        <div><dt>Niveau maximum</dt><dd>{{ d.max_level|default('Sans limite') }}</dd></div>
                        <div><dt>Rang</dt><dd>{{ d._tier_label }}</dd></div>
                    </dl>
                    {% if card.queued %}<p class="catalog-info-note">Une amélioration de ce rang est déjà en file. Les gains et le coût ci-dessous concernent le niveau visé après les niveaux déjà programmés.</p>{% endif %}
                    {% if not card.maximum and card.benefits %}
                        <h3>Gain du niveau {{ card.target }}</h3>
                        <ul class="catalog-info-benefits">
                            {% for benefit in card.benefits %}<li>{% if benefit.text is defined %}{% if benefit.label is defined %}<strong>{{ benefit.label }}</strong> · {% endif %}{{ benefit.text }}{% else %}<strong>{{ benefit.label }}</strong> · {% include 'ui/catalogue_benefit_value.html.twig' with {benefit: benefit} only %}{% endif %}</li>{% endfor %}
                        </ul>
                        {% if group == 'technologies' or d.slug in ['lab','shipyard','fortress'] %}
                            <div class="catalog-info-table-wrap"><table class="catalog-info-table"><caption>Effet cumulé des rangs</caption><thead><tr><th scope="col">Effet</th><th scope="col">Actuellement</th><th scope="col">Après ce niveau</th></tr></thead><tbody>
                                {% for benefit in card.benefits %}{% if benefit.before is defined %}<tr><th scope="row">{{ benefit.label }}</th><td>{{ benefit.before|number_format(2,',',' ')|trim('0','right')|trim(',','right') }} {{ benefit.unit }}</td><td>{{ benefit.after|number_format(2,',',' ')|trim('0','right')|trim(',','right') }} {{ benefit.unit }}</td></tr>{% endif %}{% endfor %}
                            </tbody></table></div>
                        {% endif %}
                    {% endif %}
                </section>
            {% else %}
                <p class="catalog-info-stock">{{ group == 'ships' ? 'En réserve sur cette colonie' : 'Déployées sur cette planète' }} · {{ d._tier_label }} : <strong>{{ card.quantity|number_format(0,',',' ') }}</strong></p>
                <section aria-label="Performances">
                    <h3>Performances de ce rang</h3>
                    <div class="catalog-info-table-wrap"><table class="catalog-info-table"><caption>Valeurs par unité, avec vos bonus actuels</caption><thead><tr><th scope="col">Statistique</th><th scope="col">Base du rang</th><th scope="col">Avec vos bonus</th></tr></thead><tbody>
                        {% for stat in info.performance %}<tr><th scope="row">{{ stat.label }}</th><td>{{ stat.base|number_format(2,',',' ')|trim('0','right')|trim(',','right') }} {{ stat.unit }}</td><td>{{ stat.effective|number_format(2,',',' ')|trim('0','right')|trim(',','right') }} {{ stat.unit }}</td></tr>{% endfor %}
                    </tbody></table></div>
                </section>
            {% endif %}

            {% for detail in info.sections %}
                <section class="catalog-info-section">
                    <h3>{{ detail.title }}</h3>
                    {% for paragraph in detail.paragraphs %}<p>{{ paragraph }}</p>{% endfor %}
                    {% if detail.rows %}<dl class="catalog-info-stats">
                        {% for row in detail.rows %}<div><dt>{{ row.label }}</dt><dd>{% if row.text is defined %}{{ row.text }}{% else %}{{ row.value|number_format(2,',',' ')|trim('0','right')|trim(',','right') }} {{ row.unit }}{% endif %}</dd></div>{% endfor %}
                    </dl>{% endif %}
                </section>
            {% endfor %}

            <section aria-label="Conditions d’accès">
                <h3>Conditions d’accès à ce rang{{ group in ['buildings','technologies'] and not card.maximum ? ' et au niveau '~card.target : '' }}</h3>
                {% if info.requirements %}<ul class="catalog-info-access">
                    {% for requirement in info.requirements %}<li class="{{ requirement.unreachable ? 'is-unreachable' : (requirement.met ? 'is-met' : 'is-missing') }}"><span>{{ requirement.met ? '✓ Rempli' : 'À obtenir' }}</span><strong>{{ requirement.label }}</strong> · {{ requirement.tier }}{% if requirement.required is not null %} · niveau {{ requirement.required }} requis (actuel : {{ requirement.current }}){% endif %}{% if requirement.unreachable %}<small class="catalog-info-unreachable">Prérequis actuellement inatteignable : le maximum de ce rang est {{ requirement.maximum }}.</small>{% endif %}</li>{% endfor %}
                </ul>{% else %}<p>Aucun prérequis de bâtiment ou de recherche pour ce rang.</p>{% endif %}
                {% if card.failures %}<p class="catalog-info-requirements"><strong>Accès bloqué :</strong> {{ card.failures|join(', ') }}</p>{% else %}<p class="catalog-info-ready">Prérequis remplis</p>{% endif %}
            </section>

            {% if info.unlocks %}
                <details class="catalog-info-unlocks"><summary>Accès associés à ce rang · {{ info.unlocks|length }}</summary>
                    <p>Ces éléments demandent un niveau de ce rang. Leurs autres prérequis doivent aussi être remplis.</p>{% if not show_locked_items %}<p>Les éléments verrouillés peuvent être masqués. <a href="{{ path('app_preferences') }}">Modifier leur affichage</a>.</p>{% endif %}
                    <ul>{% for unlock in info.unlocks %}<li><a href="{{ path('app_colony',{id:planet.id,section:unlock.group}) }}#item-{{ unlock.slug }}-{{ unlock.tier }}">{{ unlock.label }}</a> · {{ unlock.tierLabel }}<small>Niveau {{ unlock.requiredLevel }} requis dans {{ d.label }}</small>{% if unlock.unreachable %}<small class="catalog-info-unreachable">Seuil supérieur au maximum actuel de ce rang.</small>{% endif %}</li>{% endfor %}</ul>
                </details>
            {% endif %}

            {% if not card.maximum %}
                <section aria-label="Coût et durée">
                    <h3>{{ group in ['ships','defenses'] ? 'Construire une unité de ce rang' : (group == 'buildings' ? 'Améliorer au niveau '~card.target : 'Rechercher le niveau '~card.target) }}</h3>
                    <p>Durée : <strong>{{ duration_label(card.duration) }}</strong>{% if group in ['ships','defenses'] %} par unité{% endif %}.</p>
                    <ul class="catalog-info-costs" aria-label="Coût avec vos réductions actuelles">
                        {% for resource,cost in card.costs %}{% if cost>0 %}<li>{{ resources[resource].label|default(resource) }} <strong>{{ cost|number_format(0,',',' ') }}</strong></li>{% endif %}{% endfor %}
                    </ul>
                    <p class="catalog-info-note">Coût et durée calculés avec vos bonus actuels et les réglages de cet univers. Le temps d’attente des opérations déjà en file s’ajoute à cette durée.</p>
                </section>
            {% endif %}
            <form method="dialog"><button type="submit" class="secondary">Fermer la fiche</button></form>
        </div>
    </dialog>
</div>
