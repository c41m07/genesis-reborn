{% import 'ui/macros.html.twig' as ui %}
{% set mission_labels={explore:'Exploration',colonize:'Colonisation',transport:'Transport',attack:'Attaque',spy:'Espionnage',defend:'Défense',orbit:'Orbite',conquer:'Conquête'} %}
<section class="panel flight-operations" data-live-region="active-flights" aria-label="Flottes en vol dans votre empire">
<div class="section-heading"><div><p class="eyebrow">MON EMPIRE · TOUTES LES COLONIES</p><h2>{{ ui.icon('fleet') }} Flottes en vol <span class="badge">{{ active_fleets|length }}</span></h2></div><a href="{{ path('app_fleets') }}" class="inline-link">Gérer les flottes {{ ui.icon('arrow') }}</a></div>
{% for f in active_fleets %}{% set combat_event = combat_events[f.id]|default(null) %}<article class="flight-operation" data-active-fleet="{{ f.id }}"><div class="operation-heading"><span class="operation-type">{{ ui.icon(f.status=='returning'?'arrow':'fleet') }}{{ mission_labels[f.mission]|default(f.mission) }} <small>· {{ f.id }}</small></span><span class="badge {{ f.status=='returning'?'returning':'' }}">{{ f.status=='returning'?'RETOUR':(f.status=='attacking'?'EN COMBAT':(f.status=='defending'?'EN DÉFENSE':(f.status=='orbiting'?'EN ORBITE':(f.status=='orbit_pending'?'À ACCEPTER':'ALLER')))) }}</span></div><div class="flight-route"><span>{{ f.status=='returning'?(f.destination?f.destination.name:f.destinationSystem.name):f.homePlanet.name }}</span>{{ ui.icon('arrow') }}<span>{{ f.status=='returning'?f.homePlanet.name:(f.destination?f.destination.name:f.destinationSystem.name) }}</span></div>{% if combat_event and f.status in ['attacking','defending'] %}<div class="combat-timers" aria-label="Combat en cours, round {{ combat_event.currentRound + 1 }}"><strong class="combat-round">Round {{ combat_event.currentRound + 1 }}</strong><span>Prochain round dans <span data-controller="countdown" data-countdown-end-value="{{ combat_event.startedAt|date_modify('+' ~ ((combat_event.currentRound + 1) * 60) ~ ' seconds')|date('c') }}"><span data-countdown-target="time">{{ combat_event.startedAt|date_modify('+' ~ ((combat_event.currentRound + 1) * 60) ~ ' seconds')|date('H:i:s') }}</span></span></span><span class="combat-window">Fin estimée dans <span data-controller="countdown" data-countdown-end-value="{{ combat_event.resolveAt|date('c') }}"><span data-countdown-target="time">{{ combat_event.resolveAt|date('H:i:s') }}</span></span></span></div>{% endif %}{% if f.status=='orbit_pending' %}<p class="flight-idle">En attente de l’accord du propriétaire.</p>{% elseif f.arrivalAt %}{{ ui.progress(f.departureAt,f.arrivalAt,(f.status=='returning'?'Retour':(f.status=='defending'?'Fin de défense':(f.status=='orbiting'?'Fin d’orbite':'Arrivée')))~' de la flotte '~f.id) }}{% else %}<p class="flight-idle">Flotte engagée dans un combat.</p>{% endif %}</article>{% else %}<p class="flight-idle">Aucune flotte en vol. Les départs et les retours de toutes vos colonies apparaissent ici.</p>{% endfor %}
</section>
