<details class="panel technology-tree" {{ tree_standalone|default(false) ? 'open' : '' }}>
    <summary>Arbre technologique <span>{{ cards.technologies|length }} recherches</span></summary>
    <p>Les branches suivent les prérequis de recherche. Les bâtiments requis sont indiqués dans chaque fiche.</p>
    <div class="technology-graph" data-controller="technology-graph">
        <svg class="technology-graph-links" data-technology-graph-target="links" aria-hidden="true"></svg>
        {% for depth,nodes in technology_tree %}
            <section class="technology-branch-column" aria-label="Branche {{ depth + 1 }}">
                {% for node in nodes %}
                    <details id="tech-{{ node.slug }}-{{ node.tier }}" class="tech-node {{ node.available ? 'available' : 'locked' }}" data-technology-graph-target="node" data-node-key="{{ node.key }}" data-parents="{{ node.parents|json_encode|e('html_attr') }}">
                        <summary>
                            <span class="tech-node-tier tier-label--{{ node.tier }}">{{ {basic:'Basique',intermediate:'Intermédiaire',superior:'Supérieur'}[node.tier] }}</span>
                            <strong>{{ node.definition.label }}</strong>
                            <span class="badge">Niveau {{ node.level }}{% if node.definition.max_level is defined %} / {{ node.definition.max_level }}{% endif %}</span>
                            <small>{{ node.available ? 'Disponible' : 'Verrouillée' }}</small>
                        </summary>
                        <div class="tech-node-details">
                            {% if node.prerequisites %}
                                <h3>Prérequis</h3>
                                <ul>{% for requirement in node.prerequisites %}
                                    <li class="{{ requirement.met ? 'met' : 'missing' }}">
                                        <a href="{{ path('app_colony',{id:planet.id,section:requirement.group=='technologies'?'technologies':'buildings'}) }}#item-{{ requirement.slug }}-{{ requirement.tier }}">{{ requirement.met ? '✓' : '○' }} {{ requirement.label }} · niveau {{ requirement.level }} requis (actuel : {{ requirement.current }})</a>
                                    </li>
                                {% endfor %}</ul>
                            {% else %}
                                <p>Recherche de départ</p>
                            {% endif %}
                            <a class="tech-node-open" href="{{ path('app_colony',{id:planet.id,section:'technologies'}) }}#item-{{ node.slug }}-{{ node.tier }}">Voir la fiche de recherche →</a>
                        </div>
                    </details>
                {% endfor %}
            </section>
        {% endfor %}
    </div>
</details>
