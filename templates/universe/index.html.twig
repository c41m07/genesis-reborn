{% extends 'base.html.twig' %}{% block title %}Univers · Genesis Reborn{% endblock %}{% block body %}<div class="page-heading"><div><p class="eyebrow">CHOISIR VOTRE HORIZON</p><h1>Les univers</h1><p>Chaque univers possède sa propre carte et sa propre progression.</p></div><span class="badge">{{ universes|length }} UNIVERS</span></div><div class="universe-grid">{% for u in universes %}{% set c=configs[u.slug] %}<article class="panel universe-card"><div class="mini-planet {{ loop.index==2?'violet':'' }}" aria-hidden="true"></div><span class="badge">{{ u.isAccessible(now)?'OUVERT':'INACCESSIBLE' }}</span><h2>{{ u.name }}</h2><p>{{ u.slug=='turbo-1'?'Un espace pour expérimenter. Les constructions, recherches et vaisseaux sont accélérés pour vos essais.':'Prenez le temps de bâtir un empire durable dans un univers aux durées standard.' }}</p><dl><div><dt>Durée des constructions</dt><dd>× {{ c.multipliers.building_time }}</dd></div><div><dt>Planètes maximum</dt><dd>{{ c.limits.max_planets }}</dd></div><div><dt>Guildes</dt><dd>{{ c.features.guilds_enabled?'Activées':'Désactivées' }}</dd></div></dl>{% if u.isAccessible(now) %}<form method="post" action="{{ path('app_universe_join',{id:u.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('join'~u.id) }}"><button class="primary full">{{ app.user.currentPlayerUniverse and app.user.currentPlayerUniverse.universe.id==u.id?'Continuer dans cet univers':'Rejoindre cet univers' }} ↗</button></form>{% endif %}</article>{% else %}<p class="panel">Aucun univers n'est encore ouvert.</p>{% endfor %}</div>{% endblock %}
