{% extends 'base.html.twig' %}
{% import 'ui/macros.html.twig' as ui %}
{% block title %}Galaxie · Genesis Reborn{% endblock %}
{% block body %}
{% include 'ui/galaxy_tabs.html.twig' %}
<div class="page-heading"><div><h1>Galaxie</h1><p>Un univers de possibilités. Explorez les systèmes connus et préparez vos prochaines missions.</p></div><span class="badge">{{ systems|length }} systèmes</span></div>
<form class="galaxy-controls panel" method="get" action="{{ path('app_map') }}" data-controller="galaxy-select" data-action="change->galaxy-select#change"><div><label for="galaxy-display">Galaxie</label><select id="galaxy-display" name="galaxy">{% for galaxy in galaxies %}<option value="{{ galaxy.id }}" {{ selected_galaxy and selected_galaxy.id==galaxy.id?'selected':'' }}>{{ galaxy.name }}</option>{% endfor %}</select></div><div><label for="system-select">Système</label><select id="system-select" name="system" data-galaxy-select-target="system">{% for row in systems %}<option value="{{ row.system.id }}" {{ selected_system and selected_system.system.id==row.system.id?'selected':'' }}>{{ row.system.galaxy.coordinateCode() }}:{{ row.system.number() }} · {{ row.system.name }}</option>{% endfor %}</select></div><button class="secondary">Afficher le système</button><div class="map-legend-inline" aria-label="Légende"><span><i class="map-key owned"></i>Votre colonie</span><span><i class="map-key known"></i>Système exploré</span><span><i class="map-key"></i>Signal inconnu</span></div></form>
<p class="map-origin-note">{% if map_origin %}Les missions rapides partent de <strong>{{ map_origin.name }}</strong> · {{ map_origin.coordinates() }}.{% else %}Sélectionnez une planète dans votre empire pour envoyer une mission rapide.{% endif %}</p>
{% if selected_system %}
<section class="panel galaxy-system-panel" aria-labelledby="selected-system-title"><header class="galaxy-system-heading"><div><h2 id="selected-system-title">{{ selected_system.system.galaxy.coordinateCode() }}:{{ selected_system.system.number() }} · {{ selected_system.system.name }}</h2><p>{% if selected_system.known %}{{ selected_system.planets|length }} positions planétaires cartographiées{% else %}Signal non cartographié · envoyez une flotte d’exploration pour révéler les planètes{% endif %}</p></div><span class="badge">{{ selected_system.known?'Exploré':'Inconnu' }}</span></header>
{% if selected_system.known %}<p class="galaxy-table-hint">Sur petit écran, faites défiler le tableau pour voir toutes les actions.</p><div class="table-scroll" role="region" tabindex="0" aria-label="Positions du système, défilement horizontal"><table class="data-table galaxy-table"><thead><tr><th scope="col">Position</th><th scope="col">Planète</th><th scope="col">Occupant / informations</th><th scope="col">Type de cible</th><th scope="col">Actions disponibles</th></tr></thead><tbody>{% for p in selected_system.planets|sort((a,b)=>a.position<=>b.position) %}<tr><td>[{{ p.coordinates() }}]</td><th scope="row"><span class="galaxy-planet-name"><i class="planet-dot" aria-hidden="true"></i>{{ p.name }}</span></th><td>{% if p.owner and p.owner.id==membership.id %}Vous{% elseif p.owner %}{{ p.owner.player.username }}{% elseif p.npcPlanet %}Faction PNJ · niveau {{ p.conquestLevel }}{% else %}Planète inhabitée{% endif %}</td><td><span class="badge">{% if p.owner and p.owner.id==membership.id %}Votre planète{% elseif p.owner %}Joueur{% elseif p.npcPlanet %}PNJ · conquérable{% else %}Colonisable{% endif %}</span></td><td class="galaxy-actions">{% if p.owner and p.owner.id==membership.id %}<a class="secondary" href="{{ path('app_colony',{id:p.id}) }}">Gérer {{ ui.icon('arrow') }}</a>{% elseif p.owner %}{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'spy',quick_target:p.id} %}{% elseif p.npcPlanet %}<a class="secondary" href="{{ path('app_fleets',{mission:'conquer',planet:p.id}) }}">Préparer la conquête {{ ui.icon('arrow') }}</a>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'spy',quick_target:p.id} %}{% else %}{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'colonize',quick_target:p.id} %}{% endif %}</td></tr>{% endfor %}</tbody></table></div>{% else %}<div class="galaxy-unknown-panel"><p>Les coordonnées de ce système sont connues, mais ses planètes ne sont pas encore révélées.</p>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'explore',quick_target:selected_system.system.id} %}</div>{% endif %}
</section>
{% endif %}
<details class="system-catalog"><summary>Parcourir les autres systèmes ({{ systems|length }})</summary><div class="system-grid">{% for row in systems %}<article class="panel system-card {{ row.known?'known-system':'unknown-system' }}"><p class="muted">{{ row.system.galaxy.coordinateCode() }}:{{ row.system.number() }}</p><h2><span class="star" aria-hidden="true">✦</span> {{ row.system.name }}</h2>{% if row.known %}<span class="badge">EXPLORÉ</span><ul class="planet-list">{% for p in row.planets %}<li class="{{ p.owner and p.owner.id==membership.id?'owned-planet':'' }}"><span><i class="planet-dot" aria-hidden="true"></i>{{ p.coordinates() }}</span>{% if p.owner and p.owner.id==membership.id %}<a href="{{ path('app_colony',{id:p.id}) }}">{{ p.name }}</a><a class="map-mission" href="{{ path('app_fleets',{mission:'transport',planet:p.id}) }}">Ravitailler →</a>{% elseif p.owner %}<span>Colonisée par un joueur</span>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'spy',quick_target:p.id} %}{% elseif p.npcPlanet %}<span>Planète PNJ · niveau {{ p.conquestLevel }}</span><a class="map-mission" href="{{ path('app_fleets',{mission:'conquer',planet:p.id}) }}">Préparer la conquête →</a>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'spy',quick_target:p.id} %}{% else %}<span>Planète vierge</span>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'colonize',quick_target:p.id} %}{% endif %}</li>{% endfor %}</ul>{% else %}<p class="unknown">Signal non cartographié</p><p class="muted">Planètes inconnues. Une sonde exploratrice doit découvrir ce système.</p>{% include 'ui/map_quick_mission.html.twig' with {quick_mission:'explore',quick_target:row.system.id} %}{% endif %}</article>{% endfor %}</div></details>
{% endblock %}
