{% extends 'base.html.twig' %}{% block title %}Carte · Genesis Reborn{% endblock %}{% block body %}{% import 'ui/macros.html.twig' as ui %}<div class="page-heading"><div><p class="eyebrow">{{ membership.universe.name }}</p><h1>Carte stellaire</h1><p>Les systèmes inconnus gardent leurs planètes secrètes jusqu'à leur exploration.</p></div><span class="badge">{{ systems|length }} SYSTÈMES</span></div><div class="map-legend panel"><span><i class="map-key known"></i>Système exploré</span><span><i class="map-key owned"></i>Votre colonie</span><span><i class="map-key"></i>Signal inconnu</span><a href="{{ path('app_fleets') }}">Envoyer une sonde {{ ui.icon("arrow") }}</a></div><div class="system-grid">{% for row in systems %}<article class="panel system-card {{ row.known?'known-system':'unknown-system' }}"><p class="eyebrow">{{ row.system.galaxy.name }} / {{ row.system.coordX }}, {{ row.system.coordY }}</p><h2><span class="star" aria-hidden="true">✦</span> {{ row.system.name }}</h2>{% if row.known %}<span class="badge">EXPLORÉ</span><ul class="planet-list">{% for p in row.planets %}<li class="{{ p.owner and p.owner.id==membership.id?'owned-planet':'' }}"><span><i class="planet-dot" aria-hidden="true"></i>Position {{ p.position }}</span>{% if p.owner and p.owner.id==membership.id %}<a href="{{ path('app_colony',{id:p.id}) }}">{{ p.name }}</a><a class="map-mission" href="{{ path('app_fleets',{mission:'transport',planet:p.id}) }}">Ravitailler →</a>{% else %}{% if p.owner %}<span>Colonisée par un joueur</span>{% elseif p.npcPlanet %}<span>Planète PNJ · niveau {{ p.conquestLevel }}<a class="map-mission" href="{{ path('app_fleets',{mission:'conquer',planet:p.id}) }}">Conquérir →</a></span>{% else %}<span>Planète vierge<a class="map-mission" href="{{ path('app_fleets',{mission:'colonize',planet:p.id}) }}">Coloniser →</a></span>{% endif %}<a class="map-mission" href="{{ path('app_fleets',{mission:'spy',planet:p.id}) }}">Espionner →</a>{% endif %}</li>{% endfor %}</ul>{% else %}<p class="unknown">Signal non cartographié</p><p class="muted">Planètes inconnues. Une sonde exploratrice doit découvrir ce système.</p><a class="inline-link" href="{{ path('app_fleets',{mission:'explore',system:row.system.id}) }}">Explorer ce système {{ ui.icon('arrow') }}</a>{% endif %}</article>{% endfor %}</div>{% endblock %}
